								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1668598835485_219634_18334' body='&lt;para&gt;Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1668598835482_504105_18332'/>
