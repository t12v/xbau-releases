						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264175_856403_25406' name='bauherr' visibility='private' type='_19_0_4_b6602da_1688632025529_352662_21872'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282093_54194_30126' body='&lt;para&gt;Hier ist derjenige einzutragen, der am Verfahren als Bauherr beteiligt ist, inklusive seiner Rolle. Pro Bauherrn ist ein Element zu instanziieren. Bei mehreren Bauherren sollte das Element artdesBauherren mindestens bei einer Instanziierung befüllt sein.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264175_856403_25406'/>
							</ownedComment>
