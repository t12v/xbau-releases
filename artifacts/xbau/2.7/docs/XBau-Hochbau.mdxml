					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_131403da_1624428975996_380331_17143' name='abgeschlossenheit.antragGeaendert.0252'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1624428975999_902500_17144' body='&lt;para&gt;Diese Nachricht enthält geänderte oder ergänzte Daten der Antragstellung zur Abgeschlossenheit. Sie bezieht sich auf einen bereits gestellten Antrag, zu dem noch kein Bescheid erteilt wurde.&lt;/para&gt;&#10;&#10;&lt;para&gt;Entweder ist sie eine Reaktion auf eine zum Antrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen einen modifizierten Antrag im laufenden Verfahren nach.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_131403da_1624428975996_380331_17143'/>
						</ownedComment>
