						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1624429123200_950423_17177' name='abgeschlossenheitsbescheinigungGeaendert' visibility='private' type='_19_0_131403da_1623918845237_309998_17362'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1624429123202_93005_17179' body='&lt;para&gt;Mit diesem Element werden ggf. geänderte Informationen zu den Räumlichkeiten und der Art der Abgeschlossenheitsbescheinigung übermittelt.&lt;/para&gt;'>
