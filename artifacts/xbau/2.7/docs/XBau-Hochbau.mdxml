						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264149_25186_25275' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266226_379045_26800' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282500_227170_33479' body='&lt;para&gt;Hier trägt die Bauaufsichtsbehörde die Vorgangsnummer (Beauftragung und damit zusammenhängende Kommunikation) für künftige Referenzierung ein.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266226_379045_26800'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282500_166414_33480' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282500_819683_33478' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697455458628_371870_24662' name='pruefingenieur' visibility='private' type='_19_0_4_b6602da_1697455636812_338007_24673'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697455589968_813981_24672' body='&lt;para&gt;In diesem Element werden identifizierende Angaben zum zu beauftragenden Prüfingenieur gemacht.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1697455458628_371870_24662'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1697455496492_630841_24666' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1697455496502_593614_24667' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266227_644243_26802' name='pruefauftrag' visibility='private' type='_19_0_3_136d03d4_1611871266232_637340_26832'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282501_214983_33487' body='&lt;para&gt;In diesem Element wird der Prüfauftrag detailliert. Jeder Prüfauftrag bezieht sich auf genau einen Typ bautechnischen Nachweis und die damit verbundenen Aufgaben der Bauüberwachung.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266227_644243_26802'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282501_190202_33488' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282501_587730_33486' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266227_517104_26803' name='rahmendatenGebuehrenberechnung' visibility='private' type='_19_0_3_136d03d4_1611871266233_668239_26835'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282502_913536_33491' body='&lt;para&gt;In diesem Element sind Rahmendaten zur Gebührenberechnung aus Sicht der Bauaufsichtsbehörde abgebildet, soweit sie auf den hier erteilten Auftrag anwendbar sind. Sie geben dem Auftragnehmer die Möglichkeit, die Komplexität des Bauvorhabens einzuschätzen, in dessen Kontext der Auftrag erteilt wird, und entsprechend Aufwand und Auftragswert des Prüfauftrags zu kalkulieren.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266227_517104_26803'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282502_153877_33492' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282502_892501_33490' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266227_153484_26804' name='bauvorhaben' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244694_158760_23371'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282502_962543_33495' body='&lt;para&gt;Hier sind die Daten zum Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266227_153484_26804'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282502_888336_33496' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282502_621339_33494' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266227_143667_26805' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282503_984936_33499' body='&lt;para&gt;Dieses Objekt enthält die Unterlagen (bzw. deren Metadaten), die für die Erfüllung des Prüfauftrags benötigt werden. Auch die zu prüfenden bautechnischen Nachweise gehören zu diesen Unterlagen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266227_143667_26805'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282503_838175_33500' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282503_170659_33498' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1728480800804_893260_29447' name='bundesland' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_16_5_4_8a30247_1423044461203_939066_6394'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Codes::Code.Bundesland' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1728480867352_203631_29462' body='&lt;para&gt;In diesem Element ist das Bundesland der Bauvorhabens anzugeben&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1728480800804_893260_29447'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1728480854542_958204_29459' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1728480854542_993781_29460' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730797032156_700935_29545' name='beauftragendeBehoerde' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191873500_204582_1633'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::token' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730797111189_904840_29556' body='&lt;para&gt;In diesem Element ist die Bauaufsichtsbehörde anzugeben, die Absender der Nachricht ist, wenn diese nicht aus dem Nachrichtenkopf ersichtlich ist, z.B. weil sie über das Bauportal verschickt wurde.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730797032156_700935_29545'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730803301033_117905_29601'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730803301038_166049_29602' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730802595206_996522_29600' name='ansprechpartnerBauamt' visibility='private' type='_19_0_4_78d0259_1728629349789_247229_29479'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730803337816_237923_29605' body='&lt;para&gt;Dieser Typ deckt Namen und Erreichbarkeit des Ansprechpartners im Bauamt für Rückfragen ab.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730802595206_996522_29600'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730803312151_231720_29603' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730803312152_40628_29604' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1765372979912_603391_31428' name='prozessmerkmaleVerfahrensart' visibility='private' type='_19_0_4_b8702dd_1765372562768_166223_31413'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1765373094587_902620_31436' body='&lt;para&gt;In diesem Element ist die Verfahrensart des Bauvorhabens anzugeben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1765372979912_603391_31428'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1765373050504_566471_31434' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1765373050504_376182_31435' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248926_918979_24233' name='pruefingenieure.pruefauftragKorrektur.0503'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266228_353641_26807' body='&lt;para&gt;Diese Nachricht enthält geänderte oder ergänzte Daten zum Prüfauftrag. Sie bezieht sich auf einen bereits erteilten Prüfauftrag und auf eine zu diesem vorliegende Mängel- bzw. Befundliste.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248926_918979_24233'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
								<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_3_129a03b9_1669367503337_251100_21008' name='bautechnischeNachweise.pruefauftragKorrektur.0503' visibility='public' ownerOfDiagram='_19_0_3_136d03d4_1611871248926_918979_24233'>
