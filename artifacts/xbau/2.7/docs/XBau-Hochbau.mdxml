								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1697631203962_74248_24748' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697631208918_78374_24754' name='zuBeteiligendeStelle' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697631208921_422367_24756' body='&lt;para&gt;In den Fällen, in denen Beteiligungsplattformen verwendet werden, sollte an dieser Stelle, die Bezeichnung der zu beteiligenden Dienststelle angegeben werden.&lt;/para&gt;'>
