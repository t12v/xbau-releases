						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264152_677592_25298' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264375_201992_26490' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282389_767894_32803' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang der Bauaufsichtsbehörde zum Bauantrag Bezug zu nehmen. &lt;/para&gt;&#10;&lt;para&gt;Eine Referenz auf eine Nachricht ist hier i.d.R. nicht einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264375_201992_26490'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282389_808571_32804' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282389_110651_32802' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697630339318_82639_24738' name='referenzAufforderung' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697630339329_50589_24740' body='&lt;para&gt;Eine vom Aufforderungsservice mit dieser Nachricht vergebene eindeutige Kennung des Aufforderungsvorgangs. Sofern die aufgeforderte Stelle auf die Aufforderung reagiert, muss sie sich in ihren Reaktionsnachrichten auf diese Kennung beziehen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1697630339318_82639_24738'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1697630339329_189024_24741' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1697630339328_804748_24739' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697613890090_859409_24743' name='zuBeteiligendeStelle' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191873500_204582_1633'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::token' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697613967664_176698_24753' body='&lt;para&gt;Die Information in diesem Element wird in den Fällen benötigt, wo die Nachrichteninstanz an eine Plattform geht, in der eine Vielzahl von Stellen einen Account haben. Die Stelle, für die die Nachrichteninstanz gedacht ist, muss im vorliegenden Element technisch eindeutig bezeichnet werden (z.B. durch die ID eines Unternehmenskontos oder eine Mail-Adresse), so dass die Plattform die Nachricht entsprechend zuordnen und zustellen kann.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1697613890090_859409_24743'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1697613947700_136195_24751'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1697613947701_215502_24752' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264375_468025_26491' name='anliegenBeteiligung' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246523_190173_23499'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282389_628219_32807' body='&lt;para&gt;Hier wird der Grund bzw. das Anliegen der Beteiligung genannt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264375_468025_26491'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282389_876819_32808' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282389_692826_32806' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264376_751292_26492' name='bauvorhaben' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244694_158760_23371'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282390_58174_32811' body='&lt;para&gt;Hier werden die Daten des Bauantrags übermittelt, soweit für die adressierte Behörde von Relevanz für die Erstellung ihrer Stellungnahme.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264376_751292_26492'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282390_221609_32812' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282390_195590_32810' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264376_739559_26493' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282390_598937_32815' body='&lt;para&gt;Es sind ggf. Dokumente zum geplanten Bauvorhaben anzulegen (Alternativ Verweise auf solche Dokumente), soweit von der adressierten Behörde benötigt für die Stellungnahme zu den Fragen, die ihr vorgelegt worden sind. &lt;/para&gt;&#10;&lt;para&gt;Es muss sich nicht um dieselben Unterlagen handeln, die dem Bauantrag beilagen, sondern es können Bauvorlagen ggf. aufbereitet oder ergänzt worden sein, z.B. beim Raumbezug von Baugrundstücken, denen noch keine Adresse zugeordnet ist oder war.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264376_739559_26493'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282390_908685_32816'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282390_14737_32814' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264376_552951_26494' name='frist' visibility='private' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191726109_379108_1042'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::date' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282391_218101_32819' body='&lt;para&gt;Dies ist die durch die Bauaufsichtsbehörde gesetzte Frist, innerhalb derer die Stellungnahme durch die adressierte Stelle vorliegen muss, so dass sie berücksichtigt werden kann.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264376_552951_26494'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282391_471535_32820' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282391_822271_32818' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264376_560679_26495' name='rechtsfolgeFristversaeumnis' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282391_125782_32823' body='&lt;para&gt;Hier werden gemäß geltendem Recht Angaben zu den Konsequenzen bei Fristversäumnis eingetragen (Zustimmung durch Untätigkeit).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264376_560679_26495'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282391_517859_32824' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282391_535118_32822' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1785313133331_40819_34813' name='verfahrensart' visibility='private' type='_19_0_3_136d03d4_1611871239791_257404_22869'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1785313317959_827369_34833' body='&lt;para&gt;In diesem Element ist anzugeben, in welcher Art von Verfahren die Beteiligung erfolgt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1785313133331_40819_34813'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1785313143741_834201_34816' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1785313143741_972742_34817' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246624_522173_24058' name='beteiligung.aufforderungKorrektur.0302'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264377_831105_26497' body='&lt;para&gt;Die Bauaufsichtsbehörde hat Korrekturen und Ergänzungen der Unterlagen vom Bauherrn erhalten und versendet mittels dieser Nachricht die überarbeiteten Unterlagen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246624_522173_24058'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
