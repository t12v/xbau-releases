									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1666185768461_138573_20390' body='&lt;para&gt;In diesem Element wird erläutert, warum ein Baudenkmal von dem Bauvorhaben betroffen wird.&lt;/para&gt;'>
