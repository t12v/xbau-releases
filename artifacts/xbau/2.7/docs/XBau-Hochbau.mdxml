	<XOEV_Profil:xoevASBIE xmi:id='_19_0_3_c4f030d_1635864354720_219657_17893application1' base_Property='_19_0_3_c4f030d_1635864354716_757758_17886' Abweichung='Strukurelle Aufspaltung' MotivationDerAbweichung='Für den Hausnummernbereich werden getrennte Datenfelder benötigt, da auf Seiten der Bauaufsichtsbehörden die Möglichkeit bestehen soll, die einzelnen Werte zu verarbeiten, beispielsweise über eine Suchfunktion.'/>
	<XOEV_Profil:xsdNamedType xmi:id='_19_0_3_136d03d4_1611871264160_161563_25361' base_Classifier='_19_0_3_136d03d4_1611871243169_390594_23289'/>
