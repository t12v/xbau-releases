								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619788791979_966780_17282' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619787525767_507754_17266' name='datumGenehmigungErteilt' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191726109_379108_1042'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::date' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619789568021_971227_17287' body='&lt;para&gt;Hier ist das Datum der erteilten Genehmigung anzugeben.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619787525767_507754_17266'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619788796866_291983_17283'/>
