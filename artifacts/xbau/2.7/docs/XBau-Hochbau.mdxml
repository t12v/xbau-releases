						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266252_616438_26912' name='MppvoPruefergebnis'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282545_240514_33779' body='&lt;para&gt;Dieser Typ deckt zum Prüfgegenstand die wichtigsten Ergebnisse der durchgeführten Prüfung ab. &lt;/para&gt;'>
