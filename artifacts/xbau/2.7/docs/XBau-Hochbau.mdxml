							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1689591964329_657259_22266' body='&lt;para&gt;Hier sind ggf. geänderte oder ergänzte Daten zu den beantragten Abweichungen enthalten.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1689591963928_494835_22047'/>
							</ownedComment>
