						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1658324258057_779521_18212' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1658324258064_588424_18224' body='&lt;para&gt;Ggf. will die Bauaufsichtsbehörde der Rücknahme der Aufforderung ein Schreiben beilegen. Das lässt sich mit diesem Element abbilden.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1658324258057_779521_18212'/>
							</ownedComment>
