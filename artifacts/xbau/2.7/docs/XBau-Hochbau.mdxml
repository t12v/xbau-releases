	<XOEV_Profil:xsdElement xmi:id='_19_0_3_136d03d4_1618157111011_35900_16821' base_Property='_19_0_3_136d03d4_1618157092995_610286_16820' position='3'/>
	<XOEV_Profil:xsdXModel xmi:id='_19_0_3_136d03d4_1611871249464_963785_24348' base_Model='_19_0_3_136d03d4_1611871242634_400354_23195' schemaLocationBase='https://xleitstelle.de/xbau/schema/2/7/' deployment='true' namespace='http://www.xleitstelle.de/xbau/2/7' fassungVom='2026-08-05' prefix='xbau' automatischeImportErmittlung='false' automatischeIncludeErmittlung='false' ermittlungElementreihenfolge='Stereotyp' standardeinstellungEigenschaften='keine' xsdNamedTypeNameSuffix=''/>
	<KoSIT_Dokumentations_Profil:docGeneration xmi:id='_19_0_3_136d03d4_1611871249464_963785_24348application1' base_Package='_19_0_3_136d03d4_1611871242634_400354_23195'/>
	<XOEV_Profil:xoevVersionStandard xmi:id='_19_0_3_136d03d4_1611871249464_963785_24348application2' base_Model='_19_0_3_136d03d4_1611871242634_400354_23195' version='2.7' nameModellierungswerkzeug='MagicDraw' versionModellierungswerkzeug='19.0' versionXGenerator='3.2.4' versionXOEVHandbuch='3.0.1' beschreibung='Die Nachrichten zum Ergebnis der formellen Prüfung, die bisher spezifisch für jedes Bauantragsverfahren existierten, wurden durch eine generische Kernmodul-Nachricht ersetzt. Die Baulastenverfahren wurden durch Hinzunahme der Änderung einer Baulast weiter ausgebaut. Es wurden verschiedene Ergänzungen im Prozess der Beteiligung hinzugefügt, zum Beispiel mit Bezug auf Verlängerung oder Abbruch der Beteiligung, bessere Zuordnung des Anliegens und genauere Definition des Tenors bei Stellungnahmen. Alle Dienste, in denen die DVDV-Kategorie &quot;Bauaufsichtsbehörde&quot; Absender oder Empfänger ist, können nun auch von Bauportalen verwendet werden. Dies ermöglicht Bauaufsichtsbehörden ohne eigenes Fachverfahren die Nutzung der Dienste. Die Übermittlung mandatorischer Freitextelemente ohne Inhalt oder nur mit Leerzeichen etc. wird jetzt durch die Verwendung neuer eingeschränkter Datentypen unterbunden. Die weiteren Details zu Erweiterungen und Änderungen sind in der Versionshistorie des Spezifikationsdokuments beschrieben.'/>
	<XOEV_Profil:xoevStandard xmi:id='_19_0_3_136d03d4_1611871249464_963785_24348application3' base_Model='_19_0_3_136d03d4_1611871242634_400354_23195' kennung='urn:xoev-de:bmk:standard:xbau' nameTechnisch='xbau' nameKurz='XBau' nameLang='XBau - Standard für die Datenkommunikation der Bauaufsichtsbehörde' beschreibung='XBau ist der XÖV-Standard für den Datenaustausch der Bauaufsichtsbehörden mit ihren Kommunikationspartnern (Bauherren, Architektenbüros, Behörden zahlreicher Rechtsbereiche). '/>
	<KoSIT_Dokumentations_Profil:docGlobaleVariablen xmi:id='_19_0_3_136d03d4_1611871249464_963785_24348application4' base_Model='_19_0_3_136d03d4_1611871242634_400354_23195' artDesSchluesseltabellenabschnitts='appendix' generiereAnhangNachrichtentabellen='true' generiereDocBook5='true' generiereFlacheDatentypentabellen='false' generiereFlacheNachrichtentabellen='false' generiereNachrichtenDiensteUebersicht='true' generiereNutzungKomplexerTypen='true' generiereSVG='true' generiereWSDLMethoden='true' generiereWSDLTabelle='true' hoheVerschachtelungstiefeInKindelementtabellen='false' nutzeTabellenformat='true' rolleEmphasisDatentypEntitys='codebf' rolleEmphasisElementEntitys='codebf' rolleXRefDatentypEntitys='AS' rootElementExterneModelle='chapter' rootElementVerwendungBasismodul='section' titelDesCodeuebersichtabschnitts='Übersicht über die Code-Datentypen' verweisHistorieInVerwendungBasismodul='true' verwendungBasismodul='true' zeigeRechtsgrundlagenInNachrichten='false' zeigeRechtsgrundlagenInNachrichtenuebersicht='false' zeigeRestrictionFacetten='true'/>
