						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1726761837786_613741_27868' name='mitStellungnahme' visibility='private' isReadOnly='true'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837797_965710_27930' body='&lt;para&gt;Durch die Übermittlung dieses Elementes wird mitgeteilt, dass in der Antwortnachricht die Möglichkeit zur Stellungnahme verschaffen worden ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837786_613741_27868'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1726761837797_623570_27931'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1726761837796_671312_27929' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_19_0_3_129a03b9_1726761837797_296336_27932' value='true'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_129a03b9_1726761837681_135260_27793' name='prozessnachrichten.aktenraum.zugriffVerweigern.0152'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837787_152207_27871' body='&lt;para&gt;Mit dieser Nachricht initiiert die Bauaufsichtsbehörde den vorzeitigen Entzug von Zugriffsrechten auf den Aktenraum, z.B. bei Missbrauchsverdacht. Der Aktenraum soll damit vor dessen Gültigkeitsende unzugänglich gemacht werden.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837681_135260_27793'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_129a03b9_1726761837787_282681_27874' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1726761837787_188603_27872' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
