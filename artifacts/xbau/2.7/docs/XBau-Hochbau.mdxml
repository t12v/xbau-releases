							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1760015942932_984516_31988'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1760015942932_251605_31986' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
				</packagedElement>
				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871241081_571146_23110' name='UeberwachungspflichtigeAnlagen'>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1611871242635_630_23204'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241081_571146_23110'/>
						<supplier href='XOEV-Bibliothek.mdxml#_16_5_4_5b501fb_1387625271062_845493_4821'>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::Lateinische Zeichen in Unicode::1.1.1' referentType='Package'/>
							</xmi:Extension>
						</supplier>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1611871242636_754298_23208'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241081_571146_23110'/>
						<supplier xmi:idref='_19_0_3_136d03d4_1611871239053_307374_22661'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871249400_921233_24275' name='ueberwachungspflichtigeAnlagen.pruefbescheinigung.0800'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266250_840108_26899' body='&lt;para&gt;Diese Nachricht dient zur Übermittlung der Prüfbescheinigung an die Bauaufsichtsbehörde. Sie enthält alle relevanten Informationen zur Bewertung der Wirksamkeit und Betriebssicherheit der geprüften überwachungspflichtigen Anlagen.&lt;/para&gt;&#10;&lt;para&gt;Hinweis: Diese Nachricht wird demnächst noch überarbeitet.&lt;/para&gt;&#10;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871249400_921233_24275'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264150_925205_25276' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266250_54155_26900' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282539_381612_33741' body='&lt;para&gt;In diesem Element wird die Vorgangsnummer bzw. das Aktenzeichen zur erteilten Baugenehmigung übermittelt, die der Errichtung des Gebäudes und der technischen Anlage(n) zu Grunde lag.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266250_54155_26900'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282539_951766_33742' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282538_986168_33740' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266250_721116_26901' name='gebaeude' visibility='private' type='_19_0_3_136d03d4_1611871246531_270636_23533'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282539_973942_33745' body='&lt;para&gt;Hier wird der Ort der Prüfung bezeichnet, nämlich Anschrift und Flurstück zum Gebäude, in dem die geprüften technischen Anlagen installiert sind.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266250_721116_26901'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282539_981723_33746' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282539_408429_33744' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266250_24230_26902' name='pruefgegenstand' visibility='private' type='_19_0_3_136d03d4_1611871266252_790406_26910'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282540_420517_33749' body='&lt;para&gt;Jede Instanz dieses Elements beinhaltet Informationen zu einem Gegenstand der Prüfung (eine bestimmte technische Anlage in dem lokalisierten Gebäude) und zum Ergebnis der Prüfung dieses Gegenstands. Pro Element wird genau eine technische Anlage referenziert; die Prüfung kann mehrere technische Anlagen in dem Gebäude zum Gegenstand haben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266250_24230_26902'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282540_861113_33750' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282539_551109_33748' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266250_785545_26903' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282540_85335_33753' body='&lt;para&gt;Die Anlagen enthalten den Prüfbericht, der auch die Bewertung des Prüfergebnisses vornimmt und Konsequenzen empfiehlt. Der Inhalt des Prüfberichts ist in den Musterprüfgrundsätzen definiert (Anlage zur Musterprüfverordnung Ziffer 4). Der Betreiber der technischen Anlagen hat den Prüfbericht typischerweise als Papierdokument vom Prüfsachverständigen erhalten.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266250_785545_26903'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282540_171073_33754' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282540_387267_33752' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871249400_10020_24276' name='ueberwachungspflichtigeAnlagen.erinnerung.0801'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266251_683653_26905' body='&lt;para&gt;Diese Nachricht dient der Information des Betreibers, dass eine Prüfbescheinigung überfällig ist.&lt;/para&gt;&#10;&lt;para&gt;Hinweis: Diese Nachricht wird demnächst noch überarbeitet.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871249400_10020_24276'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264154_495391_25322' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266251_877350_26906' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282541_916573_33758' body='&lt;para&gt;In diesem Element wird die Vorgangsnummer bzw. das Aktenzeichen zur erteilten Baugenehmigung übermittelt, die der Errichtung des Gebäudes und der technischen Anlage(n) zu Grunde lag.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266251_877350_26906'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282541_646860_33759' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282541_893705_33757' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266251_965310_26907' name='pruefgegenstand' visibility='private' type='_19_0_3_136d03d4_1611871266252_790406_26910'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282542_433891_33762' body='&lt;para&gt;Dieses Element bezeichnet den Gegenstand der Prüfung, eine bestimmte technische Anlage in dem lokalisierten Gebäude. Pro Element wird genau eine technische Anlage referenziert. Die Prüfung kann mehrere technische Anlagen in dem Gebäude zum Gegenstand haben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266251_965310_26907'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282542_346315_33763' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282542_448274_33761' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266251_7666_26908' name='anlassDerPruefung' visibility='private' type='_19_0_3_136d03d4_1611871266252_574229_26911'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282542_422448_33766' body='&lt;para&gt;In diesem Element wird der Anlass der durchgeführten Prüfung genannt, über deren Ergebnis berichtet wird.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266251_7666_26908'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282542_623061_33767' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282542_518835_33765' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871249400_247127_24277' name='Datentypen'>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266252_790406_26910' name='Anonym_Pruefgegenstand'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282543_156711_33770' body='&lt;para&gt;Dieser Typ deckt Informationen ab zum Gegenstand (eine bestimmte technische Anlage in dem lokalisierten Gebäude) und zum Ergebnis der Prüfung dieses Gegenstands.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266252_790406_26910'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282543_184936_33771' name='identifikation' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283347_647605_37018' body='&lt;para&gt;Hier ist die Identifikation des Prüfgegenstands, z.B. die Seriennummer, einzutragen. &lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282543_184936_33771'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283347_711308_37019' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283347_871418_37017' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282543_416826_33772' name='bezeichnung' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283347_544957_37022' body='&lt;para&gt;Hier steht eine deskriptive Bezeichnung des Prüfgegenstands (z.B. &lt;quote&gt;Lüftungsanlage im Gebäudetrakt Süd&lt;/quote&gt;).&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282543_416826_33772'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283347_953064_37023' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283347_871583_37021' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282544_974326_33773' name='artDerTechnischenAnlage' visibility='private' type='_19_0_3_136d03d4_1611871239762_921834_22751'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283348_664106_37026' body='&lt;para&gt;Dieses Element enthält Angaben zur Art der geprüften technischen Anlage.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282544_974326_33773'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283348_598087_37027' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283348_213600_37025' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282544_708261_33774' name='anlassDerPruefung' visibility='private' type='_19_0_3_136d03d4_1611871266252_574229_26911'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283348_868740_37030' body='&lt;para&gt;In diesem Element wird zum gegebenen Prüfgegenstand der Anlass der durchgeführten Prüfung genannt.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282544_708261_33774'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283348_696376_37031' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283348_878290_37029' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282544_199386_33775' name='pruefergebnis' visibility='private' type='_19_0_3_136d03d4_1611871266252_616438_26912'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283349_636338_37034' body='&lt;para&gt;In dieses Element sind zum Prüfgegenstand die wichtigsten Ergebnisse der durchgeführten Prüfung einzutragen. Weitere Details zum Prüfergebnis sind dem Prüfbericht zu entnehmen, der in der Anlage zur vorliegenden Nachricht enthalten ist.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282544_199386_33775'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283349_22034_37035' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283349_524151_37033' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266252_574229_26911' name='Anonym_Anlass'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282545_101161_33776'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266252_574229_26911'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282545_237743_33777' name='anlass' visibility='private' type='_19_0_3_136d03d4_1611871239749_609655_22721'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283349_814840_37038' body='&lt;para&gt;Dieses Element nennt den Anlass der durchgeführten Prüfung. Es deckt eine Reihe von Standardfällen ab.&lt;/para&gt;'>
