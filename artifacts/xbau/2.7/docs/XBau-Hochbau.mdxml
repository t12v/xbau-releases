						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1784012712568_564799_34825' name='id' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1664881730540_81040_6897'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Basisnachricht::qualified::G2G::1.1::UUID' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1784012712572_342739_34833' body='&lt;para&gt;Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Baulast. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Baulast eindeutig zu identifizieren.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1784012712568_564799_34825'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1784012712572_680133_34834' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1784012712572_329012_34832' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1784012712568_771023_34826' name='beteiligtePersonen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246525_412685_23504'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1784012712572_877542_34837' body='&lt;para&gt;Die am Baulastverfahren beteiligten Personen sind unterhalb dieses Elements einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1784012712568_771023_34826'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1784012712572_978987_34838' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1784012712572_971098_34836' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1784012712570_365921_34827' name='beteiligteGrundstuecke' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246525_327813_23505'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1784012712573_88424_34841' body='&lt;para&gt;Hier werden die für das Baulastverfahren relevanten Grundstücke oder Flurstücke eingetragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1784012712570_365921_34827'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1784012712573_99044_34842' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1784012712573_682261_34840' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1784012712570_442313_34829' name='artDerBaulast' visibility='private' type='_19_0_4_b6602da_1749202368327_408887_29479'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1784012712573_259111_34849' body='&lt;para&gt;In diesem Element wird die Art der Baulast angegeben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1784012712570_442313_34829'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1784012712573_736471_34850' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1784012712573_602146_34848' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
				</packagedElement>
				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871239747_251022_22711' name='Hilfsmittel'>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246529_313323_23523' name='BezugHauptbaugenehmigung'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264239_111742_25707' body='&lt;para&gt;Dieser Typ nimmt Eintragungen im Rahmen der Beantragung eines Nachtrags zu einer bereits erteilten Baugenehmigung auf. Diese Eintragungen dienen dazu, auf die bereits erteilte Baugenehmigung Bezug zu nehmen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246529_313323_23523'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264239_266298_25708' name='vorgang' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282181_168838_30906' body='&lt;para&gt;In dieses Element ist das Zeichen (Aktenzeichen) der Hauptbaugenehmigung einzutragen, also des Vorgangs, im Rahmen dessen die Bauaufsichtsbehörde die Baugenehmigung erteilt hat, zu der mit der vorliegenden Nachrichteninstanz ein Nachtrag beantragt wird. &lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264239_266298_25708'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282181_853172_30907' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282181_91157_30905' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246530_701052_23524' name='BezugVorbescheid'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264240_538566_25710' body='&lt;para&gt;Dieser Typ nimmt im Rahmen der Beantragung einer Baugenehmigung den Bezug auf einen in der Vergangenheit erteilten Vorbescheid auf.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246530_701052_23524'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264240_475735_25711' name='vorgang' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282182_254115_30910' body='&lt;para&gt;In dieses Element ist das Zeichen (Aktenzeichen) des erteilten Vorbescheids einzutragen. &lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264240_475735_25711'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282182_673800_30911' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282182_534417_30909' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1649838383583_954587_17975' name='referenz' visibility='private' isDerivedUnion='true'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1664881730540_81040_6897'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Basisnachricht::qualified::G2G::1.1::UUID' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1650606960824_398646_17978' body='&lt;para&gt;In dieses Element ist die Referenz des erteilten Vorbescheids einzutragen. Dies ist der Identifier des Antragsservice (der mit dem Antrag bzw. der Anzeige bei der Bauaufsichtsbehörde (bzw. Aufsichtsbehörde für den Breitbandausbau) eingegangen ist) oder der Abfrage (auf die die vorliegende Nachricht eine Antwort ist).&lt;/para&gt;&#10;&lt;para&gt;Falls die vorliegende Nachricht an ein Online-Portal gerichtet ist, kann so der Projektraum bzw. Postkorb angesteuert werden.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1649838383583_954587_17975'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1649838447796_590691_17977'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1649838447796_487446_17978' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1649861960963_127678_17994' name='datum' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191726109_379108_1042'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::date' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1650447907249_282789_17974' body='&lt;para&gt;In dieses Element ist das Datum des erteilten Vorbescheids einzutragen. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1649861960963_127678_17994'/>
							</ownedComment>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1617059736838_505195_16785' name='Bezug'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1617059736840_882805_16786' body='&lt;para&gt;Dieser Typ gestattet Eintragungen, um auf einen Antrag, einen Vorgang und ggf. auf eine Nachricht, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1617059736838_505195_16785'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1617059736840_806061_16787' name='referenz' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1664881730540_81040_6897'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Basisnachricht::qualified::G2G::1.1::UUID' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1617059736844_335350_16792' body='&lt;para&gt;Hier ist der Identifier des Antragsservice (der mit dem Antrag bzw. der Anzeige bei der Bauaufsichtsbehörde eingegangen ist) oder der Abfrage (auf die die vorliegende Nachricht eine Antwort ist) anzugeben.&lt;/para&gt;&#10;&lt;para&gt;Falls die vorliegende Nachricht an ein Online-Portal gerichtet ist, kann so der Projektraum bzw. Postkorb angesteuert werden.&lt;/para&gt;&#10;&lt;para&gt;Falls die vorliegende Nachricht an die Statistik gerichtet ist, muss das Kindelement &quot;referenz&quot; befüllt sein.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1617059736840_806061_16787'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1617059736845_399647_16793'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1617059736844_572741_16791' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1617059736841_992498_16788' name='vorgang' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1617059736846_796401_16796' body='&lt;para&gt;Eine Instanz dieses Elements enthält, falls ein solches vergeben wurde, das Zeichen (Aktenzeichen) des von der Bauaufsichtsbehörde geführten Vorgangs, innerhalb dessen diese Nachricht übermittelt wird. &lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1617059736841_992498_16788'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1617059736846_417669_16797'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1617059736846_472968_16795' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1617059736842_167562_16789' name='bezugNachricht' visibility='private' type='_19_0_3_136d03d4_1611871243169_203077_23290'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1617059736848_926415_16800' body='&lt;para&gt;Falls ein solcher Zusammenhang vorliegt, sind hier die Kennungen der Nachricht einzutragen, auf die sich diese Nachricht bezieht.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1617059736842_167562_16789'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1617059736848_617148_16801'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1617059736847_812598_16799' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1655648615965_361906_18170' name='BezugBauberatung'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1655648964814_671663_18179' body='&lt;para&gt;Dieser Typ dient der Bezugnahme auf eine in der Vergangenheit stattgefundene Bauberatung.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1655648615965_361906_18170'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1655648683318_362447_18172' name='vorgang' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
