						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662298632736_832520_18237' name='baulast' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246524_125172_23503'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662298632764_29641_18239' body='&lt;para&gt;Übermittlungsanlass Baulast: Zu einer vorliegenden Baulast können hier relevante Daten übermittelt werden (Zweck der Baulast, der geregelte Sachverhalt usw.). Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662298632736_832520_18237'/>
							</ownedComment>
