								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823597_616420_26149' body='&lt;para&gt;In dieses Element ist die Lage des Baugrundstücks gemäß Gemeindegliederung (bis hinunter zum Gemeindeteil) einzutragen.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1714115823503_8057_25735'/>
								</ownedComment>
