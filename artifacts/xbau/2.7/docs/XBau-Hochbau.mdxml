				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871241079_65679_23103' name='Vorbescheid'>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1611871242635_501917_23201'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241079_65679_23103'/>
						<supplier xmi:idref='_19_0_3_136d03d4_1611871239053_307374_22661'/>
