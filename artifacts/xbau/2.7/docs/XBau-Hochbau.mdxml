							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282568_299598_33925' body='&lt;para&gt;Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266685_372421_26994'/>
