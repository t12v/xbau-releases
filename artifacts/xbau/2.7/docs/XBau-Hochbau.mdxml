					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244695_592401_23378' name='BefundlisteFormell'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264184_383172_25448' body='&lt;para&gt;Dieser Typ beinhaltet die Befunde der formellen Prüfung eines Antrags oder einer Anfrage. Für jeden Befund sind die entsprechenden Parameter gefüllt, die Inhalt und Bezug des Befundes für den Antragsteller bzw. Anfragenden nachvollziehbar machen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244695_592401_23378'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264184_938031_25449' name='befund' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244695_85010_23376' association='_19_0_3_136d03d4_1611871244696_538211_23379'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282107_450480_30246' body='&lt;para&gt;Dieses Element stellt genau einen Befund der Befundliste dar.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264184_938031_25449'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
