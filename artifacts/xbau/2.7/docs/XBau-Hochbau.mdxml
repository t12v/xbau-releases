							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1666185126538_688763_20333' name='begruendung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
