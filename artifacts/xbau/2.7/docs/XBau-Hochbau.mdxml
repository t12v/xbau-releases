							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696422846400_586973_24571' body='&lt;para&gt;Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass die Anforderungen an Außenbauteile der neu hinzugekommenen Räume gemäß § 51 Abs. 1 GEG eingehalten werden. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1696422846391_46191_24537'/>
