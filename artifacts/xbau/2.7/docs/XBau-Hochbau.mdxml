							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623921851309_505987_17504' name='baugenehmigungBeantragt' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
