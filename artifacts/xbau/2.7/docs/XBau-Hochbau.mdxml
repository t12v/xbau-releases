									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::ReferenzAntragsservice' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1702888682750_117291_24793' body='&lt;para&gt;Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1702888682739_475917_24791'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1702888682751_509988_24794' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1702888682749_995076_24792' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623873164578_996819_17221' name='antragsteller' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_16_5_4_8a30247_1408703057450_27821_3423'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::Beteiligte::Akteur' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623873164584_201319_17230' body='&lt;para&gt;In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623873164578_996819_17221'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623873164584_166224_17231'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623873164584_660323_17229' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623873724409_510767_17267' name='aenderungsantrag' visibility='private' type='_19_0_131403da_1623874368209_599583_17275'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623873724411_407047_17269' body='&lt;para&gt;Falls der vorliegende Antrag ein Änderungsantrag ist, wird mit diesem Element das Aktenzeichen des ursprünglichen Antrags übermittelt, auf das sich der Änderungsantrag bezieht.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623873724409_510767_17267'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623873724412_863991_17270'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623873724411_211805_17268' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623875618925_464612_17280' name='grundstueck' visibility='private' type='_19_0_3_136d03d4_1611871246531_270636_23533'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623875618927_73890_17282' body='&lt;para&gt;Mit diesem Element werden die Daten zu dem Grundstück übermittelt, auf das sich der Antrag der Abgeschlossenheitsbescheinigung bezieht. Falls mehrere Grundstücke betroffen sind, ist das Element mehrfach zu instantiieren.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623875618925_464612_17280'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623875618927_205900_17283' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623875618926_365693_17281' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623918772564_164999_17361' name='abgeschlossenheitsbescheinigung' visibility='private' type='_19_0_131403da_1623918845237_309998_17362'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623955275822_355506_17164' body='&lt;para&gt;Mit diesem Element werden die Informationen zu den Räumlichkeiten und der Art der beantragten Abgeschlossenheitsbescheinigung übermittelt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623918772564_164999_17361'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623923275236_607995_17541' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623923275237_983545_17542' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623923283969_700848_17543' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623928043588_787594_17799' body='&lt;para&gt;Mit diesem Element werden Anlagen zum Antrag übermittelt wie bspw. Auszüge aus dem Liegenschaftskataster, Aufteilungspläne und weitere relevante sonstige Anlagen. Dazu kann optional auch ein Grundbuchauszug gehören.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623923283969_700848_17543'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623923283970_515810_17545' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623923283969_489000_17544' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1785144109550_721947_34806' name='beteiligte' visibility='private' type='_19_0_3_136d03d4_1611871244693_522565_23367'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1785144109569_355542_34808' body='&lt;para&gt;Mit diesem Element werden Daten zu Beteiligten am Verfahren übermittelt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1785144109550_721947_34806'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1785144109569_982581_34809' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1785144109569_7668_34807' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Package' xmi:id='_19_0_131403da_1623873784766_244256_17274' name='Datentypen'>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_131403da_1623874368209_599583_17275' name='BezugNeuantrag'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623955041810_74990_17163' body='&lt;para&gt; Dieser Typ beinhaltet das Aktenzeichen des ursprünglichen Antrags, auf das sich der Änderungsantrag bezieht.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623874368209_599583_17275'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623874396717_606645_17276' name='vorgang' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623927594619_618959_17798' body='&lt;para&gt;Sofern zu dem Gebäude ein Aktenzeichen einer beantragten oder genehmigten Baugenehmigung vorliegt, ist dieses mit diesem Element zu übermitteln.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_131403da_1623874396717_606645_17276'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623874416953_536459_17277' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623874416954_565902_17278' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_131403da_1623918845237_309998_17362' name='AbgeschlossenheitsbescheinigungDaten'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623954588741_928569_17162' body='&lt;para&gt; Dieser Typ beinhaltet die Angaben zu einem Gebäude, die im Rahmen einer Abgeschlossenheitsbscheinigung relevant sind, sowie Angaben zu den einzelnen Räumlichkeiten, für die die Abgeschlossenheitsbscheinigung beantragt wird.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1623918845237_309998_17362'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623919422974_372881_17363' name='angabenEinheiten' visibility='private' type='_19_0_131403da_1626161494937_770509_17690'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1626088975186_812029_17466' body='&lt;para&gt;Mit diesem Element werden Informationen zu den Wohnungen bzw. Räumen übermittelt, für die eine Abgeschlossenheitsbescheinigung beantragt wird.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_131403da_1623919422974_372881_17363'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623921599702_583021_17464' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623921599702_966068_17465' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623921677900_850501_17466' name='angabenZumGebaeude' visibility='private' type='_19_0_131403da_1623921737148_386683_17486'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1626089045345_373016_17467' body='&lt;para&gt; Mit diesem Element werden die Angaben zum Gebäude übermittelt, die für die Bearbeitung der Abgeschlossenheitsbescheinigung relevant sind. &lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_131403da_1623921677900_850501_17466'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623921677901_188589_17468' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_131403da_1623921677900_797239_17467' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_131403da_1623922681465_379995_17527' name='wohneigentum' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
