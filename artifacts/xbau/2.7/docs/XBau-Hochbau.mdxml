							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1723793408824_607116_26480' name='artDesWohngebaeudes' visibility='private' type='_19_0_3_136d03d4_1611871239792_886892_22872'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1723793408836_142848_26503' body='&lt;para&gt;Hier wird für bauliche Anlagen, die Wohngebäude sind, eine Klassifizierung vorgenommen gemäß Einteilung der amtlichen Statistik. Die Hauptnutzung muss klar erkennbar sein.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1723793408824_607116_26480'/>
								</ownedComment>
