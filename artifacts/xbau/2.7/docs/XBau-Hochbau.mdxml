								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1725527109353_278661_27255' body='&lt;para&gt; In diesem Element wird die Anzahl der Gebäude im Bauvorhaben angegeben.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt des Elements ergibt sich aus dem Datentyp AnzahlDerGebaeude der Eingangsnachricht.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1725527109343_626962_27253'/>
								</ownedComment>
