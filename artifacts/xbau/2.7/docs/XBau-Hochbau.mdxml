					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871247069_184387_24106' name='anzeige.beseitigungAbsicht.0950'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871265758_163911_26708' body='&lt;para&gt;Mit dieser Nachricht teilt der Bauherr der Bauaufsichtsbehörde mit, dass die Beseitigung einer baulichen Anlage geplant ist.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871247069_184387_24106'/>
						</ownedComment>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1761124542610_304698_31675' name='sch-anz-001'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1761124881795_821058_31677' body='Zur Weiterleitung an die Statistik ist ein Anzeigender anzugeben. Die Nachricht enthält kein Element &quot;anzeigender&quot;.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1761124542610_304698_31675'/>
							</ownedComment>
