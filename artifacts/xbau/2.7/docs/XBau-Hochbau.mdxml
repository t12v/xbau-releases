								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619789230342_294394_17286' body='&lt;para&gt;Hier ist das Datum der Baubeginnsanzeige anzugeben.&lt;/para&gt;'>
