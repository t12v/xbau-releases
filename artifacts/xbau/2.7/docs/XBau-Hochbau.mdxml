								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264178_33588_25419' name='pruefungBautechnischeNachweise' visibility='private' type='_19_0_3_136d03d4_1611871244702_569184_23406'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282098_778589_30174' body='&lt;para&gt;Mit diesem Element wird die Angabe in Bezug auf die Prüfung der bautechnischen Nachweise (u.a. Brandschutznachweis) übermittelt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264178_33588_25419'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282098_908045_30175'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282098_287173_30173' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264179_592581_25420' name='herstellungskosten' visibility='private' type='_19_0_3_136d03d4_1611871244702_23191_23405'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282098_76304_30178' body='&lt;para&gt;Hier sind die Herstellungskosten für die entsprechenden Kostengruppen der DIN 276 einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264179_592581_25420'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282098_909176_30179'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282098_346004_30177' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244693_625845_23369' name='Anonym_Verortung'>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264179_708985_25421' name='baugrundstueck' visibility='private' type='_19_0_3_136d03d4_1611871246531_572179_23532'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282099_154768_30182' body='&lt;para&gt;In diesem Element sind Daten enthalten, die das Baugrundstück (ein Grundstück, auf dem das Vorhaben stattfinden soll bzw. auf dem es durchgeführt wurde) identifizieren. Ein Baugrundstück kann mehrere Grundstücke umfassen.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264179_708985_25421'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282099_543708_30183' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282099_366057_30181' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264179_594853_25422' name='lageBauvorhaben' visibility='private' aggregation='composite' association='_19_0_3_136d03d4_1611871244693_258041_23370'>
							<type href='XBau-kernmodul.mdxml#_16_5_4_940029b_1460651165974_293124_3777'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::Verortung::GeoreferenzierteFlaeche' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282099_623803_30186' body='&lt;para&gt;In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Bauvorhabens bzw. Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para&gt;&#10;&#10;&lt;para&gt;Falls beispielsweise ein Umbau geplant ist und auf dem Grundstück mehrere Gebäude bestehen, muss aus diesen Angaben hervorgehen, was der Gegenstand des Anbaus ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264179_594853_25422'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282099_987811_30187'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282099_814149_30185' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611871244693_258041_23370'>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264179_594853_25422'/>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264179_506685_25423'/>
						<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264179_506685_25423' visibility='private' type='_19_0_3_136d03d4_1611871244693_625845_23369' association='_19_0_3_136d03d4_1611871244693_258041_23370'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244694_158760_23371' name='Bauvorhaben'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264180_547919_25424' body='&lt;para&gt;Typ für die Daten eines Bauvorhabens, enthält Informationen zum Wer, Was und Wo des Bauvorhabens bzw. Vorhabens. Der Begriff &#39;Bauvorhaben&#39; wird hier sehr weit gefasst, so dass auch Nutzungsänderungen ohne Baumaßnahmen abgedeckt sind. Der Typ wird in allen Nachrichten eingesetzt, in denen Eigenschaften eines Bauvorhabens (bzw. Vorhabens) anzugeben sind bzw. geprüft werden sollen. Er wird auch da eingesetzt, wo über ein Bauvorhaben (Vorhaben) oder über Maßnahmen im Zusammenhang eines Bauvorhabens (Vorhabens) zu informieren ist.&lt;/para&gt;&#10;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244694_158760_23371'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264180_704571_25425' name='bezeichnungDesBauvorhabens' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282100_908749_30190' body='&lt;para&gt;In dieses Element ist die Bezeichnung des Vorhabens einzutragen. Sie wird vom Bauherrn vergeben und später ggf. von der Bauaufsichtsbehörde geändert.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264180_704571_25425'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282100_929024_30191' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282100_57105_30189' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264180_625300_25426' name='beteiligte' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244693_522565_23367' association='_19_0_3_136d03d4_1611871244694_678209_23372'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282100_651809_30194' body='&lt;para&gt;Dieses Objekt steht für die am Bauvorhaben (Vorhaben) beteiligten Parteien (Personen und Organisationen), soweit sie der Bauaufsichtsbehörde bekannt sein müssen.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264180_625300_25426'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282100_324950_30195' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282100_82107_30193' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264180_162261_25427' name='gegenstand' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244693_186561_23368' association='_19_0_3_136d03d4_1611871244694_715675_23374'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282101_767174_30198' body='&lt;para&gt;Dieser Abschnitt beschreibt, was der Gegenstand des Antrags ist.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264180_162261_25427'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282101_503407_30199' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282101_130971_30197' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264180_480489_25428' name='verortung' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244693_625845_23369' association='_19_0_3_136d03d4_1611871244694_90971_23373'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282101_615789_30202' body='&lt;para&gt;Dieser Abschnitt beschäftigt sich mit der Lokalisierung des Vorhabens in relevanten Bezugssystemen.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264180_480489_25428'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282101_96482_30203' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282101_877071_30201' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1643217429667_115612_18015' name='weitereAngaben' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1643217538110_848957_18021' body='&lt;para&gt;Mit diesem Element können ausschließlich ergänzende textliche Erläuterungen zum Bauvorhaben übermittelt werden, die sich nicht mit den vorhandenen XBau-Attributen ausdrücken lassen.&lt;/para&gt; '>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1643217429667_115612_18015'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1643217466673_435088_18019'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1643217466673_541020_18020' value='*'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611871244694_678209_23372'>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264180_625300_25426'/>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264181_381156_25430'/>
						<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264181_381156_25430' visibility='private' type='_19_0_3_136d03d4_1611871244694_158760_23371' association='_19_0_3_136d03d4_1611871244694_678209_23372'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611871244694_90971_23373'>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264180_480489_25428'/>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264181_745485_25431'/>
						<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264181_745485_25431' visibility='private' type='_19_0_3_136d03d4_1611871244694_158760_23371' association='_19_0_3_136d03d4_1611871244694_90971_23373'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611871244694_715675_23374'>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264180_162261_25427'/>
						<memberEnd xmi:idref='_19_0_3_136d03d4_1611871264181_361899_25432'/>
						<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264181_361899_25432' visibility='private' type='_19_0_3_136d03d4_1611871244694_158760_23371' association='_19_0_3_136d03d4_1611871244694_715675_23374'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244695_85010_23376' name='Anonym_BefundFormell'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264182_903459_25439'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244695_85010_23376'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264182_259422_25440' name='artDesBefundes' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1552127588117_500969_14828'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Codes::Code.FormelleBefundeArt' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282103_723201_30222' body='&lt;para&gt;In diesem Element wird die Befundkategorie angegeben, der dieser Befund zugeordnet werden kann.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264182_259422_25440'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282104_448454_30223' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282103_743089_30221' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264182_932243_25441' name='refAnlage' visibility='private' type='_19_0_3_136d03d4_1611871244695_882280_23377'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282104_265973_30226' body='&lt;para&gt;Für Befunde, die sich auf eine eingereichte Bauvorlage bzw. eine sonstige Anlage zum Antrag beziehen, wird in diesem Objekt der Bezug hergestellt.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264182_932243_25441'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282104_188029_30227'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282104_589268_30225' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264183_373949_25442' name='betroffeneAnlage' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1615201655963_472277_16611'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282104_413412_30230' body='&lt;para&gt;Für Befunde, die Mängel an einer eingereichten Bauvorlage oder das Fehlen einer Bauvorlage (einer bestimmten Art) betreffen, wird in diesem Element die Art dieser Bauvorlage angegeben (die den Mangel hat bzw. die nachzureichen ist).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264183_373949_25442'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282104_287856_30231'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282104_664991_30229' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264183_218289_25443' name='beschreibung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282105_690200_30234' body='&lt;para&gt;Hier wird der Sachverhalt des Befundes beschrieben. Dieser Sachverhalt ist eine detailliertere Darstellung im Rahmen der parallel angegebenen Art des Befundes.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264183_218289_25443'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282105_170233_30235' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282105_823227_30233' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244695_882280_23377' name='RefAnlage'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264183_361676_25444' body='&lt;para&gt;Typ für die Bezugnahme auf Bestandteile eines Antrags oder eines Auftrags. Dieser Typ wird im Kontext einer formellen Prüfung eingesetzt.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244695_882280_23377'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264183_894007_25445' name='bezeichnung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210780_355528_9523'>
