							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1747990674740_372549_30085' body='&lt;para&gt;Hier kann der Bauherr sich zur Befundliste äußern. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1747990674730_731156_30076'/>
