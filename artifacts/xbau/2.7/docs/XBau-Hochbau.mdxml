				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871239751_95334_22725' name='Code.BautechnischerNachweisArt'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871246576_219097_23664' body='&lt;para&gt;Art eines bautechnischen Nachweises, der zu den Planungsunterlagen eines Bauvorhabens nach § 66 MBO gehören kann.&lt;/para&gt;'>
