						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619792177041_697869_17288' name='Anonym_verortungAnzeige'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619792177042_175215_17289' name='baugrundstueck' visibility='private' type='_19_0_3_136d03d4_1611871246531_572179_23532'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619792177045_261533_17292' body='&lt;para&gt;In diesem Element sind Daten enthalten, die das Baugrundstück (ein Grundstück, auf dem das Vorhaben stattfinden soll bzw. auf dem es durchgeführt wurde) identifizieren. Ein Baugrundstück kann mehrere Grundstücke umfassen.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619792177042_175215_17289'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619792177045_472756_17293' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619792177044_360377_17291' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619792177044_421579_17290' name='lageBauvorhaben' visibility='private' aggregation='composite'>
								<type href='XBau-kernmodul.mdxml#_16_5_4_940029b_1460651165974_293124_3777'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::Verortung::GeoreferenzierteFlaeche' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619792177047_186892_17296' body='&lt;para&gt;In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Bauvorhabens bzw. Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para&gt;&#10;&#10;&lt;para&gt;Falls beispielsweise ein Umbau geplant wurde und auf dem Grundstück mehrere Gebäude bestehen, muss aus diesen Angaben hervorgehen, was der Gegenstand des Anbaus ist.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619792177044_421579_17290'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619792177047_431376_17297'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619792177046_301561_17295' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619793821501_211226_17307' name='Anonym_NachweiseBaubeginn'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619259527166_672026_16920' name='pruefungStandsicherheitsnachweisErforderlich' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619260748353_877695_16927' body='&lt;para&gt;Wenn die Erklärung des Tragwerksplaner ergibt, dass eine Prüfung des Standsicherheitsnachweises erforderlich ist, dann ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para&gt; '>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619259527166_672026_16920'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619259630092_146504_16924' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619259630093_185353_16925' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619793975053_346550_17310' name='Anonym_NachweiseNutzungsaufnahme'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619262519639_854555_16935' name='bezeichnungVorhaben' visibility='private'>
								<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619263419653_404355_16955' body='&lt;para&gt;Hier ist die Bezeichnung des Vorhabens anzugeben.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619262519639_854555_16935'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619796408969_762091_17326'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619796408971_290991_17327' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619262532438_625061_16936' name='standsicherheitBescheinigt' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619263653086_471936_16956' body='&lt;para&gt;Wenn die ordnungsgemäße Ausführung von Standsicherheit bescheinigt wurde, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln und der entsprechende Nachweis mit dem Element &lt;emphasis role=&quot;codebf&quot;&gt;anlagen&lt;/emphasis&gt; beizufügen. Der Wert &quot;false&quot; ist zu übermitteln, wenn kein Nachweis für die Standsicherheit erforderlich ist.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619262532438_625061_16936'/>
								</ownedComment>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619262551446_478589_16937' name='brandschutzBescheinigt' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619263840118_910799_16957' body='&lt;para&gt;Wenn die ordnungsgemäße Ausführung von Brandschutz bescheinigt wurde, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln und der entsprechende Nachweis mit dem Element &lt;emphasis role=&quot;codebf&quot;&gt;anlagen&lt;/emphasis&gt; beizufügen. Der Wert &quot;false&quot; ist zu übermitteln, wenn kein Nachweis für den Brandschutz erforderlich ist.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619262551446_478589_16937'/>
								</ownedComment>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619262561430_735855_16938' name='gebaeudeDerKlasse4' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619264059672_749623_16958' body='&lt;para&gt;Handelt es sich um ein Gebäude der Klasse 4, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619262561430_735855_16938'/>
								</ownedComment>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619262571590_895789_16939' name='wiederkehrendePruefungenErforderlich' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619264134431_653191_16959' body='&lt;para&gt;Sind wiederkehrende Prüfungen erforderlich, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln; andernfalls &quot;false&quot;.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619262571590_895789_16939'/>
								</ownedComment>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1620371731159_104197_17159' name='Anonym_NachweiseBeseitigung'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619466990228_734236_17234' name='standsicherheitsnachweisDurchTragwerksplaner' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
