							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696422846397_398184_24559' body='&lt;para&gt;Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass die Vorgaben des GEG nach § 50 Abs. 1 GEG eingehalten werden. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1696422846390_261941_24534'/>
