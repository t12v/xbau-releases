						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871239758_514838_22738'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871239758_851448_22739' name='Code.Genehmigungsfreistellung'>
