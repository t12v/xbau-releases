							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282129_718712_30446' body='&lt;para&gt;Falls die Stellungnahme positiv ausgefallen ist (Zustimmung), so wird in diesem Element &quot;true&quot; übermittelt, andernfalls &quot;false&quot;.&lt;/para&gt;&#10;&lt;para&gt;Falls die Zustimmung nur unter der Voraussetzung erteilt wird, dass die angegebenen Nebenbestimmungen eingehalten werden, wird der Tenor als &quot;positiv mit Einschränkungen&quot; betrachtet und ebenfalls &quot;true&quot; übermittelt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264199_400891_25530'/>
							</ownedComment>
