						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264184_839362_25453' name='rechtsbereich' visibility='private' aggregation='composite'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_78d0259_1728567535312_938846_10185'>
