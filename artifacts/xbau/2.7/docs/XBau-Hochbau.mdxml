									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823512_185142_25754' name='flaechen' visibility='private' type='_19_0_4_b6602da_1721393612370_612095_25849'>
