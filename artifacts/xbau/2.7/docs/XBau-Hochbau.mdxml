					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871247062_568343_24083' name='vorbescheid.antrag.0210'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264382_387902_26515' body='&lt;para&gt;Durch das Senden dieser Nachricht an die Bauaufsichtsbehörde beantragt der Absender einen Vorbescheid zu den in der Nachricht dokumentierten Fragen zum Bauvorhaben.&lt;/para&gt;&#10;&lt;para&gt;Die Nachricht enthält die Daten des Vorbescheidantrags, die auf diese Fragen fokussieren. Außerdem sind Bauvorlagen enthalten, soweit solche für die Bewertung des Anliegens erforderlich sind.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871247062_568343_24083'/>
						</ownedComment>
