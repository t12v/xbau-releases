						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264203_544393_25553' name='nachbarbeteiligungForm' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244702_221674_23404'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282135_289774_30502' body='&lt;para&gt;Dieses Element kann verwendet werden, um Modalitäten der Nachbarbeteiligung anzugeben.&lt;/para&gt;&#10;&#10;'>
