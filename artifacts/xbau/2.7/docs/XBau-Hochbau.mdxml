							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282328_275990_32246'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282328_844124_32244' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246574_675616_23649' name='Berechtigung'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264334_339775_26174' body='&lt;para&gt;Hier sind die Daten einzutragen, die die Berechtigung der entsprechenden Rolle belegen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246574_675616_23649'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264335_357292_26175' name='grundlageBauvorlageBerechtigung' visibility='private' type='_19_0_4_b8702dd_1753083654246_934028_31139'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282328_31957_32249' body='&lt;para&gt;Hier ist der Sachverhalt anzugeben, aufgrund dessen die Person bauvorlageberechtigt ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264335_357292_26175'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282328_418326_32250'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282328_596944_32248' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1629805884888_26912_17449' name='mitgliedschaftInland' visibility='private' type='_19_0_3_136d03d4_1611871246574_604766_23651'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1629805884897_726137_17453' body='&lt;para&gt;Hier sind die Daten einer inländischen Kammernzugehörigkeit anzugeben (Berechtigung als Mitglied einer Kammer). Das geschieht auch für Personen, deren Daten in einem Kammernverzeichnis gespeichert sind, sie aber nicht im engeren Sinne Mitglied dieser Kammer sind (personennummer für im Kammernverzeichnis geführte Nichtmitglieder).&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1629805884888_26912_17449'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1629805884899_927372_17454'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1629805884895_380787_17452' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264335_364046_26177' name='nachweisBerechtigung' visibility='private' type='_19_0_4_b8702dd_1753084233390_433219_31155'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282329_496724_32257' body='&lt;para&gt;Hier kann ggf. ein Nachweis zur Berechtigung angegeben werden.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264335_364046_26177'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282329_263241_32258'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282329_587143_32256' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264335_891538_26178' name='berufsbezeichnung' visibility='private' type='_19_0_4_b8702dd_1753083510332_936641_31123'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282330_444809_32261' body='&lt;para&gt;In dieses Element kann eine Angabe zur Berufsbezeichnung der Person eingetragen werden.&lt;/para&gt;'>
