							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823504_753186_25737' name='baugenehmigung' visibility='private' type='_19_0_4_b6602da_1721633659639_600867_25723'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823599_829012_26157' body='&lt;para&gt;Dieses Element enthält weitere Daten zur Baugenehmigung.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt der Kindelemente ergibt sich aus dem Datentyp Baugenehmigung der Eingangsnachricht bzw. wird in der Behörde gepflegt.&lt;/para&gt;'>
