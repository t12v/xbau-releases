							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282530_806920_33674' body='&lt;para&gt;Hier ist dokumentiert, ob der  Bauherr wünscht, dass der Vorgang bei abschlägiger Entscheidung als ein Baugenehmigungsverfahren weitergeführt werden soll  (&quot;true&quot;, andernfalls &quot;false&quot;).&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266244_915765_26871'/>
