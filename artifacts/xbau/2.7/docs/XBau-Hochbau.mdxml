									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282546_224213_33781' name='nachpruefung' visibility='private' type='_19_0_3_136d03d4_1611871266253_965580_26913'>
