							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282134_213351_30494' body='&lt;para&gt;Wurde die Zustimmung durch diesen betroffenen Nachbarn bereits erteilt? Wenn ja, ist in dieses Element &#39;true&#39; einzutragen, sonst &#39;false&#39;.&lt;/para&gt;&#10;&#10;'>
