						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266691_272261_27015' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282576_639556_33991' body='&lt;para&gt;Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;&gt;BIM Collaboration Format (BCF)&lt;/emphasis&gt;. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266691_272261_27015'/>
							</ownedComment>
