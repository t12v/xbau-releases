							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697459782419_595615_24870' name='referenzAuftrag' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697459782473_15700_24872' body='&lt;para&gt;Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#13;&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1697459782419_595615_24870'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1697459782477_929475_24873' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1697459782466_270478_24871' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282512_981674_33572' name='ergebnis' visibility='private' type='_19_0_3_136d03d4_1611871266233_874869_26834'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283328_685832_36885' body='&lt;para&gt;Hier wird das Prüfergebnis formuliert und erläutert.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282512_981674_33572'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283328_30458_36886' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283328_191646_36884' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282512_693799_33573' name='abweichung' visibility='private' type='_19_0_3_136d03d4_1611871244698_52288_23387'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283329_477307_36889' body='&lt;para&gt;Hier können bei Bedarf Empfehlungen an die Bauaufsichtsbehörde zur Zulassung von Abweichungen eingetragen werden.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282512_693799_33573'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283329_609638_36890'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283328_221842_36888' value='*'/>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282513_352251_33574' name='nebenbestimmung' visibility='private' type='_19_0_3_136d03d4_1611871244698_632785_23388'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283329_874412_36893' body='&lt;para&gt;Hier sind die Nebenbestimmungen zum Prüfergebnis einzufügen (z. B. Auflagen, die einem positiven Prüfergebnis beigegeben werden), falls solche gemäß der Bewertung des Prüfingenieurs festgesetzt werden sollten. Diese Nebenbestimmungen haben dieselbe Struktur wie im Kontext eines Bescheides der Bauaufsichtsbehörde. Im Unterschied zu dort findet im vorliegenden Kontext aber nur der Rechtsbereich des Bauordnungsrechts Anwendung.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282513_352251_33574'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283329_821784_36894'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283329_680351_36892' value='*'/>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1727770027204_260436_28790' name='artBericht' visibility='private' type='_19_0_4_78d0259_1727769618227_270195_28725'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1727882128015_399604_29278' body='&lt;para&gt;In diesem Element wird die Art des Berichts angegeben.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_78d0259_1727770027204_260436_28790'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1727876727878_676052_29276' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1727876727881_971750_29277' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266233_874869_26834' name='Anonym_Pruefergebnis'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282513_974732_33575' body='&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266233_874869_26834'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282513_503101_33577' name='erlaeuterung' visibility='private' aggregation='composite'>
								<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283330_741558_36901' body='&lt;para&gt;In diesen Textabschnitten wird aufgelistet, welche Gegenstände geprüft wurden, welche Methoden dabei angewendet wurden und zu welchen Ergebnissen der Prüfer gelangt ist.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282513_503101_33577'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283330_934483_36902'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283330_586849_36900' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1727876176314_363107_29269' name='pruefstatus' visibility='private' type='_19_0_4_78d0259_1732811154630_296366_29650'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1727876298998_279638_29275' body='&lt;para&gt;In dieses Element wird der Status eingetragen, der übermittelt werden soll. Der Status übermittelt ebenfalls das Prüfergebnis.&lt;/para&gt;&#10;&lt;para&gt;Folgende Einträge der Codeliste sind zulässig: 50-56.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_78d0259_1727876176314_363107_29269'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1727876240449_27191_29271' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1727876240453_249128_29272' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266233_668239_26835' name='RahmendatenGebuehrenberechnung'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282514_285139_33579' body='&lt;para&gt;Dieser Typ dient dazu, Rahmendaten zur Gebührenberechnung für einen erteilten Prüfauftrag an einen Prüfingenieur abzubilden. Sie geben dem Auftragnehmer die Möglichkeit, die Komplexität des Bauvorhabens einzuschätzen, in dessen Kontext der Auftrag erteilt wird, und entsprechend Aufwand und Auftragswert des Prüfauftrags zu kalkulieren. Der Typ stellt die alternativen Ansätze für die Gebührenberechnung dar, in der Anwendung des Typs ist genau eine dieser Alternativen anzuwenden.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266233_668239_26835'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
