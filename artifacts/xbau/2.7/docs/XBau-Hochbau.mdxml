							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282553_454763_33825' name='befundliste' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244700_807454_23394'>
