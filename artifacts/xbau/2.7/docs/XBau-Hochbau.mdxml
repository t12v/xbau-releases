								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837795_348564_27918' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Nachrichteninstanz Bezug zu nehmen, durch deren Eingang bei der bereitstellenden Komponente das Anlegen des Aktenraums ausgelöst worden ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837785_424603_27865'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1726761837795_770937_27919' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1726761837795_589260_27917' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
