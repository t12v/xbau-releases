						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264383_910275_26519' name='beantragterVorbescheid' visibility='private' type='_19_0_3_136d03d4_1611871244699_341220_23390'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282398_374741_32887' body='&lt;para&gt;Jedes Element steht für eine Fragestellung, die im Rahmen eines Vorbescheids durch die Bauaufsichtsbehörde beantwortet werden soll.&lt;/para&gt;'>
