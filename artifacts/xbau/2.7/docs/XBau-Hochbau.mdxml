								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1775569062674_857621_30782' name='frist' visibility='private' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191726109_379108_1042'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::date' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1775569062682_143812_30784' body='&lt;para&gt;Sollte die adressierte Stelle nicht innerhalb der gesetzten Frist die Stellungnahme vorgelegt haben, kann in diesem Element eine neue Frist gesetzt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1775569062674_857621_30782'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1775569062684_319658_30785'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1775569062680_272829_30783' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1691564863966_577849_22606' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1691564863986_679114_22625' body='&lt;para&gt;Es sind ggf. Dokumente anzulegen (Alternativ Verweise auf solche Dokumente), die mit der Zwischennachricht in Zusammenhang stehen.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1691564863966_577849_22606'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1691564863986_982786_22626'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1691564863985_344044_22624' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1691566004063_655551_22731' name='beteiligung.reaktionZwischennachricht.0306'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1691566004119_458168_22761' body='&lt;para&gt;Diese Nachricht kann die Bauaufsichtsbehörde verwenden, um auf die Zwischennachricht der beteiligten Behörde zu reagieren. Es kann zum Beispiel eine neue Frist für die Stellungnahme mitgeteilt werden.&lt;/para&gt;&#10;&lt;para&gt;Entsprechend kann auch die beteiligte Stelle auf Zwischennachrichten der Bauaufsichtsbehörde reagieren.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_b8702dd_1691566004063_655551_22731'/>
						</ownedComment>
