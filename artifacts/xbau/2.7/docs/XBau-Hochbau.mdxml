					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871247065_237302_24093' name='abweichung.antragGeaendert.0222'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264396_638471_26580' body='&lt;para&gt;Diese Nachricht enthält geänderte oder ergänzte Daten des Abweichungsantrags bzw. geänderte oder ergänzte Bauvorlagen. Sie bezieht sich also auf einen bereits gestellten Abweichungsantrag.&lt;/para&gt;&#10;&lt;para&gt;Entweder  ist sie eine Reaktion auf eine zum Bauantrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871247065_237302_24093'/>
						</ownedComment>
