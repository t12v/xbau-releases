							</xmi:Extension>
						</supplier>
					</packagedElement>
				</packagedElement>
				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871241080_972479_23105' name='Anzeige'>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1611871242635_426909_23202'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241080_972479_23105'/>
