						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1750063263375_107873_30399' name='grundstueck' visibility='private' type='_19_0_4_b6602da_1750063494976_210957_30442'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1750063263377_971749_30401' body='&lt;para&gt;Mit diesem Element werden die Daten zu einem der Grundstücke übermittelt, auf das sich die Baulastauskunft bezieht.&lt;/para&gt;'>
