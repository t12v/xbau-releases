							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1725527109343_626962_27253' name='anzahlDerGebaeudeImBauvorhaben' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191855828_468108_1536'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
