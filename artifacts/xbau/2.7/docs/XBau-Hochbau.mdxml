							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1620337550103_792609_17385' body='&lt;para&gt;Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht grundstuecksteilung.antrag.0240 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_131403da_1620337550088_613398_17379'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
