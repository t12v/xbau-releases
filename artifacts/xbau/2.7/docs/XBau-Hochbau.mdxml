					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619461293037_566894_16917' name='WeitereBeteiligte'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726125364313_141260_27797' body='&lt;para&gt;Dieser Abschnitt fasst Daten zu weiteren Beteiligten zusammen. Pro Beteiligter ist ein Element zu instanziieren.&#10;Hat ein weiterer Beteiligter die Rolle &quot;Fachplaner&quot;, &quot;Prüfsachverständiger&quot; oder &quot;Verantwortlicher&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot;, &quot;mitgliedschaftInland&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. Falls die Person nicht im Inland niedergelassen ist, sollte „Ausland“ befüllt werden. &#10;Hat ein weiterer Beteiligter die Rolle &quot;Prüfingenieur&quot; oder &quot;Prüfsachverständiger&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. &lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1619461293037_566894_16917'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
								<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_4_b6602da_1726125370781_212114_27798' name='WeitereBeteiligte' visibility='public' ownerOfDiagram='_19_0_3_136d03d4_1619461293037_566894_16917'>
