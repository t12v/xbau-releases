								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282450_347750_33217' body='&lt;para&gt;Bezug auf den Vorgang einer Nutzungsbeginnanzeige und ggf. auf die Nachricht einer Äußerung zur untersagten Nutzungsaufnahme&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871265757_988637_26701'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
