							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282133_553252_30486' body='&lt;para&gt;Pro Eigentümer des vom Bauvorhaben betroffenen Nachbargrundstücks ist ein Element zu instanziieren.&lt;/para&gt;&#10;'>
