							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696422846404_958043_24587' body='&lt;para&gt;Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass der sommerliche Wärmeschutz (Ausbau beträgt mehr als 50m2) nach § 51 Abs. 2 GEG nachgewiesen wurde. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1696422846392_358571_24541'/>
