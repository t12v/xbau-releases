						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1655369468690_893671_18418' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1655369468681_755848_18412' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1655369468694_529620_18421' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Nachricht baulastenverzeichnis.anfrage.0710 Bezug zu nehmen, durch deren Eingang bei der Behörde der Vorgang ausgelöst worden ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1655369468681_755848_18412'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1655369468695_55863_18422' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1655369468693_671501_18420' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1703144328566_650205_24970' name='antragVollstaendig' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1703144328570_807637_24972' body='&lt;para&gt;Mit diesem Element wird angegeben, ob der Antrag vollständig oder nicht vollständig ist. Falls der Antrag vollständig ist, ist true einzutragen, andernfalls false.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1703144328566_650205_24970'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1703144328570_241587_24973' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1703144328570_632960_24971' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1703144339230_855749_24977' name='befundFrist' visibility='private' type='_19_0_4_b6602da_1756978536310_860233_31468'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1703144339231_256727_24979' body='&lt;para&gt;Falls im Rahmen der formellen Prüfung Mängel festgestellt wurden, sind diese Angaben zu machen.&#10;Die Befundliste enthält die Ergebnisse der formellen Prüfung durch die Bauaufsichtsbehörde. Enthalten ist außerdem eine Frist zur Anpassung der Anfrage auf Baulastauskunft durch den Antragsteller.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1703144339230_855749_24977'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1703144339231_326977_24980'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1703144339230_889686_24978' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1655369468686_199007_18415' name='anschreiben' visibility='private' aggregation='composite'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1655369468702_898382_18433' body='&lt;para&gt;In dieses Element kann ein Anschreibentext eingetragen werden.&lt;/para&gt;&#10;&lt;para&gt;Der Anschreibentext kann auch verwendet werden, um Informationen zu organisatorischen Themen zwischen Bauaufsicht und Bauvorhaben zu übermitteln, beispielsweise zur Mitteilung eines Anhörungstermins.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1655369468686_199007_18415'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1655369468702_855535_18434'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1655369468701_57920_18432' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1655369468687_483115_18416' name='angebotFuerAntwortLeser' visibility='private' aggregation='composite'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_136d03d4_1611781855355_662927_10055'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Verlinkung' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1655369468704_693626_18437' body='&lt;para&gt;Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben.&lt;/para&gt;'>
