						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264404_259428_26614' name='sachverhalt' visibility='private' aggregation='composite' type='_19_0_3_940029b_1662300598916_548669_18264' association='_19_0_3_136d03d4_1611871247068_463332_24102'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282430_15999_33163' body='&lt;para&gt;Hier ist genau einer von drei möglichen Sachverhalten anzugeben, deren Anzeige die vorliegende Nachricht dienen kann (MBO § 72 (6, 8)).&lt;/para&gt;'>
