							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1726121018304_830134_27688' name='statusSozialerWohnungsbau' visibility='private' type='_19_0_4_78d0259_1724140852426_673060_26520'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726121018331_887811_27690' body='&lt;para&gt;Dieses Element enthält die Angabe zum Status der Beantragung sozialer Wohnraumförderung. Das Element muss in den Statistiknachrichten zur Baugenehmigung, zum Baubeginn und zur Baufertigstellung befüllt sein.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt des Elements ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht bzw. aus der Nachricht anzeige.nutzungsaufnahme.0910.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1726121018304_830134_27688'/>
								</ownedComment>
