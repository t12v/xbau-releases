						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1725003500892_995472_26665' name='anzahlDerGebaeude' visibility='private' type='_19_0_4_b6602da_1725002748026_786307_26572'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1725003617713_429042_26670' body='&lt;para&gt;Dieser Datentyp enthält die Anzahl der Gebäude des Bauvorhabens und Informationen zur Identifikation der einzelnen Gebäude.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1725003500892_995472_26665'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1725003593862_560397_26668' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1725003593862_236667_26669' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264177_560445_25412' name='artDerMassnahme' visibility='private' type='_19_0_3_136d03d4_1611871239752_686519_22726'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282095_904157_30146' body='&lt;para&gt;In dieses Element ist einzutragen, von welcher Art (z. B. Errichtung, Änderung, Nutzungsänderung) die  Maßnahmen im Rahmen des Bauvorhabens sind.  &lt;/para&gt;&#10;&lt;para&gt;Falls mehrere dieser Charakterisierungen signifikant zutreffen, so ist das Element mehrfach zu instanziieren. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264177_560445_25412'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282095_225177_30147' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282095_593152_30145' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264177_901511_25413' name='artDerBaulichenAnlage' visibility='private' type='_19_0_3_136d03d4_1611871244699_746777_23393'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282095_935130_30150' body='&lt;para&gt;Für den Gegenstand des Bauvorhabens kann hier die Art der baulichen Anlage näher spezifiziert werden. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264177_901511_25413'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282096_52090_30151'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282095_316921_30149' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1660667310510_208115_18232' name='zweckDerNutzungsaenderung' visibility='private' type='_19_0_3_129a03b9_1660667455391_257345_18239'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1660667310511_562097_18234' body='&lt;para&gt;Wenn das Bauvorhaben eine Nutzungsänderung der baulichen Anlage beabsichtigt, ist in diesem Feld die bisherige und die beabsichtigte Nutzung der baulichen Anlage anzugeben. Es ist jeweils aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1660667310510_208115_18232'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1660667310512_408479_18235'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1660667310511_523504_18233' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264177_955150_25414' name='bauordnungsrechtlicheKlassifikation' visibility='private' type='_19_0_3_136d03d4_1611871244701_991956_23400'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282096_105861_30154' body='&lt;para&gt;Dieses Element beinhaltet Zahlen zu bauordnungsrechtlichen Parametern des Vorhabens.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264177_955150_25414'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282096_580325_30155'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282096_987237_30153' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1660666966014_498422_18225' name='vorhandeneBindungen' visibility='private' type='_19_0_3_136d03d4_1611871246533_294346_23542'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1660666966016_270260_18227' body='&lt;para&gt;In diesem Element können Informationen über vorhandene Bindungen zu dem Gegenstand des Bauvorhabens übermittelt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1660666966014_498422_18225'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1660666966016_153745_18228'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1660666966015_250776_18226' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1666179206722_971561_18593' name='baudenkmalBetroffen' visibility='private' type='_19_0_3_129a03b9_1666180418426_300417_18601'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1666183622192_304651_18610' body='&lt;para&gt; In diesem Element können die Informationen über die vom Bauvorhaben betroffenen Denkmäler enthalten werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1666179206722_971561_18593'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1666180444778_783684_18602'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1666180444779_529842_18603' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264177_156109_25415' name='bauvorhabenDatenblatt' visibility='private' type='_19_0_3_136d03d4_1611871246537_77701_23557'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282096_811340_30158' body='&lt;para&gt;Dieses Objekt bietet Felder für die Übermittlung von technischen Daten und Kennzahlen zum Bauvorhaben.&lt;/para&gt;&#10;&lt;para&gt;Falls das Bauvorhaben eine Errichtung ist, beziehen sich alle aufgeführten Parameter des Datenblatts naturgemäß auf das projektierte Gesamtbauwerk.&lt;/para&gt;&#10;&lt;para&gt;Falls das Bauvorhaben eine Änderung ist, ist abzuwägen, ob Daten in Bezug auf den Erweiterungsbau oder auf das Gesamtbauwerk anzugeben sind.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264177_156109_25415'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282096_684434_30159'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282096_712395_30157' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264178_210389_25417' name='baubeschreibung' visibility='private' type='_19_0_3_136d03d4_1611871246545_228398_23585'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282097_387622_30166' body='&lt;para&gt;Dieses Element gibt die Gliederung vor, in der das Bauvorhaben thematisch strukturiert beschrieben werden kann.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264178_210389_25417'/>
							</ownedComment>
