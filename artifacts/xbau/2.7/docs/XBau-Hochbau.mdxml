							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282393_938114_32844' body='&lt;para&gt;Dies ist die aktualisierte durch die Bauaufsichtsbehörde gesetzte Frist, innerhalb derer die Stellungnahme durch die adressierte Stelle vorliegen muss, so dass sie berücksichtigt werden kann.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264378_664833_26502'/>
