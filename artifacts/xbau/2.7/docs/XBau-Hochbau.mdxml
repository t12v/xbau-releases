							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282574_9731_33971' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen; außerdem ggf. auf die Nachricht, die den Vorgang ausgelöst hat. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266690_312672_27010'/>
							</ownedComment>
