						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265765_58338_26735' name='verortungHausnummer' visibility='private' aggregation='composite' association='_19_0_3_136d03d4_1611871247552_304944_24133'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_136d03d4_1622093994597_608703_9426'>
