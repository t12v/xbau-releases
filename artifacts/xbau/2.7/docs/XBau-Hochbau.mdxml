								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282527_749191_33652' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1784710255603_318743_34706' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1784710255603_643364_34708' body='&lt;para&gt;Mit diesem Element können dem Ergebnis der Prüfung der Genehmigungsfreistellung bei Bedarf Anlagen beigefügt werden.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1784710255603_318743_34706'/>
							</ownedComment>
