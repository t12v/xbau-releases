								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265764_821662_26733' name='bauvorhaben' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244694_158760_23371'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282460_666727_33299' body='&lt;para&gt;Hier werden Daten zum Bauvorhaben übermittelt, soweit für den vorliegenden Anlass relevant. &lt;/para&gt;&#10;&#10;'>
