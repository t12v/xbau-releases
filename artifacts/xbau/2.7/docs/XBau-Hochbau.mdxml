					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_129a03b9_1658324258049_356155_18208' name='beteiligung.ruecknahme.0304'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1658324258052_44372_18209' body='&lt;para&gt;Diese Nachricht kann durch die Bauaufsichtsbehörde verwendet werden, um eine in der Vergangenheit gestellte Aufforderung zur Stellungnahme bzw. Beteiligung zurückzuziehen.&lt;/para&gt;&#10;&lt;para&gt;Wenn der Kommunikationskanal offen bleiben soll, dann muss für den Abbruch einer Beteiligung statt dieser Nachricht die Nachricht beteiligung.zwischennachricht.0305 genutzt werden.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_129a03b9_1658324258049_356155_18208'/>
						</ownedComment>
