							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1747990674738_445373_30081' body='&lt;para&gt;In diesem Elements wird auf die Vorgangsnummer der erteilten Baugenehmigung Bezug genommen, auf deren Basis gearbeitet wird, und auf die Nachricht 0920, mittels derer der geprüfte Bauzustand angezeigt worden ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1747990674728_548713_30075'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
