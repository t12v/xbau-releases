						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264176_52936_25409' name='entwurfsverfasser' visibility='private' type='_19_0_3_136d03d4_1611871246574_751919_23648'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282094_113866_30138' body='&lt;para&gt;Hier ist die Person einzutragen, die am Verfahren als Entwurfsverfasser beteiligt ist. Falls kein Entwurfsverfasser für das Bauvorhaben benötigt wird, kann dieses Element entfallen.&lt;/para&gt;'>
