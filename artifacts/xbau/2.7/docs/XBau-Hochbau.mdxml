								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837797_495384_27937' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang bzw. die Nachricht Bezug zu nehmen, die das Anlegen des Aktenraums veranlasst hat.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837787_188603_27872'/>
							</ownedComment>
