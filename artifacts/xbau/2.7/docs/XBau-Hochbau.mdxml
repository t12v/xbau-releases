							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282069_856218_29955' body='&lt;para&gt;Eine Hausnummer dient der genauen Lokalisierung eines Grundstücks, Gebäudes oder Gebäudeteils (Eingang) in einer Straße. Es ist je nach Sachlage eine Zahl einzutragen (&quot;39&quot;) oder eine Zahl in Kombination mit einem Buchstaben (&quot;39b&quot;).&lt;/para&gt; &#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264144_6233_25264'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282069_246279_29956'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282069_231320_29954' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264145_979204_25265' name='strasseHausnummer' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282069_487797_29959' body='&lt;para&gt;Element für die Erfassung von Straße und Hausnummer des Grundstücks als undifferenzierte Zeichenkette (nur für bestimmte Kontexte: ersetzt dann die Verwendung der Elemente &lt;emphasis role=&quot;codebf&quot;&gt;strasse&lt;/emphasis&gt; und &lt;emphasis role=&quot;codebf&quot;&gt;hausnummer&lt;/emphasis&gt;).&lt;/para&gt;&#10;&lt;para&gt;Falls sich in einem Kontext der Übernahme von Anschriftsdaten die Bezeichnung der Straße und die Hausnummer nicht maschinell zuverlässig trennen lassen, können diese Informationen in das Element als eine gemeinsame Zeichenkette übernommen werden.&lt;/para&gt; &#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264145_979204_25265'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282069_771082_29960'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282069_889735_29958' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
