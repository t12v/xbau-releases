					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871247069_785599_24104' name='anzeige.nutzungsaufnahmeUntersagung.0911'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871265756_355288_26700' body='&lt;para&gt;Die Nachricht enthält den Hinweis, dass die geplante Maßnahme die Voraussetzungen nicht erfüllt und benennt entsprechende Mängel. Sie fordert zur Nachbesserung auf.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871247069_785599_24104'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264153_588779_25314' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265757_988637_26701' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
