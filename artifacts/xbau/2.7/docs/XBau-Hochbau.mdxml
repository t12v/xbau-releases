									<referenceExtension referentPath='W3C Data Types::date' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_940029b_1703698029463_630385_24996' body='&lt;para&gt;In diesem Element kann ggf. ein geändertes Datum für die Gültigkeitsverlängerung übermittelt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_940029b_1703698029459_76946_24994'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_940029b_1703698029465_950645_24997'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_940029b_1703698029463_97238_24995' value='1'/>
