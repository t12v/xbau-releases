								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282211_844858_31188' body='&lt;para&gt;Unbebaute Fläche UF. Teilfläche der Grundstücksfläche (GF), die nicht durch ein Bauwerk überbaut, überdeckt oder unterbaut ist. Angabe: Anzahl Quadratmeter mit zwei Nachkommastellen&lt;/para&gt;&#10;&lt;para&gt;= grundstuecksFlaecheGF - bebauteFlaecheBF&lt;/para&gt;'>
