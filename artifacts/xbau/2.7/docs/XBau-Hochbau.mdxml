								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1691564863982_376167_22617' body='&lt;para&gt;Hier wird der Grund bzw. das Anliegen der Zwischennachricht genannt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1691564863962_92513_22604'/>
							</ownedComment>
