							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1668598974072_502592_18362' body='&lt;para&gt;Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1668598974070_194434_18360'/>
