				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246902_789057_7586' name='Bauaufsichtsbehörde'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247457_469361_7631' body='&lt;para&gt;Die Bauaufsichtsbehörde (BAB) prüft die Einhaltung der öffentlich-rechtlichen Vorschriften (vgl. §58 Abs.2 MBO).&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246902_789057_7586'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246904_263601_7587' name='Bauherr'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247457_427614_7632' body='&lt;para&gt;Natürliche oder juristische  Person mit Bauvorhaben oder Bauprojekt. Verantwortlich für das Stellen von Anträgen., Anzeigen und Nachweisen. Bestellung der am Bau Beteiligten. (vgl. §53 MBO)&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246904_263601_7587'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246905_579674_7588' name='Prüfsachverständiger'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247458_432225_7633' body='&lt;para&gt;Prüft im Auftrag des Bauherrn an Stelle der Bauaufsichtsbehörde. Verantwortlich für die Prufung von bautechnischen Nachweisen unter Beachtung der Schutzziele.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246905_579674_7588'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246906_807967_7589' name='Entwurfsverfasser'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247458_632836_7634' body='&lt;para&gt;Vom Bauherrn mit der fachlichen Betreuung des Bauvorhabens beauftragt. Kann ein Architekt sein / kann ein  Ingenieur sein.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246906_807967_7589'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246907_160324_7590' name='Fachbehörde'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247458_778060_7635' body='&lt;para&gt;Behörde mit Expertise für ein Fachgebiet. Nimmt im Beteiligungsverfahren Stellung zu entsprechenden Sach- und Fachfragen.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246907_160324_7590'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246908_446292_7591' name='Fachplaner'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247459_566325_7636' body='&lt;para&gt;Arbeitet im Auftrag des Entwurfsverfassers. Hat Sachkunde auf speziellen Gebieten.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246908_446292_7591'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246908_913128_7592' name='Prüfingenieur'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247459_486009_7637' body='&lt;para&gt;Prüft im Auftrag der Bauaufsichtsbehörde als beliehener Unternehmer. Verantwortlich für die Prufung von bautechnischen Nachweisen unter Beachtung der Schutzziele.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246908_913128_7592'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246909_567406_7593' name='Zuständige Behörde'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247459_989752_7638' body='&lt;para&gt;Diese Behörde prüft, ob die öffentlich-rechtlichen Vorschriften ihres Zuständigkeitsbereichs eingehalten sind.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246909_567406_7593'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_c4f030d_1632746086778_324980_18660' general='_19_0_3_940029b_1619933652637_247045_17476'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246909_516735_7594' name='Informationsempfänger'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247459_520827_7639' body='&lt;para&gt;Datenempfänger im Rahmen eines Informationsverfahrens.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246909_516735_7594'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246910_43159_7595' name='Nachbar'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247460_322355_7640' body='&lt;para&gt;Eigentümer eines benachbarten (nach SEVESO III betroffenen) Grundstücks (vgl. §70 Abs. 1). / &lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246910_43159_7595'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Actor' xmi:id='_19_0_3_136d03d4_1611870246910_698536_7596' name='Gemeinde'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611870247460_868161_7641' body='&lt;para&gt;Gemeinde, in der das Bauvorhaben gelegen ist. Sie ist Trägerin der kommunalen Planungshoheit.&lt;/para&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1611870246910_698536_7596'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611870246911_72139_7597'>
