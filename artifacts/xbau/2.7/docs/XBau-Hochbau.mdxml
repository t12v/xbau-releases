						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1752843163695_47952_31795' name='nachweissubjekt' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1752843163703_206204_31819' body='&lt;para&gt;In diesem Element ist das Nachweissubjekt (Person oder Unternehmen) zu nennen, zu dem die Daten abgerufen wurden. Die Angabe sollte hinreichend genau sein, um eine zweifelsfreie Zuordnung zu ermöglichen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1752843163695_47952_31795'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
