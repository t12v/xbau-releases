										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283263_553623_36420' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283263_815177_36418' value='*'/>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Association' xmi:id='_19_0_3_136d03d4_1611871264407_248204_26629'>
							<memberEnd xmi:idref='_19_0_3_136d03d4_1611871282435_613511_33193'/>
							<memberEnd xmi:idref='_19_0_3_136d03d4_1611871282436_814920_33194'/>
							<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282436_814920_33194' visibility='private' type='_19_0_3_136d03d4_1611871264407_40415_26628' association='_19_0_3_136d03d4_1611871264407_248204_26629'/>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871264408_360318_26632' name='Untersagung'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282436_445993_33198' body='&lt;para&gt;Dieser Typ deckt alle Informationen ab, die zu einer verfügten Untersagung als Reaktion auf eine Anzeige gehören können.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264408_360318_26632'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282436_114040_33199' name='anordnung' visibility='private' aggregation='composite'>
								<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283264_618573_36427' body='&lt;para&gt;Die Anordnung besteht aus einem Sachverhalt (Verstoß wird genannt, z.B. &quot;fehlende Absteckung&quot;), einer Begründung (die Rechtsnorm, die zur Untersagung führt) sowie einer Rechtsbehelfsbelehrung (Textbaustein, ggf. §-Referenz, ggf. als Anlage, z.B. pdf-Datei o.ä.).&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282436_114040_33199'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283264_296734_36428' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283264_643154_36426' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282437_111669_33200' name='fehlendeUnterlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871264407_40415_26628'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283265_273345_36431' body='&lt;para&gt;Hinweise auf fehlende Voraussetzungen (Mängelliste) werden benannt. Es werden die Unterlagen genannt, deren Fehlen zur Untersagung geführt hat.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282437_111669_33200'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283265_295721_36432' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283265_592769_36430' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619787338760_271682_17254' name='Anonym_BezugBaubeginn'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619787358658_455850_17255' name='mitAktenzeichen' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619788578331_222490_17277' body='&lt;para&gt;Dieses Element ist zu befüllen, wenn ein Aktenzeichen zum Verfahren vorhanden ist (bei genehmigten Bauverfahren).&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619787358658_455850_17255'/>
								</ownedComment>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619787364752_762097_17256' name='ohneAktenzeichen' visibility='private' type='_19_0_3_136d03d4_1619787440576_90366_17263'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619788601044_121541_17278' body='&lt;para&gt;Dieses Element ist zu befüllen, wenn kein Aktenzeichen zum Verfahren vorhanden ist (z. B. bei genehmigungsfreigestellten Verfahren).&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619787364752_762097_17256'/>
								</ownedComment>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1619787440576_90366_17263' name='Anonym_OhneAktenzeichen'>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619787503999_359556_17264' name='datumEingereicht' visibility='private'>
