								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1726761837786_288151_27867' name='zugangslink' visibility='private' type='_19_0_3_c4f030d_1642416591066_427158_17824'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837796_556786_27926' body='&lt;para&gt;In diesem Element kann der Zugang zum Aktenraum per Verlinkung zum Ablageort der Dokumente eingetragen werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837786_288151_27867'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1726761837796_220252_27927'/>
