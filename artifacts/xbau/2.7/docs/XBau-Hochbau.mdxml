						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_c4f030d_1634126019826_734801_17902' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1634126019822_108180_17895' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1634126019827_428504_17905' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang (oder den Antrag) bzw. die Nachricht akteneinsicht.antrag.0120 Bezug zu nehmen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para&gt;&#10;&lt;para&gt;Damit wird gleichzeitig dem Antragsteller die entsprechende Vorgangsnummer für künftige Referenzierung mitgeteilt. Dadurch ist der Bezug zum Antrag hergestellt, zu dessen formeller Prüfung die vorliegende Nachricht Ergebnisse enthält.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1634126019822_108180_17895'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1634126019827_313918_17906' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1634126019827_126708_17904' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1701856116261_972344_24880' name='antragVollstaendig' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1701856116274_87989_24882' body='&lt;para&gt;Mit diesem Element wird angegeben, ob der Antrag vollständig oder nicht vollständig ist. Falls der Antrag vollständig ist, ist true einzutragen, andernfalls false.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1701856116261_972344_24880'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1701856116275_663036_24883' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1701856116272_906386_24881' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1701856120169_95935_24887' name='befundFrist' visibility='private' type='_19_0_4_b6602da_1701856263692_20128_24899'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1701856120172_784551_24889' body='&lt;para&gt;Falls im Rahmen der formellen Prüfung Mängel festgestellt wurden, sind diese Angaben zu machen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1701856120169_95935_24887'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1701856120173_911765_24890'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1701856120170_399320_24888' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1634126019823_475613_17898' name='anschreiben' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1634126019830_731149_17917' body='&lt;para&gt;In dieses Element kann ein Anschreibentext eingetragen werden.&lt;/para&gt;&#10;&lt;para&gt;Der Anschreibentext kann auch verwendet werden, um Informationen zu organisatorischen Themen zwischen Bauaufsicht und Bauvorhaben zu übermitteln, beispielsweise zur Mitteilung eines Anhörungstermins.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1634126019823_475613_17898'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1634126019830_770729_17918'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1634126019829_44878_17916' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1634126019824_491537_17899' name='angebotFuerAntwortLeser' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_136d03d4_1611781855355_662927_10055'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Verlinkung' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1634126019831_484961_17921' body='&lt;para&gt;Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1634126019824_491537_17899'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1634126019831_388390_17922'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1634126019830_721865_17920' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1634126019825_769787_17901' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1634126019833_260437_17929' body='&lt;para&gt;Falls die Behörde der Nachricht Anlagen beifügen möchte, ist dieses Element zu verwenden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1634126019825_769787_17901'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1634126019833_190495_17930'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1634126019832_920753_17928' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1634129872230_494850_18077' name='eingangAnalog' visibility='private' isReadOnly='true'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1634129872231_627707_18079' body='&lt;para&gt;Durch die Übermittlung dieses Elementes wird mitgeteilt, dass der Antrag analog eingegangen ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1634129872230_494850_18077'/>
							</ownedComment>
