					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1643200532556_194571_17916' general='_19_0_3_136d03d4_1611871240522_213462_22999'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1643200614724_906197_17928' name='BAB2AIKsync'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1643200614726_641015_17929' body='&lt;head&gt;&#10;&lt;title&gt;Datenübermittlungen zwischen den Architekten- und Ingenieurkammern und den Bauaufsichtsbehörden&lt;/title&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;&lt;p&gt;Folgende Nachrichten des XBau-Schemas sind als Input der Operation &#10;&lt;i&gt;sendeBAB2AIKsync&lt;/i&gt; zulässig:&amp;serviceInputlist;&lt;/p&gt;&#10;&lt;p&gt;Folgende Nachrichten des XBau-Schemas sind als Output der Operation&#10;&lt;i&gt;sendeBAB2AIKsync&lt;/i&gt; zulässig:&amp;serviceOutputlist;&lt;/p&gt;&#10;&lt;p&gt;Folgende Nachrichten des XBau-Schemas sind als Fehlermeldung der einzigen Operation&#10;&lt;i&gt;sendeBAB2AIKsync&lt;/i&gt; zulässig:&amp;serviceFaultlist.&lt;/p&gt;&#10;&#10;&lt;p&gt;Organisationsschlüssel für &lt;i&gt;find.servicedescription&lt;/i&gt;-Anfragen sind &#10;die entsprechende Codes der unter der XBau-Spezifikation veröffentlichten Codeliste urn:xoev-de:xbau:codeliste:kammer; der zu verwendende Präfix lautet &quot;&lt;b&gt;aik&lt;/b&gt;&quot;. &lt;/p&gt;&#10;&#10;&lt;p&gt;Zulässige Dienstanbieter und -nutzer sind die Architekten- und Ingenieurkammern (DVDV-Organisationskategorie &#10;&quot;&lt;b&gt;Architekten- und Ingenieurkammer&lt;/b&gt;&quot;.&#10;Zulässige Dienstnutzer sind Organisationen in der DVDV-Organisationskategorie &#10;&quot;&lt;b&gt;Bauaufsichtsbehörde&lt;/b&gt;&quot;,&#10;&quot;&lt;b&gt;Bauportal&lt;/b&gt;&quot;.&lt;/p&gt;&lt;/body&gt;'>
						<annotatedElement xmi:idref='_19_0_3_136d03d4_1643200614724_906197_17928'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1643200614728_212010_17930' general='_19_0_3_940029b_1664830194263_663634_18220'/>
				</packagedElement>
