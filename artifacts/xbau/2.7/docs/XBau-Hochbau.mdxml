								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282450_933397_33216' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265757_714942_26702' name='untersagung' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871264408_360318_26632'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282450_673870_33221' body='&lt;para&gt;Dieses Objekt enthält die nötigen Informationen zur verfügten Untersagung.&lt;/para&gt;&#10;'>
