							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282327_503775_32240' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264334_323658_26172' name='berechtigung' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246574_675616_23649' association='_19_0_3_136d03d4_1611871246575_553449_23653'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282328_282891_32245' body='&lt;para&gt;Hier sind die Daten einzutragen, die die Berechtigung des Entwurfsverfassers belegen.&lt;/para&gt;'>
