					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b6602da_1725002748026_786307_26572' name='AnzahlDerGebaeude'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1725002836797_412302_26574' body='&lt;para&gt;Dieser Datentyp enthält die Anzahl der Gebäude des Bauvorhabens und Informationen zur Identifikation der einzelnen Gebäude. Die Angabe, die im Element &quot;anzahlDerGebaeudeImBauvorhaben&quot; gemacht wurde, bedingt wie oft der Datentyp &quot;identifikationGebaeude&quot; befüllt werden muss.&#10;Beispiel: Bei einer Baugenehmigung für ein Reihenhaus bestehend aus 3 Wohneinheiten (= Gebäuden) wird der Datentyp &quot;identifikationGebaeude&quot; dreimal befüllt. &lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_b6602da_1725002748026_786307_26572'/>
						</ownedComment>
