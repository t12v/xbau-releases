							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282211_824586_31180' body='&lt;para&gt;Die Fläche, die durch die Grundstücksgrenzen gebildet wird und die im Liegenschaftskataster sowie im Grundbuch ausgewiesen ist.&#10;Zur Grundstücksfläche gehören die bebaute Grundstücksfläche und die unbebaute Grundstücksfläche.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264260_998256_25810'/>
							</ownedComment>
