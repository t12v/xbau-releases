						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264151_843191_25291' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265763_531564_26730' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282459_273869_33287' body='&lt;para&gt;Dieses Element nennt den Vorgang der Bauaufsichtsbehörde, aus dem die Informationen entnommen sind. &lt;/para&gt;&#10;&lt;para&gt;Eine Referenz auf eine Nachricht ist hier i.d.R. nicht einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871265763_531564_26730'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282459_112465_33288' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282458_900148_33286' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1752838757161_891965_31006' name='adressierteStelle' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191873500_204582_1633'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::token' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1752838757165_197592_31008' body='&lt;para&gt;Die Information in diesem Element wird in den Fällen benötigt, wo die Nachrichteninstanz an eine Plattform geht, in der eine Vielzahl von Stellen einen Account haben. Die Stelle, für die die Nachrichteninstanz gedacht ist, muss im vorliegenden Element technisch eindeutig bezeichnet werden (z.B. durch die ID eines Unternehmenskontos oder eine Mail-Adresse), so dass die Plattform die Nachricht entsprechend zuordnen und zustellen kann.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1752838757161_891965_31006'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1752838757166_96892_31009'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1752838757164_546610_31007' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265764_238367_26731' name='anlass' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871239763_75300_22754'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282459_461132_33291' body='&lt;para&gt;Hier wird der Übermittlungsanlass genannt: Welches bauaufsichtliche Ereignis hat zu dieser Benachrichtigung geführt?&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871265764_238367_26731'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
