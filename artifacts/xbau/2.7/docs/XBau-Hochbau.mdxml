						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264154_738905_25319' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264372_207656_26474' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282384_240890_32756' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang (oder den Antrag) und ggf. auf eine Nachricht prozessnachrichten.formellePruefungBefundliste.1140, auf die die vorliegende Nachrichteninstanz eine Reaktion ist, Bezug zu nehmen. &lt;/para&gt;&#10;&#10;&lt;para&gt;Falls mit der Nachricht initiativ eine geänderte Planung eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten. &lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264372_207656_26474'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282384_225378_32757' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282383_879908_32755' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264372_870533_26475' name='prozessmerkmale' visibility='private' type='_19_0_3_136d03d4_1611871244702_582549_23403'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282384_905150_32760' body='&lt;para&gt;Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264372_870533_26475'/>
							</ownedComment>
