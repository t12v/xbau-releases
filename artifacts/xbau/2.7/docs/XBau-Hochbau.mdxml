								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1619788926052_91379_17285' body='&lt;para&gt;Hier ist das Datum der Einreichung der Bauunterlagen anzugeben.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1619787503999_359556_17264'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1619788746804_932495_17279'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1619788746805_534107_17280' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1619787513896_275406_17265' name='datumBaubeginnanzeige' visibility='private'>
