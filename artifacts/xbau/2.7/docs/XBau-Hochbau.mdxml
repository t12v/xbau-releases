							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1726561768426_795577_27845' name='artDesBauens' visibility='private' type='_19_0_4_b6602da_1726561927319_573706_27854'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726563679965_808389_27975' body='&lt;para&gt;Hier kann angegeben werden, ob es sich bei der Baumaßnahme um einen Neubau oder um eine Baumaßnahme am Bestand handelt.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt der Kindelemente ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para&gt;'>
