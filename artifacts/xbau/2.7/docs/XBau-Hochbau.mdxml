							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282517_800101_33590' name='bruttorauminhalt' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191855828_468108_1536'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::positiveInteger' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283335_676692_36937' body='&lt;para&gt;Bruttorauminhalt dieser Gebäudeart: Hier ist die Anzahl an Kubikmetern anzugeben, mit der diese Gebäudeart im Bauvorhaben repräsentiert ist.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282517_800101_33590'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283335_681409_36938' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283335_97011_36936' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1729865242362_5200_29736' name='gebauedeklasse' visibility='private' type='_19_0_3_136d03d4_1611871239759_272892_22742'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1729865501720_380114_29744' body='&lt;para&gt;Hier ist die Gebäudeklasse abgebildet, die dem Bauvorhaben zugeordnet werden kann. Die Information kann aus dem Element &quot;gebauederechtlicheKlassifikation&quot; aus der Nachricht 0200 entnommen werden.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_78d0259_1729865242362_5200_29736'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1729865291372_437303_29738' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1729865291372_514252_29739' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1729865297914_727139_29740' name='sonderbautatbestand' visibility='private' type='_19_0_3_136d03d4_1611871239759_905594_22743'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1729865518378_759416_29745' body='&lt;para&gt;Hier ist der Sonderbautatbestand abgebildet, die dem Bauvorhaben zugeordnet werden kann. Die Information kann aus dem Element &quot;gebauederechtlicheKlassifikation&quot; aus der Nachricht 0200 entnommen werden.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_78d0259_1729865297914_727139_29740'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1729865373481_525403_29742' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1729865373481_959687_29743' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282516_54341_33588' name='gebaeudeartBauwert' visibility='private' type='_19_0_3_136d03d4_1611871239760_833644_22746'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283334_332013_36929' body='&lt;para&gt;In diesem Element sind die Gebäudeart mit dem zugehörigem relativen Bauwert (Eurocent pro Kubikmeter) genannt. Sie sind bei der Berechnung der anrechenbaren Bauwerte zu berücksichtigen gemäß zutreffender Verordnung für die Prüfingenieure und Prüfsachverständige.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282516_54341_33588'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283334_474188_36930' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283334_156661_36928' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1765372562768_166223_31413' name='ProzessmerkmaleVerfahrensart'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1765372921465_639769_31426' body='&lt;para&gt;Dieser Datentyp dient zur Übermittlung der Verfahrensart, wenn keine weiteren Prozessmerkmale benötigt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1765372562768_166223_31413'/>
							</ownedComment>
							<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_b8702dd_1765372805308_882091_31417' general='_19_0_3_136d03d4_1611871244702_582549_23403'/>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1765372859643_924066_31419' name='verfahrensart' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871239791_257404_22869'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1765372859660_134050_31421' body='&lt;para&gt;Dieses Element wird verwendet, um die baurechtliche Verfahrensart anzugeben. &lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b8702dd_1765372859643_924066_31419'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1765372859660_390391_31422' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1765372859660_954306_31420' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248928_34997_24239' name='pruefingenieure.nachforderungUnterlagen.0504'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266235_495836_26842' body='&lt;para&gt;Diese Nachricht nennt inhaltliche Mängel an einem Bauvorhaben und fordert im Rahmen der materiellen Prüfung nachgebesserte Unterlagen ein. Das kann für die Prüfung bautechnischer Nachweise oder der Bauüberwachung nötig sein.&lt;/para&gt;&#10;&lt;para&gt;Nachforderungen gemäß dieser Nachricht sind in geeigneter Form dem Bauherrn oder Bauleiter zur Verfügung zu stellen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248928_34997_24239'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_78d0259_1737986871965_506956_29291' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734093148_513867_29352' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734093151_802812_29357' body='&lt;para&gt;Hier ist die Vorgangsnummer der Bauaufsichtsbehörde (Beauftragung) einzutragen, wie in der &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; vergeben. Außerdem wird die Referenz auf &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; eingetragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734093148_513867_29352'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734093151_809930_29358' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734093150_521370_29356' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734093150_609091_29353' name='referenzPruefauftrag' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734093152_610068_29361' body='&lt;para&gt;Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#13;&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734093150_609091_29353'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734093152_310150_29362'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734093152_69272_29360' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734093150_471680_29354' name='befundliste' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244696_372837_23381'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734093154_208469_29365' body='&lt;para&gt;Nach der Prüfung der vorliegenden Dokumente werden hier die Ergebnisse als Befundliste eingetragen. Jeder Befund wird mit den nötigen Details erläutert..&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734093150_471680_29354'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734093155_524812_29366' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734093153_710269_29364' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734093150_57612_29355' name='aufforderungZurStellungnahme' visibility='private' aggregation='composite'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734093156_42184_29369' body='&lt;para&gt;Hier ist die Aufforderung zu Stellungnahme bzw. Kommentar formuliert, soweit anwendbar.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734093150_57612_29355'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734093156_841687_29370'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734093155_318697_29368' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248928_426780_24240' name='pruefingenieure.angepassteUnterlagen.0505'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266236_698673_26847' body='&lt;para&gt;Diese Nachricht enthält nachgebesserte Unterlagen zum Prüfauftrag. Sie bezieht sich auf einen erteilten Prüfauftrag und auf eine Nachricht, die zur Nachbesserung von Unterlagen gesendet worden ist.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248928_426780_24240'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_78d0259_1737986895113_571187_29292' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734075363_400112_29324' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734075383_596711_29329' body='&lt;para&gt;Hier ist die Vorgangsnummer der Bauaufsichtsbehörde (Beauftragung) einzutragen, wie in der &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; vergeben. Außerdem ist auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.nachforderungUnterlagen.0504&quot;&gt;Nachricht 0504&lt;/link&gt; zu verweisen, mit der eine Befundliste übermittelt wurde. Falls die Nachricht nicht auf eine 0504 Nachricht antwortet, kann auch auf die Nachricht 0500 verwiesen werden.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734075363_400112_29324'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734075388_317472_29330' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734075383_820839_29328' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734075367_487641_29325' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734075389_589167_29333' body='&lt;para&gt;Hier sind die angepassten Unterlagen eingetragen.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734075367_487641_29325'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734075390_246316_29334'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734075389_408957_29332' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734075371_271879_29326' name='referenzPruefauftrag' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734075392_645629_29337' body='&lt;para&gt;Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#13;&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734075371_271879_29326'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734075392_670888_29338'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734075391_206261_29336' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734075378_388879_29327' name='autor' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734075393_960296_29341' body='&lt;para&gt;In diesem Element soll ergänzt werden, wer der ursprüngliche Herausgeber/Autor ist der nachgereichten Unterlagen ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734075378_388879_29327'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734075393_532317_29342' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734075393_612042_29340' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1616761145079_360532_16846'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241080_104258_23107'/>
