						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1725002867937_507840_26575' name='anzahlDerGebaeudeImBauvorhaben' visibility='private'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191841406_826039_1460'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::nonNegativeInteger' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1725003039507_145861_26578' body='&lt;para&gt; In diesem Element wird die Anzahl der Gebäude im Bauvorhaben angegeben. Falls der Vorgang keine Gebäude, sondern lediglich bauliche Anlagen wie Aufschüttungen, Abgrabungen, Werbeanlagen, Stell- und Lagerplätze betrifft, ist der Wert 0 einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1725002867937_507840_26575'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1725003273089_366338_26656' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1725003273091_129137_26657' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1725002871495_279080_26576' name='identifikationGebaeude' type='_19_0_4_b6602da_1725003116971_550114_26581'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1725003090149_704246_26580' body='&lt;para&gt;Dieser Datentyp enthält Angaben zur Identifikation des Gebäudes im Bauvorhaben. Beispiel: Bei einer Baugenehmigung für ein Reihenhaus bestehend aus 3 Wohneinheiten (= Gebäuden) wird dieser Datentyp dreimal befüllt. Zu UUID1 gehört &quot;Reihenendhaus Ost&quot;, zu UUID2 gehört &quot;Mittelhaus&quot; und zu UUID3 gehört &quot;Reihenendhaus West&quot;.&#10;Bei einer Baugenehmigung für bauliche Anlagen wie Aufschüttungen, Abgrabungen, Werbeanlagen, Stell- und Lagerplätze wird dieser Datentyp nicht befüllt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1725002871495_279080_26576'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1725003277697_755294_26658'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1725003277698_887199_26659' value='*'/>
						</ownedAttribute>
					</packagedElement>
