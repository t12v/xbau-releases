						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1652711388343_134646_18034' name='einwilligung' visibility='private' type='_19_0_3_136d03d4_1652711472496_341236_18039'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1652711460710_277674_18038' body='&lt;para&gt;Dieses Element kann verwendet werden, um Modalitäten der Einwilligung zur öffentlichen Bekanntmachung anzugeben.&lt;/para&gt;'>
