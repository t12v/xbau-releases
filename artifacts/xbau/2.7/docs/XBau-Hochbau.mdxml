							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282136_848419_30514' body='&lt;para&gt;Falls beantragt wird, das Bauvorhaben öffentlich bekannt zu machen, ist in diesem Element &quot;true&quot; zu übermitteln.&lt;/para&gt;'>
