					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246574_751919_23648' name='Entwurfsverfasser'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264334_324092_26170' body='&lt;para&gt;Dieser Typ dient dazu, die Daten des  Entwurfsverfassers zu übermitteln, der verantwortlich an der Vorbereitung des  Bauprojekts mitwirkt bzw. mitgewirkt hat.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246574_751919_23648'/>
						</ownedComment>
