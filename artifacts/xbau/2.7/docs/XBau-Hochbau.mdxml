					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1752843163628_281618_31760' name='NachweisbezugType'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1752843163696_114777_31798' body='&lt;para&gt;Dieser Datentyp dient dazu, einen Bezug zu einem XNachweis-Abruf herzustellen.&lt;/para&gt;'>
