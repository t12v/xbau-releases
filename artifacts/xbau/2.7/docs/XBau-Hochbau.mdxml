				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871239747_665890_22713' name='Verortung'>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871246531_572179_23532' name='Baugrundstueck'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264243_916851_25725' body='&lt;para&gt;Das Baugrundstück ist der Ort der Baumaßnahme. Es kann aus mehreren Grundstücken im Sinne des Grundbuchs bestehen. Ein Grundstück kann aus mehreren Flurstücken bestehen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871246531_572179_23532'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264243_318331_25726' name='grundstueck' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246531_270636_23533'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282186_490391_30948' body='&lt;para&gt;Hier sind in jedem Fall die Angaben zum Flurstück des Vorhabens einzutragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264243_318331_25726'/>
							</ownedComment>
