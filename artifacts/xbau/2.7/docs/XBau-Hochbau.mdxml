							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282527_440370_33649' body='&lt;para&gt;Bezug auf die Anzeige des Bauherrn gegenüber der Gemeinde. Nachricht 0600, auf die die Gemeinde mit dieser Nachricht antwortet.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266242_190567_26863'/>
