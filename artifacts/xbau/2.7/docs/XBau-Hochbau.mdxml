									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_131403da_1623921851310_142689_17506' body='&lt;para&gt;Sofern eine Baugenehmigung beantragt wurde (und der Antragsprozess noch läuft), ist der Wert true anzugeben. Wurde die Baugenehmigung bereits erteilt, ist der Wert false einzutragen. Liegt eine Baugenehmigung nicht (mehr) vor, obwohl das Gebäude bereits errichtet wurde, ist dieses Element nicht zu instantiieren. &lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_131403da_1623921851309_505987_17504'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_131403da_1623921851310_675386_17507'/>
