					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871249396_929148_24266' name='genehmigungsfreistellung.anzeigeBAB.0601'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266243_470793_26866' body='&lt;para&gt;Mit dieser Nachricht unterrichtet die Gemeinde die Bauaufsichtsbehörde über die eingegangene Anzeige der Genehmigungsfreistellung. Erfolgte die Einreichung der Anzeige bei der Bauaufsichtsbehörde, unterrichtet mit dieser Nachricht die Bauaufsichtsbehörde die Gemeinde.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871249396_929148_24266'/>
						</ownedComment>
