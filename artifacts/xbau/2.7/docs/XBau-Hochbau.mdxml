				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_940029b_1662300582178_497392_18262' name='Anzeigen'>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_940029b_1662300598911_76890_18263' name='SachverhaltAbsichtBeseitigung'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598929_261065_18268' body='&lt;para&gt;Hier sind Eckdaten zum Sachverhalt der geplanten Beseitigung anzugeben.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_940029b_1662300598911_76890_18263'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598930_764579_18269' name='bezeichnungDesBauvorhabens' visibility='private'>
							<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598974_156433_18290' body='&lt;para&gt;In dieses Element ist die Bezeichnung des Vorhabens einzutragen. Sie wird vom Bauherrn vergeben und später ggf. von der Bauaufsichtsbehörde geändert.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598930_764579_18269'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598975_954767_18291'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598973_175968_18289' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598933_231927_18270' name='mboGebaeudeklasse' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871239759_272892_22742'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598978_257716_18294' body='&lt;para&gt;In diesem Element wird die Art des Gebäudes übermittelt, das beseitigt werden soll. Es wird die Einteilung in Gebäudeklassen gemäß MBO verwendet.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598933_231927_18270'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598979_809957_18295'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598977_915682_18293' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598936_258576_18271' name='artDerBaulichenAnlage' visibility='private' type='_19_0_3_136d03d4_1611871244699_746777_23393'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598982_840042_18298' body='&lt;para&gt;Hier kann die Art der baulichen Anlage näher spezifiziert werden. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598936_258576_18271'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598983_833662_18299'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598981_668405_18297' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598938_293149_18272' name='grundstueck' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871246531_270636_23533'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598986_449084_18302' body='&lt;para&gt;In diesem Element werden die Grundstücke und die Anschriften der Gebäude übermittelt, die beseitigt werden sollen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598938_293149_18272'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598987_376115_18303' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598985_153574_18301' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598940_152062_18273' name='istFreistehend' visibility='private' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598990_831573_18306' body='&lt;para&gt;Falls das betreffende Gebäude freistehend ist, wird hier &quot;true&quot; eingetragen, andernfalls &quot;false&quot;.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598940_152062_18273'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598991_775065_18307' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598989_678814_18305' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598943_730155_18274' name='hoeheDerBaulichenAnlage' visibility='private' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191855828_468108_1536'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::positiveInteger' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598994_744474_18310' body='&lt;para&gt;Falls die bauliche Anlage eine Höhe von mehr als 10 m hat, ist dieses Element zu übermitteln. Es ist die Höhe in Metern einzutragen (ohne Nachkommastellen). &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598943_730155_18274'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300598994_491600_18311'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598993_643360_18309' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_940029b_1662300598916_548669_18264' name='SachverhaltBaubeginn'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300598953_135609_18278' body='&lt;para&gt;Hier ist genau einer von drei möglichen Sachverhalten anzugeben, die einer Anzeige Baubeginn zu Grunde liegen können (MBO § 72 (6, 8)).&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_940029b_1662300598916_548669_18264'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598954_413344_18279' name='baubeginn' visibility='private' aggregation='composite' type='_19_0_3_940029b_1662300598923_338376_18266' association='_19_0_3_940029b_1662300598952_659898_18277'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300599001_236982_18317' body='&lt;para&gt;Falls die Nachricht dazu dient, den  Baubeginn (Ausführung eines genehmigten Bauvorhabens oder einer zuvor angezeigten Beseitigung) anzuzeigen, dann ist dieses Element zu wählen unter Angabe des Datums des geplanten Baubeginns.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598954_413344_18279'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300599002_500963_18318' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300598999_638154_18316' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598956_775501_18280' name='ausfuehrungBauabschnitt' visibility='private' aggregation='composite' type='_19_0_3_940029b_1662300598926_740778_18267' association='_19_0_3_940029b_1662300598950_855129_18276'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300599005_292339_18321' body='&lt;para&gt;Falls die Nachricht die Aufnahme von Bauarbeiten zur Ausführung eines bestimmten Bauabschnitts anzeigen soll, dann ist dieses Element zu wählen. Zusätzlich sind weitere Angaben zu machen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598956_775501_18280'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300599005_979646_18322' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662300599004_47367_18320' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662300598958_258503_18281' name='wiederaufnahmeBauarbeiten' visibility='private' aggregation='composite' type='_19_0_3_940029b_1662300598923_338376_18266' association='_19_0_3_940029b_1662300598945_517401_18275'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662300599007_606201_18325' body='&lt;para&gt;Falls die Nachricht die Wiederaufnahme von Bauarbeiten anzeigen soll, dann ist dieses Element zu wählen unter Angabe des Datums der geplanten Wiederaufnahme.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1662300598958_258503_18281'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1662300599008_723323_18326' value='1'/>
								</modelExtension>
							</xmi:Extension>
