					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1651603758786_601318_18005' name='baulastenverzeichnis.auskunft.0713'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1651603758787_817072_18006' body='&lt;para&gt;Diese Nachricht liefert die Auskunft aus dem Baulastenverzeichnis.&lt;/para&gt;&#10;&lt;para&gt;Die Nachricht bündelt sowohl alle Negativantworten (es liegt kein berechtigtes Interesse vor), alle positiven Ergebnisse (Information aus dem Baulastenverzeichnis kann abgerufen werden) als auch alle negativen Ergebnisse (Angabe zum Flurstück war nicht korrekt, keine Auskunft möglich).&lt;/para&gt;&#10;&lt;para&gt; Somit erhält der Antragsteller nur eine gebündelte Antwortnachricht.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1651603758786_601318_18005'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1651603758788_670921_18007' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1652254158979_666239_18256' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1652254200182_509000_18257' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Anfrage Bezug zu nehmen, zu der die vorliegende&#10;Nachricht Auskünfte enthält.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1652254158979_666239_18256'/>
							</ownedComment>
