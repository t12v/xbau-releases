						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264202_386808_25548' name='grundstueck' visibility='private' type='_19_0_3_136d03d4_1611871246531_270636_23533'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282134_929862_30490' body='&lt;para&gt;In dieses Element sind die Daten zum Nachbargrundstück einzutragen, das den Eigentümer zum vom Bauvorhaben betroffenen Nachbarn macht. Pro Grundstück ist ein Element zu instanziieren.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264202_386808_25548'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
