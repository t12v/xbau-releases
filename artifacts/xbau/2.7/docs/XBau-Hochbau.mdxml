					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_78d0259_1725449706250_674334_27870' name='informationsempfaenger.benachrichtigungUV.0401'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1725449706251_767656_27874' body='&lt;para&gt;Mit dieser Nachricht übermittelt die Bauaufsichtsbehörde zusammen mit der Erteilung der Baugenehmigung dem zuständigen Unfallversicherungsträger Daten zum Bauvorhaben. Zu den Daten zählen Name und Anschrift des Bauherrn, Ort und Art des Bauvorhabens, Datum des Baubeginns sowie die Höhe der im Baugenehmigungsverfahren angegebenen oder festgestellten Baukosten.&lt;/para&gt;&#10;&lt;para&gt;Weitere nach §195 Absatz 3 SGB VII mitzuteilende Daten wie Geburtsname und Geburtsdatum des Bauherrn werden bis auf Weiteres im Nachgang von der BG Bau beim Bauherren per Fragebogen erfasst.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_78d0259_1725449706250_674334_27870'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
								<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_4_78d0259_1725449706228_985489_27841' name='informationsempfaenger.benachrichtigungBaugenossenschaft.0401' visibility='public' ownerOfDiagram='_19_0_4_78d0259_1725449706250_674334_27870'>
