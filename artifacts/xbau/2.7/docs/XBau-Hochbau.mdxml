						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823370_273297_25561' name='bezug' visibility='private' type='_19_0_4_b6602da_1714115823078_454737_25385'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823572_577063_25956' body='&lt;para&gt;Dieses Element nennt den Vorgang der Bauaufsichtsbehörde, aus dem die Informationen entnommen sind.&#10;Für Zwecke der Bezugnahme auf der Seite der Statistik ist auch die entsprechende Gebäude-UUID und ggf. die Ordnungsnummer der Statistik eingetragen.&#10;Durch die Baubehörde ist die Gebäude-UUID und Ordnungsnummer zu verwenden, die sie im Rahmen der Statistikmeldung Baugenehmigung bereits verwendet hat.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1714115823370_273297_25561'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
