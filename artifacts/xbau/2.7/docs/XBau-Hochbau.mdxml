							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282108_995943_30253' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264185_846422_25455' name='begruendung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282108_107245_30258' body='&lt;para&gt;Hier wird begründet, inwiefern es sich um einen Regelverstoß handelt.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264185_846422_25455'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282109_752514_30259' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282108_436811_30257' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244696_372837_23381' name='BefundlisteMateriell'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264185_231072_25456' body='&lt;para&gt;Eine Instanz dieses Typs steht für eine Befundliste der materiellen Prüfung eines Antrags. Jeder Befund beinhaltet die Parameter, die einen  belastenden Verwaltungsakt im Kontext eines Baugenehmigungsvorgangs definieren. &lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244696_372837_23381'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264185_676888_25457' name='befund' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244696_135967_23380'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282109_290515_30262' body='&lt;para&gt;Jedes Element steht für einen  belastenden Verwaltungsakt im Kontext des aktuellen Baugenehmigungsvorgang, zu dem der Adressat der Nachricht zu einer Stellungnahme aufgefordert ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264185_676888_25457'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282109_675064_30263' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282109_891208_30261' value='*'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244697_819552_23382' name='StellungnahmeBelastenderVerwaltungsakt'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264186_245842_25459' body='&lt;para&gt;Dieser Typ nimmt die Parameter einer Stellungnahme auf, mit der sich ein Antragsteller zu einem  belastenden Verwaltungsakt äußert. &lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244697_819552_23382'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264186_729535_25460' name='bezeichnungRegelverstoss' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_b8702dd_1782126210777_148475_9522'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Basisdatentypen::datatypeCNotBlank' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282110_168908_30266' body='&lt;para&gt;Hier ist die Bezeichnung des betreffenden Regelverstoßes genannt.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264186_729535_25460'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282110_302978_30267' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282110_740895_30265' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264186_393367_25461' name='stellungnahme' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282110_339839_30270' body='&lt;para&gt;Dieses Element enthält die Stellungnahme des Antragsstellers. Sie nimmt auf die Beanstandung Bezug.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264186_393367_25461'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282110_198092_30271' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282110_248779_30269' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244697_588683_23383' name='StellungnahmeStrukturiert'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871264186_827817_25463' body='&lt;para&gt;Dieser Typ beinhaltet die Parameter einer strukturierten Stellungnahme, die die beteiligte Behörde für die Zustellung ihrer Stellungnahme verwenden kann.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871244697_588683_23383'/>
						</ownedComment>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1773066322009_839117_31321' name='sch-bet-001'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1773066535430_993871_31323' body='Wenn der Tenor der Stellungnahme negativ ist, muss eine Begründung angegeben werden.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1773066322009_839117_31321'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1773066322009_613593_31322'>
								<body>not(xbau:tenor/xbau:istZustimmung=&#39;false&#39; and string-length(normalize-space(xbau:begruendung/text))=0)</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1773220194188_397467_31321' name='sch-bet-002'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1773220267673_654227_31323' body='Wenn der Tenor der Stellungnahme positiv ist, aber Nebenbestimmungen genannt werden (d.h. Tenor positiv mit Einschränkungen), muss eine Begründung angegeben werden.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1773220194188_397467_31321'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1773220194188_953158_31322'>
								<body>not((xbau:tenor/xbau:istZustimmung=&#39;true&#39; and xbau:nebenbestimmung) and string-length(normalize-space(xbau:begruendung/text))=0)</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
								<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_4_b8702dd_1784897148406_635305_34709' name='StellungnahmeStrukturiert' visibility='public' ownerOfDiagram='_19_0_3_136d03d4_1611871244697_588683_23383'>
