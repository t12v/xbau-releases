					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b6602da_1714115822005_515055_25227' name='statistik.baugenehmigung.0421'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823191_959775_25432' body='&lt;para&gt;Mittels dieser Nachricht übermittelt die Bauaufsichtsbehörde nach der Genehmigung eines Bauvorhabens dessen statistikrelevante Daten an die amtliche Statistik. Die Nachricht wird nur anlässlich der Bescheidung einer Baugenehmigung gesendet, nicht  bei Teilbaugenehmigung oder Nachtragsbaugenehmigung.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_b6602da_1714115822005_515055_25227'/>
						</ownedComment>
