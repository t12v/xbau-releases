								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282526_316381_33643' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1668598974070_194434_18360' name='anbindungFachverfahren' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668163024704_848043_9712'>
