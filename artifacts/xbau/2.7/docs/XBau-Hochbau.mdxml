						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_b6602da_1689591964100_933861_22123' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1689591964095_827371_22120' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1689591964349_515625_22308' body='&lt;para&gt;Dieses Objekt enthält die Eintragungen, die auf den Vorgang (oder den Antrag) bzw. die Nachricht 0260 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1689591964095_827371_22120'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1689591964350_534642_22309' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1689591964349_340036_22307' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1689591964096_797192_22121' name='bescheid' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244700_476704_23397'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1689591964351_197186_22312' body='&lt;para&gt;In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para&gt;&#10;&lt;para&gt;Ein Bescheid mit positivem Tenor  geht mit zugelassenen Abweichungen (Element abweichung) einher. Nicht zugelassene Abweichungen können nur in einem Bescheid mit negativem Tenor enthalten sein.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1689591964096_797192_22121'/>
							</ownedComment>
