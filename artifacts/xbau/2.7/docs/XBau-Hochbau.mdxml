						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871265764_504492_26734' name='verortungAbbruch' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244693_625845_23369'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282460_104089_33303' body='&lt;para&gt;Übermittlungsanlass Abbruch: Hier werden Daten zum geplanten Abbruch eingetragen, soweit für den vorliegenden Anlass relevant. &lt;/para&gt;&#10;&#10;'>
