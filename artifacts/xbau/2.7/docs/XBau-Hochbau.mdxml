							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1774009364859_13040_31323' body='&lt;para&gt;Dieses Element enthält den &quot;Universally Unique IDentifier (UUID)&quot; des Beteiligungsanliegens. Der UUID ermöglicht es, die Stellungnahme dem Beteiligungsanliegen, auf das sie sich bezieht, eindeutig zuzuordnen.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1774009364851_572925_31321'/>
							</ownedComment>
