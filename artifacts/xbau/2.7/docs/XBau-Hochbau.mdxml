							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1662298632763_988493_18238' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1662301099207_950609_18373' name='sachverhaltBaubeginn' visibility='private' aggregation='composite' type='_19_0_3_940029b_1662300598916_548669_18264'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1662301099216_745288_18375' body='&lt;para&gt;Übermittlungsanlass Baubeginn: Hier kann einer der drei möglichen Sachverhalte zum Baubeginn angegeben werden.&lt;/para&gt;&#10;'>
