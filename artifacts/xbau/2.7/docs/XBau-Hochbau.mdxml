					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871249396_604844_24267' name='genehmigungsfreistellung.ergebnisBAB.0603'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266245_476038_26873' body='&lt;para&gt;Mit dieser Nachricht informiert die Gemeinde die Bauaufsichtsbehörde über das Ergebnis der Prüfung. Mit der Nachricht 0602 hat die Gemeinde auch den Bauherrn benachrichtigt.&lt;/para&gt;&#10;'>
