						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_b6602da_1696230848684_489430_23826' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1696230848678_688929_23820' name='bezug' visibility='private' type='_19_0_4_b6602da_1696231048363_68384_23946'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696230848689_801398_23830' body='&lt;para&gt;Referenz auf ein Vorhaben, ein Bauprojekt bzw. eine Baugenehmigung: abgebildet als Bezug auf einen Vorgang, beispielsweise ein durchlaufenes Baugenehmigungsverfahren mit Bescheid. Der Bescheid kann durch die Übermittlung einer Nachricht baugenehmigung.bescheid.0205 erteilt worden sein. Bei Neubauten sollte die Option &quot;mitAktenzeichen&quot; befüllt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1696230848678_688929_23820'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1696230848691_526302_23831' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1696230848689_734137_23829' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1696234716603_248045_24029' name='erklaerenderErfuellungserklaerung' visibility='private' type='_19_0_4_b6602da_1696234823669_746536_24040'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696234756393_944357_24037' body='&lt;para&gt;Hier sind Angaben zum Erklärenden zu machen.&lt;/para&gt;'>
