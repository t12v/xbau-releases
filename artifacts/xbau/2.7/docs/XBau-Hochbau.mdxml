						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264155_164408_25332' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264377_884091_26498' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282392_254895_32828' body='&lt;para&gt;Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang der Bauaufsichtsbehörde Bezug zu nehmen; außerdem auf die Nachricht 0301, auf die die vorliegende Nachricht antwortet.&lt;/para&gt;&#10;&lt;para&gt;Falls die Nachricht aufgrund einer geänderten Planung ohne vorhergehende Nachricht 0301 eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264377_884091_26498'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282392_891882_32829' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282392_675116_32827' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1697631203944_578700_24747' name='referenzAufforderung' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1697631203965_868250_24749' body='&lt;para&gt;Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Die aufgeforderte Stelle bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1697631203944_578700_24747'/>
							</ownedComment>
