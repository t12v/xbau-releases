					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1707479928197_161613_24611' name='pruefingenieure.mitteilungBaubeginnsanzeige.0508'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1707480516830_575747_24644' body='&lt;para&gt;Mit dieser Nachricht informiert die Bauaufsichtsbehörde den Prüfingenieur über eine eingegangene Anzeige zum Baubeginn und damit über den anstehenden Baubeginn.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_b8702dd_1707479928197_161613_24611'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_b8702dd_1707480241770_434304_24615' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1707480376906_141240_24623' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1707480376909_244093_24627' body='&lt;para&gt;In diesem Element werden Eintragungen vorgenommen, um auf die Baugenehmigung Bezug zu nehmen, die der aktuellen Baumaßnahme zugrunde liegt. Ggf. wird auf die entsprechende XBau-Nachricht zum Bescheid referenziert.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1707480376906_141240_24623'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1707480376909_223623_24628' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1707480376909_821735_24626' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1707480376907_245273_24624' name='sachverhalt' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1707480376909_9524_24631' body='&lt;para&gt;In diesem Element wird der eingetretene Bauzustand erläutert, der angezeigt wurde. Es wird auf entsprechende Termine hingewiesen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1707480376907_245273_24624'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1707480376909_748629_24632' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1707480376909_673052_24630' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1707480376908_755666_24625' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1707480376910_101474_24635' body='&lt;para&gt;Hier können mit der Bauzustandsanzeige eingegangene Bauvorlagen als Anlage beigefügt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1707480376908_755666_24625'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1707480376910_184872_24636'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1707480376910_497730_24634' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
				</packagedElement>
				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871241081_154843_23108' name='Genehmigungsfreistellung'>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_3_136d03d4_1611871242635_429357_23206'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241081_154843_23108'/>
						<supplier xmi:idref='_19_0_3_136d03d4_1611871239053_307374_22661'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871249394_149217_24263' name='genehmigungsfreistellung.anzeige.0600'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266240_303565_26853' body='&lt;para&gt;Mit dieser Nachricht zeigt der Bauherr der Gemeinde (in einigen Ländern der Bauaufsichtsbehörde) wg. möglicher Freistellung von der Genehmigungspflicht sein Vorhaben an. Die Nachricht enthält die einschlägigen Daten zum Vorhaben, ergänzend dokumentiert durch Unterlagen, die Bauvorlagen entsprechen sowie sonstige Unterlagen.&lt;/para&gt;&#10;&#10;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871249394_149217_24263'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 19.0'>
							<modelExtension>
								<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_3_129a03b9_1669369541245_751094_21277' name='genehmigungsfreistellung.anzeige.0600' visibility='public' ownerOfDiagram='_19_0_3_136d03d4_1611871249394_149217_24263'>
