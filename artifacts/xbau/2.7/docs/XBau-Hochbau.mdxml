								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1695991441155_303690_23704' name='rechtshelfsbelehrung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1695991441156_438556_23707' body='&lt;para&gt;Hier werden die Rechtshelfsbelehrungen zur Untersagung gegeben.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1695991441155_303690_23704'/>
							</ownedComment>
