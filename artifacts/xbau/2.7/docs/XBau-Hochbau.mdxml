							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282105_849688_30238' body='&lt;para&gt;Hier wird die Bezeichnung der referenzierten Bauvorlage angegeben.&lt;/para&gt;&#10;'>
