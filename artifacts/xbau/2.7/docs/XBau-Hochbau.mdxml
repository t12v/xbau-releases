					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1655369468674_518134_18410' name='baulastenverzeichnis.formellePruefung.0711'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1655369468680_503923_18411' body='&lt;para&gt;Diese Nachricht bezieht sich auf eine bereits gestellte Anfrage auf Baulastauskunft. Enthalten sind hier die Ergebnisse der formellen Prüfung (Befunde) sowie eine Frist, innerhalb derer der Antragsteller die Anfrage auf Baulastauskunft anzupassen hat, falls in der formellen Prüfung Mängel festgestellt wurden. &#10;&lt;/para&gt;&#10;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1655369468674_518134_18410'/>
						</ownedComment>
