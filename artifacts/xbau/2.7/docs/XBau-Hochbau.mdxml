							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282330_143675_32260' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264335_833367_26179' name='ausland' visibility='private' type='_19_0_3_136d03d4_1611871246574_62237_23650'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282330_911858_32265' body='&lt;para&gt;Falls die Person nicht im Inland niedergelassen ist, sind hier Angaben zur Niederlassung im Ausland einzutragen.&lt;/para&gt;&#10;&#10;'>
