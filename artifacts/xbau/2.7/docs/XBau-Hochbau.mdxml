						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264398_978225_26588' name='aufforderungZurStellungnahme' visibility='private' aggregation='composite'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282422_292048_33090' body='&lt;para&gt;Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264398_978225_26588'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
