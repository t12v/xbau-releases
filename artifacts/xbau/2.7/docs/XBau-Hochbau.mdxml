							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282515_826559_33585' name='bauwerksklasse' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871239750_794560_22722' association='_19_0_3_136d03d4_1611871266235_52004_26839'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283332_538909_36917' body='&lt;para&gt;Hier ist die Bauwerksklasse abgebildet, die dem Bauvorhaben zugeordnet werden kann.&lt;/para&gt;'>
