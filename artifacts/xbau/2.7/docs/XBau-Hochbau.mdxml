					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1652711472496_341236_18039' name='Anonym_Einwilligung'>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1652858745604_921538_18070' name='einwilligungOeffentlicheBekanntmachung' visibility='private' isReadOnly='true' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1652858745618_891526_18072' body='&lt;para&gt;Falls allgemein eingewilligt wird, das Bauvorhaben öffentlich bekannt zu machen, ist in diesem Element &quot;true&quot; zu übermitteln.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1652858745604_921538_18070'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1652858745620_225227_18073' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1652858745618_709480_18071' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_19_0_3_136d03d4_1652858745621_119551_18074' value='true'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1652712257082_268784_18047' name='einwilligungOeffentlicheBekanntmachungArt' visibility='private' type='_19_0_3_136d03d4_1652712313339_558262_18051'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1652712281039_526022_18048' body='&lt;para&gt;Falls eingewilligt wird, das Bauvorhaben über konkret definierte Medien öffentlich bekannt zu machen, sind in&#10;diesem Element diese Medien zu spezifizieren.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1652712257082_268784_18047'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1652712288177_992368_18049' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1652712288177_610048_18050' value='*'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_129a03b9_1660667455391_257345_18239' name='ZweckDerNutzungsaenderung'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1664552169948_760818_18223' body='&lt;para&gt;Wenn das Bauvorhaben eine Nutzungsänderung der baulichen Anlage beabsichtigt, ist in diesem Feld die bisherige und die beabsichtigte Nutzung der baulichen Anlage anzugeben. Es ist jeweils aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_129a03b9_1660667455391_257345_18239'/>
						</ownedComment>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1660667485120_33884_18240' name='bisherigeNutzung' visibility='private' type='_19_0_3_136d03d4_1611871244699_746777_23393'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1660668727411_288956_18248' body='&lt;para&gt;Um den Zweck der Nutzungsänderung näher zu spezifizieren, ist hier die bisherige Nutzung des Gegenstandes vom Bauvorhaben anzugeben. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1660667485120_33884_18240'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1664551514886_353394_18218' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1664551514887_306352_18219' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1660667568369_712376_18241' name='beabsichtigteNutzung' visibility='private' type='_19_0_3_136d03d4_1611871244699_746777_23393'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1660668983825_379465_18249' body='&lt;para&gt;Um den Zweck der Nutzungsänderung näher zu spezifizieren, ist hier die beabsichtigte  Nutzung des Gegenstandes vom Bauvorhaben anzugegeben. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1660667568369_712376_18241'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1664551531880_499981_18220' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1664551531880_991482_18221' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_129a03b9_1666180418426_300417_18601' name='Anonym_Baudenkmal'>
