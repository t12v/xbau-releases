							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1655649450165_754718_18185'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1655649450174_343666_18186' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1639993391401_370801_17826' name='istReferenzgebaeude' visibility='private' isReadOnly='true' aggregation='composite'>
							<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191716468_578747_1004'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='W3C Data Types::boolean' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1639993391412_581834_17828' body='&lt;para&gt;Durch die Übermittlung dieses Elements (enthält, falls vorhanden, den Wert true) wird mitgeteilt, dass der Gegenstand des vorliegenden Antragsverfahrens als Referenzgebäude markiert werden soll, so dass in zukünftigen Anträgen oder Anzeigen Bezug auf diesen genommen werden kann.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1639993391401_370801_17826'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1639993391413_113514_17829'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1639993391412_663363_17827' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_19_0_3_c4f030d_1639993447341_507129_17833' value='true'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_c4f030d_1639995085238_636536_17853' name='referenzgebaeude' visibility='private' aggregation='composite' type='_19_0_3_c4f030d_1639993698856_4870_17834'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_c4f030d_1639995085241_459699_17855' body='&lt;para&gt;Im Rahmen eines referenziellen Baugenehmigungsverfahrens sind in dieses Element Angaben einzutragen, die auf das Referenzgebäude (und den entsprechenden durchgeführten Vorgang) verweisen.&lt;/para&gt;&#10;&#10;&lt;para&gt;Dieses Element muss verwendet werden, wenn das Attribut &quot;verfahrensart&quot; den Code &quot;Referenzielles Baugenehmigungsverfahren&quot; enthält.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_c4f030d_1639995085238_636536_17853'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_c4f030d_1639995085241_10054_17856'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_c4f030d_1639995085240_555990_17854' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244702_221674_23404' name='Anonym_NachbarbeteiligungForm'>
