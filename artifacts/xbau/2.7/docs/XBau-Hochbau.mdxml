									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282504_530735_33511' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266228_401631_26811' name='rahmendatenGebuehrenberechnung' visibility='private' type='_19_0_3_136d03d4_1611871266233_668239_26835'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282505_177020_33516' body='&lt;para&gt;Hier können die ggf. korrigierten Rahmendaten zur Gebührenberechnung eingetragen werden.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266228_401631_26811'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282505_103474_33517'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282505_999096_33515' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266229_419288_26812' name='bauvorhaben' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244694_158760_23371'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282505_880399_33520' body='&lt;para&gt;Hier werden angepasste Daten zum Bauvorhaben (Wer, Was, Wo) eingetragen, falls eine solche Anpassung in einem Bereich notwendig war (Bruttoprinzip).&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266229_419288_26812'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282505_248285_33521'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282505_71382_33519' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266229_872941_26813' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282506_273734_33524' body='&lt;para&gt;Hier können korrigierte bzw. ergänzte Unterlagen, die für die Erfüllung des Prüfauftrags benötigt werden, eingetragen werden.&lt;/para&gt;&#10;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266229_872941_26813'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282506_363298_33525'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282506_875848_33523' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248926_858201_24234' name='pruefingenieure.formellePruefung.0502'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266229_450587_26815' body='&lt;para&gt;Diese Nachricht nennt Mängel bzw. Nachbesserungsbedarf zu einem erteilten Prüfauftrag bzw. fordert Dokumentation im Rahmen der formellen Prüfung des Auftrags nach.&lt;/para&gt;&#10;&lt;para&gt;&#10;Sie kann auch verwendet werden, um weitere Informationen nachzufordern, die für die Entscheidung über die Annahme des Prüfauftrags benötigt werden.&#10;&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248926_858201_24234'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264155_156626_25330' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266229_83324_26816' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282506_716510_33529' body='&lt;para&gt;Hier trägt der Auftragnehmer die Vorgangsnummer der Bauaufsichtsbehörde ein, die ihm mit der Beauftragung (Nachricht 0500) zugestellt wurde. Außerdem wird die Referenz auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; eingetragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266229_83324_26816'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282506_911702_33530' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282506_544568_33528' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266230_31751_26817' name='befundliste' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871244695_592401_23378'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282507_524616_33533' body='&lt;para&gt;Nach der Prüfung des Auftrags durch den Auftragnehmer: Hier sind die Ergebnisse der formellen Prüfung als Befundliste enthalten. Für jeden Befund sind die entsprechenden Parameter gefüllt, die Inhalt und Bezug des Befundes nachvollziehbar machen.&lt;/para&gt;&#10;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266230_31751_26817'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282507_716967_33534' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282507_356016_33532' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1701418633368_370081_24763' name='referenzPruefauftrag' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1701418633369_682123_24765' body='&lt;para&gt;Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#13;&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1701418633368_370081_24763'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1701418633369_205243_24766' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1701418633369_743059_24764' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248927_787955_24235' name='pruefingenieure.pruefbericht.0506'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266230_821468_26819' body='&lt;para&gt;Diese Nachricht nennt die Ergebnisse der Prüfung bautechnische Nachweise oder Aktivitäten im Rahmen der Prüfung bautechnischer Nachweise oder der Bauüberwachung.&lt;/para&gt;&#10;&#10;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248927_787955_24235'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_78d0259_1737986911579_82977_29293' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734016949_873958_29303' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734016963_452237_29307' body='&lt;para&gt;Hier trägt der Auftragnehmer die Vorgangsnummer der Bauaufsichtsbehörde ein, die ihm mit der Beauftragung zugestellt wurde. Außerdem wird die Referenz auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; eingetragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734016949_873958_29303'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734016965_693034_29308' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734016961_584548_29306' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734016958_524840_29304' name='anlagen' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734016971_220799_29311' body='&lt;para&gt;Hier sind, soweit zutreffend, weitere Anlagen zu dem Prüfbericht als Verlinkung mittels URI angefügt. Die Verlinkung lässt sich manuell und maschinell verarbeiten.&lt;/para&gt;&#10;&lt;para&gt;Die Verlinkung verweist immer auf &lt;emphasis&gt;https://docs.bvpi-elba.de&lt;/emphasis&gt;. Die Verlinkung wird mit geeigneten Mitteln abgesichert. Eine Beschreibung der Zugriffe und der API steht unter &lt;emphasis&gt;https://docs.bvpi-elba.de/api&lt;/emphasis&gt; zur Verfügung.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734016958_524840_29304'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734016971_533803_29312'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734016970_98447_29310' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1730734016960_962532_29305' name='pruefbericht' visibility='private' aggregation='composite' type='_19_0_3_136d03d4_1611871266233_851019_26833'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_78d0259_1730734016972_358858_29315' body='&lt;para&gt;In diesem Element werden die Prüfergebnisse dargestellt und durch Nebensbestimmungen und Anmerkungen ergänzt.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_78d0259_1730734016960_962532_29305'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1730734016972_959297_29316' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1730734016972_718525_29314' value='*'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871248927_126690_24237' name='pruefingenieure.auftragsbestaetigung.0501'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871266232_857204_26829' body='&lt;para&gt;Der Prüfingenieur bestätigt  mit dieser Nachricht den Erhalt des Auftrags nebst der Tatsache der Auftragsannahme oder -ablehnung.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871248927_126690_24237'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264155_26977_25334' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266232_760613_26830' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282510_676807_33564' body='&lt;para&gt;Dieses Elements stellt den Bezug zum erteilten Auftrag (Vorgangsnummer) und zur entsprechenden &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;&gt;Nachricht 0500&lt;/link&gt; her. Dieser Auftrag wird mit dieser Nachricht bestätigt.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266232_760613_26830'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282511_615476_33565' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282510_971380_33563' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1701418396307_594855_24756' name='referenzPruefauftrag' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1701418396311_53932_24758' body='&lt;para&gt;Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#13;&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1701418396307_594855_24756'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1701418396311_127888_24759' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1701418396311_638148_24757' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_78d0259_1727689592639_389276_28729' name='auftragSachverhalt' visibility='private' type='_19_0_4_78d0259_1727689287249_421469_28720'>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_78d0259_1727689651601_489133_28731' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_78d0259_1727689651615_98895_28732' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871248928_855819_24238' name='Datentypen'>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266232_637340_26832' name='Anonym_Pruefauftrag'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282511_332860_33568'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266232_637340_26832'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<ownedDiagram xmi:type='uml:Diagram' xmi:id='_19_0_4_b6602da_1697457483417_766073_24789' name='Anonym_Pruefauftrag' visibility='public' ownerOfDiagram='_19_0_3_136d03d4_1611871266232_637340_26832'>
