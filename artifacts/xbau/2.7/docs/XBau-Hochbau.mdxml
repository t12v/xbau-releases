						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1721641481684_41681_26082' name='voraussichtlicheFertigstellung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1684499176991_74723_8754'>
