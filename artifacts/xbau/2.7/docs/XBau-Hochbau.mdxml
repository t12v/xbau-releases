								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283331_717623_36909' body='&lt;para&gt;Gebührenberechnung nach Herstellungskosten: Prognostizierte Herstellungskosten des Bauvorhabens in Eurocent.&lt;/para&gt;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282514_397258_33581'/>
								</ownedComment>
