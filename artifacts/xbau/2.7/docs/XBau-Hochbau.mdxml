							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1696422846399_677020_24563' body='&lt;para&gt;Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass zur Erfüllung der Anforderungen eine Dokumentation mittels Energieausweis genutzt werden. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&#10;&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1696422846390_166645_24535'/>
