								</modelExtension>
							</xmi:Extension>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282186_961821_30947' value='*'/>
						</ownedAttribute>
					</packagedElement>
