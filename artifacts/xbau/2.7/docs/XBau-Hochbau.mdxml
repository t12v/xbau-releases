							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1723793408825_189825_26481' name='artDesNichtwohngebaeudes' visibility='private' type='_19_0_3_136d03d4_1611871239790_196517_22867'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1723793408838_757485_26507' body='&lt;para&gt;Bauliche Anlagen, die nicht Wohngebäude sind, werden durch dieses Element klassifiziert gemäß Signierschlüsselverzeichnis des Statistischen Bundesamts.&lt;/para&gt;&#10;&#10;'>
