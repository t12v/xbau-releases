						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1726566054562_38093_28008' name='allgemeineAngaben' visibility='private' aggregation='composite' type='_19_0_4_b6602da_1726566387590_811697_28116'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726566054587_8721_28019' body='&lt;para&gt;Dieses Element enthält grundlegende Angaben zum Bauvorhaben.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1726566054562_38093_28008'/>
