						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264186_198174_25464' name='tenor' visibility='private' type='_19_0_3_136d03d4_1611871244700_835390_23398'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282111_920598_30274' body='&lt;para&gt;Hier wird der Tenor der Stellungnahme formuliert. Handelt es sich um eine Zustimmung, kann diese mit oder ohne Nebenbestimmung zugestellt werden. Falls eine Abweichungsentscheidung in diesem Fall vorliegt, kann diese positiv oder negativ ausfallen.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264186_198174_25464'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282111_483297_30275' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282111_716713_30273' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264187_273175_25465' name='rechtsbereich' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_4_78d0259_1728567535312_938846_10185'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Codes::Code.Rechtsbereich' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282111_259843_30278' body='&lt;para&gt;Dieses Element nennt den Rechtsbereich, innerhalb dessen die Stellungnahme zugestellt wird.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264187_273175_25465'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282111_143768_30279' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282111_97894_30277' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264187_131470_25466' name='abweichung' visibility='private' type='_19_0_3_136d03d4_1611871244698_52288_23387'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282112_525193_30282' body='&lt;para&gt;Hier werden ggf. die Erläuterungen zur Stellungnahme geliefert, die eine beantragte Abweichung betreffen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264187_131470_25466'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282112_153897_30283'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282112_587059_30281' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264187_524856_25467' name='nebenbestimmung' visibility='private' type='_19_0_3_136d03d4_1611871244698_632785_23388'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282112_82974_30286' body='&lt;para&gt;Hier werden ggf. Nebenbestimmungen zur Stellungnahme eingefügt. Falls Nebenbestimmungen angegeben werden, gilt das Ergebnis der Stellungnahme als &quot;positiv mit Einschränkungen&quot;.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264187_524856_25467'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282112_692948_30287'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282112_759591_30285' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264187_904203_25468' name='begruendung' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282113_641833_30290' body='&lt;para&gt;Falls die Stellungnahme nicht zustimmend ausgefallen ist, oder falls unter Angabe von Nebenbestimmungen zugestimmt wurde, muss in diesem Element die entsprechende Begründung geliefert werden.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264187_904203_25468'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282113_57100_30291'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282112_159679_30289' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264188_686414_25469' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282113_718836_30294' body='&lt;para&gt;Die für das Verständnis der Stellungnahme notwendigen Bauvorlagen werden in diesem Objekt eingefügt. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264188_686414_25469'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282113_1554_30295'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282113_848075_30293' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1784897276148_30672_34805' name='gegenstand' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1784898280448_112534_34831' body='&lt;para&gt;In dieses Element können fachrechtlich zu erteilende Genehmigungen, Bewilligungen, Erlaubnisse oder Gestattungen der zuständig beteiligten Dienststelle eingetragen werden. Diese können dadurch bei konzentrierten Genehmigungsverfahren in einem einheitlichen Verwaltungsakt zusammenfasst werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1784897276148_30672_34805'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1784897359243_328944_34814'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1784897359243_458361_34815' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1784897289366_683810_34808' name='stellungnahme' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1784897674981_56408_34829' body='&lt;para&gt;In diesem Element können bei der Beteiligung sachverständiger Stellen Angaben zur Nachvollziehbarkeit der Entscheidung gemacht oder fachliche Einschätzungen zu einem Sachverhalt erläutert werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1784897289366_683810_34808'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1784897361560_695019_34816'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1784897361560_259289_34817' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1784897300297_560118_34811' name='zustaendigeStelle' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535726187446_656135_10650'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::TextFormatiert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1784897895281_502645_34830' body='&lt;para&gt;In diesem Element können Kontaktdaten der für die Überwachung zuständigen Stelle gemacht werden. Diese können zur Kontaktaufnahme bezüglich der Auflagen und Hinweise des jeweiligen Fachbereichs dienen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1784897300297_560118_34811'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1784897363770_534689_34818'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1784897363770_696426_34819' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871244697_801218_23384' name='Anonym_TenorBescheid'>
