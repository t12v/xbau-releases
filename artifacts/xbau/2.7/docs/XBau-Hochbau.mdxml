					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b6602da_1747990674681_205770_30073' name='bauzustand.aeusserung.0923'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1747990674725_485812_30074' body='&lt;para&gt;Der Bauherr äußert sich zu den mitgeteilten Ausführungsmängeln (Nachricht 0921) und erhofft im Anschluss die Freigabe des Bauzustands (Nachricht 0922).&#10;&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_4_b6602da_1747990674681_205770_30073'/>
						</ownedComment>
						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_4_b6602da_1747990674732_207619_30078' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
