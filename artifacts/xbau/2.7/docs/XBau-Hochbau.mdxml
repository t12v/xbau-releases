						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_129a03b9_1708002012714_381489_24685' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1708002012713_346579_24683' name='referenzAufforderung' visibility='private' type='_19_0_4_b6602da_1697611488329_265944_24730'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1708002012715_489243_24693' body='&lt;para&gt;Eine eindeutige Kennung des Akteneinsichtvorgangs. Die zu beteiligende Partei bezieht sich in ihren Reaktionsnachrichten auf diese Kennung. Die Kennung ist in der Regel in dem Brief zu finden, mit dem der Empfänger zur Beteiligung zugelassen oder aufgefordert  wurde.  &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1708002012713_346579_24683'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1708002012716_469388_24694' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1708002012715_223372_24692' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1709042156626_206079_24927' name='stellungnahme' visibility='private' aggregation='composite' type='_19_0_3_129a03b9_1708002949618_225493_24878'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1709042156629_727652_24931' body='&lt;para&gt;Unterhalb dieses Elements ist die Stellungnahme eingefügt, die aus der Einsichtnahme durch die beteiligte Partei hervorgegangen ist.&lt;/para&gt;&#10;&lt;para&gt;Um hier eine strukturierte Stellungnahme einzutragen, ist eine bestimmte Form bei der Dokumentation der Stellungnahme einzuhalten. Es sind die Parameter dieses Objekts zu füllen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1709042156626_206079_24927'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1709042156630_90136_24932' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_129a03b9_1709042156629_905462_24930' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_129a03b9_1715350109743_568053_25869' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1715350109744_287884_25871' body='&lt;para&gt;Die für das Verständnis der Stellungnahme notwendigen Bauvorlagen werden in diesem Objekt eingefügt. &lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1715350109743_568053_25869'/>
							</ownedComment>
