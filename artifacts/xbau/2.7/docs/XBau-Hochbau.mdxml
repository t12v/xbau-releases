							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726566054581_280690_28015' body='&lt;para&gt;Dieses Element nennt die Vorgangsnummer der Bauaufsichtsbehörde, unter der sie das Bauvorhaben prüft. Oder die referenzAntragsservice, unter der der Genehmigungsantrag vom Bauvorhaben eingereicht worden ist.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1726566054556_548957_28007'/>
							</ownedComment>
