	<XOEV_Profil:xsdNamedType xmi:id='_19_0_3_136d03d4_1611871264161_394265_25367' base_Classifier='_19_0_3_136d03d4_1611871243169_203077_23290'/>
	<XOEV_Profil:xoevBBIE xmi:id='_19_0_3_136d03d4_1611871282069_248992_29961' base_Property='_19_0_3_136d03d4_1611871264145_979204_25265' Abweichung='Strukturelle Zusammenfassung' MotivationDerAbweichung='Die eID führt gemäß BSI TR-03110 Advanced Security Mechanisms for Machine Readable Travel Documents and eIDAS token die Straße und Hausnummer in einem einzigen Feld „street“. Für die Übertragung von Anschriftsdaten nach Verwendung der eID-Funktion des neuen Personalausweises können Straße und Hausnummer nicht allgemeingültig getrennt werden. Für die Übernahme der Daten wird daher ein gemeinsames Feld benötigt. &#10;&#10;'/>
