					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b6602da_1697458158172_128624_24868'>
						<client xmi:idref='_19_0_3_136d03d4_1611871241080_104258_23107'/>
						<supplier href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1664881730536_329586_6881'>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Basisnachricht::qualified::G2G::1.1' referentType='Package'/>
