					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b6602da_1714115823090_237240_25389' name='Nutzflaechen'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823515_593668_25761' body='&lt;para&gt;Daten zu Flächen gemäß Wohnflächenverordnung (Verordnung zur Berechnung der Wohnfläche). Bei Baumaßnahmen am Bestand ist ebenfalls nutzflaecheAlt zu übermitteln.&lt;/para&gt;'>
