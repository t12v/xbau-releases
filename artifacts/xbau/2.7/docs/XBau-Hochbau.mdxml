						<generalization xmi:type='uml:Generalization' xmi:id='_19_0_3_136d03d4_1611871264154_80902_25318' general='_19_0_3_136d03d4_1611871243167_733539_23288'/>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266698_183300_27045' name='bezug' visibility='private'>
							<type href='XBau-kernmodul.mdxml#_19_0_3_129a03b9_1668162628374_570793_9692'>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::BezugErweitert' referentType='Class'/>
								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282584_71054_34062' body='&lt;para&gt;In diesem Objekt werden Eintragungen vorgenommen, um auf die Anfrage Bezug zu nehmen, zu der die vorliegende Nachricht Auskünfte enthält.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266698_183300_27045'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282584_56824_34063' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282584_536432_34061' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266698_319591_27046' name='angabenAnfrage' visibility='private' aggregation='composite' type='_19_0_4_b6602da_1728384229446_765580_29301'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282585_567581_34066' body='&lt;para&gt;Hier sind die Merkmale einzutragen, die in der korrespondierenden Anfrage übermittelt wurden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266698_319591_27046'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282585_777615_34067' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282585_772001_34065' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871266699_361432_27047' name='auskunftKammernverzeichnis' visibility='private' isReadOnly='true' aggregation='composite' type='_19_0_3_136d03d4_1611871266699_712869_27049'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282585_731383_34070' body='&lt;para&gt;In einer Instanz dieses Elements werden die Daten aus dem angefragten Kammernverzeichnis zur Person mit der angefragten Mitgliedsnummer,  Personennummer oder Namen übermittelt.&lt;/para&gt;&#10;&lt;para&gt;Ein Fehlen dieses Elements zeigt an, dass die Anfrage korrekt bearbeitet werden konnte, das angefragte Kammernverzeichnis zu den übermittelten Merkmalen aber keinen Eintrag enthält (es wird keine Person mit der angegebenen Mitgliedsnummer, Personennummer oder Namen geführt).&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266699_361432_27047'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282585_697740_34071'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282585_210324_34069' value='*'/>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1752481429820_291554_31041' name='anlagen' visibility='private' type='_19_0_3_136d03d4_1616753758357_771153_16737'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1752481717372_439257_31047' body='&lt;para&gt;Wurden die Informationen aus dem Kammernverzeichnis per automatisiertem Nachweisabruf bereitgestellt, kann hier die XNachweis-Datei beigefügt werden.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1752481429820_291554_31041'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1752481668013_701141_31045'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1752481668013_828143_31046' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_136d03d4_1611871249414_812689_24308' name='Datentypen'>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_136d03d4_1611871266699_712869_27049' name='Anonym_Auskunft'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282586_844939_34074' body='&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266699_712869_27049'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282586_390174_34075' name='name' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_16_5_4_8a30247_1422955073653_603895_5103'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::fachuebergrBausteine::NameNatuerlichePerson' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283374_407188_37209' body='&lt;para&gt;Namensangaben zur angefragten Person&lt;/para&gt;&#10;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282586_390174_34075'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283374_319458_37210' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283373_804250_37208' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282586_15058_34076' name='nummernKammernverzeichnis' visibility='private' type='_19_0_3_940029b_1669717113595_748613_21898'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283374_692400_37213' body='&lt;para&gt;In diesem Objekt werden die im Datensatz im Kammernverzeichnis gespeicherten Nummern zur angefragten Person übermittelt. Zu Personen, die laut Verzeichnis mehrere Personennummern habe, können diese alle in einer Ergebnisnachricht übermittelt werden.&lt;/para&gt;&#10;&lt;para&gt;Wenn die vorliegende Nachrichteninstanz Daten aus einem Kammernverzeichnis liefert, dann muss dieses Objekt gefüllt sein. Es sind die gespeicherten Nummern zu übermitteln&lt;/para&gt;&#10;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282586_15058_34076'/>
								</ownedComment>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283374_703201_37214' value='1'/>
									</modelExtension>
								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283374_866296_37212' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282587_407735_34077' name='berufsbezeichnung' visibility='private'>
								<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283375_275540_37217' body='&lt;para&gt;Angaben zur Berufsbezeichnung (Architekt, Stadtplaner usw.). Pro Angabe ist ein separates Element zu instantiieren.&lt;/para&gt;&#10;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282587_407735_34077'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283375_515008_37218'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283375_730657_37216' value='*'/>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871282587_373830_34078' name='nachweisBerechtigung' visibility='private'>
								<type href='XBau-kernmodul.mdxml#_18_0_2_940029b_1535727067041_864259_10734'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XBau-Kernmodul::XBau-Kernmodul::Datentypen::TextUndBezug::Text' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871283375_157183_37221' body='&lt;para&gt;Angaben zu Nachweis und Prüfberechtigung.&lt;/para&gt;&#10;&lt;para&gt;Pro Angabe ist ein separates Element zu befüllen.&lt;/para&gt;&#10;&#10;'>
									<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871282587_373830_34078'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871283375_549248_37222'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871283375_350635_37220' value='*'/>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1752481090355_864718_30967' name='sperrung' visibility='private' type='_19_0_4_b8702dd_1752480895187_569505_30955'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1752481188384_441564_30971' body='&lt;para&gt;Falls Informationen über eine Sperrung im Kammernverzeichnis vorliegen (z.B. aufgrund von entzogener Bauvorlageberechtigung, Disziplinarmaßnahmen, Ablauf der Registrierung, fehlenden Nachweisen), können diese hier angegeben werden.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b8702dd_1752481090355_864718_30967'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1752481090356_190459_30969'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1752481090356_376104_30968' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b8702dd_1758112752647_137245_31569' name='status' visibility='private'>
								<type href='XOEV-Bibliothek.mdxml#_19_0_4_41901a4_1659506109571_319729_6731'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='Externe Modelle::XOEV-Bibliothek::XOEV-Datentypen::Teilmengen der in Unicode enthaltenen Zeichen::DIN 91379::2022-08::datatypeC' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1758113066692_163347_31572' body='&lt;para&gt;Zur detaillierten Beurteilung der Bauvorlageberechtigung durch die Bauaufsicht kann hier der Status der Person, z.B. selbständig oder angestellt bei einer Behörde, übermittelt werden.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b8702dd_1758112752647_137245_31569'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b8702dd_1758113014781_879108_31570'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b8702dd_1758113014781_946939_31571' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
						</packagedElement>
						<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_940029b_1669717113595_748613_21898' name='Anonym_AuskunftKammerneintrag'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1669717113601_570972_21899'>
								<annotatedElement xmi:idref='_19_0_3_940029b_1669717113595_748613_21898'/>
							</ownedComment>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1669717113601_938488_21900' name='mitgliedsnummer' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191873500_204582_1633'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::token' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1669717113605_98574_21905' body='&lt;para&gt;Dieses Elements übermittelt die Mitgliedsnummer aus dem Kammernverzeichnis.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_940029b_1669717113601_938488_21900'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1669717113605_883436_21906'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1669717113604_615603_21904' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_940029b_1669717113602_678008_21901' name='personennummer' visibility='private'>
								<type href='XOEV-Profil.mdxml#_14_0_1_6370212_1218191873500_204582_1633'>
									<xmi:Extension extender='MagicDraw UML 19.0'>
										<referenceExtension referentPath='W3C Data Types::token' referentType='Class'/>
									</xmi:Extension>
								</type>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_940029b_1669717113606_521680_21909' body='&lt;para&gt;Dieses Element wird instantiiert, wenn im Kammerverzeichnis gespeicherte Personennummern für Nichtmitglieder übermittelt werden sollen.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_3_940029b_1669717113602_678008_21901'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_940029b_1669717113607_982047_21910'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_940029b_1669717113606_220370_21908' value='*'/>
							</ownedAttribute>
