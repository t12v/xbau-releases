								</xmi:Extension>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1725527109351_165987_27254' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823430_704103_25638' name='beteiligteBauprojekt' visibility='private' aggregation='composite' type='_19_0_4_b6602da_1714115823067_394992_25381'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823583_361948_26041' body='&lt;para&gt;In diesem Element werden Daten zu den beteiligten Personen übermittelt, soweit für die Anlässe relevant. &lt;/para&gt;&#10;&lt;para&gt;Der Inhalt des Elements &quot;bauherr&quot; ergibt sich aus dem Datentyp BeteiligteBauprojekt oder BeteiligteBauprojektStatistik der Eingangsnachricht.&lt;/para&gt;&#10;&lt;para&gt;Der Inhalt des Elements &quot;grundstueckseigentuemer&quot; ergibt sich aus dem Inhalt des Elements &quot;beteiligter&quot; im Datentyp WeitereBeteiligte (falls der Inhalt des Elements &quot;rolle&quot; im Datentyp WeitereBeteiligte gleich 02 Grundstückseigentümer ist) oder aus dem Datentyp BeteiligteBauprojektStatistik der Eingangsnachricht.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1714115823430_704103_25638'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1714115823583_137367_26042'/>
								<xmi:Extension extender='MagicDraw UML 19.0'>
									<modelExtension>
										<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1714115823583_74675_26040' value='1'/>
									</modelExtension>
								</xmi:Extension>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823431_196645_25639' name='baugrundstueck' visibility='private' aggregation='composite' type='_19_0_4_b6602da_1721639026632_995350_25901'>
								<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1714115823583_774322_26045' body='&lt;para&gt;Hier werden Daten zum Baugrundstück übermittelt, soweit für die Anlässe relevant. &lt;/para&gt;&#10;&lt;para&gt;Der Inhalt der Kindelemente ergibt sich aus dem Datentyp Grundstueck, GrundstueckStatistik oder DatenBauabgangBeseitigungAbsicht der Eingangsnachricht.&lt;/para&gt;'>
									<annotatedElement xmi:idref='_19_0_4_b6602da_1714115823431_196645_25639'/>
								</ownedComment>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1714115823583_478000_26046'/>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1714115823583_793987_26044' value='*'/>
							</ownedAttribute>
							<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1714115823431_569130_25640' name='lageGebaeude' visibility='private' aggregation='composite'>
								<type href='XBau-kernmodul.mdxml#_16_5_4_940029b_1460651165974_293124_3777'>
