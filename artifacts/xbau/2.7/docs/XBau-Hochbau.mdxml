								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1726570818336_850331_28295' name='bauvorhabenGebaeude' visibility='private' type='_19_0_4_b6602da_1726570890090_615170_28297'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726571114062_355394_28376' body='&lt;para&gt;Dieses Element enthält detaillierte Daten zu den einzelnen Gebäuden des Bauvorhabens.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1726570818336_850331_28295'/>
							</ownedComment>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1726571034747_826695_28374' value='1'/>
								</modelExtension>
							</xmi:Extension>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1726571034749_542686_28375' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_4_b6602da_1726566054568_342532_28010' name='ansprechpartner' visibility='private' aggregation='composite' type='_19_0_4_b8702dd_1760601420782_168778_31690'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b6602da_1726566054593_943827_28027' body='&lt;para&gt;Unterhalb dieses Elements werden Angaben zu einem Ansprechpartner des Bauvorhabens für Rückfragen der Statistik eingetragen.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_4_b6602da_1726566054568_342532_28010'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_4_b6602da_1726566054595_891011_28028'/>
							<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_4_b6602da_1726566054592_434718_28026' value='*'/>
						</ownedAttribute>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1754476447533_61486_31262' name='ruleset.statistik.01'>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753707792092_56879_31642' name='sch-stat-006'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753707792093_872691_31646' body='Die angegebene Anzahl Vollgeschosse überschreitet den Maximalwert drei, der für Wohngebäude mit nur einer Wohnung zulässig ist.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753707792092_56879_31642'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753707792093_827135_31645'>
								<body>if (exists(xbau:anzahlVollgeschosse) and xbau:angabenGebaeude/xbau:artDesWohngebaeudes/code = (&#39;1&#39;,&#39;2&#39;) and  xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = (&#39;1&#39;,&#39;2&#39;) and xbau:anzahlDerWohnungen/xbau:gesamtanzahlWohnungen = 1) then (xbau:anzahlVollgeschosse &lt;= 3) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753707792093_217484_31644' name='sch-stat-008'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753707792094_769662_31650' body='Die Angabe des Haustyps des Wohngebäudes ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753707792093_217484_31644'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753707792094_548414_31649'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then (not(exists(xbau:angabenGebaeude/xbau:haustypWohngebaeude))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753707792093_270779_31643' name='sch-stat-007'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753707792093_5904_31648' body='Die veranschlagten Baukosten je Kubikmeter liegen außerhalb des Rahmens von 150 bis 400 € bei einem neu errichteten Wohngebäude.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753707792093_270779_31643'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753707792093_905500_31647'>
								<body>if (exists(xbau:baukosten[xbau:kostengruppe300 or xbau:kostengruppe400]) and xbau:angabenGebaeude/xbau:artDesWohngebaeudes/code = (&#39;1&#39;,&#39;2&#39;) and xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = (&#39;1&#39;,&#39;2&#39;) and (xbau:bruttoRauminhaltBRI &gt; 0)) then (((xbau:baukosten/xbau:kostengruppe300+xbau:baukosten/xbau:kostengruppe400) div (100*xbau:bruttoRauminhaltBRI) &gt;= 150) and ((xbau:baukosten/xbau:kostengruppe300+xbau:baukosten/xbau:kostengruppe400) div (100*xbau:bruttoRauminhaltBRI) &lt;= 400)) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969400812_939402_31271' name='sch-stat-009'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969400825_548713_31273' body='Die Angabe des überwiegend verwendeten Baustoffs ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969400812_939402_31271'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969400823_28666_31272'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:ueberwiegendVerwendeterBaustoff))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969401783_36508_31274' name='sch-stat-010'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969401785_789610_31276' body='Angaben zur Heizung und zur Heizenergie sind nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969401783_36508_31274'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969401783_980843_31275'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:heizungHeizenergie))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969403216_856383_31277' name='sch-stat-011'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969403216_560768_31279' body='Die Angabe des Bruttorauminhalts ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969403216_856383_31277'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969403216_341327_31278'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:bruttoRauminhaltBRI))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969404016_449681_31280' name='sch-stat-012'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969404016_828456_31282' body='Die Angabe der Anzahl der Vollgeschosse ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969404016_449681_31280'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969404016_222122_31281'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:anzahlVollgeschosse))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969404609_41463_31283' name='sch-stat-013'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969404609_383528_31285' body='Die Angabe zu Lüftungsanlagen ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969404609_41463_31283'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969404609_513095_31284'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:sonstigeLueftungsanlagen))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969405121_896498_31286' name='sch-stat-014'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969405125_594876_31288' body='Die Angabe zur Kühlung ist nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969405121_896498_31286'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969405121_524915_31287'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then (not(exists(xbau:kuehlung))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1756969405598_320669_31289' name='sch-stat-015'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1756969405598_541883_31291' body='Angaben zur Erfüllung des Gebäudeenergiegesetzes sind nur für Neubauten zulässig.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1756969405598_320669_31289'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1756969405598_548993_31290'>
								<body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = &#39;3&#39;) then ( not(exists(xbau:erfuellungGEG))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b8702dd_1754476546279_40511_31266'>
						<client xmi:idref='_19_0_4_b8702dd_1754476447533_61486_31262'/>
						<supplier xmi:idref='_19_0_4_b6602da_1714115823086_573174_25388'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b8702dd_1754476557755_881599_31267'>
						<client xmi:idref='_19_0_4_b8702dd_1754476447533_61486_31262'/>
						<supplier xmi:idref='_19_0_4_b6602da_1726571206703_949495_28380'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1754477270740_259672_31451' name='ruleset.statistik.03'>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753710605043_146615_31676' name='sch-stat-002'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753710605044_323371_31678' body='Der Bauherr muss angegeben werden.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753710605043_146615_31676'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753710605043_7543_31677'>
								<body>not(normalize-space(//xbau:bauherr//familienname/name) = &#39;&#39; and normalize-space(//xbau:bauherr/organisation/name) = &#39;&#39;)</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1755515914709_138278_31743' name='sch-stat-001'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1755515914715_987815_31745' body='Die Angabe des Bundeslandes fehlt.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1755515914709_138278_31743'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1755515914714_72490_31744'>
								<body>exists(//xbau:flurstueck/bundesland)</body>
								<language>English</language>
							</specification>
						</ownedRule>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b8702dd_1754477347488_918402_31455'>
						<client xmi:idref='_19_0_4_b8702dd_1754477270740_259672_31451'/>
						<supplier xmi:idref='_19_0_4_b6602da_1714115823069_702069_25382'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b8702dd_1754477357392_809089_31456'>
						<client xmi:idref='_19_0_4_b8702dd_1754477270740_259672_31451'/>
						<supplier xmi:idref='_19_0_4_b6602da_1726566387590_811697_28116'/>
					</packagedElement>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_4_b8702dd_1754391572868_945441_31438' name='ruleset.statistik.04'>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753433706920_431938_31374' name='sch-stat-005'>
							<constrainedElement xmi:idref='_19_0_3_136d03d4_1611871246540_458471_23565'/>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753433706962_81620_31419' body='Bei Wohnungen mit sieben oder mehr Räumen muss die Gesamtzahl der Räume mindestens das Siebenfache der Wohnungsanzahl betragen. Die angegebene Raumanzahl ist zu gering.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753433706920_431938_31374'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753433706962_909316_31418'>
								<body>not(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen &lt; 7*xbau:anzahlWohnungen)</body>
								<language>English</language>
							</specification>
						</ownedRule>
						<ownedRule xmi:type='uml:Constraint' xmi:id='_19_0_4_b8702dd_1753433706920_923999_31373' name='sch-stat-004'>
							<constrainedElement xmi:idref='_19_0_3_136d03d4_1611871246540_458471_23565'/>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_4_b8702dd_1753433706962_305718_31417' body='Wenn die Wohnungskategorie &quot;7 oder mehr als 7 Räume&quot; gewählt wird, muss die Anzahl der Räume angegeben werden und umgekehrt.'>
								<annotatedElement xmi:idref='_19_0_4_b8702dd_1753433706920_923999_31373'/>
							</ownedComment>
							<specification xmi:type='uml:OpaqueExpression' xmi:id='_19_0_4_b8702dd_1753433706962_442226_31416'>
								<body>if (exists(xbau:kategorie)) then ((xbau:kategorie/code=&#39;7&#39; and exists(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen)) or (xbau:kategorie/code != &#39;7&#39; and not(exists(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen)))) else true()</body>
								<language>English</language>
							</specification>
						</ownedRule>
					</packagedElement>
					<packagedElement xmi:type='uml:Dependency' xmi:id='_19_0_4_b8702dd_1755525117456_67519_31757'>
						<client xmi:idref='_19_0_4_b8702dd_1754391572868_945441_31438'/>
						<supplier xmi:idref='_19_0_4_b6602da_1721382124872_703313_25307'/>
					</packagedElement>
				</packagedElement>
				<packagedElement xmi:type='uml:Package' xmi:id='_19_0_3_129a03b9_1715339742997_974829_25845' name='Angrenzer'>
					<packagedElement xmi:type='uml:Class' xmi:id='_19_0_3_129a03b9_1708002012670_87284_24651' name='angrenzer.stellungnahme.0310'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1708002012711_542072_24681' body='&lt;para&gt;Diese Nachricht verwendet die beteiligte Partei, um der  Bauaufsichtsbehörde ihre Stellungnahme zuzustellen. &#10;&lt;/para&gt;&#10;&lt;para&gt;&#10;In der Regel werden die Nachbarn und die Inhaber von angrenzenden Grundstücken von der Bauaufsichtsbehörde zur Stellungnahme über den eingereichten Bauantrag aufgerufen und antworten daraufhin mit dieser Nachricht.&lt;/para&gt;'>
							<annotatedElement xmi:idref='_19_0_3_129a03b9_1708002012670_87284_24651'/>
						</ownedComment>
