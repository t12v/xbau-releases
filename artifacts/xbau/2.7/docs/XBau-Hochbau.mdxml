								</xmi:Extension>
							</type>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_129a03b9_1726761837795_629364_27922' body='&lt;para&gt;Dieses Element enthält Informationen zur Identität des angelegten Aktenraums bzw. die entsprechenden Zugangsdaten.&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_129a03b9_1726761837786_698717_27866'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_129a03b9_1726761837796_521443_27923'/>
