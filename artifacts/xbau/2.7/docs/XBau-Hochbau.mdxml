							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282210_676009_31179' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264260_63404_25811' name='bebauteGrundstuecksflaecheBF' visibility='private' type='_19_0_3_136d03d4_1611871246536_10471_23553'>
							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282211_328568_31184' body='&lt;para&gt;Bebaute Fläche (BF). Teilfläche der Grundstücksfläche (GF), die durch ein Bauwerk oberhalb der Geländeoberfläche überbaut oder überdeckt oder unterhalb der Geländeoberfläche unterbaut ist.&lt;/para&gt;&#10;&lt;para&gt;= ueberbauteFlaecheBF1 + unterbauteFlaecheBF2&lt;/para&gt;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871264260_63404_25811'/>
							</ownedComment>
							<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_3_136d03d4_1611871282211_769549_31185'/>
							<xmi:Extension extender='MagicDraw UML 19.0'>
								<modelExtension>
									<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_3_136d03d4_1611871282211_987937_31183' value='1'/>
								</modelExtension>
							</xmi:Extension>
						</ownedAttribute>
						<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_3_136d03d4_1611871264260_891917_25812' name='nichtBebauteGrundstuecksflaecheUF' visibility='private'>
