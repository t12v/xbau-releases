							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_3_136d03d4_1611871282527_622964_33653' body='&lt;para&gt;Die Gemeinde trägt in dieses Element ein, welches Ergebnis die gemeindliche Prüfung der Anzeige ergeben hat.&lt;/para&gt;&#10;'>
								<annotatedElement xmi:idref='_19_0_3_136d03d4_1611871266243_628702_26864'/>
							</ownedComment>
