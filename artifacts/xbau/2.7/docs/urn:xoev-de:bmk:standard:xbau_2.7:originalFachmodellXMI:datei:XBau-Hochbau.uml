              <ownedComment xmi:id="_19_0_4_b6602da_1714115823635_996417_26262" annotatedElement="_19_0_4_b6602da_1714115823542_869656_25795" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass flüssige Biomasse nach § 71ff GEG genutzt wird. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823635_961995_26263" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823635_338778_26261" name="" visibility="public" value="1"/>
