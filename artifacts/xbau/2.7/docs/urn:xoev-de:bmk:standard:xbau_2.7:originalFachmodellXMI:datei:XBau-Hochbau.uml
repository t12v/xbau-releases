              <packagedElement xmi:type="uml:Dependency" xmi:id="_16_5_4_8ae0277_1427193498410_184944_6953" name="" visibility="public" client="_16_5_4_8a30247_1422977426041_172815_6757" supplier="_16_5_4_5b501fb_1387625291114_133591_5178"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_16_5_4_8ae0277_1427193864249_936524_7178" name="" visibility="public" client="_16_5_4_8a30247_1422977426041_754458_6765" supplier="_16_5_4_5b501fb_1387625291278_848988_5852"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_16_5_4_8ae0277_1427196979970_783012_8890" name="" visibility="public" client="_16_5_4_940029b_1422888807308_342425_3010" supplier="_16_5_4_5b501fb_1387625291104_134064_5166"/>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1655652146888_346373_9674" name="Anonym_Ansprechpartner" visibility="public">
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1655652249439_955647_9676" name="name" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1655654471159_32568_9690" annotatedElement="_19_0_3_136d03d4_1655652249439_955647_9676" body="&lt;para>Hier ist der Name des Ansprechpartners einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655655373447_625085_9693" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655655373453_148949_9694" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1655652255505_600320_9677" name="funktion" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1655654488729_831208_9691" annotatedElement="_19_0_3_136d03d4_1655652255505_600320_9677" body="&lt;para>Hier kann über eine Funktionsangabe die Zuständigkeit des Ansprechpartners bezeichnet werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655655381915_148881_9695" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655655381918_810010_9696" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1655652263103_746156_9678" name="kommunikation" visibility="private" type="_16_5_4_8a30247_1422894619924_503273_3379">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1655654514357_660847_9692" annotatedElement="_19_0_3_136d03d4_1655652263103_746156_9678" body="&lt;para>Pro Element kann eine Angaben zur Erreichbarkeit des Ansprechpartners innerhalb der Organisation gemacht werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655655392144_280547_9697" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655655392145_12416_9698" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479020860_697631_9331" name="Beteiligte" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_8a30247_1408703057450_27821_3423" name="Akteur" visibility="public">
                <ownedComment xmi:id="_16_5_4_8a30247_1408706838747_261394_4377" annotatedElement="_16_5_4_8a30247_1408703057450_27821_3423" body="&lt;para>Durch den Typ Akteur wird eine Differenzierung zwischen natürlichen Einzelpersonen, Personengruppen und juristischen Personen definiert.&lt;/para>&#xA;&lt;para>Im Namen einer Firma handelt eine natürliche Person als Vertreter. Bei mehreren Personen (z.B. Eigentümergemeinschaften) wird jede Person (juristisch oder natürlich) als Akteur definiert. Eine Person dieser Gruppe kann als Vertreter definiert werden.&lt;/para>"/>
                <ownedAttribute xmi:id="_16_5_4_8a30247_1422977828419_207131_7447" name="organisation" visibility="private" type="_16_5_4_8a30247_1422977426041_172815_6757" aggregation="composite" association="_16_5_4_8a30247_1422977828419_100798_7445">
                  <ownedComment xmi:id="_16_5_4_8a30247_1422977828419_864327_7450" annotatedElement="_16_5_4_8a30247_1422977828419_207131_7447" body="&lt;para>In dieses Element sind die Angaben zu der Organisation einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_8a30247_1422977828419_180743_7449" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_8a30247_1422977828419_252084_7451" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460622920874_103982_4471" name="natuerlichePerson" visibility="private" type="_16_5_4_940029b_1460619307903_831925_3517" aggregation="composite" association="_16_5_4_940029b_1460622920874_846896_4469">
                  <ownedComment xmi:id="_16_5_4_940029b_1460622920874_478403_4474" annotatedElement="_16_5_4_940029b_1460622920874_103982_4471" body="&lt;para>In dieses Element sind die Angaben zu der natürlichen Person einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460622920874_265752_4473" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460622920874_805149_4475" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_940029b_1460619307903_831925_3517" name="AmBauBeteiligtePerson" visibility="public">
                <ownedComment xmi:id="_16_5_4_940029b_1460619307918_202040_3525" annotatedElement="_16_5_4_940029b_1460619307903_831925_3517" body="&lt;para>Dieser Typ fasst die Merkmale zusammen, die typischerweise zu am Bau beteiligten natürlichen Personen genannt werden bzw. zu nennen sind. &lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1664349507523_89507_9680" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                  <ownedComment xmi:id="_19_0_3_940029b_1664349507534_6560_9682" annotatedElement="_19_0_3_940029b_1664349507523_89507_9680" body="&lt;para>Dieses Element kann genutzt werden, um die Person zu identifizieren. Es handelt es sich um eine technische ID, die es erlaubt einen Datensatz für Änderungen deskriptiver Eigenschaften herauszugreifen. Dem Element ist der W3C-Datentyp ID (https://www.w3.org/TR/xmlschema11-2/#ID) zugeordnet, ein String-Derivat.&lt;/para>&#xA;&#xA;&lt;para>Scope des hiermit eingeführten Identifikationsmechanismus: Der Scope ist gemäß der hier festgelegten Semantik nur der gegebene Vorgang. Dies bedeutet beispielsweise im Rahmen eines Antragsvorgangs: Der Antrag wird initial vom Online-Service (&quot;Baugenehmigung Online&quot;) an die zuständige Bauaufsichtsbehörde übermittelt. In der XBau-Nachrichteninstanz werden die beteiligten Personen und Firmen identifiziert mittels vom Online-Service vergebener Identifier. Ab dem Zeitpunkt werden diese Identifikationsmittel im Nachrichtenaustausch im Rahmen des gegebenen Vorgangs in beide Richtungen weiterverwendet, um in der Kommunikation intersubjektiv nachvollziehbar zu referenzieren. Ob über diesen Scope hinausgehend identifiziert werden soll, ist Angelegenheit des Umsetzungsprojekts, XBau macht dazu keine Aussage.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1664349507535_793333_9683" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1664349507533_486450_9681" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460619307918_202687_3519" name="name" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103">
                  <ownedComment xmi:id="_16_5_4_940029b_1460619307918_517815_3528" annotatedElement="_16_5_4_940029b_1460619307918_202687_3519" body="&lt;para>In dieses Element sind die Angaben zu den Namen der Person einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460621351010_776728_4051" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460621351010_693379_4052" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460619307918_770102_3520" name="anschrift" visibility="private" type="_16_5_4_8a30247_1422884384004_352244_4233">
                  <ownedComment xmi:id="_16_5_4_940029b_1460619307918_585177_3532" annotatedElement="_16_5_4_940029b_1460619307918_770102_3520" body="&lt;para>In dieses Objekt sind die Angaben zur Anschrift der Person einzutragen. Welche Anschrift dafür auszuwählen ist, ist nicht festgelegt. Wichtig ist, dass es eine zustellfähige Anschrift sein muss (für den Zweck der verbindlichen Zustellung).&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460622442815_634129_4123" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460622442815_531805_4124" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460619307918_566376_3524" name="kommunikation" visibility="private" type="_16_5_4_8a30247_1422894619924_503273_3379">
                  <ownedComment xmi:id="_16_5_4_940029b_1460619307918_756628_3548" annotatedElement="_16_5_4_940029b_1460619307918_566376_3524" body="&lt;para>In dieses Objekt sind Angaben einzutragen, die benötigt werden, um mit der Person zu kommunizieren (z. B. per Brief oder per Telefon). Diese Daten dienen der persönlichen Erreichbarkeit; die Unterscheidung, ob es sich um eine private oder eine geschäftliche E-Mail-Adresse handelt, ist nicht erheblich.).&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460622475673_81049_4129" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460622475673_312080_4130" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1652864369535_823879_9665" name="istVertreter" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1652864369552_985185_9667" annotatedElement="_19_0_3_136d03d4_1652864369535_823879_9665" body="&lt;para>Sofern mehrere natürliche Personen involviert sind, handelt es sich um eine Personengruppe, deren Vertreter mit diesem Element zu kennzeichnen ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1652864369553_740106_9668" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1652864369551_533859_9666" name="" visibility="public" value="1"/>
                  <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_136d03d4_1652864369555_713905_9669" name="" visibility="public" value="true"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_940029b_1460622920874_846896_4469" name="" visibility="public" memberEnd="_16_5_4_940029b_1460622920874_103982_4471 _16_5_4_940029b_1460622920874_634152_4470">
                <ownedEnd xmi:id="_16_5_4_940029b_1460622920874_634152_4470" name="" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423" association="_16_5_4_940029b_1460622920874_846896_4469"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_8a30247_1422977828419_100798_7445" name="" visibility="public" memberEnd="_16_5_4_8a30247_1422977828419_207131_7447 _16_5_4_8a30247_1422977828419_632855_7446">
                <ownedEnd xmi:id="_16_5_4_8a30247_1422977828419_632855_7446" name="" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423" association="_16_5_4_8a30247_1422977828419_100798_7445"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1513951637567_197418_9729" name="" visibility="public" client="_16_5_4_940029b_1460619307903_831925_3517" supplier="_16_5_4_5b501fb_1387625291102_608193_5164"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1552467670464_818516_14343" name="" visibility="public" client="_16_5_4_940029b_1460619307918_202687_3519" supplier="_16_5_4_5b501fb_1387625291178_204613_5460"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479007081_8721_9329" name="Anlagen" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611752450693_63128_15571" name="MetadatenAnlage" visibility="public" isAbstract="true">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611752450698_448880_15572" annotatedElement="_19_0_3_136d03d4_1611752450693_63128_15571" body="&lt;para>Dieser Kernmodul-Basistyp bildet die Metadaten zu einer Bauvorlage bzw. sonstigen Anlage ab, die gemäß der Architektur der Übertragung von &lt;link linkend=&quot;spezifikation.infrastrukturtechnologie.primaerdokumente&quot;>Primärdokumenten&lt;/link> im Zusammenhang mit einer XBau-Fachnachricht benötigt werden.&lt;/para>&#xA;&lt;para>XBau-Fachmodule können nach ihrem Bedarf vom vorliegenden Basistyp ableiten.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611752450698_501601_15573" name="bezeichnung" visibility="private" type="_19_0_4_41901a4_1659506109571_897108_6730">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611752450708_984319_15583" annotatedElement="_19_0_3_136d03d4_1611752450698_501601_15573" body="&lt;para>Hier ist eine deskriptive Bezeichnung der Bauvorlage bzw. sonstigen Anlage einzutragen, z. B. &quot;Grundriss 3. OG&quot;. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611752450709_689247_15584" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611752450708_355737_15582" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611752450699_664861_15574" name="versionsnummer" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611752450710_998750_15587" annotatedElement="_19_0_3_136d03d4_1611752450699_664861_15574" body="&lt;para>Hier ist eine Versionsnummer einzutragen. Sie dient dazu, (sequentiell eingereichte) Bauvorlagen (oder sonstige Anlagen) zu unterscheiden, die dieselbe Bezeichnung tragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611752450710_642377_15588" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611752450709_540261_15586" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611752450700_809244_15575" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611752450711_710501_15591" annotatedElement="_19_0_3_136d03d4_1611752450700_809244_15575" body="&lt;para>Hier ist das Datum der Erstellung bzw. der letzten Bearbeitung dieser Bauvorlage bzw. sonstigen Anlage einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611752450711_488611_15592" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611752450711_356414_15590" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611752450700_172558_15576" name="anlageart" visibility="private" type="_16_5_4_5b501fb_1387625280047_322339_5028">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611752450712_617215_15595" annotatedElement="_19_0_3_136d03d4_1611752450700_172558_15576" body="&lt;para>Unterhalb dieses Elements wird die Art dieser Bauvorlage oder sonstigen Anlage näher spezifiziert.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611752450712_61130_15596" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611752450712_371848_15594" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611752450701_695078_15577" name="mimeType" visibility="private" type="_16_5_4_940029b_1483303261965_543138_5139">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611752450713_297062_15599" annotatedElement="_19_0_3_136d03d4_1611752450701_695078_15577" body="&lt;para>Dieses Element nennt - analog zur Übermittlung von E-Mail-Anlagen - den MIME-Typ der angehängten oder verlinkten Bauvorlage bzw. sonstigen Anlage (z.B. text/xml, text/plain, application/gzip oder application/pdf). &lt;/para>&#xA;&lt;para>Die Angabe ist mandatorisch, weil eine für den Empfänger zur Verarbeitung der Daten notwendige Information.&lt;/para>&#xA;&lt;para>Als Anlagen können u.a. auch IFC-Darstellungen (gemäß der Technologie Building Information Modeling (BIM)) des Bauvorhabens übermittelt werden. Entsprechende Kennzeichnungen des mimeTypes (ifc, ifcXML, fcZIP) sind dafür verfügbar.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611752450713_7750_15600" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611752450713_200457_15598" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1621436465618_164867_9405" name="anhangOderVerlinkung" visibility="private" type="_19_0_3_940029b_1621589626990_578637_9405">
                  <ownedComment xmi:id="_19_0_3_940029b_1621436465626_718701_9407" annotatedElement="_19_0_3_940029b_1621436465618_164867_9405" body="&lt;para>Eine Instanz dieses Elements enthält passende Metadaten zur Bauvorlage bzw. sonstigen Anlage, je nachdem ob diese (i) als Anhang mit dieser XBau-Nachricht übermittelt wird oder ob sie (ii) über einen Link zugänglich gemacht  wird, der in diese XBau-Nachricht eingetragen ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1621436465627_780459_9408" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1621436465624_860109_9406" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_940029b_1460560241523_867175_3826" name="Anlagen" visibility="public">
                <ownedComment xmi:id="_16_5_4_940029b_1461259171039_660685_5520" annotatedElement="_16_5_4_940029b_1460560241523_867175_3826" body="&lt;para>Dieser Typ dient dazu, die Metadaten zu Dokumenten aufzunehmen, die einer XBau-Kommunikation (z.B. Antragstellung) als Anlagen beigefügt sind. Als Anlagen sind in erster Linie Bauvorlagen zu nennen, in vielen Fällen zusätzlich weitere Anlagen (wie Nachweise und ergänzende Dokumentationen) und sonstiges Schriftgut.&lt;/para>&#xA;&#xA;"/>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460733760899_910997_4047" name="anlage" visibility="private" type="_19_0_3_940029b_1629982120314_774000_9457" aggregation="composite">
                  <ownedComment xmi:id="_16_5_4_940029b_1461160810037_905663_5869" annotatedElement="_16_5_4_940029b_1460733760899_910997_4047" body="&lt;para>Jede Instanz dieses Elements steht für eine Anlage (Bauvorlage, Primärdokument, sonstige Anlage) zum vorliegenden Antrag bzw. zur übermittelten XBau-Fachnachricht.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460733760899_826458_4049" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460733760899_101516_4050" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1621589626990_578637_9405" name="AnhangOderVerlinkung" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1621589627004_405867_9406" annotatedElement="_19_0_3_940029b_1621589626990_578637_9405" body="&lt;para>Dieser Typ beschreibt die Mechanismen, mit denen eine Bauvorlage oder sonstige Anlage im Zusammenhang mit einer XBau-Fachnachricht übermittelt wird.&lt;/para>&#xA;&lt;para>Die Bauvorlage bzw. sonstige Anlage wird entweder als Anhang (Attachment) zur XBau-Fachnachricht übermittelt. Oder sie wird dem Adressaten per Verlinkung zur Verfügung gestellt, also über ein Quellsystem, das sich in seiner Kontrolle befindet.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1621589627005_510551_9407" name="anhang" type="_19_0_3_940029b_1621589794838_197505_9429">
                  <ownedComment xmi:id="_19_0_3_940029b_1621589627015_758997_9411" annotatedElement="_19_0_3_940029b_1621589627005_510551_9407" body="&lt;para>Das Dokument wird als &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;spezifikation.infrastrukturtechnologie.primaerdokumente.anhang&quot;>Anhang&lt;/link> mit dieser XBau-Fachnachricht übertragen.&lt;/para>&#xA;&lt;para>Dazu stehen unterhalb dieses Elements die passenden Metadaten .&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1621589627017_681608_9412" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1621589627014_109122_9410" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b6602da_1740389939527_513220_8934" name="verlinkung" visibility="private" type="_19_0_4_b6602da_1740389866542_150336_8930">
                  <ownedComment xmi:id="_19_0_4_b6602da_1740390177242_572116_8940" annotatedElement="_19_0_4_b6602da_1740389939527_513220_8934" body="&lt;para>Das Dokument wird über eine Verlinkung zugänglich gemacht. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1740390090030_365334_8938" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1740390090031_69943_8939" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1621589794838_197505_9429" name="MetadatenAnhang" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1621589794839_126528_9430" annotatedElement="_19_0_3_940029b_1621589794838_197505_9429" body="&lt;para>Dieser Typ dient zur Aufnahme der Metadaten eines lokalen Anhangs, der mit einer XBau-Fachnachricht übertragen wird.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1621589794846_514231_9436" name="dokumentid" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                  <ownedComment xmi:id="_19_0_3_940029b_1621589794859_688977_9461" annotatedElement="_19_0_3_940029b_1621589794846_514231_9436" body="&lt;para>Hier ist die Kennung des Dokuments einzutragen bzw. zu vergeben. Die Kennung wird für Referenzierungszwecke verwendet und muss innerhalb der Fachnachricht eindeutig sein.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1621589794860_799923_9462" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1621589794859_9498_9460" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1621589794847_717344_9437" name="dateiname" visibility="private" type="_19_0_4_b8702dd_1765890051130_965114_9288">
                  <ownedComment xmi:id="_19_0_3_940029b_1621589794861_119118_9465" annotatedElement="_19_0_3_940029b_1621589794847_717344_9437" body="&lt;para>Hier ist der Name der Datei (Primärdokument) einzutragen. Der Dateiname muss innerhalb der Fachnachricht eindeutig sein. Es ist darauf zu achten, dass der hier angegebene Dateiname mit dem Namen der physischen Datei übereinstimmt.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1621589794861_833022_9466" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1621589794861_595073_9464" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1664355934638_84127_9737" name="filesize" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                  <ownedComment xmi:id="_19_0_3_940029b_1664355934640_275241_9739" annotatedElement="_19_0_3_940029b_1664355934638_84127_9737" body=" &lt;para>Größe des Inhaltes der Datei in Bytes. Dieses Attribut kann verwendet werden, um die Dateigröße des Anhangs anzugeben. So kann bei der Übertragung überprüft werden, ob die Anlage komplett geladen wurde, hilfreich z.B. bei sehr großen Dateien.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1664355934641_378786_9740" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1664355934640_473950_9738" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1664355934776_442854_9744" name="hashValue" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_19_0_3_940029b_1664355934778_575897_9746" annotatedElement="_19_0_3_940029b_1664355934776_442854_9744" body="&lt;para>Hashwert der Datei im Anhang. Anhand dieses Wertes kann bei der Übertragung die Integrität der Datei abgesichert werden. Der binäre Hashwert ist in Textform einzutragen als eine Sequenz hexadezimaler Werte (hexadecimal digits).&lt;/para>&#xA;&lt;para>Als Algorithmus für den Hashwert ist SHA2-256 zu verwenden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1664355934778_918282_9747" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1664355934777_664893_9745" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1629982120314_774000_9457" name="MetadatenAnlageDirekt" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1629982120328_521027_9458" annotatedElement="_19_0_3_940029b_1629982120314_774000_9457" body="&lt;para>Dieser Typ nimmt die Metadaten zu einer Bauvorlage bzw. sonstigen Anlage auf, die gemäß der Architektur der Übertragung von &lt;link linkend=&quot;spezifikation.infrastrukturtechnologie.primaerdokumente&quot;>Primärdokumenten&lt;/link> im Zusammenhang mit einer XBau-Fachnachricht benötigt werden.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120328_598268_9459" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210780_355528_9523">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120342_675956_9467" annotatedElement="_19_0_3_940029b_1629982120328_598268_9459" body="&lt;para>Hier ist eine deskriptive Bezeichnung der Bauvorlage bzw. sonstigen Anlage einzutragen, z. B. &quot;Grundriss 3. OG&quot;. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120343_436891_9468" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120341_33350_9466" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120331_680082_9460" name="versionsnummer" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120344_944458_9471" annotatedElement="_19_0_3_940029b_1629982120331_680082_9460" body="&lt;para>Hier ist eine Versionsnummer einzutragen. Sie dient dazu, (sequentiell eingereichte) Bauvorlagen (oder sonstige Anlagen) zu unterscheiden, die dieselbe Bezeichnung tragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120345_811946_9472" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120344_715173_9470" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120332_763149_9461" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120346_166138_9475" annotatedElement="_19_0_3_940029b_1629982120332_763149_9461" body="&lt;para>Hier ist das Datum der Erstellung bzw. der letzten Bearbeitung dieser Bauvorlage bzw. sonstigen Anlage einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120346_901864_9476" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120346_943754_9474" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120333_73780_9462" name="anlageart" visibility="private" type="_19_0_3_940029b_1629982356132_732557_9504">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120348_473495_9479" annotatedElement="_19_0_3_940029b_1629982120333_73780_9462" body="&lt;para>Unterhalb dieses Elements wird die Art dieser Bauvorlage oder sonstigen Anlage näher spezifiziert.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120348_531070_9480" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120347_95412_9478" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120333_276783_9463" name="mimeType" visibility="private" type="_16_5_4_940029b_1483303261965_543138_5139">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120349_392920_9483" annotatedElement="_19_0_3_940029b_1629982120333_276783_9463" body="&lt;para>Dieses Element nennt - analog zur Übermittlung von E-Mail-Anlagen - den MIME-Typ der angehängten oder verlinkten Bauvorlage bzw. sonstigen Anlage (z.B. text/xml, text/plain, application/gzip oder application/pdf). &lt;/para>&#xA;&lt;para>Die Angabe ist mandatorisch, weil eine für den Empfänger zur Verarbeitung der Daten notwendige Information.&lt;/para>&#xA;&lt;para>Als Anlagen können u.a. auch IFC-Darstellungen (gemäß der Technologie Building Information Modeling (BIM)) des Bauvorhabens übermittelt werden. Entsprechende Kennzeichnungen des mimeTypes (ifc, ifcXML, fcZIP) sind dafür verfügbar.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120350_122316_9484" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120349_103595_9482" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1629982120334_800022_9464" name="anhangOderVerlinkung" visibility="private" type="_19_0_3_940029b_1621589626990_578637_9405">
                  <ownedComment xmi:id="_19_0_3_940029b_1629982120351_982520_9487" annotatedElement="_19_0_3_940029b_1629982120334_800022_9464" body="&lt;para>Eine Instanz dieses Elements enthält passende Metadaten zur Bauvorlage bzw. sonstigen Anlage, je nachdem ob diese (i) als Anhang mit dieser XBau-Nachricht übermittelt wird oder ob sie (ii) über einen Link zugänglich gemacht  wird, der in diese XBau-Nachricht eingetragen ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629982120351_694913_9488" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629982120350_226592_9486" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1740389866542_150336_8930" name="UriVerlinkung" visibility="public">
                <ownedComment xmi:id="_19_0_4_b6602da_1740392397141_10598_9030" annotatedElement="_19_0_4_b6602da_1740389866542_150336_8930" body="&lt;para>Mit diesem Typ wird ein Dokument über eine Verlinkung zugänglich gemacht.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1621589712845_8322_9422" name="uriVerlinkung" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                  <ownedComment xmi:id="_19_0_3_940029b_1621589712847_788516_9424" annotatedElement="_19_0_3_940029b_1621589712845_8322_9422" body="&lt;para>Der Link identifiziert die Anlage (Primärdokument) in einem Quellsystem (das sich in Kontrolle der Behörde befindet) eindeutig. Die Verlinkung auf ein Quellsystem entspricht der Architektur der (externen) &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;spezifikation.infrastrukturtechnologie.primaerdokumente.verlinkung&quot;>Verlinkung&lt;/link>. Der Link muss innerhalb der Fachnachricht eindeutig sein.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1621589712847_141794_9425" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1621589712846_719067_9423" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b6602da_1740389777279_341149_8928" name="dateiname" visibility="private" type="_19_0_4_b8702dd_1765890051130_965114_9288">
                  <ownedComment xmi:id="_19_0_4_b6602da_1740390343547_631197_9016" annotatedElement="_19_0_4_b6602da_1740389777279_341149_8928" body="&lt;para>Hier kann ein Dateiname zum verlinkten Dokument eingetragen werden. Der Dateiname muss innerhalb der Fachnachricht eindeutig sein.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1740390246985_292158_9010" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1740390246985_623394_9011" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1776934015171_395475_9484" name="dokumentid" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1776934015175_886940_9486" annotatedElement="_19_0_4_b8702dd_1776934015171_395475_9484" body="&lt;para>Hier ist die Kennung des Dokuments einzutragen bzw. zu vergeben. Die Kennung wird für Referenzierungszwecke verwendet und muss innerhalb der Fachnachricht eindeutig sein.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1776934015176_745131_9487" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1776934015175_378612_9485" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479073596_772047_9334" name="TextUndBezug" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611781889004_410228_10088" name="Anonym_Link" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611781889005_455806_10089" annotatedElement="_19_0_3_136d03d4_1611781889004_410228_10088" body=""/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781889005_408024_10090" name="url" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781889006_302590_10093" annotatedElement="_19_0_3_136d03d4_1611781889005_408024_10090" body="&lt;para>Hier ist die URL einer Webseite oder Ressource anzugeben.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781889007_931920_10094" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781889006_336912_10092" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781889006_612710_10091" name="beschreibung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781889007_996082_10097" annotatedElement="_19_0_3_136d03d4_1611781889006_612710_10091" body="&lt;para>Hier ist die zur URL passende Beschreibung der Webseite oder Ressource einzutragen. &lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781889007_685107_10098" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781889007_980938_10096" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611781871673_705551_10079" name="Anonym_LinkListe" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611781871674_8741_10080" annotatedElement="_19_0_3_136d03d4_1611781871673_705551_10079" body=""/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781871674_544000_10081" name="link" visibility="private" type="_19_0_3_136d03d4_1611781889004_410228_10088">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781871675_452931_10083" annotatedElement="_19_0_3_136d03d4_1611781871674_544000_10081" body="&lt;para>Jedes instanziierte Element steht für einen Link auf eine Webseite oder Ressource.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781871675_959785_10084" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781871674_855158_10082" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_940029b_1465368877212_444325_5428" name="Bezug" visibility="public">
                <ownedComment xmi:id="_16_5_4_940029b_1465369587050_970021_5510" annotatedElement="_16_5_4_940029b_1465368877212_444325_5428" body="&lt;para>Dieser Typ gestattet Eintragungen, um auf einen Antrag, einen Vorgang und ggf. auf eine Nachricht, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para>"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546720734944_199093_13359" name="referenz" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                  <ownedComment xmi:id="_18_0_2_940029b_1546720734959_14595_13361" annotatedElement="_18_0_2_940029b_1546720734944_199093_13359" body="&lt;para>Hier ist der Identifier des Antragsservice (der mit dem Antrag bzw. der Anzeige bei der Fachbehörde eingegangen ist) oder der Abfrage (auf die die vorliegende Nachricht eine Antwort ist) anzugeben.&lt;/para>&#xA;&lt;para>Falls die vorliegende Nachricht an ein Online-Portal gerichtet ist, kann so der Projektraum bzw. Postkorb angesteuert werden.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546720734959_437875_13362" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546720734959_220578_13360" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1465369045932_696516_5487" name="vorgang" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_16_5_4_940029b_1465369445636_190258_5508" annotatedElement="_16_5_4_940029b_1465369045932_696516_5487" body="&lt;para>Eine Instanz dieses Elements enthält, falls ein solches vergeben wurde, das Zeichen (Aktenzeichen) des von der Fachbehörde geführten Vorgangs, innerhalb dessen diese Nachricht übermittelt wird. &lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1465369058452_265785_5489" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1465369058452_98569_5490" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1612387491891_70335_9576" name="bezugNachricht" visibility="private" type="_19_0_4_41901a4_1664881730540_634830_6898">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1612387592075_194225_9582" annotatedElement="_19_0_3_136d03d4_1612387491891_70335_9576" body="&lt;para>Falls ein solcher Zusammenhang vorliegt, sind hier die Kennungen der Nachricht einzutragen, auf die sich diese Nachricht bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1612387564308_84214_9580" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1612387564308_525826_9581" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1601245573232_871949_15379" name="Nachweisdaten" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1601245610915_709820_15381" annotatedElement="_19_0_3_136d03d4_1601245573232_871949_15379" body="&lt;para>Dieser Typ bildet Nachweisdaten zu behördlichen Vorgängen ab.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1601245613095_453060_15382" name="behoerde" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1601245704076_125051_15394" annotatedElement="_19_0_3_136d03d4_1601245613095_453060_15382" body="&lt;para>In dieses Element ist die zuständige Behörde einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1605090075410_873194_15285" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1605090075410_573890_15286" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1601245625528_78234_15383" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1601245714548_305112_15395" annotatedElement="_19_0_3_136d03d4_1601245625528_78234_15383" body="&lt;para>In dieses Element ist das Datum einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1605090083293_564430_15287" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1605090083293_537380_15288" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1601245635439_872357_15384" name="aktenzeichen" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1601245728038_658552_15396" annotatedElement="_19_0_3_136d03d4_1601245635439_872357_15384" body="&lt;para>In dieses Element ist das Aktenzeichen einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1605090098128_900802_15289" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1605090098128_213687_15290" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1591038023050_502647_13346" name="ReferenzAbfrage" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1591038023052_266186_13347" annotatedElement="_19_0_3_940029b_1591038023050_502647_13346" body="&lt;para>Dieser Typ deckt die Identifizierung einer Abfrage ab.&lt;/para>&#xA;"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1591038023052_140224_13348" name="referenzAbfrage" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                  <ownedComment xmi:id="_19_0_3_940029b_1591038023059_550273_13351" annotatedElement="_19_0_3_940029b_1591038023052_140224_13348" body="&lt;para>Maschinell erzeugter Identifier, der die Anfrage (nicht die Anfragenachricht) eindeutig kennzeichnet. &lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1591038023062_426281_13352" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1591038023058_807652_13350" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1546716878558_771130_12819" name="ReferenzAntragsservice" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1546716878574_382210_12820" annotatedElement="_18_0_2_940029b_1546716878558_771130_12819" body="&lt;para>Dieser Typ deckt Daten ab, durch die ein Antragsservice einen Antrags- (oder Anzeigen-)vorgang eindeutig kennzeichnet. &lt;/para>&#xA;"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546716878574_879685_12821" name="referenzAntragsservice" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                  <ownedComment xmi:id="_18_0_2_940029b_1546716878574_479178_12825" annotatedElement="_18_0_2_940029b_1546716878574_879685_12821" body="&lt;para>Initial eingetragener, i.d.R. maschinell erzeugter Identifier, der für den Antragsvorgang steht (nicht für die Antragsnachricht). &lt;/para>&#xA;&#xA;&lt;para>Dieser Identifier geht mit den Antragsnachrichten der Fachbehörde zu und schafft dieser die Möglichkeit, in ihren Reaktionsnachrichten darauf zu referenzieren.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546716878574_412621_12826" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546716878574_969813_12824" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1535727067041_864259_10734" name="Text" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1535727067042_958881_10735" annotatedElement="_18_0_2_940029b_1535727067041_864259_10734" body="&lt;para>Diese Typ nimmt Absätze eines formatierungsfreien Textes auf. &lt;/para>"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1535727067042_432901_10736" name="textabsatz" visibility="private" type="_19_0_4_b8702dd_1782126210780_647789_9524">
                  <ownedComment xmi:id="_18_0_2_940029b_1535727067043_816131_10739" annotatedElement="_18_0_2_940029b_1535727067042_432901_10736" body="&lt;para>Pro Element wird Text im Umfang eines Absatzes (Freitext) festgehalten.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1535727067044_742452_10740" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1535727067043_593982_10738" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1535726187446_656135_10650" name="TextFormatiert" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1535726187449_311762_10651" annotatedElement="_18_0_2_940029b_1535726187446_656135_10650" body="&lt;para>Dieser Typ nimmt Absätze eines Textes in einer Form auf, so dass das Empfängersystem diesen Text formatierungstreu anzeigen und medienbruchfrei weiterverarbeiten kann. &lt;/para>"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1535726187450_347378_10652" name="text" visibility="private" type="_14_0_1_6370212_1218191711843_120906_985">
                  <ownedComment xmi:id="_18_0_2_940029b_1535726187451_706391_10655" annotatedElement="_18_0_2_940029b_1535726187450_347378_10652" body="&lt;para>In dieses Element ist ein Textabschnitt in Form von HTML-5 Markup einzutragen. Das schließt die Möglichkeit von Formatierung und Integration von Abbildungen ein. Folgende Regeln sind beim Eintrag von HTML-5-Text zu beachten: &lt;/para>&#xA;&lt;para>&lt;itemizedlist>&#xA;&#xA;&lt;listitem>&#xA;&lt;para>&#xA;Das Textfeld enthält nur den Inhalt des BODY-Elements (nicht dieses selber), also nur &quot;Flow Content&quot; im Sinne der HTML5-Spezifikation (&lt;uri xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot;>https://html.spec.whatwg.org/multipage/dom.html#flow-content&lt;/uri>).  Es ist zu beachten, dass XBau die Menge des erlaubten HTML5-Markups grundlegend einschränkt (vgl. &lt;xref xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;spezifikation.infrastruktur_technologie.formatierter_text&quot; role=&quot;AS&quot;/>) und dass diese Einschränkungen Vorrang haben.&#xA;&lt;/para>&#xA;&lt;/listitem>&#xA;&#xA;&lt;listitem>&lt;para>Als Encoding wird stets &quot;UTF-8&quot; verwendet.&lt;/para>&lt;/listitem>&#xA;&#xA;&lt;listitem>&lt;para>Externe CSS-Referenzen dürfen nicht verwendet werden, sondern lediglich HTML Inline Styles.&lt;/para>&lt;/listitem>&#xA;&#xA;&lt;/itemizedlist>&#xA;&#xA;&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1535726187451_928146_10656" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1535726187451_993271_10654" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1535726283017_758163_10660" name="textOffice" visibility="private" type="_19_0_3_940029b_1666691511135_384844_9674">
                  <ownedComment xmi:id="_18_0_2_940029b_1535726283018_124609_10662" annotatedElement="_18_0_2_940029b_1535726283017_758163_10660" body="&lt;para>Unterhalb dieses Elements kann derselbe Inhalt wie im Element &lt;emphasis role=&quot;codebf&quot;>text&lt;/emphasis> in einem alternativen technischen Format angeboten werden. &lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1535726283018_164508_10663" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1535726283018_390092_10661" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611781855355_662927_10055" name="Verlinkung" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611781855356_57394_10056" annotatedElement="_19_0_3_136d03d4_1611781855355_662927_10055" body="&lt;para>Dieser Typ gestattet es, Webressourcen anzugeben für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht. &lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781855357_852545_10057" name="linkliste" visibility="private" type="_19_0_3_136d03d4_1611781871673_705551_10079">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781855359_106696_10062" annotatedElement="_19_0_3_136d03d4_1611781855357_852545_10057" body="&lt;para>Dieses Element steht für eine Liste von verlinkten Angeboten, die vom Autor der Nachricht bereitgestellt werden.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781855359_563141_10063" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781855359_554318_10061" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781855357_991858_10058" name="default" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781855360_371449_10066" annotatedElement="_19_0_3_136d03d4_1611781855357_991858_10058" body="&lt;para>Falls dieses Elements instanziiert ist, gibt der Autor dadurch an, dass auf ein eigenes Angebot verzichtet wird und dass stattdessen auf eine ggf. bereitgestellte zentrale bzw. einheitlich vorgegebene Möglichkeit verwiesen wird. &lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781855360_816812_10067" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781855360_616906_10065" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1611781855358_861039_10059" name="noreply" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1611781855362_468139_10070" annotatedElement="_19_0_3_136d03d4_1611781855358_861039_10059" body="&lt;para>Falls dieses Element instanziiert ist, ist das das Zeichen, dass weder ein eigenes Angebot bereitgestellt wird, noch auf eine zentrale Lösung verwiesen wird.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611781855362_517862_10071" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611781855361_847475_10069" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1666691511135_384844_9674" name="Anonym_textOffice" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1666691511140_613493_9675" annotatedElement="_19_0_3_940029b_1666691511135_384844_9674" body=""/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1666691653616_570086_9683" name="textOfficeXML" visibility="private" type="_14_0_1_6370212_1218191711843_120906_985">
                  <ownedComment xmi:id="_19_0_3_940029b_1666691653620_531383_9685" annotatedElement="_19_0_3_940029b_1666691653616_570086_9683" body="&lt;para>Falls dieses Element genutzt wird, ist derselbe Inhalt wie im Element &lt;emphasis role=&quot;codebf&quot;>text&lt;/emphasis> einzutragen, nur wird hier ein XML-basiertes Office-Format verwendet, um den Text technisch zu repräsentieren. Dafür ist eines der beiden XML-basierten Office-Formate ODF (= OASIS Open Document Format) und OOXML (= Office Open XML, entwickelt von Microsoft) zu verwenden. Die Verwertung dieses Elements, insoweit in einer Nachrichteninstanz instanziiert, steht im Belieben des Lesers der Nachricht.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1666691653621_228035_9686" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1666691653619_855715_9684" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1666691511140_9276_9676" name="textOfficeMimeType" visibility="private" type="_19_0_3_940029b_1666692580127_872014_9690">
                  <ownedComment xmi:id="_19_0_3_940029b_1666691511142_22376_9678" annotatedElement="_19_0_3_940029b_1666691511140_9276_9676" body="&lt;para>ODF und OOXML sind Rahmenformate, die diverse Subtypen zulassen. Dieses Element steuert die mimeType-Angabe bei, die aussagt, welches Format für die Office-Darstellung im Element textOffice instanziiert ist.&lt;/para>&#xA;&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1666691511143_29415_9679" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1666691511142_941398_9677" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1668162628374_570793_9692" name="BezugErweitert" visibility="public">
                <ownedComment xmi:id="_19_0_3_129a03b9_1668162628381_735030_9693" annotatedElement="_19_0_3_129a03b9_1668162628374_570793_9692" body="&lt;para>Dieser Typ erweitert den Typ xbau:Bezug um Angaben zu einem API-Key und einer anwendungsspezifischen Erweiterung.&lt;/para> "/>
                <generalization xmi:id="_19_0_3_129a03b9_1668162749366_146708_9710" general="_16_5_4_940029b_1465368877212_444325_5428"/>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1668162854473_318253_9711" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
                  <ownedComment xmi:id="_19_0_3_940029b_1668700688138_904238_9708" annotatedElement="_19_0_3_129a03b9_1668162854473_318253_9711" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668163168100_947610_9713" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668163168100_873022_9714" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1668163024704_848043_9712" name="AnbindungFachverfahren" visibility="public">
                <ownedComment xmi:id="_19_0_3_129a03b9_1668596611021_427024_9709" annotatedElement="_19_0_3_129a03b9_1668163024704_848043_9712" body="&lt;para>Dieser Typ deckt Parameter ab, die angewendet werden können, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1668162628381_823548_9694" name="apiKey" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1668162628386_843549_9699" annotatedElement="_19_0_3_129a03b9_1668162628381_823548_9694" body="&lt;para>Hier ist der API-Key einzutragen. Der API-Key dient als zusätzliche Absicherung der Authenzität auf Ebene der Fachnachricht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668162628387_670084_9700" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668162628385_293957_9698" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1668162628382_80253_9695" name="anwendungsspezifischeErweiterung" visibility="private" type="_19_0_3_129a03b9_1668163431794_297591_9718">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1668162628387_226275_9703" annotatedElement="_19_0_3_129a03b9_1668162628382_80253_9695" body="&lt;para>Über AnwendungsspezifischeErweiterung können über die in XBau konkret definierten Metadaten hinaus weiterführende Metadaten, z. B. fachspezifischer Natur, zu einem Informationsobjekt angegeben werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668162628388_237945_9704" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668162628387_898304_9702" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1668163431794_297591_9718" name="AnwendungsspezifischeErweiterungXML" visibility="public">
                <ownedComment xmi:id="_19_0_3_129a03b9_1668163431795_150056_9719" annotatedElement="_19_0_3_129a03b9_1668163431794_297591_9718" body="&lt;para>Die AnwendungsspezifischeErweiterungXML bietet die Möglichkeit, mittels Einbindung externer XML-Schemata weitere Metadaten zu spezifizieren. Es können beliebige XML-Schemata mit unterschiedlichen Namensräumen angegeben werden. Die XML-Schema-Validierung der weiterführenden Metadaten erfolgt innerhalb der XBau-Nachricht selbst &quot;lax&quot;.&lt;/para>"/>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479353605_22016_9336" name="Datentypen zu Prozessnachrichten" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1552127281869_824594_14787" name="Anonym_BefundFormell" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1552127281872_940165_14792" annotatedElement="_18_0_2_940029b_1552127281869_824594_14787" body=""/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1552127281872_444985_14793" name="artDesBefundes" visibility="private" type="_18_0_2_940029b_1552127588117_500969_14828">
                  <ownedComment xmi:id="_18_0_2_940029b_1552127281877_438571_14803" annotatedElement="_18_0_2_940029b_1552127281872_444985_14793" body="&lt;para>In diesem Element wird die Befundkategorie angegeben, der dieser Befund zugeordnet werden kann.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1552127281877_748516_14804" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1552127281877_598367_14802" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1552127281875_614895_14796" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                  <ownedComment xmi:id="_18_0_2_940029b_1552127281878_429485_14815" annotatedElement="_18_0_2_940029b_1552127281875_614895_14796" body="&lt;para>Hier wird der Sachverhalt des Befundes beschrieben. Dieser Sachverhalt enthält Details, die für den Adressaten hilfreich sind ergänzend zur angegebenen Art des Befundes.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1552127281878_929087_14816" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1552127281878_454104_14814" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1552127281868_654162_14786" name="BefundlisteFormell" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1552127281871_346470_14789" annotatedElement="_18_0_2_940029b_1552127281868_654162_14786" body="&lt;para>Dieser Typ beinhaltet die Befunde der formellen Prüfung eines Antrags, einer Anzeige oder einer Erklärung. Für jeden Befund sind die entsprechenden Parameter gefüllt, die Inhalt und Bezug des Befundes für den Antragsteller bzw. Anfragenden nachvollziehbar machen.&lt;/para>"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1552127281871_563444_14790" name="befund" visibility="private" type="_18_0_2_940029b_1552127281869_824594_14787" aggregation="composite" association="_18_0_2_940029b_1552127281870_107742_14788">
                  <ownedComment xmi:id="_18_0_2_940029b_1552127281876_873618_14799" annotatedElement="_18_0_2_940029b_1552127281871_563444_14790" body="&lt;para>Dieses Element stellt genau einen Befund der Befundliste dar.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1552127281876_187299_14800" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1552127281876_506491_14798" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1541324483751_614901_11350" name="Rueckweisung" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1541324483751_665655_11351" annotatedElement="_18_0_2_940029b_1541324483751_614901_11350" body="&lt;para>Dieser Typ nimmt Angaben zu Art und Ort eines Fehlers auf, der zur Rückweisung der Nachricht geführt hat. &lt;/para>&#xA;&#xA;"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541324505462_418915_11367" name="rueckweisungsgrund" visibility="private" type="_18_0_2_940029b_1541262088385_800525_11851" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1541324505465_120963_11371" annotatedElement="_18_0_2_940029b_1541324505462_418915_11367" body="&lt;para>Jede Instanz dieses Elements enthält Informationen zu einem Fehler bzw. einem Mangel, der in Bezug auf die erhaltene Nachricht identifiziert wurde.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541324505465_779282_11372" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541324505464_44971_11370" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541324505463_80054_11368" name="idNachricht" visibility="private" type="_19_0_4_41901a4_1664881730540_634830_6898">
                  <ownedComment xmi:id="_18_0_2_940029b_1541324505466_804390_11375" annotatedElement="_18_0_2_940029b_1541324505463_80054_11368" body="&lt;para>Identifikationsmerkmale der zurückgewiesenen XBau-Nachricht, die der Autor der Rückweisung zu einem Zeitpunkt in der Vergangenheit empfangen hat.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541324505466_688423_11376" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541324505466_186950_11374" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541324505464_278413_11369" name="nachricht" visibility="private" type="_14_0_1_6370212_1218191711843_120906_985">
                  <ownedComment xmi:id="_18_0_2_940029b_1541324505467_865555_11379" annotatedElement="_18_0_2_940029b_1541324505464_278413_11369" body="&lt;para>Dieses Element bildet die zurückgewiesene Fachnachricht ohne Attachments im Binärformat ab..&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541324505468_776322_11380" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541324505467_904601_11378" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1541262088385_800525_11851" name="Rueckweisungsgrund" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1541262170416_555404_11921" annotatedElement="_18_0_2_940029b_1541262088385_800525_11851" body="&lt;para>Dieser Typ nimmt Angaben zu Art und Ort eines Fehlers auf, der zur Rückweisung der Nachricht geführt hat. &lt;/para>&#xA;&#xA;"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541262170416_216816_11922" name="grund" visibility="private" type="_18_0_2_940029b_1541261707920_683057_11719" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1541262170432_582703_11958" annotatedElement="_18_0_2_940029b_1541262170416_216816_11922" body="&lt;para>Mit diesem Element wird der Grund übermittelt, aus dem die Nachricht zurückgewiesen wird. Die im Rahmen der hier zu verwendenden Codeliste zur Verfügung gestellten Rückweisungsgründe sind kontextunabhängig und finden daher in allen Übermittlungskontexten Anwendung.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541262170432_568324_11959" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541262170432_43932_11957" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541262170416_106272_11923" name="fehlertext" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_18_0_2_940029b_1541262170432_173694_11962" annotatedElement="_18_0_2_940029b_1541262170416_106272_11923" body="&lt;para>Hier steht ein ergänzender textueller Hinweis auf die Art des Fehlers, der zur Zurückweisung der Nachricht geführt hat. Sofern kein Text angegeben ist (das Element also nicht übermittelt wird), gilt allein die Erläuterung zur im Element grund stehenden Fehlerkennzahl.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541262170432_686678_11963" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541262170432_349374_11961" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_18_0_2_940029b_1552127281870_107742_14788" name="" visibility="public" memberEnd="_18_0_2_940029b_1552127281871_563444_14790 _18_0_2_940029b_1552127281876_702012_14797">
                <ownedEnd xmi:id="_18_0_2_940029b_1552127281876_702012_14797" name="" visibility="private" type="_18_0_2_940029b_1552127281868_654162_14786" association="_18_0_2_940029b_1552127281870_107742_14788"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1615478976523_673762_9731" name="Identifikation.Nachricht" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1615478976525_4203_9732" annotatedElement="_19_0_3_136d03d4_1615478976523_673762_9731" body="&lt;para>Identifkationsmerkmale zu einer Nachricht. Dieser Typ kann im ID-Block zu einer Nachricht verwendet werden oder in einem Abschnitt, der auf eine Nachricht referenziert.&lt;/para>&#xA;"/>
                <generalization xmi:id="_19_0_3_129a03b9_1678807820375_664559_9935" general="_19_0_4_41901a4_1664542664488_758001_6848"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1615478976528_979620_9735" name="nachrichtenUUID" visibility="private" type="_19_0_4_41901a4_1664542664473_543941_6845">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1615478976534_804742_9747" annotatedElement="_19_0_3_136d03d4_1615478976528_979620_9735" body="&lt;para>Hier wird der Universally Unique Identifier (UUID) der Nachricht mitgeteilt, der das primäre Identifikationsmerkmal einer Nachricht darstellt. Der UUID der Nachricht ist weltweit eindeutig. So wird es möglich, Nachrichten hersteller- und anwendungsübergreifend eindeutig zu identifizieren. &lt;/para>&#xA;&lt;para>Für jede Nachricht muss eine neue UUID erzeugt werden, um eine eindeutige Identifikation der Nachricht sicherzustellen. Insbesondere ist es nicht zulässig, in einer korrigierten Nachricht (bspw. nach Erhalt einer RTS-Nachricht) die UUID der ursprünglichen Nachricht wiederzuverwenden.&lt;/para>&#xA;&lt;para>Sofern eine einmal erzeugte Nachricht ein weiteres Mal gesendet werden soll (bspw. aufgrund von Problemen beim Nachrichtentransport), muss die UUID nicht angepasst werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1615478976534_182813_9748" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1615478976534_472174_9746" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1615478976526_667304_9733" name="nachrichtentyp" visibility="private" type="_19_0_3_136d03d4_1615476797907_523392_9724">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1615478976530_837001_9739" annotatedElement="_19_0_3_136d03d4_1615478976526_667304_9733" body="&lt;para>Die eindeutige Identifizierungsnummer für einen Nachrichtentyp. Der konkret zu verwendende Datentyp für die Übermittlung des Schlüsselwertes wird durch den Fachstandard auf Schemaebene festgelegt.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1615478976531_147470_9740" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1615478976530_392700_9738" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1615478976527_691672_9734" name="erstellungszeitpunkt" visibility="private" type="_14_0_1_6370212_1218191729703_367727_1061">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1615478976533_227442_9743" annotatedElement="_19_0_3_136d03d4_1615478976527_691672_9734" body="&lt;para>Der Zeitpunkt, an dem die Nachricht erstellt wurde.&lt;/para>&#xA;&lt;para>Dieses Feld wird durch das Fachverfahren beim Erstellen der Nachricht gefüllt. Hier ist explizit nicht der Sende- und Empfangszeitpunkt  festgehalten, denn die können in der Regel der Transportschicht entnommen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1615478976533_813268_9744" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1615478976532_388097_9742" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1617016621104_44246_9389" name="Nachrichtenkopf.G2G" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1617017384818_422698_9421" annotatedElement="_19_0_3_136d03d4_1617016621104_44246_9389" body="&lt;para>Nachrichtenkopf für Nachrichten von Behörden (bzw. öffentlichen Stellen oder Diensten) an andere Behörden (bzw. öffentliche Stellen oder Dienste).&lt;/para>"/>
                <generalization xmi:id="_19_0_3_129a03b9_1678821228460_613379_9943" general="_19_0_4_41901a4_1664542664488_238164_6851"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617016815724_215263_9390" name="identifikation.nachricht" visibility="private" type="_19_0_3_136d03d4_1615478976523_673762_9731" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617016815733_514481_9394" annotatedElement="_19_0_3_136d03d4_1617016815724_215263_9390" body="&lt;para>Hier werden die Identifkationsmerkmale zur vorliegenden Nachricht genannt.&lt;/para>"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617016815730_248817_9391" name="leser" visibility="private" type="_19_0_4_41901a4_1664542664473_466147_6844" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617016815735_852562_9398" annotatedElement="_19_0_3_136d03d4_1617016815730_248817_9391" body="&lt;para>Hier wird die Fachbehörde bzw. Organisation genannt, für die die vorliegende Nachricht bestimmt ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617016815735_634364_9399" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617016815735_513784_9397" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617016815731_950476_9392" name="autor" visibility="private" type="_19_0_4_41901a4_1664542664473_466147_6844" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617016815736_45417_9402" annotatedElement="_19_0_3_136d03d4_1617016815731_950476_9392" body="&lt;para>Hier wird die Fachbehörde bzw. Organisation genannt, die die vorliegende Nachricht erstellt hat.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617016815736_561372_9403" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617016815736_555587_9401" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1617018517570_525675_9422" name="Nachricht.G2G" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1617018517572_747392_9423" annotatedElement="_19_0_3_136d03d4_1617018517570_525675_9422" body="&lt;para>Nachrichtenstruktur für die Kommunikation von Behörden (bzw. öffentlichen Stellen oder Diensten) mit anderen Behörden (bzw. öffentlichen Stellen oder Diensten).&lt;/para>"/>
                <generalization xmi:id="_19_0_3_129a03b9_1678821150556_823315_9941" general="_19_0_4_41901a4_1664542664488_129929_6847"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517574_560370_9426" name="produkt" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517581_187523_9442" annotatedElement="_19_0_3_136d03d4_1617018517574_560370_9426" body="&lt;para>In diesem Attribut ist der Name des Produktes (der Software) einzutragen, mit dem diese Nachricht erstellt worden ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517581_11871_9443" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517581_487471_9441" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517574_696333_9427" name="produkthersteller" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517582_642356_9446" annotatedElement="_19_0_3_136d03d4_1617018517574_696333_9427" body="&lt;para>In diesem Attribut ist der Name der Firma oder der Organisation einzutragen, die für das DV-Verfahren verantwortlich ist, mit dem diese Nachricht erstellt worden ist.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517583_808205_9447" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517582_922091_9445" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517575_48654_9428" name="produktversion" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517584_591224_9450" annotatedElement="_19_0_3_136d03d4_1617018517575_48654_9428" body="&lt;para>In diesem Attribut sollen ergänzende Hinweise zu dem Produkt, mit dem diese Nachricht erstellt worden ist, eingetragen werden. Dies sind Angaben, die für eine möglichst präzise Identifikation im Fehlerfall hilfreich sind, wie zum Beispiel Version und Patchlevel.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517584_412113_9451" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517583_452383_9449" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517572_887187_9424" name="standard" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731" isReadOnly="true">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517578_239395_9434" annotatedElement="_19_0_3_136d03d4_1617018517572_887187_9424" body="&lt;para>In diesem Attribut wird der Name des Standards übermittelt, aus dem die Nachricht stammt. Der Name des Standards wird durch den Fachstandard als fixed-Value auf Schemaebene festgelegt (z. B. &lt;emphasis>XPersonenstand&lt;/emphasis>).&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517578_360878_9435" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517578_233068_9433" name="" visibility="public" value="1"/>
                  <defaultValue xmi:type="uml:LiteralString" xmi:id="_19_0_3_c4f030d_1637573981904_513524_9668" name="" visibility="public" value="XBau-Kernmodul"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517576_517352_9429" name="test" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517584_528131_9454" annotatedElement="_19_0_3_136d03d4_1617018517576_517352_9429" body="&lt;para>Dieses Attribut ist optional. Ist es vorhanden, so sagt dies aus, dass es sich um eine Nachricht handelt, die (aus Sicht des Senders der Nachricht) nicht im normalen Produktivbetrieb behandelt werden soll. Über den Inhalt des Attributes wird nichts weiter ausgesagt, dies kann bilateral zwischen den Kommunikationspartnern vereinbart werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517585_463396_9455" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517584_664392_9453" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517573_632173_9425" name="version" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731" isReadOnly="true">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517580_469380_9438" annotatedElement="_19_0_3_136d03d4_1617018517573_632173_9425" body="&lt;para>In diesem Attribut wird die Version des Standards übermittelt, aus dem die Nachricht stammt. Die Versionsbezeichnung wird durch den Fachstandard als fixed-Value auf Schemaebene festgelegt (z. B. &lt;emphasis>1.5.0&lt;/emphasis>).&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517580_26992_9439" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517579_361103_9437" name="" visibility="public" value="1"/>
                  <defaultValue xmi:type="uml:LiteralString" xmi:id="_19_0_3_c4f030d_1637574049241_530026_9669" name="" visibility="public" value="1.4.0"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1617018517576_983893_9430" name="nachrichtenkopf.g2g" visibility="private" type="_19_0_3_136d03d4_1617016621104_44246_9389" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1617018517586_890521_9458" annotatedElement="_19_0_3_136d03d4_1617018517576_983893_9430" body="&lt;para>Dieses Element enthält die  Kopfinformationen zu Nachrichten des vorliegenden Typs.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617018517586_260912_9459" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617018517585_88665_9457" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622230009808_308184_9453" name="Anonym_TextOderTextFormatiert" visibility="public">
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622230030992_984691_9454" name="textUnformatiert" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622230110793_311068_9463" annotatedElement="_19_0_3_136d03d4_1622230030992_984691_9454" body="&lt;para>Hier wird der unformatierte Text übermittelt.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622230173886_182229_9465" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622230173886_188218_9466" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622230060145_801698_9455" name="textFormatiert" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622230121397_343168_9464" annotatedElement="_19_0_3_136d03d4_1622230060145_801698_9455" body="&lt;para>Hier wird der formatierte Text übermittelt.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622230178973_694988_9467" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622230178973_708819_9468" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_129a03b9_1694598356258_185770_8876" name="Gebuehrenbescheid" visibility="public" URI="">
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694598367137_540587_8877" name="Gebuehrenbescheid" visibility="public">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598367137_250944_8878" annotatedElement="_19_0_3_129a03b9_1694598367137_540587_8877" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Gebührenbescheids der Fachbehörde. Es sind die Daten zu Gegenstand, Herleitung, Betrag und Bezahlung der Gebühren enthalten.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367137_657904_8879" name="istVorauszahlungsbescheid" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_765710_8888" annotatedElement="_19_0_3_129a03b9_1694598367137_657904_8879" body="&lt;para>Falls es sich nicht um den abschließenden Gebührenbescheid, sondern um einen Vorauszahlungsbescheid handelt, ist hier true einzutragen. Dann weiß der Empfänger, dass weitere Gebührenbescheide zum angegebenen Vorgang zu erwarten sind.&lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_31228_8889" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367145_888361_8887" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367137_167267_8880" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_767911_8892" annotatedElement="_19_0_3_129a03b9_1694598367137_167267_8880" body="&lt;para>Hier ist die Rechtsgrundlage für die Gebühr bzw. eine sonstige Begründung einzutragen.&lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_923548_8893" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_404372_8891" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367137_819782_8881" name="kostenberechnung" visibility="private" type="_19_0_3_129a03b9_1694598444342_688874_8929">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_134795_8896" annotatedElement="_19_0_3_129a03b9_1694598367137_819782_8881" body="&lt;para>Dieses Objekt enthält alle Informationen zu den Positionen des Gebührenbescheids und deren Summierung zu einem Geldbetrag.&lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_674202_8897" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_508864_8895" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367145_783195_8882" name="zahlungsdaten" visibility="private" type="_19_0_3_129a03b9_1694598818396_360789_9002">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_529832_8900" annotatedElement="_19_0_3_129a03b9_1694598367145_783195_8882" body="&lt;para>Dieses Element enthält die Angaben, die der Anwender zur Veranlassung einer bargeldlosen Bezahlung gemäß SEPA benötigt. &lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_948131_8901" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_968021_8899" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367145_235940_8883" name="informationVerspaetungszuschlag" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_80180_8904" annotatedElement="_19_0_3_129a03b9_1694598367145_235940_8883" body="&lt;para>Hier werden Angaben zu Zuschlägen bei Fristversäumnis eingetragen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_337123_8905" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_413320_8903" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367145_783691_8884" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_753179_8908" annotatedElement="_19_0_3_129a03b9_1694598367145_783691_8884" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zum Bescheid gegeben.&lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_391649_8909" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_128095_8907" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598367145_885575_8885" name="anlage" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598367147_525424_8912" annotatedElement="_19_0_3_129a03b9_1694598367145_885575_8885" body="&lt;para>Mit diesem Element kann der Gebührenbescheid als PDF-Datei übermittelt werden.&lt;/para>&#xA;"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598367147_900335_8913" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598367147_596493_8911" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694598444342_688874_8929" name="Kostenberechnung" visibility="public">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598444342_536364_8930" annotatedElement="_19_0_3_129a03b9_1694598444342_688874_8929" body="&lt;para>Dieser Datentyp enthält die Aufschlüsselung der Gebühren und Auslagen in einzelne Positionen und die sich ergebende Summe. Es sind auch gebührenfreie Positionen oder negative Beträge (z.B. bei Abschlägen) möglich.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598444342_538478_8931" name="gebuehrenposition" visibility="private" type="_19_0_3_129a03b9_1694598473346_186963_8953">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598444342_125265_8936" annotatedElement="_19_0_3_129a03b9_1694598444342_538478_8931" body="&lt;para>Dieses Element steht für eine Gebührenposition.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598444342_561086_8937" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598444342_733279_8935" name="" visibility="public" value="*"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598444342_176201_8932" name="auslagenposition" visibility="private" type="_19_0_3_129a03b9_1694598571521_16955_8993">
