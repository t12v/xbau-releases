              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846400_594574_24566" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846391_46191_24537" name="anforderungAussenbauteile" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846400_586973_24571" annotatedElement="_19_0_4_b6602da_1696422846391_46191_24537" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass die Anforderungen an Außenbauteile der neu hinzugekommenen Räume gemäß § 51 Abs. 1 GEG eingehalten werden. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846401_749077_24572" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846400_675008_24570" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846392_358571_24541" name="sommerlicherWaermeschutz" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846404_958043_24587" annotatedElement="_19_0_4_b6602da_1696422846392_358571_24541" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass der sommerliche Wärmeschutz (Ausbau beträgt mehr als 50m2) nach § 51 Abs. 2 GEG nachgewiesen wurde. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846404_591297_24588" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846404_489443_24586" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846392_230794_24539" name="beratungsgespraech" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846402_653179_24579" annotatedElement="_19_0_4_b6602da_1696422846392_230794_24539" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass ein informatorisches Beratungsgespräch durchgeführt wurde. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846403_136770_24580" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846402_684232_24578" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846391_523848_24538" name="vereinfachtesVerfahrenEinzonenmodell" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846401_201633_24575" annotatedElement="_19_0_4_b6602da_1696422846391_523848_24538" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass es sich um ein vereinfachtes Verfahren nach § 32 GEG (Einzonenmodell) handelt. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846401_824651_24576" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846401_974695_24574" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846394_909195_24547" name="geometrischeAbmessung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846406_92877_24611" annotatedElement="_19_0_4_b6602da_1696422846394_909195_24547" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass eine geometrische Abmessung (vereinfachtes Verfahren oder Erfahrungswerte) nach § 50 GEG ermittelt wurde. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846407_665515_24612" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846406_577793_24610" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696422846395_381465_24552" name="waermeKaelteVersorgungImQuartier" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696422846410_315168_24631" annotatedElement="_19_0_4_b6602da_1696422846395_381465_24552" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass die Wärme- oder Kälteversorgung im Quartier nach § 107 GEG erfolgt. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696422846410_21244_24632" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696422846410_603575_24630" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
