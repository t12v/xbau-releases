  <XOEVProfil:xoevABIE xmi:id="_ngsNKpDEEfGoGvl6Hw52FA" base_Class="_18_0_2_940029b_1577646723035_837384_15544" Abweichung="Abweichende Bezeichnung der Klasse" MotivationDerAbweichung="Es werden von der Kernkomponente Geokodierung nur die Eigenschaften verwendet, die sich auf das Liegenschaftskataster beziehen."/>
