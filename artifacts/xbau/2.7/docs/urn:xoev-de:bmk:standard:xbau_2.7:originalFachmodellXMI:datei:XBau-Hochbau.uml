                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287322_278997_6888" annotatedElement="_16_5_4_5b501fb_1406633287172_466724_5864" body="Hier kann angegeben werden, welche Sprachen eine natürliche Person als Fremdsprache beherrscht."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287322_599215_6889" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287172_466724_5864"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287182_32150_5903" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287183_164532_5907 _16_5_4_5b501fb_1406633287335_983696_7040">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287335_80481_7039" annotatedElement="_16_5_4_5b501fb_1406633287182_32150_5903" body="Angaben zur Unterorganisation dieser Organisation."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287335_983696_7040" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_771644_5372" association="_16_5_4_5b501fb_1406633287182_32150_5903"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287183_746031_5904" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287185_437607_5915 _16_5_4_5b501fb_1406633287335_520293_7042">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287335_135053_7041" annotatedElement="_16_5_4_5b501fb_1406633287183_746031_5904" body="Hier werden Angaben zum Zeitraum der Existenz einer Organisation gemacht, der mit Gründungs- und Auflösungsdatum der Organisation angegeben wird."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287335_520293_7042" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_771644_5372" association="_16_5_4_5b501fb_1406633287183_746031_5904"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287183_161413_5905" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287186_569212_5916 _16_5_4_5b501fb_1406633287335_368675_7044">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287335_601079_7043" annotatedElement="_16_5_4_5b501fb_1406633287183_161413_5905" body="Informationen zur autorisierenden Registrierung  einer Organisation in einem fachlichen Register."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287335_368675_7044" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_771644_5372" association="_16_5_4_5b501fb_1406633287183_161413_5905"/>
