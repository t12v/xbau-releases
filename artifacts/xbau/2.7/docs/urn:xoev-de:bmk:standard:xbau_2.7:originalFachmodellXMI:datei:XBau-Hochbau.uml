              <ownedComment xmi:id="_19_0_4_b6602da_1750073082087_65925_31679" annotatedElement="_19_0_4_b6602da_1750072921481_982981_31551" body="&lt;para>Hier kann die Nummer im Bestandsverzeichnis des Erbbaugrundbuchs angegeben werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750073032227_861101_31656" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750073032228_184122_31657" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1658334000809_885284_18259" name="Anonym_AngabenGrundstuecke" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658334038688_996111_18260" name="grundstueck" visibility="private" type="_19_0_4_b6602da_1752219183845_859478_31114">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658385847475_544335_18285" annotatedElement="_19_0_3_129a03b9_1658334038688_996111_18260" body="&lt;para>Mit diesem Element werden die Daten zu einem der Grundstücke übermittelt, auf das sich die Anfrage bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658334091862_874339_18262" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658334091862_571402_18263" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1752219183845_859478_31114" name="GrundstueckBaulast" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1752219434473_269735_31124" annotatedElement="_19_0_4_b6602da_1752219183845_859478_31114" body="&lt;para>Dieses Element enthält die Angaben des Grundstücks oder der Grundstücke, zu denen die Auskunft angefragt wird.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1752219320544_170415_31116" general="_19_0_3_136d03d4_1611871246531_270636_23533"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1752219357377_859808_31117" name="artBaulastauskunft" visibility="private" type="_19_0_4_b6602da_1750057006289_680868_30087">
              <ownedComment xmi:id="_19_0_4_b6602da_1752219357382_486957_31119" annotatedElement="_19_0_4_b6602da_1752219357377_859808_31117" body="&lt;para>In diesem Element wird angegeben, ob eine einfache Auskunft gewünscht ist, oder ob bei einem belasteten Grundstück auch eine Abschrift benötigt wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1752219357383_847345_31120" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1752219357381_430966_31118" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1658127585185_917813_18202" name="Anonym_BerechtigtesInteresse" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658127760325_867873_18215" name="beschreibung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658127760326_883332_18217" annotatedElement="_19_0_3_129a03b9_1658127760325_867873_18215" body="&lt;para>Mit diesem Element kann das berechtigte Interesse je nach Anforderung der unteren Bauaufsichtsbehörde erläutert werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658127760327_502190_18218" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658127760326_600670_18216" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658127747512_779447_18208" name="nachweis" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658127747513_505720_18210" annotatedElement="_19_0_3_129a03b9_1658127747512_779447_18208" body="&lt;para>Mit diesem Element kann ein Nachweis über das berechtige Interesse beigefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658127747513_940778_18211" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658127747513_409763_18209" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1750063494976_210957_30442" name="Anonym_GrundstueckAuskunft" visibility="public">
            <ownedAttribute xmi:id="_19_0_4_b6602da_1750063494977_403576_30443" name="angabeGrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_4_b6602da_1750063494982_791307_30449" annotatedElement="_19_0_4_b6602da_1750063494977_403576_30443" body="&lt;para>Dieses Element enthält Angaben zum Grundstück, auf das sich die Anfrage bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750063494982_648845_30450" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750063494980_647593_30448" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1750063494979_895499_30446" name="baulastErgebnis" visibility="private" type="_19_0_3_136d03d4_1655371247411_625691_18517">
              <ownedComment xmi:id="_19_0_4_b6602da_1750063494985_136041_30461" annotatedElement="_19_0_4_b6602da_1750063494979_895499_30446" body="&lt;para>Mit diesem Element werden nähere Informationen zur Baulastauskunft übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750063494986_860399_30462" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750063494985_562772_30460" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1750063494979_662720_30445" name="baulastDaten" visibility="private" type="_19_0_3_940029b_1669644209576_648844_21935">
              <ownedComment xmi:id="_19_0_4_b6602da_1750063494984_491558_30457" annotatedElement="_19_0_4_b6602da_1750063494979_662720_30445" body="&lt;para>Falls Baulasten vorhanden sind, beinhaltet dieses Element die Daten der Baulast aus dem Baulastenverzeichnis.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750063494985_29847_30458" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750063494983_949297_30456" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1750063494980_385413_30447" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_4_b6602da_1750063494987_240140_30465" annotatedElement="_19_0_4_b6602da_1750063494980_385413_30447" body="&lt;para>Falls Baulasten vorhanden sind, werden mit diesem Element Anlagen, wie  beispielsweise Zeichnungen, Baulastenblatt oder Lageplan, übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750063494987_246958_30466" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750063494986_609314_30464" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1669644209576_648844_21935" name="BaulastErweitert" visibility="public">
            <ownedComment xmi:id="_19_0_3_940029b_1669644452998_239156_21971" annotatedElement="_19_0_3_940029b_1669644209576_648844_21935" body="&lt;para>Erweiterter Datentyp für Baulasten, die bereits vorliegen und daher über eine zugeordnete Baulastnummer gemäß Baulastenverzeichnis verfügen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_940029b_1669645065951_473474_21999" general="_19_0_3_136d03d4_1611871246524_125172_23503"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1669644364266_795801_21963" name="baulastnummer" visibility="private" type="_14_0_1_6370212_1218191867218_582037_1593">
              <ownedComment xmi:id="_19_0_3_940029b_1669644364273_447012_21965" annotatedElement="_19_0_3_940029b_1669644364266_795801_21963" body="&lt;para>Soweit von einer bereits existierenden Baulast die Rede ist (nicht eine neue beantragt wird) und eine Baulastnummer vergeben worden ist, ist sie in dieses Element einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1669644364274_830537_21966" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1669644364273_392664_21964" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1652251114534_152277_18037" name="Anonym_Baulastauskunft" visibility="public">
            <ownedAttribute xmi:id="_19_0_4_b6602da_1750063263375_107873_30399" name="grundstueck" visibility="private" type="_19_0_4_b6602da_1750063494976_210957_30442">
              <ownedComment xmi:id="_19_0_4_b6602da_1750063263377_971749_30401" annotatedElement="_19_0_4_b6602da_1750063263375_107873_30399" body="&lt;para>Mit diesem Element werden die Daten zu einem der Grundstücke übermittelt, auf das sich die Baulastauskunft bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1750063263378_844216_30402" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1750063263377_901107_30400" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1756978536310_860233_31468" name="Anonym_BefundFristBaulast" visibility="public">
            <ownedAttribute xmi:id="_19_0_4_b6602da_1756978536310_723423_31469" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1756978536310_635732_31472" annotatedElement="_19_0_4_b6602da_1756978536310_723423_31469" body="&lt;para>Hier können die Ergebnisse der formellen Prüfung in Form einer strukturierten Befundliste eingetragen werden (die Liste zählt Mängel der Anfrage auf).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1756978536325_152443_31473" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1756978536310_50042_31471" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1756978536310_247438_31470" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1756978536327_161094_31476" annotatedElement="_19_0_4_b6602da_1756978536310_247438_31470" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist eingetragen werden, innerhalb derer die genannten Mängel durch den Antragsteller zu beseitigen sind und eine überarbeitete Anfrage einzureichen ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1756978536327_822755_31477" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1756978536327_265127_31475" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1758273736209_224807_31829" name="Anonym_GrundstueckeBaulastLoeschung" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1758273736216_925564_31830" annotatedElement="_19_0_4_b6602da_1758273736209_224807_31829" body="&lt;para>Typ für die an der Umsetzung eines Bauprojekts beteiligten Parteien (Personen und Organisationen).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758273736216_219363_31831" name="belastetesGrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_4_b6602da_1758273736218_555531_31834" annotatedElement="_19_0_4_b6602da_1758273736216_219363_31831" body="&lt;para>Für jedes aufzuführende belastete Grundstück ist ein Element zu füllen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758273736218_993454_31835" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758273736218_279080_31833" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758273736217_193387_31832" name="beguenstigtesGrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_4_b6602da_1758273736220_239601_31838" annotatedElement="_19_0_4_b6602da_1758273736217_193387_31832" body="&lt;para>Für jedes aufzuführende begünstigte Grundstück  ist ein Element zu füllen.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758273736220_566282_31839" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758273736219_997796_31837" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1784012712503_850368_34794" name="BaulastFortschreibung" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1784012712568_607379_34824" annotatedElement="_19_0_4_b6602da_1784012712503_850368_34794" body="&lt;para>Dieser Typ beinhaltet die Daten zur Fortschreibung einer Baulast.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1784012712568_564799_34825" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_4_b6602da_1784012712572_342739_34833" annotatedElement="_19_0_4_b6602da_1784012712568_564799_34825" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Baulast. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Baulast eindeutig zu identifizieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1784012712572_680133_34834" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1784012712572_329012_34832" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1784012712568_771023_34826" name="beteiligtePersonen" visibility="private" type="_19_0_3_136d03d4_1611871246525_412685_23504" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1784012712572_877542_34837" annotatedElement="_19_0_4_b6602da_1784012712568_771023_34826" body="&lt;para>Die am Baulastverfahren beteiligten Personen sind unterhalb dieses Elements einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1784012712572_978987_34838" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1784012712572_971098_34836" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1784012712570_365921_34827" name="beteiligteGrundstuecke" visibility="private" type="_19_0_3_136d03d4_1611871246525_327813_23505" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1784012712573_88424_34841" annotatedElement="_19_0_4_b6602da_1784012712570_365921_34827" body="&lt;para>Hier werden die für das Baulastverfahren relevanten Grundstücke oder Flurstücke eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1784012712573_99044_34842" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1784012712573_682261_34840" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1784012712570_442313_34829" name="artDerBaulast" visibility="private" type="_19_0_4_b6602da_1749202368327_408887_29479">
              <ownedComment xmi:id="_19_0_4_b6602da_1784012712573_259111_34849" annotatedElement="_19_0_4_b6602da_1784012712570_442313_34829" body="&lt;para>In diesem Element wird die Art der Baulast angegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1784012712573_736471_34850" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1784012712573_602146_34848" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239747_251022_22711" name="Hilfsmittel" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246529_313323_23523" name="BezugHauptbaugenehmigung" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264239_111742_25707" annotatedElement="_19_0_3_136d03d4_1611871246529_313323_23523" body="&lt;para>Dieser Typ nimmt Eintragungen im Rahmen der Beantragung eines Nachtrags zu einer bereits erteilten Baugenehmigung auf. Diese Eintragungen dienen dazu, auf die bereits erteilte Baugenehmigung Bezug zu nehmen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264239_266298_25708" name="vorgang" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282181_168838_30906" annotatedElement="_19_0_3_136d03d4_1611871264239_266298_25708" body="&lt;para>In dieses Element ist das Zeichen (Aktenzeichen) der Hauptbaugenehmigung einzutragen, also des Vorgangs, im Rahmen dessen die Bauaufsichtsbehörde die Baugenehmigung erteilt hat, zu der mit der vorliegenden Nachrichteninstanz ein Nachtrag beantragt wird. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282181_853172_30907" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282181_91157_30905" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246530_701052_23524" name="BezugVorbescheid" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264240_538566_25710" annotatedElement="_19_0_3_136d03d4_1611871246530_701052_23524" body="&lt;para>Dieser Typ nimmt im Rahmen der Beantragung einer Baugenehmigung den Bezug auf einen in der Vergangenheit erteilten Vorbescheid auf.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264240_475735_25711" name="vorgang" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282182_254115_30910" annotatedElement="_19_0_3_136d03d4_1611871264240_475735_25711" body="&lt;para>In dieses Element ist das Zeichen (Aktenzeichen) des erteilten Vorbescheids einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282182_673800_30911" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282182_534417_30909" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1649838383583_954587_17975" name="referenz" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897" isDerivedUnion="true">
              <ownedComment xmi:id="_19_0_3_129a03b9_1650606960824_398646_17978" annotatedElement="_19_0_3_129a03b9_1649838383583_954587_17975" body="&lt;para>In dieses Element ist die Referenz des erteilten Vorbescheids einzutragen. Dies ist der Identifier des Antragsservice (der mit dem Antrag bzw. der Anzeige bei der Bauaufsichtsbehörde (bzw. Aufsichtsbehörde für den Breitbandausbau) eingegangen ist) oder der Abfrage (auf die die vorliegende Nachricht eine Antwort ist).&lt;/para>&#xA;&lt;para>Falls die vorliegende Nachricht an ein Online-Portal gerichtet ist, kann so der Projektraum bzw. Postkorb angesteuert werden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1649838447796_590691_17977" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1649838447796_487446_17978" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1649861960963_127678_17994" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_129a03b9_1650447907249_282789_17974" annotatedElement="_19_0_3_129a03b9_1649861960963_127678_17994" body="&lt;para>In dieses Element ist das Datum des erteilten Vorbescheids einzutragen. &lt;/para>"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1617059736838_505195_16785" name="Bezug" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1617059736840_882805_16786" annotatedElement="_19_0_3_136d03d4_1617059736838_505195_16785" body="&lt;para>Dieser Typ gestattet Eintragungen, um auf einen Antrag, einen Vorgang und ggf. auf eine Nachricht, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1617059736840_806061_16787" name="referenz" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_136d03d4_1617059736844_335350_16792" annotatedElement="_19_0_3_136d03d4_1617059736840_806061_16787" body="&lt;para>Hier ist der Identifier des Antragsservice (der mit dem Antrag bzw. der Anzeige bei der Bauaufsichtsbehörde eingegangen ist) oder der Abfrage (auf die die vorliegende Nachricht eine Antwort ist) anzugeben.&lt;/para>&#xA;&lt;para>Falls die vorliegende Nachricht an ein Online-Portal gerichtet ist, kann so der Projektraum bzw. Postkorb angesteuert werden.&lt;/para>&#xA;&lt;para>Falls die vorliegende Nachricht an die Statistik gerichtet ist, muss das Kindelement &quot;referenz&quot; befüllt sein.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617059736845_399647_16793" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617059736844_572741_16791" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1617059736841_992498_16788" name="vorgang" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1617059736846_796401_16796" annotatedElement="_19_0_3_136d03d4_1617059736841_992498_16788" body="&lt;para>Eine Instanz dieses Elements enthält, falls ein solches vergeben wurde, das Zeichen (Aktenzeichen) des von der Bauaufsichtsbehörde geführten Vorgangs, innerhalb dessen diese Nachricht übermittelt wird. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617059736846_417669_16797" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617059736846_472968_16795" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1617059736842_167562_16789" name="bezugNachricht" visibility="private" type="_19_0_3_136d03d4_1611871243169_203077_23290">
              <ownedComment xmi:id="_19_0_3_136d03d4_1617059736848_926415_16800" annotatedElement="_19_0_3_136d03d4_1617059736842_167562_16789" body="&lt;para>Falls ein solcher Zusammenhang vorliegt, sind hier die Kennungen der Nachricht einzutragen, auf die sich diese Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1617059736848_617148_16801" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1617059736847_812598_16799" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1655648615965_361906_18170" name="BezugBauberatung" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1655648964814_671663_18179" annotatedElement="_19_0_3_136d03d4_1655648615965_361906_18170" body="&lt;para>Dieser Typ dient der Bezugnahme auf eine in der Vergangenheit stattgefundene Bauberatung.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655648683318_362447_18172" name="vorgang" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655648683333_360607_18174" annotatedElement="_19_0_3_136d03d4_1655648683318_362447_18172" body="&lt;para>In dieses Element ist das Zeichen (Aktenzeichen) der vorangegangenen Bauberatung einzutragen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655648683335_852921_18175" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655648683330_451824_18173" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1752843163624_18262_31759" name="DatenabrufType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1752843163690_361459_31790" annotatedElement="_19_0_4_b8702dd_1752843163624_18262_31759" body="&lt;para>Dieser Datentyp enthält die Metadaten eines XNachweis-Abrufs.&lt;/para>&#xA;&lt;para>Die im Rahmen dieses Abrufs übermittelten Nachrichtenelemente werden über die Abruf-ID referenziert.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163691_318796_31791" name="abrufId" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163698_177216_31803" annotatedElement="_19_0_4_b8702dd_1752843163691_318796_31791" body="&lt;para>Dieses Element ist die ID eines XNachweis-Datenabrufs. Sie entspricht der in der XNachweis-Nachricht übermittelten requestId. Daten, die aus diesem Abruf stammen, wird die ID im Element nachweisbezug beigefügt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843163699_553156_31804" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843163698_923746_31802" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163692_670852_31792" name="zeitstempel" visibility="private" type="_14_0_1_6370212_1218191729703_367727_1061">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163700_220392_31807" annotatedElement="_19_0_4_b8702dd_1752843163692_670852_31792" body="&lt;para>In diesem Element werden Datum und Zeit des Abrufs dokumentiert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843163700_165028_31808" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843163700_503500_31806" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163692_925930_31793" name="quelle" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163701_722729_31811" annotatedElement="_19_0_4_b8702dd_1752843163692_925930_31793" body="&lt;para>Hier wird die Quelle des Datenabrufs angegeben, z.B. das Register.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843163701_810739_31812" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843163701_763950_31810" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163693_676357_31794" name="zweck" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163702_145325_31815" annotatedElement="_19_0_4_b8702dd_1752843163693_676357_31794" body="&lt;para>In diesem Element kann angegeben werden, welchem Zweck der Datenabruf dient, z.B. Bauvorlageberechtigung Entwurfsverfasser.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843163702_870037_31816" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843163702_663535_31814" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163695_47952_31795" name="nachweissubjekt" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163703_206204_31819" annotatedElement="_19_0_4_b8702dd_1752843163695_47952_31795" body="&lt;para>In diesem Element ist das Nachweissubjekt (Person oder Unternehmen) zu nennen, zu dem die Daten abgerufen wurden. Die Angabe sollte hinreichend genau sein, um eine zweifelsfreie Zuordnung zu ermöglichen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843163703_77245_31820" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843163703_673444_31818" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1752843163628_281618_31760" name="NachweisbezugType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1752843163696_114777_31798" annotatedElement="_19_0_4_b8702dd_1752843163628_281618_31760" body="&lt;para>Dieser Datentyp dient dazu, einen Bezug zu einem XNachweis-Abruf herzustellen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843163696_567097_31799" name="abrufId" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752843163704_422256_31826" annotatedElement="_19_0_4_b8702dd_1752843163696_567097_31799" body="&lt;para>Hier wird die ID des XNachweis-Abrufs angegeben, bei dem der Inhalt eines Nachrichtenelements übermittelt wurde. Diese ID entspricht dem XNachweis-Attribut requestId.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752844604640_952592_31955" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752844604640_657463_31956" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239747_665890_22713" name="Verortung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246531_572179_23532" name="Baugrundstueck" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264243_916851_25725" annotatedElement="_19_0_3_136d03d4_1611871246531_572179_23532" body="&lt;para>Das Baugrundstück ist der Ort der Baumaßnahme. Es kann aus mehreren Grundstücken im Sinne des Grundbuchs bestehen. Ein Grundstück kann aus mehreren Flurstücken bestehen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264243_318331_25726" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282186_490391_30948" annotatedElement="_19_0_3_136d03d4_1611871264243_318331_25726" body="&lt;para>Hier sind in jedem Fall die Angaben zum Flurstück des Vorhabens einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282186_590279_30949" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282186_961821_30947" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246531_270636_23533" name="Grundstueck" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264243_625234_25728" annotatedElement="_19_0_3_136d03d4_1611871246531_270636_23533" body="&lt;para>Dieser Typ nimmt Angaben zu einem Grundstück auf.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264243_600300_25729" name="anschrift" visibility="private" type="_19_0_3_c4f030d_1635864354709_685445_17884" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282186_790149_30952" annotatedElement="_19_0_3_136d03d4_1611871264243_600300_25729" body="&lt;para>In diesem Element wird die Anschrift des Grundstücks eingetragen. Falls dem Grundstück von der Kommune keine Anschrift zugewiesen ist, wird dieses Element nicht instanziiert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282186_257791_30953" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282186_843307_30951" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264244_256836_25730" name="flurstueck" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282187_262870_30956" annotatedElement="_19_0_3_136d03d4_1611871264244_256836_25730" body="&lt;para>Pro Instanziierung des Elements sind Angaben zu einem Flurstück vorzunehmen, das zum Grundstück gehört. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282187_473134_30957" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282187_246167_30955" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264244_177993_25731" name="verwaltungsgemeinschaft" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282187_86226_30960" annotatedElement="_19_0_3_136d03d4_1611871264244_177993_25731" body="&lt;para>In diesem Element kann bei Bedarf eine Angabe zur Verwaltungsgemeinschaft (Zusammenschluss mehrerer Gemeinden, in manchem Bundesland auch Samtgemeinde oder Verbandsgemeinde genannt) übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282187_904824_30961" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282187_783746_30959" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264244_317802_25732" name="bebauungsplan" visibility="private" type="_19_0_3_136d03d4_1611871246533_68994_23541">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282188_796390_30964" annotatedElement="_19_0_3_136d03d4_1611871264244_317802_25732" body="&lt;para>In diesem Element können Angaben zu einem Bebauungsplan eingetragen werden, falls das Grundstück von einem solchen betroffen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282188_797750_30965" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282187_594453_30963" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264244_825629_25733" name="vorhandeneBaulasten" visibility="private" type="_19_0_3_136d03d4_1611871246533_294346_23542">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282188_704974_30968" annotatedElement="_19_0_3_136d03d4_1611871264244_825629_25733" body="&lt;para>In diesem Element können Angaben zu vorhandenen Baulasten übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282188_315320_30969" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282188_807324_30967" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1713513062252_861291_24843" name="erschliessung" visibility="private" type="_19_0_4_b6602da_1713513216830_376392_24929">
              <ownedComment xmi:id="_19_0_4_b6602da_1713513191284_642404_24926" annotatedElement="_19_0_4_b6602da_1713513062252_861291_24843" body="&lt;para>In diesem Element werden Angaben zur Erschließung gemacht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1713513107918_556375_24920" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1713513107920_35949_24921" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246533_68994_23541" name="Anonym_Bebauungsplan" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264248_344041_25751" name="nummerBebauungsplan" visibility="private" type="_19_0_4_b8702dd_1782126210780_938004_9525" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282191_887324_31000" annotatedElement="_19_0_3_136d03d4_1611871264248_344041_25751" body="&lt;para>In dieses Element ist die Nummer des Bebauungsplans einzutragen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282192_168524_31001" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282191_583986_30999" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264248_899405_25752" name="bezeichnungBebauungsplan" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282192_79614_31004" annotatedElement="_19_0_3_136d03d4_1611871264248_899405_25752" body="&lt;para>Dieses Element steht für die Bezeichnung des Bebauungsplans.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282192_484909_31005" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282192_157404_31003" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246533_294346_23542" name="Bindungen" visibility="public">
