            </node>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_3_136d03d4_1611871270058_250111_27568" name="Befundliste erstellen" visibility="public" incoming="_19_0_3_136d03d4_1611871270065_724252_27604" outgoing="_19_0_4_78d0259_1728913473255_782315_30067" inPartition="_19_0_3_136d03d4_1611871270065_75840_27599">
