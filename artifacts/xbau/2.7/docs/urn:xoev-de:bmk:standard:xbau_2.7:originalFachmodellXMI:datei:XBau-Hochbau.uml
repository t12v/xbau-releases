                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598499127_326424_8979" name="betrag" visibility="private" type="_14_0_1_6370212_1218191803156_348252_1327" aggregation="composite">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598499127_123271_8986" annotatedElement="_19_0_3_129a03b9_1694598499127_326424_8979" body="&lt;para>Hier ist der Betrag in Eurocent einzutragen.&lt;/para>"/>
