            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264259_767319_25808" name="baumassenzahlGeplant" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282210_569963_31176" annotatedElement="_19_0_3_136d03d4_1611871264259_767319_25808" body="&lt;para>Geplante Baumassenzahl (BMZ).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282210_851604_31177" name="" visibility="public"/>
