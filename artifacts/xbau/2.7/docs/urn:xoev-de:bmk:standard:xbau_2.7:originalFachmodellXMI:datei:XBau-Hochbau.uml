            <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_3_136d03d4_1611871270058_419173_27570" name="materielle Prüfung durchführen" visibility="public" incoming="_19_0_3_136d03d4_1611871270069_963931_27631" outgoing="_19_0_3_136d03d4_1611871270069_101767_27632" inPartition="_19_0_3_136d03d4_1611871270065_75840_27599">
