                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287308_65722_6709" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_771644_5372" association="_16_5_4_5b501fb_1406633287145_892863_5736"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287145_81236_5737" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287175_143466_5877 _16_5_4_5b501fb_1406633287308_151777_6711">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287308_245815_6710" annotatedElement="_16_5_4_5b501fb_1406633287145_81236_5737" body="Persönliche Identifikationsnummer einer natürlichen Person, die sie kontextbezogen von allen anderen Personen eindeutig unterscheidet. Eine natürliche Person kann mehrere Identifikationsnummern haben."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287308_151777_6711" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287145_81236_5737"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287150_68846_5764" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287183_675356_5908 _16_5_4_5b501fb_1406633287310_920053_6740">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287310_188873_6739" annotatedElement="_16_5_4_5b501fb_1406633287150_68846_5764" body="Unter &quot;kommunikation&quot; werden Angaben zur Erreichbarkeit einer Organisation über elektronische Kommunikationskanäle zusammengefasst. "/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287310_920053_6740" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_771644_5372" association="_16_5_4_5b501fb_1406633287150_68846_5764"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287150_133200_5765" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287175_432655_5876 _16_5_4_5b501fb_1406633287311_31818_6742">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287311_53330_6741" annotatedElement="_16_5_4_5b501fb_1406633287150_133200_5765" body="Unter &quot;kommunikation&quot; werden Angaben zur Erreichbarkeit einer &quot;NatuerlichenPerson&quot; über elektronische Telekommunikationskanäle zusammengefasst. "/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287311_31818_6742" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287150_133200_5765"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287156_377630_5793" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287173_711311_5869 _16_5_4_5b501fb_1406633287312_929164_6767">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287312_164172_6766" annotatedElement="_16_5_4_5b501fb_1406633287156_377630_5793" body="Hier werden Informationen zu den Namen einer natürlichen Person zusammengefasst."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287312_929164_6767" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287156_377630_5793"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287166_221356_5832" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287166_657043_5837 _16_5_4_5b501fb_1406633287319_68053_6850">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287319_518421_6849" annotatedElement="_16_5_4_5b501fb_1406633287166_221356_5832" body="Angaben zum Gültigkeitszeitraum für den Namen der Organisation."/>
