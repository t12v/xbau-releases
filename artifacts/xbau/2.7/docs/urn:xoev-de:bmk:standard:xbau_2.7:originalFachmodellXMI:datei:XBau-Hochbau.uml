                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_774817_10928" name="Bestätigung der Schließung des Vorgangsraums entgegennehmen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_850662_10951" outgoing="_19_0_4_b8702dd_1784535338881_867873_10942" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938">
                  <argument xmi:id="_19_0_4_b8702dd_1784535338881_204985_10953" name="input" visibility="public"/>
                </node>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_346521_10929" name="Anlegung des Vorgangsraums vorbereiten und veranlassen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_183558_10945" outgoing="_19_0_4_b8702dd_1784535338881_135177_10944" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938"/>
                <node xmi:type="uml:InitialNode" xmi:id="_19_0_4_b8702dd_1784535338881_761739_10930" name="Anlass zur Einleitung eines bauaufsichtlichen Verfahrens gegeben" visibility="public" outgoing="_19_0_4_b8702dd_1784535338881_183558_10945" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938"/>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_987943_10931" name="Zugangsdaten entgegennehmen und berechtigten Personen zur Verfügung stellen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_446730_10940" outgoing="_19_0_4_b8702dd_1784535338881_835363_10946" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938"/>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_308414_10932" name="Verwaltungsverfahren durchführen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_835363_10946" outgoing="_19_0_4_b8702dd_1784535338881_152351_10947" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938"/>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_278144_10933" name="Schließen des Vorgangsraums veranlassen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_152351_10947" outgoing="_19_0_4_b8702dd_1784535338881_944525_10948" inPartition="_19_0_4_b8702dd_1784535338881_24036_10938">
