                <ownedComment xmi:id="_19_0_4_b6602da_1714115823597_616420_26149" annotatedElement="_19_0_4_b6602da_1714115823503_8057_25735" body="&lt;para>In dieses Element ist die Lage des Baugrundstücks gemäß Gemeindegliederung (bis hinunter zum Gemeindeteil) einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823597_166140_26150" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823597_886187_26148" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823503_280791_25736" name="strassenschluessel" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823597_146921_26153" annotatedElement="_19_0_4_b6602da_1714115823503_280791_25736" body="&lt;para>Hier ist entweder der kommunale Straßenschlüssel oder der offizielle ALKIS-Schlüssel (Amtliches Liegenschaftskatasterinformationssystem) einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823597_849390_26154" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823597_116048_26152" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726561768426_795577_27845" name="artDesBauens" visibility="private" type="_19_0_4_b6602da_1726561927319_573706_27854">
                <ownedComment xmi:id="_19_0_4_b6602da_1726563679965_808389_27975" annotatedElement="_19_0_4_b6602da_1726561768426_795577_27845" body="&lt;para>Hier kann angegeben werden, ob es sich bei der Baumaßnahme um einen Neubau oder um eine Baumaßnahme am Bestand handelt.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726561819340_374469_27852" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726561819341_463718_27853" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823504_753186_25737" name="baugenehmigung" visibility="private" type="_19_0_4_b6602da_1721633659639_600867_25723">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823599_829012_26157" annotatedElement="_19_0_4_b6602da_1714115823504_753186_25737" body="&lt;para>Dieses Element enthält weitere Daten zur Baugenehmigung.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp Baugenehmigung der Eingangsnachricht bzw. wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823599_306446_26158" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823598_891196_26156" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823504_48144_25738" name="angabenGebaeude" visibility="private" type="_19_0_4_b6602da_1726122177071_818653_27698">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823600_605015_26161" annotatedElement="_19_0_4_b6602da_1714115823504_48144_25738" body="&lt;para>Hier können Angaben zum Gebäude gemacht werden.&lt;/para>&#xA;&lt;para>Der Inhalt der Elemente &quot;artDesWohngebaeudes&quot; und &quot;artDesNichtwohngebaeudes&quot; ergibt sich aus dem Datentyp ArtDerBaulichenAnlage oder AngabenGebaeude der Eingangsnachricht.&lt;/para>&#xA;&lt;para>Der Inhalt der Elemente &quot;haustypWohngebaeude&quot; und &quot;artDesGebaeudes&quot; ergibt sich aus dem Datentyp AngabenGebaeude der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823600_352013_26162" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823600_632860_26160" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823505_361987_25741" name="ueberwiegendVerwendeterBaustoff" visibility="private" type="_19_0_3_136d03d4_1611871239777_727630_22814">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823604_733056_26173" annotatedElement="_19_0_4_b6602da_1714115823505_361987_25741" body="&lt;para>Angabe des überwiegend verwendeten Baustoffs&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp Baubeschreibung oder DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823604_934790_26174" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823604_34356_26172" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823506_871206_25743" name="heizungHeizenergie" visibility="private" type="_19_0_4_b6602da_1721385973058_987970_25438">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823606_261309_26181" annotatedElement="_19_0_4_b6602da_1714115823506_871206_25743" body="&lt;para>Angaben zur Heizung und zur Heizenergie&lt;/para>&#xA;&lt;para>Der Inhalt des Elements &quot;artDerHeizung&quot; ergibt sich aus dem Datentyp Heizung oder HeizungHeizenergie der Eingangsnachricht.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements &quot;heizenergie&quot; ergibt sich aus dem Datentyp  HeizungHeizenergie der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823606_485393_26182" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823605_379202_26180" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823508_136750_25747" name="sonstigeLueftungsanlagen" visibility="private" type="_19_0_3_136d03d4_1611871239786_491557_22852">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823613_749407_26197" annotatedElement="_19_0_4_b6602da_1714115823508_136750_25747" body="&lt;para>Genehmigungspflichtige Lüftungsanlagen die nicht für Mittel- und Großgaragen bestimmt sind&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp RaumlufttechnischeAnlagen oder DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823614_483771_26198" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823613_150263_26196" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823509_217423_25748" name="kuehlung" visibility="private" type="_19_0_3_136d03d4_1611871239787_91481_22854">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823615_777186_26201" annotatedElement="_19_0_4_b6602da_1714115823509_217423_25748" body="&lt;para>Angabe zur Kühlung&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp RaumlufttechnischeAnlagen oder DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823615_213126_26202" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823614_487413_26200" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823509_962030_25749" name="erfuellungGEG" visibility="private" type="_19_0_4_b6602da_1714115823091_433237_25390">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823615_217406_26205" annotatedElement="_19_0_4_b6602da_1714115823509_962030_25749" body="&lt;para>Angabe, ob die Verpflichtungen des Gebäudeenergiegesetzes (GEG) erfüllt werden.&lt;/para>&#xA;&lt;para>Diese Daten müssen nur bei Neubauten übermittelt werden.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht oder aus der Nachricht anzeige.erklaerungGEG.0903.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823616_214137_26206" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823615_470267_26204" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823510_941770_25750" name="bruttoRauminhaltBRI" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823616_359356_26209" annotatedElement="_19_0_4_b6602da_1714115823510_941770_25750" body="&lt;para>Angabe des Brutto-Rauminhalts (BRI) nach FlaechenDIN277&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp FlaechenDIN277 oder DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823616_845242_26210" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823616_574007_26208" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823511_313086_25751" name="anzahlVollgeschosse" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823617_812876_26213" annotatedElement="_19_0_4_b6602da_1714115823511_313086_25751" body="&lt;para>Geplante Vollgeschosse. Als Vollgeschosse gelten Geschosse, die nach landesrechtlichen Vorschriften Vollgeschosse sind oder auf ihre Zahl angerechnet werden (§ 20 BauNVO).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp FlaechenBauNVO oder DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823617_194664_26214" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823617_120052_26212" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823512_185142_25754" name="flaechen" visibility="private" type="_19_0_4_b6602da_1721393612370_612095_25849">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823620_965476_26225" annotatedElement="_19_0_4_b6602da_1714115823512_185142_25754" body="&lt;para>Daten zu Flächen&lt;/para>&#xA;&lt;para>Der Inhalt des Elements Nutzungseinheit ergibt sich aus dem Datentyp Nutzungseinheit oder FlaechenStatistik der Eingangsnachricht.&lt;/para>&#xA;&lt;para>Der Inhalt der Elemente flaechen.WoFIV und nutzflaechen ergeben sich aus dem Datentyp Flaechen oder FlaechenStatistik der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823620_824502_26226" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823619_474560_26224" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721379125376_21142_25284" name="anzahlDerWohnungen" visibility="private" type="_19_0_4_b6602da_1721382124872_703313_25307">
                <ownedComment xmi:id="_19_0_4_b6602da_1721379125380_736991_25286" annotatedElement="_19_0_4_b6602da_1721379125376_21142_25284" body="&lt;para>Hier können Angaben zur Anzahl der Wohnungen im Gebäude gemacht werden. &lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus den Datentypen AnzahlDerWohnungen und Barrierefreiheit bzw. aus dem Datentyp AnzahlDerWohnungenErweitert der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721379125380_593398_25287" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721379125380_901209_25285" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823515_805112_25759" name="grundflaeche" visibility="private" type="_19_0_3_136d03d4_1611871246536_10471_23553">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823627_5261_26245" annotatedElement="_19_0_4_b6602da_1714115823515_805112_25759" body="&lt;para>Angabe der Grundflaeche&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp BebauteGrundstuecksflaeche der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823627_371261_26246" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823625_761227_26244" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823513_946177_25757" name="baukosten" visibility="private" type="_19_0_4_b6602da_1721392221782_686829_25638">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823621_586353_26237" annotatedElement="_19_0_4_b6602da_1714115823513_946177_25757" body="&lt;para>Hier sind die veranschlagten Baukosten pro Gebäude einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp kostenEinzelnesGebauede oder KostenEinzelnesGebaeudeStatistikEingeschraenkt der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823622_481821_26238" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823621_117743_26236" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823514_440861_25758" name="datumAntragstellung" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823623_781612_26241" annotatedElement="_19_0_4_b6602da_1714115823514_440861_25758" body="&lt;para>Hier ist das Datum der Antragstellung einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823625_430602_26242" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823623_324263_26240" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721641277510_435022_26056" name="voraussichtlicheFertigstellung" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
                <ownedComment xmi:id="_19_0_4_b6602da_1721641370234_942337_26072" annotatedElement="_19_0_4_b6602da_1721641277510_435022_26056" body="&lt;para>Hier ist das Datum der voraussichhtlichen Baufertigstellung einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus der Nachricht anzeige.baubeginn.0900.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721641324391_380010_26069" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721641324392_4788_26070" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726121018304_830134_27688" name="statusSozialerWohnungsbau" visibility="private" type="_19_0_4_78d0259_1724140852426_673060_26520">
                <ownedComment xmi:id="_19_0_4_b6602da_1726121018331_887811_27690" annotatedElement="_19_0_4_b6602da_1726121018304_830134_27688" body="&lt;para>Dieses Element enthält die Angabe zum Status der Beantragung sozialer Wohnraumförderung. Das Element muss in den Statistiknachrichten zur Baugenehmigung, zum Baubeginn und zur Baufertigstellung befüllt sein.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben der Eingangsnachricht bzw. aus der Nachricht anzeige.nutzungsaufnahme.0910.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726121018333_871228_27691" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726121018328_917616_27689" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823094_591417_25391" name="DatenBaubeginn" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823547_742374_25811" annotatedElement="_19_0_4_b6602da_1714115823094_591417_25391" body="&lt;para>Dieser Typ enthält die Daten, die zum Anlass 'Baubeginn' gehören.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823549_544169_25815" name="datumBaubeginn" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823659_285459_26334" annotatedElement="_19_0_4_b6602da_1714115823549_544169_25815" body="&lt;para>In dieses Element ist das Datum des Baubeginns einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823659_201213_26335" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823659_298385_26333" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721720049133_761788_25868" name="aktenbereinigungBaubeginn" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1721720049133_949847_25870" annotatedElement="_19_0_4_b6602da_1721720049133_761788_25868" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass es sich bei dem übermittelten Datum zum Baubeginn um eine Schätzung im Zuge einer Aktenbereinigung handelt. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721720049134_167086_25871" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721720049133_704056_25869" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1721385973058_987970_25438" name="HeizungHeizenergie" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1721386102541_995247_25454" annotatedElement="_19_0_4_b6602da_1721385973058_987970_25438" body="&lt;para>In diesem Datentyp können Angaben zur Heizung und zur Heizenergie gemacht werden.&lt;/para>"/>
              <ownedRule xmi:id="_19_0_4_b8702dd_1753364867406_913937_31339" name="sch-stat-003" visibility="public" constrainedElement="_19_0_4_b6602da_1686322223300_430349_21762">
                <ownedComment xmi:id="_19_0_4_b8702dd_1753364867477_992178_31382" annotatedElement="_19_0_4_b8702dd_1753364867406_913937_31339" body="Die angegebene Kombination von primärer und sekundärer Wärmeenergie ist nicht plausibel."/>
                <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753364867477_726285_31381" name="" visibility="public">
                  <language>English</language>
                  <body>not((xbau:primaereHeizenergieHeizung/xbau:code/code = '001' and xbau:sekundaereHeizenergieHeizung/xbau:code/code = '014') or (xbau:primaereHeizenergieHeizung/xbau:code/code = '014' and xbau:sekundaereHeizenergieHeizung/xbau:code/code = '001'))</body>
                </specification>
              </ownedRule>
