          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679317832180_957069_22490" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_615950_23106" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1725449706250_674334_27870" name="informationsempfaenger.benachrichtigungUV.0401" visibility="public">
            <ownedComment xmi:id="_19_0_4_78d0259_1725449706251_767656_27874" annotatedElement="_19_0_4_78d0259_1725449706250_674334_27870" body="&lt;para>Mit dieser Nachricht übermittelt die Bauaufsichtsbehörde zusammen mit der Erteilung der Baugenehmigung dem zuständigen Unfallversicherungsträger Daten zum Bauvorhaben. Zu den Daten zählen Name und Anschrift des Bauherrn, Ort und Art des Bauvorhabens, Datum des Baubeginns sowie die Höhe der im Baugenehmigungsverfahren angegebenen oder festgestellten Baukosten.&lt;/para>&#xA;&lt;para>Weitere nach §195 Absatz 3 SGB VII mitzuteilende Daten wie Geburtsname und Geburtsdatum des Bauherrn werden bis auf Weiteres im Nachgang von der BG Bau beim Bauherren per Fragebogen erfasst.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_78d0259_1728578561309_716254_29556" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1725449706251_914473_27871" name="bezug" visibility="private" type="_16_5_4_940029b_1465368877212_444325_5428">
              <ownedComment xmi:id="_19_0_4_78d0259_1725449706251_532822_27876" annotatedElement="_19_0_4_78d0259_1725449706251_914473_27871" body="&lt;para>Dieses Element nennt den Vorgang der Bauaufsichtsbehörde, aus dem die Informationen entnommen sind. Eine Referenz auf eine Nachricht ist hier i.d.R. nicht einzutragen.&lt;/para>"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1725449706251_89072_27872" name="bauvorhaben" visibility="private" type="_19_0_4_78d0259_1725449419651_508583_26879">
              <ownedComment xmi:id="_19_0_4_78d0259_1725449706252_244839_27878" annotatedElement="_19_0_4_78d0259_1725449706251_89072_27872" body="&lt;para>Hier werden die relevanten Daten zum Bauvorhaben übermittelt.&lt;/para>"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241080_104258_23107" name="Pruefingenieure" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242636_448579_23210" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_104258_23107" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248926_591587_24232" name="pruefingenieure.pruefauftrag.0500" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266226_264443_26799" annotatedElement="_19_0_3_136d03d4_1611871248926_591587_24232" body="&lt;para>Diese Nachricht enthält die Auftragsinformationen und die zu prüfenden Dokumente (bautechnische Planungsdokumente).&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264149_25186_25275" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266226_379045_26800" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282500_227170_33479" annotatedElement="_19_0_3_136d03d4_1611871266226_379045_26800" body="&lt;para>Hier trägt die Bauaufsichtsbehörde die Vorgangsnummer (Beauftragung und damit zusammenhängende Kommunikation) für künftige Referenzierung ein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282500_166414_33480" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282500_819683_33478" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697455458628_371870_24662" name="pruefingenieur" visibility="private" type="_19_0_4_b6602da_1697455636812_338007_24673">
              <ownedComment xmi:id="_19_0_4_b6602da_1697455589968_813981_24672" annotatedElement="_19_0_4_b6602da_1697455458628_371870_24662" body="&lt;para>In diesem Element werden identifizierende Angaben zum zu beauftragenden Prüfingenieur gemacht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697455496492_630841_24666" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697455496502_593614_24667" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266227_644243_26802" name="pruefauftrag" visibility="private" type="_19_0_3_136d03d4_1611871266232_637340_26832">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282501_214983_33487" annotatedElement="_19_0_3_136d03d4_1611871266227_644243_26802" body="&lt;para>In diesem Element wird der Prüfauftrag detailliert. Jeder Prüfauftrag bezieht sich auf genau einen Typ bautechnischen Nachweis und die damit verbundenen Aufgaben der Bauüberwachung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282501_190202_33488" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282501_587730_33486" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266227_517104_26803" name="rahmendatenGebuehrenberechnung" visibility="private" type="_19_0_3_136d03d4_1611871266233_668239_26835">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282502_913536_33491" annotatedElement="_19_0_3_136d03d4_1611871266227_517104_26803" body="&lt;para>In diesem Element sind Rahmendaten zur Gebührenberechnung aus Sicht der Bauaufsichtsbehörde abgebildet, soweit sie auf den hier erteilten Auftrag anwendbar sind. Sie geben dem Auftragnehmer die Möglichkeit, die Komplexität des Bauvorhabens einzuschätzen, in dessen Kontext der Auftrag erteilt wird, und entsprechend Aufwand und Auftragswert des Prüfauftrags zu kalkulieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282502_153877_33492" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282502_892501_33490" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266227_153484_26804" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282502_962543_33495" annotatedElement="_19_0_3_136d03d4_1611871266227_153484_26804" body="&lt;para>Hier sind die Daten zum Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282502_888336_33496" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282502_621339_33494" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266227_143667_26805" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282503_984936_33499" annotatedElement="_19_0_3_136d03d4_1611871266227_143667_26805" body="&lt;para>Dieses Objekt enthält die Unterlagen (bzw. deren Metadaten), die für die Erfüllung des Prüfauftrags benötigt werden. Auch die zu prüfenden bautechnischen Nachweise gehören zu diesen Unterlagen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282503_838175_33500" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282503_170659_33498" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1728480800804_893260_29447" name="bundesland" visibility="private" type="_16_5_4_8a30247_1423044461203_939066_6394">
              <ownedComment xmi:id="_19_0_4_78d0259_1728480867352_203631_29462" annotatedElement="_19_0_4_78d0259_1728480800804_893260_29447" body="&lt;para>In diesem Element ist das Bundesland der Bauvorhabens anzugeben&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728480854542_958204_29459" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728480854542_993781_29460" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730797032156_700935_29545" name="beauftragendeBehoerde" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
              <ownedComment xmi:id="_19_0_4_78d0259_1730797111189_904840_29556" annotatedElement="_19_0_4_78d0259_1730797032156_700935_29545" body="&lt;para>In diesem Element ist die Bauaufsichtsbehörde anzugeben, die Absender der Nachricht ist, wenn diese nicht aus dem Nachrichtenkopf ersichtlich ist, z.B. weil sie über das Bauportal verschickt wurde.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730803301033_117905_29601" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730803301038_166049_29602" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730802595206_996522_29600" name="ansprechpartnerBauamt" visibility="private" type="_19_0_4_78d0259_1728629349789_247229_29479">
              <ownedComment xmi:id="_19_0_4_78d0259_1730803337816_237923_29605" annotatedElement="_19_0_4_78d0259_1730802595206_996522_29600" body="&lt;para>Dieser Typ deckt Namen und Erreichbarkeit des Ansprechpartners im Bauamt für Rückfragen ab.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730803312151_231720_29603" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730803312152_40628_29604" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1765372979912_603391_31428" name="prozessmerkmaleVerfahrensart" visibility="private" type="_19_0_4_b8702dd_1765372562768_166223_31413">
              <ownedComment xmi:id="_19_0_4_b8702dd_1765373094587_902620_31436" annotatedElement="_19_0_4_b8702dd_1765372979912_603391_31428" body="&lt;para>In diesem Element ist die Verfahrensart des Bauvorhabens anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1765373050504_566471_31434" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1765373050504_376182_31435" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248926_918979_24233" name="pruefingenieure.pruefauftragKorrektur.0503" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266228_353641_26807" annotatedElement="_19_0_3_136d03d4_1611871248926_918979_24233" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten zum Prüfauftrag. Sie bezieht sich auf einen bereits erteilten Prüfauftrag und auf eine zu diesem vorliegende Mängel- bzw. Befundliste.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_94169_25323" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266228_219909_26808" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282503_477241_33504" annotatedElement="_19_0_3_136d03d4_1611871266228_219909_26808" body="&lt;para>Hier ist die Vorgangsnummer der Bauaufsichtsbehörde (Beauftragung) einzutragen, wie in der &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> vergeben. Außerdem ist auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.formellePruefung.0502&quot;>Nachricht 0502&lt;/link> zu verweisen, mit der eine Befundliste übermittelt wurde. Falls die Nachricht nicht auf eine 0502 Nachricht antwortet, kann auch auf die Nachricht 0500 verwiesen werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282503_408428_33505" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282503_705111_33503" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266228_702431_26810" name="pruefauftrag" visibility="private" type="_19_0_3_136d03d4_1611871266232_637340_26832">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282504_933095_33512" annotatedElement="_19_0_3_136d03d4_1611871266228_702431_26810" body="&lt;para>In diesem Element wird der ggf. angepasste Prüfauftrag übermittelt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282504_539819_33513" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282504_530735_33511" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266228_401631_26811" name="rahmendatenGebuehrenberechnung" visibility="private" type="_19_0_3_136d03d4_1611871266233_668239_26835">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282505_177020_33516" annotatedElement="_19_0_3_136d03d4_1611871266228_401631_26811" body="&lt;para>Hier können die ggf. korrigierten Rahmendaten zur Gebührenberechnung eingetragen werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282505_103474_33517" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282505_999096_33515" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266229_419288_26812" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282505_880399_33520" annotatedElement="_19_0_3_136d03d4_1611871266229_419288_26812" body="&lt;para>Hier werden angepasste Daten zum Bauvorhaben (Wer, Was, Wo) eingetragen, falls eine solche Anpassung in einem Bereich notwendig war (Bruttoprinzip).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282505_248285_33521" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282505_71382_33519" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266229_872941_26813" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282506_273734_33524" annotatedElement="_19_0_3_136d03d4_1611871266229_872941_26813" body="&lt;para>Hier können korrigierte bzw. ergänzte Unterlagen, die für die Erfüllung des Prüfauftrags benötigt werden, eingetragen werden.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282506_363298_33525" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282506_875848_33523" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248926_858201_24234" name="pruefingenieure.formellePruefung.0502" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266229_450587_26815" annotatedElement="_19_0_3_136d03d4_1611871248926_858201_24234" body="&lt;para>Diese Nachricht nennt Mängel bzw. Nachbesserungsbedarf zu einem erteilten Prüfauftrag bzw. fordert Dokumentation im Rahmen der formellen Prüfung des Auftrags nach.&lt;/para>&#xA;&lt;para>&#xA;Sie kann auch verwendet werden, um weitere Informationen nachzufordern, die für die Entscheidung über die Annahme des Prüfauftrags benötigt werden.&#xA;&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_156626_25330" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266229_83324_26816" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282506_716510_33529" annotatedElement="_19_0_3_136d03d4_1611871266229_83324_26816" body="&lt;para>Hier trägt der Auftragnehmer die Vorgangsnummer der Bauaufsichtsbehörde ein, die ihm mit der Beauftragung (Nachricht 0500) zugestellt wurde. Außerdem wird die Referenz auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282506_911702_33530" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282506_544568_33528" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266230_31751_26817" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282507_524616_33533" annotatedElement="_19_0_3_136d03d4_1611871266230_31751_26817" body="&lt;para>Nach der Prüfung des Auftrags durch den Auftragnehmer: Hier sind die Ergebnisse der formellen Prüfung als Befundliste enthalten. Für jeden Befund sind die entsprechenden Parameter gefüllt, die Inhalt und Bezug des Befundes nachvollziehbar machen.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282507_716967_33534" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282507_356016_33532" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1701418633368_370081_24763" name="referenzPruefauftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b8702dd_1701418633369_682123_24765" annotatedElement="_19_0_4_b8702dd_1701418633368_370081_24763" body="&lt;para>Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#xD;&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1701418633369_205243_24766" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1701418633369_743059_24764" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248927_787955_24235" name="pruefingenieure.pruefbericht.0506" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266230_821468_26819" annotatedElement="_19_0_3_136d03d4_1611871248927_787955_24235" body="&lt;para>Diese Nachricht nennt die Ergebnisse der Prüfung bautechnische Nachweise oder Aktivitäten im Rahmen der Prüfung bautechnischer Nachweise oder der Bauüberwachung.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_78d0259_1737986911579_82977_29293" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734016949_873958_29303" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734016963_452237_29307" annotatedElement="_19_0_4_78d0259_1730734016949_873958_29303" body="&lt;para>Hier trägt der Auftragnehmer die Vorgangsnummer der Bauaufsichtsbehörde ein, die ihm mit der Beauftragung zugestellt wurde. Außerdem wird die Referenz auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734016965_693034_29308" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734016961_584548_29306" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734016958_524840_29304" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734016971_220799_29311" annotatedElement="_19_0_4_78d0259_1730734016958_524840_29304" body="&lt;para>Hier sind, soweit zutreffend, weitere Anlagen zu dem Prüfbericht als Verlinkung mittels URI angefügt. Die Verlinkung lässt sich manuell und maschinell verarbeiten.&lt;/para>&#xA;&lt;para>Die Verlinkung verweist immer auf &lt;emphasis>https://docs.bvpi-elba.de&lt;/emphasis>. Die Verlinkung wird mit geeigneten Mitteln abgesichert. Eine Beschreibung der Zugriffe und der API steht unter &lt;emphasis>https://docs.bvpi-elba.de/api&lt;/emphasis> zur Verfügung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734016971_533803_29312" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734016970_98447_29310" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734016960_962532_29305" name="pruefbericht" visibility="private" type="_19_0_3_136d03d4_1611871266233_851019_26833" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734016972_358858_29315" annotatedElement="_19_0_4_78d0259_1730734016960_962532_29305" body="&lt;para>In diesem Element werden die Prüfergebnisse dargestellt und durch Nebensbestimmungen und Anmerkungen ergänzt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734016972_959297_29316" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734016972_718525_29314" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248927_126690_24237" name="pruefingenieure.auftragsbestaetigung.0501" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266232_857204_26829" annotatedElement="_19_0_3_136d03d4_1611871248927_126690_24237" body="&lt;para>Der Prüfingenieur bestätigt  mit dieser Nachricht den Erhalt des Auftrags nebst der Tatsache der Auftragsannahme oder -ablehnung.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_26977_25334" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266232_760613_26830" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282510_676807_33564" annotatedElement="_19_0_3_136d03d4_1611871266232_760613_26830" body="&lt;para>Dieses Elements stellt den Bezug zum erteilten Auftrag (Vorgangsnummer) und zur entsprechenden &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> her. Dieser Auftrag wird mit dieser Nachricht bestätigt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282511_615476_33565" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282510_971380_33563" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1701418396307_594855_24756" name="referenzPruefauftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b8702dd_1701418396311_53932_24758" annotatedElement="_19_0_4_b8702dd_1701418396307_594855_24756" body="&lt;para>Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#xD;&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1701418396311_127888_24759" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1701418396311_638148_24757" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1727689592639_389276_28729" name="auftragSachverhalt" visibility="private" type="_19_0_4_78d0259_1727689287249_421469_28720">
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727689651601_489133_28731" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727689651615_98895_28732" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871248928_855819_24238" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266232_637340_26832" name="Anonym_Pruefauftrag" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282511_332860_33568" annotatedElement="_19_0_3_136d03d4_1611871266232_637340_26832" body=""/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282511_531987_33569" name="gegenstand" visibility="private" type="_19_0_3_136d03d4_1611871239751_95334_22725">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283327_796381_36877" annotatedElement="_19_0_3_136d03d4_1611871282511_531987_33569" body="&lt;para>Dieses Element bezeichnet die Art des zu prüfenden bautechnischen Nachweises.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283327_868857_36878" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283327_426727_36876" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282511_985069_33570" name="auftrag" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283328_469928_36881" annotatedElement="_19_0_3_136d03d4_1611871282511_985069_33570" body="&lt;para>Dieses Element enthält die Formulierung des Prüfauftrags.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283328_326952_36882" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283327_445310_36880" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1697457137717_933494_24786" name="referenzAuftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
                <ownedComment xmi:id="_19_0_4_b6602da_1697457178074_862656_24788" annotatedElement="_19_0_4_b6602da_1697457137717_933494_24786" body="&lt;para>Eine vom Auftragsservice mit dieser Nachricht vergebene eindeutige Kennung des Auftragsvorgangs. Sofern der Auftragnehmer auf den Auftrag reagiert, muss er sich in seinen Reaktionsnachrichten auf diese Kennung beziehen.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697457508798_127760_24858" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697457508799_871383_24859" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727870115118_323605_29144" name="fachgebiet" visibility="private" type="_19_0_4_78d0259_1727870201664_646286_29148">
                <ownedComment xmi:id="_19_0_4_78d0259_1727870931740_325118_29267" annotatedElement="_19_0_4_78d0259_1727870115118_323605_29144" body="&lt;para>Dieses Element bezeichnet das Fachgebiet des zu prüfenden bautechnischen Nachweises.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727870149777_759662_29146" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727870149781_945915_29147" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727870836698_65450_29259" name="baustoffe" visibility="private" type="_19_0_4_78d0259_1728576518480_940223_29423">
                <ownedComment xmi:id="_19_0_4_78d0259_1727870970092_681211_29268" annotatedElement="_19_0_4_78d0259_1727870836698_65450_29259" body="&lt;para>Dieses Element bezeichnet den Hauptbaustoff des Bauvorhabens für den zu prüfenden bautechnischen Nachweises.&lt;/para>&#xA;&lt;para>Die Elemente werden aus dem Bauantrag entnommen, wobei die Werte 1-4 aus der Codeliste Baustoff hier in 1 &quot;Mauerwerk/Massivbau&quot; zusammengefasst werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728472135782_80627_29381" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728472135793_777924_29382" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266233_851019_26833" name="Anonym_Pruefbericht" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282512_188580_33571" annotatedElement="_19_0_3_136d03d4_1611871266233_851019_26833" body=""/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1697459782419_595615_24870" name="referenzAuftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
                <ownedComment xmi:id="_19_0_4_b6602da_1697459782473_15700_24872" annotatedElement="_19_0_4_b6602da_1697459782419_595615_24870" body="&lt;para>Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#xD;&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697459782477_929475_24873" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697459782466_270478_24871" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282512_981674_33572" name="ergebnis" visibility="private" type="_19_0_3_136d03d4_1611871266233_874869_26834">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283328_685832_36885" annotatedElement="_19_0_3_136d03d4_1611871282512_981674_33572" body="&lt;para>Hier wird das Prüfergebnis formuliert und erläutert.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283328_30458_36886" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283328_191646_36884" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282512_693799_33573" name="abweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_52288_23387">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283329_477307_36889" annotatedElement="_19_0_3_136d03d4_1611871282512_693799_33573" body="&lt;para>Hier können bei Bedarf Empfehlungen an die Bauaufsichtsbehörde zur Zulassung von Abweichungen eingetragen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283329_609638_36890" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283328_221842_36888" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282513_352251_33574" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283329_874412_36893" annotatedElement="_19_0_3_136d03d4_1611871282513_352251_33574" body="&lt;para>Hier sind die Nebenbestimmungen zum Prüfergebnis einzufügen (z. B. Auflagen, die einem positiven Prüfergebnis beigegeben werden), falls solche gemäß der Bewertung des Prüfingenieurs festgesetzt werden sollten. Diese Nebenbestimmungen haben dieselbe Struktur wie im Kontext eines Bescheides der Bauaufsichtsbehörde. Im Unterschied zu dort findet im vorliegenden Kontext aber nur der Rechtsbereich des Bauordnungsrechts Anwendung.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283329_821784_36894" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283329_680351_36892" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727770027204_260436_28790" name="artBericht" visibility="private" type="_19_0_4_78d0259_1727769618227_270195_28725">
                <ownedComment xmi:id="_19_0_4_78d0259_1727882128015_399604_29278" annotatedElement="_19_0_4_78d0259_1727770027204_260436_28790" body="&lt;para>In diesem Element wird die Art des Berichts angegeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727876727878_676052_29276" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727876727881_971750_29277" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266233_874869_26834" name="Anonym_Pruefergebnis" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282513_974732_33575" annotatedElement="_19_0_3_136d03d4_1611871266233_874869_26834" body="&#xA;"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282513_503101_33577" name="erlaeuterung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283330_741558_36901" annotatedElement="_19_0_3_136d03d4_1611871282513_503101_33577" body="&lt;para>In diesen Textabschnitten wird aufgelistet, welche Gegenstände geprüft wurden, welche Methoden dabei angewendet wurden und zu welchen Ergebnissen der Prüfer gelangt ist.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283330_934483_36902" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283330_586849_36900" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727876176314_363107_29269" name="pruefstatus" visibility="private" type="_19_0_4_78d0259_1732811154630_296366_29650">
                <ownedComment xmi:id="_19_0_4_78d0259_1727876298998_279638_29275" annotatedElement="_19_0_4_78d0259_1727876176314_363107_29269" body="&lt;para>In dieses Element wird der Status eingetragen, der übermittelt werden soll. Der Status übermittelt ebenfalls das Prüfergebnis.&lt;/para>&#xA;&lt;para>Folgende Einträge der Codeliste sind zulässig: 50-56.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727876240449_27191_29271" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727876240453_249128_29272" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266233_668239_26835" name="RahmendatenGebuehrenberechnung" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282514_285139_33579" annotatedElement="_19_0_3_136d03d4_1611871266233_668239_26835" body="&lt;para>Dieser Typ dient dazu, Rahmendaten zur Gebührenberechnung für einen erteilten Prüfauftrag an einen Prüfingenieur abzubilden. Sie geben dem Auftragnehmer die Möglichkeit, die Komplexität des Bauvorhabens einzuschätzen, in dessen Kontext der Auftrag erteilt wird, und entsprechend Aufwand und Auftragswert des Prüfauftrags zu kalkulieren. Der Typ stellt die alternativen Ansätze für die Gebührenberechnung dar, in der Anwendung des Typs ist genau eine dieser Alternativen anzuwenden.&lt;/para>&#xA;"/>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1729865120846_744708_29726" name="bauwerksinformationen" visibility="private" type="_19_0_4_78d0259_1729865223547_714675_29732">
                <ownedComment xmi:id="_19_0_4_78d0259_1729865216723_164486_29731" annotatedElement="_19_0_4_78d0259_1729865120846_744708_29726" body="&lt;para>In diesem Element werden Angaben zu den Elementen gemacht, die zu der Gebührenberechnung genutzt werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1729865144673_980681_29729" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1729865144673_898148_29730" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282514_397258_33581" name="herstellungskosten" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536" association="_19_0_4_78d0259_1729864883512_786862_29563">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283331_717623_36909" annotatedElement="_19_0_3_136d03d4_1611871282514_397258_33581" body="&lt;para>Gebührenberechnung nach Herstellungskosten: Prognostizierte Herstellungskosten des Bauvorhabens in Eurocent.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283331_352642_36910" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283331_963576_36908" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282515_92241_33582" name="aufwand" visibility="private" type="_19_0_3_136d03d4_1611871266235_798477_26841" association="_19_0_4_78d0259_1729864883544_3106_29576">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283332_105416_36913" annotatedElement="_19_0_3_136d03d4_1611871282515_92241_33582" body="&lt;para>Gebührenberechnung nach Aufwand: Die Gebühr für die beauftragten Leistungen wird nach Zeitaufwand in Rechnung zu stellen sein. In diesem Element ist der Stundensatz (netto) in Eurocent anzugeben, zu dem der Auftragnehmer seine Leistungen in Rechnung stellen darf.&lt;/para>&#xA;&lt;para>Diese Alternative wird angewendet, falls die Basiswerte nicht ermittelt werden können. Falls das Bauvorhaben in einem Umbau oder Anbau besteht, kann z. B. kein Bauvolumen ermittelt werden.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283332_618971_36914" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283332_834203_36912" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1728480501234_161925_29437" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" association="_19_0_4_78d0259_1729864883569_874120_29592">
                <ownedComment xmi:id="_19_0_4_78d0259_1728480695278_688865_29441" annotatedElement="_19_0_4_78d0259_1728480501234_161925_29437" body="&lt;para>In diesem Element kann die Gebührenberechnung (z.B. durch BVS, PI oder Baurechtsbehörde erstellt) als Anlage beigefügt werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728480707766_407259_29442" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728480707767_252148_29443" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266234_241574_26837" name="Anonym_AnrechenbareKosten" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282516_643720_33586" name="bauwert" visibility="private" type="_19_0_3_136d03d4_1611871266234_947760_26838" aggregation="composite" association="_19_0_3_136d03d4_1611871266235_465953_26840">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283333_389343_36921" annotatedElement="_19_0_3_136d03d4_1611871282516_643720_33586" body="&lt;para>Hier wird der anrechenbare Bauwert des Bauvorhabens dargestellt. Pro Gebäudeart, die im Bauvorhaben vorgesehen ist, ist eine Position aufzuführen.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283333_529123_36922" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283333_893054_36920" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282516_843874_33587" name="summeGesamt" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283333_649238_36925" annotatedElement="_19_0_3_136d03d4_1611871282516_843874_33587" body="&lt;para>Summe über alle Positionen (in Eurocent). Der anrechenbare Bauuwert für das Bauvorhaben.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283333_956703_36926" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283333_97956_36924" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266234_947760_26838" name="Anonym_AnrechenbareBauwerte" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282517_613186_33589" name="zuschlaege" visibility="private" type="_19_0_3_136d03d4_1611871239761_772733_22747">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283334_158231_36933" annotatedElement="_19_0_3_136d03d4_1611871282517_613186_33589" body="&lt;para>In diesem Element sind die Zuschläge zu nennen, die bei der Berechnung der anrechenbaren Bauwerte zu berücksichtigen sind, gemäß zutreffender Verordnung für die Prüfingenieure und Prüfsachverständige.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283335_220928_36934" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283334_283734_36932" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282517_296059_33591" name="summePosition" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283335_16440_36941" annotatedElement="_19_0_3_136d03d4_1611871282517_296059_33591" body="&lt;para>Der anrechenbare Bauwert für diese Position (in Eurocent), also für diese Gebäudeart.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283336_483576_36942" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283335_150642_36940" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871266235_52004_26839" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871282515_826559_33585 _19_0_3_136d03d4_1611871282518_493490_33592">
              <ownedEnd xmi:id="_19_0_3_136d03d4_1611871282518_493490_33592" name="" visibility="private" type="_19_0_4_78d0259_1729865223547_714675_29732" association="_19_0_3_136d03d4_1611871266235_52004_26839"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871266235_465953_26840" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871282516_643720_33586 _19_0_3_136d03d4_1611871282518_648227_33593">
              <ownedEnd xmi:id="_19_0_3_136d03d4_1611871282518_648227_33593" name="" visibility="private" type="_19_0_3_136d03d4_1611871266234_241574_26837" association="_19_0_3_136d03d4_1611871266235_465953_26840"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266235_798477_26841" name="Anonym_Aufwand" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282518_99278_33594" name="stundensatz" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283336_794877_36945" annotatedElement="_19_0_3_136d03d4_1611871282518_99278_33594" body="&lt;para>Der Stundensatz, der der Berechnung des voraussichtlichen Aufwands zugrunde liegt (in Eurocent).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283336_199307_36946" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283336_280199_36944" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282518_961643_33595" name="anzahlStunden" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283337_317495_36949" annotatedElement="_19_0_3_136d03d4_1611871282518_961643_33595" body="&lt;para>Der voraussichtlich zu leistende Aufwand in Stunden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283337_330650_36950" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283337_896121_36948" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282519_202044_33596" name="geschaetzteGebuehr" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283337_96378_36953" annotatedElement="_19_0_3_136d03d4_1611871282519_202044_33596" body="&lt;para>Die sich auf der Basis von Stundensatz und voraussichtlich zu leistendem Aufwand ergebende Gebühr (in Eurocent).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283337_783629_36954" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283337_89274_36952" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1697455636812_338007_24673" name="Anonym_Pruefingenieur" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_b6602da_1697455694699_393840_24674" name="name" type="_16_5_4_8a30247_1422955073653_603895_5103">
                <ownedComment xmi:id="_19_0_4_b6602da_1697456017940_345650_24779" annotatedElement="_19_0_4_b6602da_1697455694699_393840_24674" body="&lt;para>Hier ist der Name des Prüfingenieurs einzutragen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697455979556_906654_24758" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697455979557_330346_24759" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1697455712484_769821_24675" name="ingenieurbuero" type="_16_5_4_8a30247_1422957408723_400098_8364">
                <ownedComment xmi:id="_19_0_4_b6602da_1697456037961_830668_24781" annotatedElement="_19_0_4_b6602da_1697455712484_769821_24675" body="&lt;para>Hier kann das Ingenieurbüro eingetragen werden, zu dem der Püfingenieur gehört.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697455986458_782808_24762" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697455986458_492726_24763" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1697455753596_877921_24676" name="piKennung" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                <ownedComment xmi:id="_19_0_4_b6602da_1697456036694_453991_24780" annotatedElement="_19_0_4_b6602da_1697455753596_877921_24676" body="&lt;para>Hier ist die PI-Kennung (Prüfingenieurskennung) einzutragen, mit der der Prüfingenieur eindeutig identifiziert werden kann. &lt;/para>&lt;para>&#xA;Die Kennung kann über den Verzeichnisdienst &lt;emphasis>https://ds.bvpi-elba.de&lt;/emphasis> abgefragt &#xA;werden. Der Verzeichnisdienst wird mit geeigneten Mitteln abgesichert.&#xA;Eine Beschreibung der Zugriffe und der API steht unter &lt;emphasis>https://ds.bvpi-elba.de/api&lt;/emphasis> &#xA;zur Verfügung.&#xA;&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697455983427_184302_24760" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697455983427_796723_24761" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1727689287249_421469_28720" name="Anonym_AuftragSachverhalt" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727689324382_635661_28721" name="auftragAkzeptiert" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_78d0259_1727708115946_23251_28733" annotatedElement="_19_0_4_78d0259_1727689324382_635661_28721" body="&lt;para>Falls der Auftrag angenommen wird ist hier 'true' zu übermitteln, andernfalls 'false'.&lt;/para>&#x9;&#x9;&#x9;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727689456897_995175_28725" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727689456897_839924_28726" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1727689338185_131747_28722" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                <ownedComment xmi:id="_19_0_4_78d0259_1727708156416_630430_28734" annotatedElement="_19_0_4_78d0259_1727689338185_131747_28722" body="&lt;para>Im Falle einer Ablehnung des Auftrags (Element auftragAkzeptiert = false), muss hier eine Erklärung abgegeben werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1727689464929_417193_28727" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1727689464929_701358_28728" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_4_78d0259_1729864883512_786862_29563" name="" visibility="public" memberEnd="_19_0_4_78d0259_1729864883513_211549_29564 _19_0_3_136d03d4_1611871282514_397258_33581">
              <ownedEnd xmi:id="_19_0_4_78d0259_1729864883513_211549_29564" name="" visibility="private" type="_19_0_3_136d03d4_1611871266233_668239_26835" association="_19_0_4_78d0259_1729864883512_786862_29563"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_4_78d0259_1729864883544_3106_29576" name="" visibility="public" memberEnd="_19_0_4_78d0259_1729864883544_997650_29577 _19_0_3_136d03d4_1611871282515_92241_33582">
              <ownedEnd xmi:id="_19_0_4_78d0259_1729864883544_997650_29577" name="" visibility="private" type="_19_0_3_136d03d4_1611871266233_668239_26835" association="_19_0_4_78d0259_1729864883544_3106_29576"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_4_78d0259_1729864883569_874120_29592" name="" visibility="public" memberEnd="_19_0_4_78d0259_1729864883569_171498_29593 _19_0_4_78d0259_1728480501234_161925_29437">
              <ownedEnd xmi:id="_19_0_4_78d0259_1729864883569_171498_29593" name="" visibility="private" type="_19_0_3_136d03d4_1611871266233_668239_26835" association="_19_0_4_78d0259_1729864883569_874120_29592"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1729865223547_714675_29732" name="Anonym_Bauwerksinformationen" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282515_826559_33585" name="bauwerksklasse" visibility="private" type="_19_0_3_136d03d4_1611871239750_794560_22722" aggregation="composite" association="_19_0_3_136d03d4_1611871266235_52004_26839">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283332_538909_36917" annotatedElement="_19_0_3_136d03d4_1611871282515_826559_33585" body="&lt;para>Hier ist die Bauwerksklasse abgebildet, die dem Bauvorhaben zugeordnet werden kann.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283332_4337_36918" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283332_569709_36916" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282517_800101_33590" name="bruttorauminhalt" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283335_676692_36937" annotatedElement="_19_0_3_136d03d4_1611871282517_800101_33590" body="&lt;para>Bruttorauminhalt dieser Gebäudeart: Hier ist die Anzahl an Kubikmetern anzugeben, mit der diese Gebäudeart im Bauvorhaben repräsentiert ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283335_681409_36938" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283335_97011_36936" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1729865242362_5200_29736" name="gebauedeklasse" visibility="private" type="_19_0_3_136d03d4_1611871239759_272892_22742">
                <ownedComment xmi:id="_19_0_4_78d0259_1729865501720_380114_29744" annotatedElement="_19_0_4_78d0259_1729865242362_5200_29736" body="&lt;para>Hier ist die Gebäudeklasse abgebildet, die dem Bauvorhaben zugeordnet werden kann. Die Information kann aus dem Element &quot;gebauederechtlicheKlassifikation&quot; aus der Nachricht 0200 entnommen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1729865291372_437303_29738" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1729865291372_514252_29739" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1729865297914_727139_29740" name="sonderbautatbestand" visibility="private" type="_19_0_3_136d03d4_1611871239759_905594_22743">
                <ownedComment xmi:id="_19_0_4_78d0259_1729865518378_759416_29745" annotatedElement="_19_0_4_78d0259_1729865297914_727139_29740" body="&lt;para>Hier ist der Sonderbautatbestand abgebildet, die dem Bauvorhaben zugeordnet werden kann. Die Information kann aus dem Element &quot;gebauederechtlicheKlassifikation&quot; aus der Nachricht 0200 entnommen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1729865373481_525403_29742" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1729865373481_959687_29743" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282516_54341_33588" name="gebaeudeartBauwert" visibility="private" type="_19_0_3_136d03d4_1611871239760_833644_22746">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283334_332013_36929" annotatedElement="_19_0_3_136d03d4_1611871282516_54341_33588" body="&lt;para>In diesem Element sind die Gebäudeart mit dem zugehörigem relativen Bauwert (Eurocent pro Kubikmeter) genannt. Sie sind bei der Berechnung der anrechenbaren Bauwerte zu berücksichtigen gemäß zutreffender Verordnung für die Prüfingenieure und Prüfsachverständige.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283334_474188_36930" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283334_156661_36928" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1765372562768_166223_31413" name="ProzessmerkmaleVerfahrensart" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1765372921465_639769_31426" annotatedElement="_19_0_4_b8702dd_1765372562768_166223_31413" body="&lt;para>Dieser Datentyp dient zur Übermittlung der Verfahrensart, wenn keine weiteren Prozessmerkmale benötigt werden.&lt;/para>"/>
              <generalization xmi:id="_19_0_4_b8702dd_1765372805308_882091_31417" general="_19_0_3_136d03d4_1611871244702_582549_23403"/>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1765372859643_924066_31419" name="verfahrensart" visibility="private" type="_19_0_3_136d03d4_1611871239791_257404_22869" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b8702dd_1765372859660_134050_31421" annotatedElement="_19_0_4_b8702dd_1765372859643_924066_31419" body="&lt;para>Dieses Element wird verwendet, um die baurechtliche Verfahrensart anzugeben. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1765372859660_390391_31422" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1765372859660_954306_31420" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248928_34997_24239" name="pruefingenieure.nachforderungUnterlagen.0504" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266235_495836_26842" annotatedElement="_19_0_3_136d03d4_1611871248928_34997_24239" body="&lt;para>Diese Nachricht nennt inhaltliche Mängel an einem Bauvorhaben und fordert im Rahmen der materiellen Prüfung nachgebesserte Unterlagen ein. Das kann für die Prüfung bautechnischer Nachweise oder der Bauüberwachung nötig sein.&lt;/para>&#xA;&lt;para>Nachforderungen gemäß dieser Nachricht sind in geeigneter Form dem Bauherrn oder Bauleiter zur Verfügung zu stellen.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_78d0259_1737986871965_506956_29291" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734093148_513867_29352" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734093151_802812_29357" annotatedElement="_19_0_4_78d0259_1730734093148_513867_29352" body="&lt;para>Hier ist die Vorgangsnummer der Bauaufsichtsbehörde (Beauftragung) einzutragen, wie in der &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> vergeben. Außerdem wird die Referenz auf &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734093151_809930_29358" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734093150_521370_29356" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734093150_609091_29353" name="referenzPruefauftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734093152_610068_29361" annotatedElement="_19_0_4_78d0259_1730734093150_609091_29353" body="&lt;para>Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#xD;&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734093152_310150_29362" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734093152_69272_29360" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734093150_471680_29354" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734093154_208469_29365" annotatedElement="_19_0_4_78d0259_1730734093150_471680_29354" body="&lt;para>Nach der Prüfung der vorliegenden Dokumente werden hier die Ergebnisse als Befundliste eingetragen. Jeder Befund wird mit den nötigen Details erläutert..&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734093155_524812_29366" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734093153_710269_29364" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734093150_57612_29355" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734093156_42184_29369" annotatedElement="_19_0_4_78d0259_1730734093150_57612_29355" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme bzw. Kommentar formuliert, soweit anwendbar.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734093156_841687_29370" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734093155_318697_29368" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871248928_426780_24240" name="pruefingenieure.angepassteUnterlagen.0505" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266236_698673_26847" annotatedElement="_19_0_3_136d03d4_1611871248928_426780_24240" body="&lt;para>Diese Nachricht enthält nachgebesserte Unterlagen zum Prüfauftrag. Sie bezieht sich auf einen erteilten Prüfauftrag und auf eine Nachricht, die zur Nachbesserung von Unterlagen gesendet worden ist.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_78d0259_1737986895113_571187_29292" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734075363_400112_29324" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734075383_596711_29329" annotatedElement="_19_0_4_78d0259_1730734075363_400112_29324" body="&lt;para>Hier ist die Vorgangsnummer der Bauaufsichtsbehörde (Beauftragung) einzutragen, wie in der &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.pruefauftrag.0500&quot;>Nachricht 0500&lt;/link> vergeben. Außerdem ist auf die &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; linkend=&quot;XBau.Nachrichten.Pruefingenieure.pruefingenieure.nachforderungUnterlagen.0504&quot;>Nachricht 0504&lt;/link> zu verweisen, mit der eine Befundliste übermittelt wurde. Falls die Nachricht nicht auf eine 0504 Nachricht antwortet, kann auch auf die Nachricht 0500 verwiesen werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734075388_317472_29330" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734075383_820839_29328" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734075367_487641_29325" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734075389_589167_29333" annotatedElement="_19_0_4_78d0259_1730734075367_487641_29325" body="&lt;para>Hier sind die angepassten Unterlagen eingetragen.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734075390_246316_29334" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734075389_408957_29332" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734075371_271879_29326" name="referenzPruefauftrag" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734075392_645629_29337" annotatedElement="_19_0_4_78d0259_1730734075371_271879_29326" body="&lt;para>Dieses Element enthält die Kennung des Prüfauftrags. Jeder Prüfauftrag bezieht sich auf genau einen bautechnischen Nachweis.&#xD;&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734075392_670888_29338" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734075391_206261_29336" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1730734075378_388879_29327" name="autor" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_78d0259_1730734075393_960296_29341" annotatedElement="_19_0_4_78d0259_1730734075378_388879_29327" body="&lt;para>In diesem Element soll ergänzt werden, wer der ursprüngliche Herausgeber/Autor ist der nachgereichten Unterlagen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730734075393_532317_29342" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730734075393_612042_29340" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761145079_360532_16846" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_104258_23107" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1697456700768_930097_24784" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_104258_23107" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1697458158172_128624_24868" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_104258_23107" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1707479928197_161613_24611" name="pruefingenieure.mitteilungBaubeginnsanzeige.0508" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1707480516830_575747_24644" annotatedElement="_19_0_4_b8702dd_1707479928197_161613_24611" body="&lt;para>Mit dieser Nachricht informiert die Bauaufsichtsbehörde den Prüfingenieur über eine eingegangene Anzeige zum Baubeginn und damit über den anstehenden Baubeginn.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b8702dd_1707480241770_434304_24615" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1707480376906_141240_24623" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b8702dd_1707480376909_244093_24627" annotatedElement="_19_0_4_b8702dd_1707480376906_141240_24623" body="&lt;para>In diesem Element werden Eintragungen vorgenommen, um auf die Baugenehmigung Bezug zu nehmen, die der aktuellen Baumaßnahme zugrunde liegt. Ggf. wird auf die entsprechende XBau-Nachricht zum Bescheid referenziert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1707480376909_223623_24628" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1707480376909_821735_24626" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1707480376907_245273_24624" name="sachverhalt" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1707480376909_9524_24631" annotatedElement="_19_0_4_b8702dd_1707480376907_245273_24624" body="&lt;para>In diesem Element wird der eingetretene Bauzustand erläutert, der angezeigt wurde. Es wird auf entsprechende Termine hingewiesen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1707480376909_748629_24632" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1707480376909_673052_24630" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1707480376908_755666_24625" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_4_b8702dd_1707480376910_101474_24635" annotatedElement="_19_0_4_b8702dd_1707480376908_755666_24625" body="&lt;para>Hier können mit der Bauzustandsanzeige eingegangene Bauvorlagen als Anlage beigefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1707480376910_184872_24636" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1707480376910_497730_24634" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241081_154843_23108" name="Genehmigungsfreistellung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_429357_23206" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_154843_23108" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249394_149217_24263" name="genehmigungsfreistellung.anzeige.0600" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266240_303565_26853" annotatedElement="_19_0_3_136d03d4_1611871249394_149217_24263" body="&lt;para>Mit dieser Nachricht zeigt der Bauherr der Gemeinde (in einigen Ländern der Bauaufsichtsbehörde) wg. möglicher Freistellung von der Genehmigungspflicht sein Vorhaben an. Die Nachricht enthält die einschlägigen Daten zum Vorhaben, ergänzend dokumentiert durch Unterlagen, die Bauvorlagen entsprechen sowie sonstige Unterlagen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_231384_25311" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266241_861588_26856" name="anzeigender" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282525_681925_33632" annotatedElement="_19_0_3_136d03d4_1611871266241_861588_26856" body="&lt;para>In dieses Element sind die Daten des Anzeigenden bzw. der Anzeigenden einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282525_5075_33633" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282525_318559_33631" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266241_599502_26854" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite" association="_19_0_3_136d03d4_1611871249395_167625_24264">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282524_845342_33624" annotatedElement="_19_0_3_136d03d4_1611871266241_599502_26854" body="&lt;para>Dies ist die Dokumentation zum Bauvorhaben, für das der Bauherr die Genehmigungsfreistellung anzeigt. Die nötigen Daten (Wer, Was, Wo) sind enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282524_664383_33625" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282524_635249_33623" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266241_586008_26855" name="referenzAnzeigeservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282524_90454_33628" annotatedElement="_19_0_3_136d03d4_1611871266241_586008_26855" body="&lt;para>Eine vom Antragsservice (Anzeigeservice) vergebene eindeutige Kennung des Antragsvorgangs (Anzeigevorgangs). Sofern die Gemeinde auf die Anzeige reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282524_205449_33629" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282524_619040_33627" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266241_810913_26857" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282525_115771_33636" annotatedElement="_19_0_3_136d03d4_1611871266241_810913_26857" body="&lt;para>Falls Baulasterklärungen im Rahmen des vorliegenden Verfahrens gefordert sind, können hier der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben werden. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282525_149825_33637" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282525_476780_33635" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266242_230753_26858" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282526_788855_33640" annotatedElement="_19_0_3_136d03d4_1611871266242_230753_26858" body="&lt;para>Die für die Planung des Vorhabens notwendigen Unterlagen sind hier als Anlage beigefügt (MBO, MBauVorlV). In diesem Element sind die nötigen Metadaten und ggf. auch das Primärdokument enthalten. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282526_94531_33641" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282526_187858_33639" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266242_781033_26859" name="alsBauantragWeiterzufuehren" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282526_990922_33644" annotatedElement="_19_0_3_136d03d4_1611871266242_781033_26859" body="&lt;para>Hier kann der Bauherr kennzeichnen (&quot;true&quot;, andernfalls &quot;false&quot;), dass der Vorgang bei abschlägiger Entscheidung in ein Baugenehmigungsverfahren übergehen soll und die eingereichten Unterlagen dann als Bauvorlagen verwendet werden sollen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282526_628000_33645" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282526_316381_33643" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668598974070_194434_18360" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668598974072_502592_18362" annotatedElement="_19_0_3_129a03b9_1668598974070_194434_18360" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668598974073_306982_18363" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668598974072_79975_18361" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871249395_167625_24264" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871266241_599502_26854 _19_0_3_136d03d4_1611871266242_793444_26861">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871266242_793444_26861" name="" visibility="private" type="_19_0_3_136d03d4_1611871249394_149217_24263" association="_19_0_3_136d03d4_1611871249395_167625_24264"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249395_483546_24265" name="genehmigungsfreistellung.ergebnis.0602" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266242_407022_26862" annotatedElement="_19_0_3_136d03d4_1611871249395_483546_24265" body="&lt;para>Mittels dieser Nachricht teilt die Gemeinde dem Bauherrn das Ergebnis der Prüfung seiner Anzeige mit. Der Bauherr erfährt, ob sein Vorhaben genehmigungspflichtig ist. Auch erhält er Informationen, ob die Gemeinde eine Untersagung gemäß § 15 BauGB beantragt hat.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_474293_25289" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266242_190567_26863" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282527_440370_33649" annotatedElement="_19_0_3_136d03d4_1611871266242_190567_26863" body="&lt;para>Bezug auf die Anzeige des Bauherrn gegenüber der Gemeinde. Nachricht 0600, auf die die Gemeinde mit dieser Nachricht antwortet.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282527_257578_33650" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282527_706993_33648" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266243_628702_26864" name="ergebnisDesVerfahrens" visibility="private" type="_19_0_3_136d03d4_1611871239758_851448_22739" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282527_622964_33653" annotatedElement="_19_0_3_136d03d4_1611871266243_628702_26864" body="&lt;para>Die Gemeinde trägt in dieses Element ein, welches Ergebnis die gemeindliche Prüfung der Anzeige ergeben hat.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282527_597923_33654" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282527_749191_33652" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1784710255603_318743_34706" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1784710255603_643364_34708" annotatedElement="_19_0_4_b8702dd_1784710255603_318743_34706" body="&lt;para>Mit diesem Element können dem Ergebnis der Prüfung der Genehmigungsfreistellung bei Bedarf Anlagen beigefügt werden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784710255603_383327_34709" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784710255603_950487_34707" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249396_929148_24266" name="genehmigungsfreistellung.anzeigeBAB.0601" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266243_470793_26866" annotatedElement="_19_0_3_136d03d4_1611871249396_929148_24266" body="&lt;para>Mit dieser Nachricht unterrichtet die Gemeinde die Bauaufsichtsbehörde über die eingegangene Anzeige der Genehmigungsfreistellung. Erfolgte die Einreichung der Anzeige bei der Bauaufsichtsbehörde, unterrichtet mit dieser Nachricht die Bauaufsichtsbehörde die Gemeinde.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264156_780094_25341" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266243_151578_26867" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282528_671498_33658" annotatedElement="_19_0_3_136d03d4_1611871266243_151578_26867" body="&lt;para>Bezug auf die Anzeige des Bauherrn gegenüber der Gemeinde. Nachricht 0600, die die Gemeinde erhalten hat.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282528_503267_33659" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282528_573086_33657" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266243_199688_26868" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282528_38965_33662" annotatedElement="_19_0_3_136d03d4_1611871266243_199688_26868" body="&lt;para>Dies ist die Dokumentation zum Bauvorhaben, für das der Bauherr die Genehmigungsfreistellung anzeigt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282528_554788_33663" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282528_199045_33661" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266244_648740_26869" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282529_718699_33666" annotatedElement="_19_0_3_136d03d4_1611871266244_648740_26869" body="&lt;para>Falls Baulasterklärungen im Rahmen des vorliegenden Verfahrens gefordert sind, können hier der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben werden. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282529_289695_33667" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282529_24808_33665" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266244_774856_26870" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282529_640656_33670" annotatedElement="_19_0_3_136d03d4_1611871266244_774856_26870" body="&lt;para>In diesem Element sind die durch den Bauherrn beigefügten Anlagen enthalten.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282529_571897_33671" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282529_779035_33669" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266244_915765_26871" name="alsBauantragWeiterzufuehren" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282530_806920_33674" annotatedElement="_19_0_3_136d03d4_1611871266244_915765_26871" body="&lt;para>Hier ist dokumentiert, ob der  Bauherr wünscht, dass der Vorgang bei abschlägiger Entscheidung als ein Baugenehmigungsverfahren weitergeführt werden soll  (&quot;true&quot;, andernfalls &quot;false&quot;).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282530_948798_33675" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282530_319828_33673" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249396_604844_24267" name="genehmigungsfreistellung.ergebnisBAB.0603" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266245_476038_26873" annotatedElement="_19_0_3_136d03d4_1611871249396_604844_24267" body="&lt;para>Mit dieser Nachricht informiert die Gemeinde die Bauaufsichtsbehörde über das Ergebnis der Prüfung. Mit der Nachricht 0602 hat die Gemeinde auch den Bauherrn benachrichtigt.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264152_17669_25302" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266245_752033_26874" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282530_322345_33679" annotatedElement="_19_0_3_136d03d4_1611871266245_752033_26874" body="&lt;para>Bezug auf die Anzeige des Bauherrn gegenüber der Gemeinde. Nachricht 0600, die die Gemeinde erhalten hat.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282530_224701_33680" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282530_28097_33678" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266245_148644_26875" name="ergebnisDesVerfahrens" visibility="private" type="_19_0_3_136d03d4_1611871239758_851448_22739" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282531_432192_33683" annotatedElement="_19_0_3_136d03d4_1611871266245_148644_26875" body="&lt;para>Die Gemeinde trägt in dieses Element ein, welches Ergebnis der gemeindlichen Prüfung der Anzeige sie dem Bauherrn übermittelt hat.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282531_263414_33684" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282531_660387_33682" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761222523_231732_16852" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_154843_23108" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241081_159728_23109" name="Baulasten" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242636_347617_23209" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_159728_23109" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249397_412545_24269" name="baulasten.vorlageErklaerung.0700" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266246_86937_26878" annotatedElement="_19_0_3_136d03d4_1611871249397_412545_24269" body="&lt;para>Diese Nachricht dient dazu, der Bauaufsichtsbehörde die Baulast-Erklärung sowie ergänzende Dokumentationen zuzustellen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_680273_25282" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753777237243_362699_31246" name="referenzBaulast" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753777353974_174051_31252" annotatedElement="_19_0_4_b8702dd_1753777237243_362699_31246" body="&lt;para>Eine von der Antragsplattform mit dieser Nachricht vergebene eindeutige Kennung des Vorgangs zur Baulasteintragung. In nachfolgenden Nachrichten zur Baulasteintragung ist zur Bezugnahme diese Kennung zu verwenden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753777269358_974964_31247" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753777269359_247798_31248" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266246_355836_26879" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282531_54657_33689" annotatedElement="_19_0_3_136d03d4_1611871266246_355836_26879" body="&lt;para>Im Kontext einer nicht-selbständigen Baulasterklärung wird hier der Bezug zu einem laufenden Baugenehmigungsverfahren hergestellt. Im anderen Fall existiert noch keine Vorgangsnummer, so dass dieses Element nicht verwendet wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282532_450405_33690" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282531_823449_33688" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266246_893513_26880" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282532_945176_33693" annotatedElement="_19_0_3_136d03d4_1611871266246_893513_26880" body="&lt;para>Hier wird der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282532_785040_33694" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282532_727508_33692" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266246_525742_26881" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282532_36710_33697" annotatedElement="_19_0_3_136d03d4_1611871266246_525742_26881" body="&lt;para>Hier sind alle Pläne darzustellen, die für die Eindeutigkeit der Baulasterklärung relevant sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282533_393287_33698" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282532_351999_33696" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249397_897089_24270" name="baulasten.nachforderung.0701" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266247_830840_26883" annotatedElement="_19_0_3_136d03d4_1611871249397_897089_24270" body="&lt;para>Diese Nachricht enthält die Befunde der Bauaufsichtsbehörde zu der eingereichten Baulasterklärung bzw. den beigefügten Unterlagen.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_225333_25317" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266247_126193_26884" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282533_753815_33702" annotatedElement="_19_0_3_136d03d4_1611871266247_126193_26884" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulasterklärung und die Nachricht baulasten.&#xA;vorlageErklaerung.0700 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282533_31524_33703" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282533_15707_33701" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266247_304172_26885" name="befundfrist" visibility="private" type="_19_0_4_b6602da_1756978536310_860233_31468" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282534_7036_33706" annotatedElement="_19_0_3_136d03d4_1611871266247_304172_26885" body="&lt;para>Die Befundliste enthält die Ergebnisse der formellen und materiellen Prüfung durch die Bauaufsichtsbehörde. Enthalten ist außerdem eine Frist zur Korrektur der Baulast-Erklärung durch den Antragsteller.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282534_878003_33707" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282533_72573_33705" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1752148427469_993878_31082" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1752148427487_669749_31084" annotatedElement="_19_0_4_b6602da_1752148427469_993878_31082" body="&lt;para>Hier können Anlagen eingefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1752148427490_19820_31085" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1752148427483_130798_31083" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249398_486094_24271" name="baulasten.information.0702" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266247_852337_26887" annotatedElement="_19_0_3_136d03d4_1611871249398_486094_24271" body="&lt;para>Die Akteure, die die Baulast-Erklärung vorgelegt haben, werden durch diese Nachricht über das Ergebnis der&#xA;Prüfung informiert.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_953969_25306" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266247_59876_26888" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282534_226932_33711" annotatedElement="_19_0_3_136d03d4_1611871266247_59876_26888" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulasterklärung und die Nachricht baulasten.vorlageErklaerung.0700 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282534_179327_33712" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282534_830607_33710" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266248_903926_26889" name="sachverhalt" visibility="private" type="_19_0_3_136d03d4_1611871266249_387937_26897">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282535_337422_33715" annotatedElement="_19_0_3_136d03d4_1611871266248_903926_26889" body="&lt;para>Dieses Element enthält die Ergebnisse der Prüfung der Baulasterklärung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282535_483932_33716" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282534_468193_33714" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266248_980353_26890" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282535_469095_33719" annotatedElement="_19_0_3_136d03d4_1611871266248_980353_26890" body="&lt;para>Hier ist im Erfolgsfall die Dokumentation der vorgenommenen Eintragung ins Baulastenverzeichnis enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282535_544716_33720" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282535_243562_33718" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871249399_680611_24273" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266249_387937_26897" name="Anonym_Entscheidung" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282538_151175_33736" annotatedElement="_19_0_3_136d03d4_1611871266249_387937_26897" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Bescheides, den die Bauaufsichtsbehörde nach Prüfung eines Antrags erlässt.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282538_490400_33737" name="baulastAkzeptiert" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283344_707591_37001" annotatedElement="_19_0_3_136d03d4_1611871282538_490400_33737" body="&lt;para>Falls die Baulast akzeptiert und eingetragen wurde, ist hier 'true' zu übermitteln, anderenfalls 'false'.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283344_19167_37002" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283344_464537_37000" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282538_18311_33738" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283345_267690_37005" annotatedElement="_19_0_3_136d03d4_1611871282538_18311_33738" body="&lt;para>Falls die Baulast durch die Behörde nicht akzeptiert und eingetragen wurde, wird in diesem Element die Begründung für diese Entscheidung geliefert.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283345_238345_37006" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283345_981291_37004" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761108131_912543_16844" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_159728_23109" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1749649113135_863859_30896" name="baulasten.eintragung.0703" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1749649113154_14716_30897" annotatedElement="_19_0_4_b6602da_1749649113135_863859_30896" body="&lt;para>Diese Nachricht dient dazu, eine Eintragung im Baulastenverzeichnis anzustoßen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1749649113167_287783_30901" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1749649113156_348338_30898" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1749649113174_865337_30904" annotatedElement="_19_0_4_b6602da_1749649113156_348338_30898" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulasterklärung und die Nachricht baulasten.vorlageErklaerung.0700 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1749649113176_727646_30905" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1749649113173_282014_30903" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1749649113163_351858_30899" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1749649113179_87413_30908" annotatedElement="_19_0_4_b6602da_1749649113163_351858_30899" body="&lt;para>Hier werden Angaben zur einzutragenden Baulast gemacht. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1749649113180_741921_30909" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1749649113178_734393_30907" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1749649113164_918316_30900" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1749649113181_989617_30912" annotatedElement="_19_0_4_b6602da_1749649113164_918316_30900" body="&lt;para>Hier sind alle Pläne beizufügen, in denen der Gegenstand der Baulasterklärung eindeutig dargestellt ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1749649113182_739030_30913" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1749649113180_923636_30911" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1760015942922_391411_31966" name="baulasten.korrekturErklaerung.0704" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1760015942927_300209_31967" annotatedElement="_19_0_4_b6602da_1760015942922_391411_31966" body="&lt;para>Diese Nachricht enthält eine Korrektur oder eine Ergänzung der Baulast-Erklärung. Sie bezieht sich also auf eine bereits abgegebene Erklärung und ist eine Reaktion auf eine zur Erklärung vorliegende Mängelliste der Behörde.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1760015942928_662502_31972" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760015942927_527992_31969" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1760015942930_736823_31979" annotatedElement="_19_0_4_b6602da_1760015942927_527992_31969" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulasterklärung und die Nachricht baulasten.vorlageErklaerung.0700 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760015942930_557088_31980" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760015942930_427178_31978" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760015942927_166752_31970" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1760015942932_801586_31983" annotatedElement="_19_0_4_b6602da_1760015942927_166752_31970" body="&lt;para>Hier wird der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760015942932_14522_31984" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760015942930_574458_31982" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760015942927_454271_31971" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1760015942932_374246_31987" annotatedElement="_19_0_4_b6602da_1760015942927_454271_31971" body="&lt;para>Hier sind alle Pläne darzustellen, die für die Eindeutigkeit der Baulasterklärung relevant sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760015942932_984516_31988" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760015942932_251605_31986" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241081_571146_23110" name="UeberwachungspflichtigeAnlagen" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_630_23204" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_571146_23110" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242636_754298_23208" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_571146_23110" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249400_921233_24275" name="ueberwachungspflichtigeAnlagen.pruefbescheinigung.0800" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266250_840108_26899" annotatedElement="_19_0_3_136d03d4_1611871249400_921233_24275" body="&lt;para>Diese Nachricht dient zur Übermittlung der Prüfbescheinigung an die Bauaufsichtsbehörde. Sie enthält alle relevanten Informationen zur Bewertung der Wirksamkeit und Betriebssicherheit der geprüften überwachungspflichtigen Anlagen.&lt;/para>&#xA;&lt;para>Hinweis: Diese Nachricht wird demnächst noch überarbeitet.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_925205_25276" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266250_54155_26900" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282539_381612_33741" annotatedElement="_19_0_3_136d03d4_1611871266250_54155_26900" body="&lt;para>In diesem Element wird die Vorgangsnummer bzw. das Aktenzeichen zur erteilten Baugenehmigung übermittelt, die der Errichtung des Gebäudes und der technischen Anlage(n) zu Grunde lag.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282539_951766_33742" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282538_986168_33740" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266250_721116_26901" name="gebaeude" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282539_973942_33745" annotatedElement="_19_0_3_136d03d4_1611871266250_721116_26901" body="&lt;para>Hier wird der Ort der Prüfung bezeichnet, nämlich Anschrift und Flurstück zum Gebäude, in dem die geprüften technischen Anlagen installiert sind.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282539_981723_33746" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282539_408429_33744" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266250_24230_26902" name="pruefgegenstand" visibility="private" type="_19_0_3_136d03d4_1611871266252_790406_26910">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282540_420517_33749" annotatedElement="_19_0_3_136d03d4_1611871266250_24230_26902" body="&lt;para>Jede Instanz dieses Elements beinhaltet Informationen zu einem Gegenstand der Prüfung (eine bestimmte technische Anlage in dem lokalisierten Gebäude) und zum Ergebnis der Prüfung dieses Gegenstands. Pro Element wird genau eine technische Anlage referenziert; die Prüfung kann mehrere technische Anlagen in dem Gebäude zum Gegenstand haben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282540_861113_33750" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282539_551109_33748" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266250_785545_26903" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282540_85335_33753" annotatedElement="_19_0_3_136d03d4_1611871266250_785545_26903" body="&lt;para>Die Anlagen enthalten den Prüfbericht, der auch die Bewertung des Prüfergebnisses vornimmt und Konsequenzen empfiehlt. Der Inhalt des Prüfberichts ist in den Musterprüfgrundsätzen definiert (Anlage zur Musterprüfverordnung Ziffer 4). Der Betreiber der technischen Anlagen hat den Prüfbericht typischerweise als Papierdokument vom Prüfsachverständigen erhalten.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282540_171073_33754" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282540_387267_33752" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249400_10020_24276" name="ueberwachungspflichtigeAnlagen.erinnerung.0801" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266251_683653_26905" annotatedElement="_19_0_3_136d03d4_1611871249400_10020_24276" body="&lt;para>Diese Nachricht dient der Information des Betreibers, dass eine Prüfbescheinigung überfällig ist.&lt;/para>&#xA;&lt;para>Hinweis: Diese Nachricht wird demnächst noch überarbeitet.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_495391_25322" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266251_877350_26906" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282541_916573_33758" annotatedElement="_19_0_3_136d03d4_1611871266251_877350_26906" body="&lt;para>In diesem Element wird die Vorgangsnummer bzw. das Aktenzeichen zur erteilten Baugenehmigung übermittelt, die der Errichtung des Gebäudes und der technischen Anlage(n) zu Grunde lag.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282541_646860_33759" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282541_893705_33757" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266251_965310_26907" name="pruefgegenstand" visibility="private" type="_19_0_3_136d03d4_1611871266252_790406_26910">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282542_433891_33762" annotatedElement="_19_0_3_136d03d4_1611871266251_965310_26907" body="&lt;para>Dieses Element bezeichnet den Gegenstand der Prüfung, eine bestimmte technische Anlage in dem lokalisierten Gebäude. Pro Element wird genau eine technische Anlage referenziert. Die Prüfung kann mehrere technische Anlagen in dem Gebäude zum Gegenstand haben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282542_346315_33763" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282542_448274_33761" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266251_7666_26908" name="anlassDerPruefung" visibility="private" type="_19_0_3_136d03d4_1611871266252_574229_26911">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282542_422448_33766" annotatedElement="_19_0_3_136d03d4_1611871266251_7666_26908" body="&lt;para>In diesem Element wird der Anlass der durchgeführten Prüfung genannt, über deren Ergebnis berichtet wird.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282542_623061_33767" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282542_518835_33765" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871249400_247127_24277" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266252_790406_26910" name="Anonym_Pruefgegenstand" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282543_156711_33770" annotatedElement="_19_0_3_136d03d4_1611871266252_790406_26910" body="&lt;para>Dieser Typ deckt Informationen ab zum Gegenstand (eine bestimmte technische Anlage in dem lokalisierten Gebäude) und zum Ergebnis der Prüfung dieses Gegenstands.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282543_184936_33771" name="identifikation" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283347_647605_37018" annotatedElement="_19_0_3_136d03d4_1611871282543_184936_33771" body="&lt;para>Hier ist die Identifikation des Prüfgegenstands, z.B. die Seriennummer, einzutragen. &lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283347_711308_37019" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283347_871418_37017" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282543_416826_33772" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283347_544957_37022" annotatedElement="_19_0_3_136d03d4_1611871282543_416826_33772" body="&lt;para>Hier steht eine deskriptive Bezeichnung des Prüfgegenstands (z.B. &lt;quote>Lüftungsanlage im Gebäudetrakt Süd&lt;/quote>).&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283347_953064_37023" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283347_871583_37021" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282544_974326_33773" name="artDerTechnischenAnlage" visibility="private" type="_19_0_3_136d03d4_1611871239762_921834_22751">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283348_664106_37026" annotatedElement="_19_0_3_136d03d4_1611871282544_974326_33773" body="&lt;para>Dieses Element enthält Angaben zur Art der geprüften technischen Anlage.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283348_598087_37027" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283348_213600_37025" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282544_708261_33774" name="anlassDerPruefung" visibility="private" type="_19_0_3_136d03d4_1611871266252_574229_26911">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283348_868740_37030" annotatedElement="_19_0_3_136d03d4_1611871282544_708261_33774" body="&lt;para>In diesem Element wird zum gegebenen Prüfgegenstand der Anlass der durchgeführten Prüfung genannt.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283348_696376_37031" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283348_878290_37029" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282544_199386_33775" name="pruefergebnis" visibility="private" type="_19_0_3_136d03d4_1611871266252_616438_26912">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283349_636338_37034" annotatedElement="_19_0_3_136d03d4_1611871282544_199386_33775" body="&lt;para>In dieses Element sind zum Prüfgegenstand die wichtigsten Ergebnisse der durchgeführten Prüfung einzutragen. Weitere Details zum Prüfergebnis sind dem Prüfbericht zu entnehmen, der in der Anlage zur vorliegenden Nachricht enthalten ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283349_22034_37035" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283349_524151_37033" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266252_574229_26911" name="Anonym_Anlass" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282545_101161_33776" annotatedElement="_19_0_3_136d03d4_1611871266252_574229_26911" body=""/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282545_237743_33777" name="anlass" visibility="private" type="_19_0_3_136d03d4_1611871239749_609655_22721">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283349_814840_37038" annotatedElement="_19_0_3_136d03d4_1611871282545_237743_33777" body="&lt;para>Dieses Element nennt den Anlass der durchgeführten Prüfung. Es deckt eine Reihe von Standardfällen ab.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283349_767332_37039" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283349_555681_37037" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282545_313809_33778" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283350_651715_37042" annotatedElement="_19_0_3_136d03d4_1611871282545_313809_33778" body="&lt;para>Hier werden ggf. die Nebenbestimmungen der Baugenehmigung, insofern diese Prüfungen vorsehen, aufgeführt. Diese können ebenfalls Anlass einer durchgeführten Prüfung sein.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283350_205384_37043" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283350_932508_37041" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266252_616438_26912" name="MppvoPruefergebnis" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282545_240514_33779" annotatedElement="_19_0_3_136d03d4_1611871266252_616438_26912" body="&lt;para>Dieser Typ deckt zum Prüfgegenstand die wichtigsten Ergebnisse der durchgeführten Prüfung ab. &lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282546_855467_33780" name="keinMangel" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283350_740004_37046" annotatedElement="_19_0_3_136d03d4_1611871282546_855467_33780" body="&lt;para>Falls in der Prüfung der technischen Anlage kein Mangel festgestellt wurde (alle Pflichteigenschaften für den freigegebenen Betrieb sind gewährleistet), enthält dieses Element &quot;true&quot;, andernfalls &quot;false&quot;. &lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283350_78550_37047" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283350_878307_37045" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282546_224213_33781" name="nachpruefung" visibility="private" type="_19_0_3_136d03d4_1611871266253_965580_26913">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283351_394057_37050" annotatedElement="_19_0_3_136d03d4_1611871282546_224213_33781" body="&lt;para>Dieses Element enthält die Festlegungen im Prüfergebnis zu einer ggf. erforderlichen Nachprüfung. &lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283351_126893_37051" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283351_290061_37049" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282546_861845_33782" name="weiterbetrieb" visibility="private" type="_19_0_3_136d03d4_1611871266253_850509_26915">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283351_367105_37054" annotatedElement="_19_0_3_136d03d4_1611871282546_861845_33782" body="&lt;para>Dieses Element enthält die Festlegungen im Prüfergebnis zu einem zugelassenen bzw. nicht zugelassenen Weiterbrieb der geprüften technischen Anlage. &lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283352_609526_37055" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283351_571097_37053" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266253_965580_26913" name="Anonym_Nachpruefung" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282547_731333_33784" annotatedElement="_19_0_3_136d03d4_1611871266253_965580_26913" body=""/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282547_258471_33785" name="nichtErforderlich" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283352_753478_37058" annotatedElement="_19_0_3_136d03d4_1611871282547_258471_33785" body="&lt;para>Dieses Element ist auszuwählen, falls eine Nachprüfung nicht notwendig ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283352_891354_37059" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283352_815406_37057" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_136d03d4_1611871283352_455806_37060" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282547_838757_33786" name="erforderlich" visibility="private" type="_19_0_3_136d03d4_1611871266253_521718_26914">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283353_168766_37063" annotatedElement="_19_0_3_136d03d4_1611871282547_838757_33786" body="&lt;para>Dieses Element ist auszuwählen, falls eine Nachprüfung notwendig ist. Es enthält Informationen über die dafür vorliegenden Gründe.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283353_205940_37064" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283353_380173_37062" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266253_521718_26914" name="Anonym_Grund" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282548_634005_33788" annotatedElement="_19_0_3_136d03d4_1611871266253_521718_26914" body=""/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282548_208294_33789" name="grund" visibility="private" type="_19_0_3_136d03d4_1611871239762_634861_22752">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283353_189992_37067" annotatedElement="_19_0_3_136d03d4_1611871282548_208294_33789" body="&lt;para>Pro Instanz dieses Elements wird ein Grund genannt dafür, dass eine Nachprüfung notwendig ist (es können mehrere Gründe zutreffen).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283353_54539_37068" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283353_985665_37066" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266253_850509_26915" name="Anonym_WeiterbetriebFrist" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282548_974711_33790" annotatedElement="_19_0_3_136d03d4_1611871266253_850509_26915" body=""/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282548_332359_33791" name="festlegung" visibility="private" type="_19_0_3_136d03d4_1611871239762_314899_22753">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283354_389362_37071" annotatedElement="_19_0_3_136d03d4_1611871282548_332359_33791" body="&lt;para>Hier ist die Information zu hinterlegen, ob und ggf. bis zu welcher Frist ein Weiterbetrieb der geprüften technischen Anlage gestattet ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283354_300944_37072" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283354_8258_37070" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282548_385338_33792" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283354_199401_37075" annotatedElement="_19_0_3_136d03d4_1611871282548_385338_33792" body="&lt;para>Falls der Weiterbetrieb nur befristet gestattet wird, ist hier das Datum des Fristablaufs zu hinterlegen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283354_7120_37076" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283354_861927_37074" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761397119_429498_16860" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_571146_23110" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679317800676_229935_22488" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_571146_23110" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241081_824336_23111" name="Bauzustand" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242636_329858_23207" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_824336_23111" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249401_582179_24279" name="bauzustand.anzeige.0920" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266254_476216_26917" annotatedElement="_19_0_3_136d03d4_1611871249401_582179_24279" body="&lt;para>Mittels dieser Nachricht kündigt der  Bauherr der Bauaufsichtsbehörde den Zeitpunkt des Erreichens eines bestimmten Bauzustandes an.&lt;/para>&#xA;&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_951001_25278" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266254_349349_26918" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282549_481619_33795" annotatedElement="_19_0_3_136d03d4_1611871266254_349349_26918" body="&lt;para>In diesem Elements werden Eintragungen vorgenommen, um auf die Baugenehmigung Bezug zu nehmen, die der aktuellen Baumaßnahmen zugrunde liegen. Ggf. wird auf die entsprechende XBau-Nachricht referenziert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282549_656348_33796" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282549_260193_33794" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266254_846599_26919" name="sachverhalt" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282549_382952_33799" annotatedElement="_19_0_3_136d03d4_1611871266254_846599_26919" body="&lt;para>In diesem Element wird der eingetretene Bauzustand erläutert, der anzuzeigen ist. Es wird auf entsprechende Termine hingewiesen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282550_269871_33800" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282549_966080_33798" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1721289032978_632850_25224" name="zustandUnterDach" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1721289425294_542510_25226" annotatedElement="_19_0_4_b6602da_1721289032978_632850_25224" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass der Bauzustand &quot;Rohbaufertig/UnterDach&quot; erreicht wurde. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721289500414_535679_25299" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721289500415_982960_25300" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1632756632816_859467_17683" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_c4f030d_1632756632822_206479_17685" annotatedElement="_19_0_3_c4f030d_1632756632816_859467_17683" body="&lt;para>Für die Bauzustandsanzeige können hier Bauvorlagen der Nachricht als Anlage beigefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1632756632823_842725_17686" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1632756632820_62364_17684" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785753754056_888232_35413" name="referenzAnzeigeservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785753754056_32172_35415" annotatedElement="_19_0_4_b8702dd_1785753754056_888232_35413" body="&lt;para>Eine vom Antragsservice (Anzeigeservice) vergebene eindeutige Kennung des Anzeigevorgangs. Sofern die Bauaufsichtsbehörde auf die Anzeige reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785753754056_952225_35416" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785753754056_184471_35414" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249402_137399_24280" name="bauzustand.befundliste.0921" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266254_765163_26921" annotatedElement="_19_0_3_136d03d4_1611871249402_137399_24280" body="&lt;para>Diese Nachricht teilt dem Bauherrn festgestellte Ausführungsmangel mit, falls die Prüfung des Bauzustandes durch die Behörde ein negatives Ergebnis ergeben hat.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_679690_25331" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266255_619727_26922" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282550_507639_33804" annotatedElement="_19_0_3_136d03d4_1611871266255_619727_26922" body="&lt;para>In diesem Elements wird auf die Vorgangsnummer der erteilten Baugenehmigung Bezug genommen, auf deren Basis gearbeitet wird, und auf die Nachricht 0920, mittels derer der geprüfte Bauzustand angezeigt worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282550_246257_33805" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282550_492877_33803" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266255_178866_26923" name="pruefung" visibility="private" type="_19_0_3_136d03d4_1611871266256_773703_26929" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282550_221125_33808" annotatedElement="_19_0_3_136d03d4_1611871266255_178866_26923" body="&lt;para>Dieses Element enthält die Informationen zur Prüfung und benennt die entsprechenden Mängel.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282551_764551_33809" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282550_526338_33807" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249402_982141_24281" name="bauzustand.freigabe.0922" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266255_968205_26925" annotatedElement="_19_0_3_136d03d4_1611871249402_982141_24281" body="&lt;para>Mit dieser Nachricht erklärt die Bauaufsichtsbehörde dem Bauherrn ihre Zustimmung zur Fortführung der Bauarbeiten gemäß § 82 Abs. 1 Satz 2 MBO.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_890145_25320" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266255_344947_26926" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282551_337151_33813" annotatedElement="_19_0_3_136d03d4_1611871266255_344947_26926" body="&lt;para>Dieses Element enthält die Vorgangsnummer der erteilten Baugenehmigung und referenziert auf die Nachricht 0920, mittels derer der geprüfte Bauzustand angezeigt worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282551_175968_33814" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282551_741783_33812" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266256_540783_26927" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282552_926362_33817" annotatedElement="_19_0_3_136d03d4_1611871266256_540783_26927" body="&lt;para>Hier können, falls notwendig, Nebenbestimmungen zur erteilten Zustimmung eingefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282552_5917_33818" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282551_813874_33816" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871249402_918806_24282" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266256_773703_26929" name="Anonym_Pruefung" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282552_236124_33821" annotatedElement="_19_0_3_136d03d4_1611871266256_773703_26929" body="&lt;para>Dieser Typ enthält die Informationen zur Prüfung auf der Baustelle mit den entsprechenden Befunden ab.&lt;/para>&#xA;"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282552_967384_33822" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283356_624474_37088" annotatedElement="_19_0_3_136d03d4_1611871282552_967384_33822" body="&lt;para>Dieses Element enthält das Datum des Tages, an dem die Prüfung durchgeführt wurde.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283356_583530_37089" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283356_108910_37087" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282552_704460_33823" name="pruefer" visibility="private" type="_16_5_4_940029b_1460619307903_831925_3517">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283357_15632_37092" annotatedElement="_19_0_3_136d03d4_1611871282552_704460_33823" body="&lt;para>Hier werden die Daten der Person genannt, die die Prüfung durchgeführt hat.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283357_459499_37093" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283357_978367_37091" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282553_554118_33824" name="ansprechpartnerBaustelle" visibility="private" type="_16_5_4_940029b_1460619307903_831925_3517">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283357_237497_37096" annotatedElement="_19_0_3_136d03d4_1611871282553_554118_33824" body="&lt;para>Hier kann ggf. die Person angegeben werden, mit der auf der Baustelle im Kontext der durchgeführten Prüfung kommuniziert worden ist.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283357_872006_37097" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283357_428805_37095" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282553_454763_33825" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244700_807454_23394" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283358_616058_37100" annotatedElement="_19_0_3_136d03d4_1611871282553_454763_33825" body="&lt;para>Dieses Element enthält die Mängelliste, die die Prüfung ergeben hat.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283358_761360_37101" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283358_461011_37099" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761175083_174632_16848" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_824336_23111" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1747990674681_205770_30073" name="bauzustand.aeusserung.0923" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1747990674725_485812_30074" annotatedElement="_19_0_4_b6602da_1747990674681_205770_30073" body="&lt;para>Der Bauherr äußert sich zu den mitgeteilten Ausführungsmängeln (Nachricht 0921) und erhofft im Anschluss die Freigabe des Bauzustands (Nachricht 0922).&#xA;&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1747990674732_207619_30078" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1747990674728_548713_30075" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1747990674738_445373_30081" annotatedElement="_19_0_4_b6602da_1747990674728_548713_30075" body="&lt;para>In diesem Elements wird auf die Vorgangsnummer der erteilten Baugenehmigung Bezug genommen, auf deren Basis gearbeitet wird, und auf die Nachricht 0920, mittels derer der geprüfte Bauzustand angezeigt worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1747990674738_336634_30082" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1747990674735_700670_30080" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1747990674730_731156_30076" name="aeusserung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_4_b6602da_1747990674740_372549_30085" annotatedElement="_19_0_4_b6602da_1747990674730_731156_30076" body="&lt;para>Hier kann der Bauherr sich zur Befundliste äußern. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1747990674741_665811_30086" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1747990674740_663467_30084" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1747990674731_834161_30077" name="anlage" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_4_b6602da_1747990674742_866051_30089" annotatedElement="_19_0_4_b6602da_1747990674731_834161_30077" body="&lt;para>Hier sind ggf. nachgereichte Anlagen bzw. Verweise auf nachgereichte Anlagen enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1747990674742_252548_30090" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1747990674742_130658_30088" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1747992423093_262398_30198" name="" visibility="public" client="_19_0_3_136d03d4_1611871241081_824336_23111" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241082_214319_23113" name="Teilbaugenehmigung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871249409_422712_24295" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_214319_23113" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249409_953430_24296" name="teilbaugenehmigung.antrag.0230" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266685_21631_26993" annotatedElement="_19_0_3_136d03d4_1611871249409_953430_24296" body="&lt;para>Mittels dieser Nachricht beantragt der Autor eine Teilbaugenehmigung zu einem bereits bei der Bauaufsichtsbehörde vorliegenden Bauantrag.&lt;/para>&#xA;&lt;para>Die Nachricht enthält die Daten zum Antrag Teilbaugenehmigung und ggf. ergänzende Anlagen (zusätzlich zu den der Behörde bereits vorliegenden), die die Bauabschnitte abgrenzen, die den Gegenstand des Antrags bilden.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_404346_25313" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266685_372421_26994" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282568_299598_33925" annotatedElement="_19_0_3_136d03d4_1611871266685_372421_26994" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282568_335120_33926" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282568_829222_33924" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266685_883053_26995" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282569_413374_33929" annotatedElement="_19_0_3_136d03d4_1611871266685_883053_26995" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282569_720940_33930" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282568_717060_33928" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1670245257054_393750_22199" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1670245257056_371899_22201" annotatedElement="_19_0_3_129a03b9_1670245257054_393750_22199" body="&lt;para>Dieses Element dient der Bezugnahme auf das bei der Behörde laufende Baugenehmigungsverfahren, zu dem die vorliegende Nachricht eine Teilbaugenehmigung beantragt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1670245257056_818386_22202" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1670245257055_808734_22200" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266686_862794_26997" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite" association="_19_0_3_136d03d4_1611871249410_438040_24297">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282569_434403_33937" annotatedElement="_19_0_3_136d03d4_1611871266686_862794_26997" body="&lt;para>Hier sind die Daten zum  Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282570_297327_33938" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282569_30736_33936" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266686_661031_26998" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282570_7474_33941" annotatedElement="_19_0_3_136d03d4_1611871266686_661031_26998" body="&lt;para>Die für die Prüfung des Antrags notwendigen Bauvorlagen sind dem Antrag als Anlage&#xA;beizufügen. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282570_638616_33942" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282570_830937_33940" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871249410_438040_24297" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871266686_862794_26997 _19_0_3_136d03d4_1611871266687_548039_27000">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871266687_548039_27000" name="" visibility="private" type="_19_0_3_136d03d4_1611871249409_953430_24296" association="_19_0_3_136d03d4_1611871249410_438040_24297"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249411_463607_24299" name="teilbaugenehmigung.anhoerung.0233" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266690_198074_27009" annotatedElement="_19_0_3_136d03d4_1611871249411_463607_24299" body="&lt;para>Diese Nachricht fordert den Bauherrn zur Stellungnahme auf, nachdem die materielle Prüfung des Antrags ergeben hat, dass Gründe vorliegen, die zu seiner Ablehnung durch die Bauaufsichtsbehörde führen können. Es sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung sind. Diese werden hier aufgelistet bzw. erläutert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_364200_25279" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266690_312672_27010" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282574_9731_33971" annotatedElement="_19_0_3_136d03d4_1611871266690_312672_27010" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen; außerdem ggf. auf die Nachricht, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282574_984873_33972" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282574_136310_33970" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266690_596333_27011" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282574_212526_33975" annotatedElement="_19_0_3_136d03d4_1611871266690_596333_27011" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282574_222143_33976" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282574_517066_33974" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266691_638770_27012" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282575_999886_33979" annotatedElement="_19_0_3_136d03d4_1611871266691_638770_27012" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Bauantrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282575_327331_33980" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282574_522234_33978" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266691_317146_27013" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282575_802471_33983" annotatedElement="_19_0_3_136d03d4_1611871266691_317146_27013" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282575_922907_33984" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282575_772092_33982" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266691_70032_27014" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282575_434608_33987" annotatedElement="_19_0_3_136d03d4_1611871266691_70032_27014" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282576_922238_33988" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282575_512167_33986" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266691_272261_27015" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282576_639556_33991" annotatedElement="_19_0_3_136d03d4_1611871266691_272261_27015" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;>BIM Collaboration Format (BCF)&lt;/emphasis>. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282576_348280_33992" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282576_916191_33990" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249411_938496_24300" name="teilbaugenehmigung.bescheid.0235" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266692_879337_27017" annotatedElement="_19_0_3_136d03d4_1611871249411_938496_24300" body="&lt;para>Diese Nachricht stellt den Bescheid dar, in den die Bauaufsichtsbehörde die Ergebnisse ihrer materiellen Prüfung einträgt. Der Antrag ist entweder genehmigt, genehmigt mit Nebenbestimmungen&#xA;(zum Beispiel unter Auflagen) oder abgelehnt. Das Absenden dieser Nachricht stellt das Erteilen des Bescheids dar.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_177953_25280" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266692_778594_27018" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282577_439413_33996" annotatedElement="_19_0_3_136d03d4_1611871266692_778594_27018" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang (bzw. die Antragsnachricht) Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282577_862879_33997" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282576_43508_33995" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266692_696277_27019" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282577_513622_34000" annotatedElement="_19_0_3_136d03d4_1611871266692_696277_27019" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&lt;para>Ein Bescheid mit positivem Tenor kann zugelassene oder auch nicht zugelassene Abweichungen (Element abweichung) enthalten. Ein Bescheid mit negativem Tenor kann nur nicht zugelassene Abweichungen enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282577_923114_34001" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282577_187556_33999" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266692_173821_27020" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282577_758547_34004" annotatedElement="_19_0_3_136d03d4_1611871266692_173821_27020" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282578_890658_34005" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282577_651551_34003" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249412_892964_24302" name="teilbaugenehmigung.antragGeaendert.0232" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266694_585158_27027" annotatedElement="_19_0_3_136d03d4_1611871249412_892964_24302" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Antrags bzw. geänderte oder ergänzte Bauvorlagen. &lt;/para>&#xA;&lt;para>Entweder  ist sie eine Reaktion auf eine zum Antrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_223485_25304" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266694_133369_27028" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282580_868755_34022" annotatedElement="_19_0_3_136d03d4_1611871266694_133369_27028" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang (oder den Antrag) und ggf. auf eine Nachricht, auf die die vorliegende Nachrichteninstanz eine Reaktion ist, Bezug zu nehmen. &lt;/para>&#xA;&#xA;&lt;para>Falls mit der Nachricht initiativ eine geänderte Planung eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282580_521769_34023" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282580_187179_34021" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266694_731320_27029" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282580_616317_34026" annotatedElement="_19_0_3_136d03d4_1611871266694_731320_27029" body="&lt;para>Ggf. sind in diesem Element korrigierte oder ergänzte Daten zum (Teil-)Bauvorhaben (Wer, Was, Wo)  zu übermitteln. Daten, die an dieser Stelle eingetragen sind, sollen die aufgeführten Mängel beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;&lt;para>Dabei wird nicht informiert, welche Daten gestrichen, geändert oder ergänzt wurden. Der Datenempfänger wird das also eigenständig ermitteln, soweit auf seiner Seite notwendig. Auch ein Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der zur Änderung oder Ergänzung führte, ist nicht in der Nachricht enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282580_955594_34027" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282580_509659_34025" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266694_729834_27030" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282581_398374_34030" annotatedElement="_19_0_3_136d03d4_1611871266694_729834_27030" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;&lt;para>Falls  der Antragsteller initiativ mit der Nachricht eine modifizierte  Planung einreicht, muss unter den Anlagen (je nach Landesbauordnung) ggf. eine Übereinstimmungserklärung enthalten sein. Außerdem muss unter den Anlagen eine Begründung bzw. Erläuterung zur eingereichten geänderten Planung enthalten sein. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282581_154027_34031" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282580_719690_34029" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249412_95193_24303" name="teilbaugenehmigung.stellungnahme.0234" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266695_337574_27032" annotatedElement="_19_0_3_136d03d4_1611871249412_95193_24303" body="&lt;para>Diese Nachricht bezieht sich auf einen gestellten Antrag auf Teilbaugenehmigung und auf eine zu diesem&#xA;vorliegende Anhörungsnachricht. Sie enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Bauvorhabens bzw. des Antrags, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_108776_25286" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266695_905622_27033" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282581_745539_34035" annotatedElement="_19_0_3_136d03d4_1611871266695_905622_27033" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen und außerdem auf die Nachricht, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282581_891388_34036" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282581_247392_34034" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266695_775500_27034" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282582_57442_34039" annotatedElement="_19_0_3_136d03d4_1611871266695_775500_27034" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282582_117734_34040" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282582_781268_34038" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266695_851553_27035" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282582_359456_34043" annotatedElement="_19_0_3_136d03d4_1611871266695_851553_27035" body="&lt;para>Ggf. sind hier geänderte oder ergänzte Daten zum Bauvorhaben enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282582_811457_34044" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282582_213481_34042" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266696_15689_27036" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282583_542037_34047" annotatedElement="_19_0_3_136d03d4_1611871266696_15689_27036" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282583_552016_34048" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282582_221201_34046" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761359719_338148_16858" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_214319_23113" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241082_31515_23114" name="Kammernverzeichnis" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871249413_54500_24305" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_31515_23114" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249413_431334_24306" name="kammernverzeichnis.anfrage.0930" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266697_866708_27040" annotatedElement="_19_0_3_136d03d4_1611871249413_431334_24306" body="&lt;para>Mit dieser Nachricht wird eine Anfrage an den Verzeichnisdienst der Kammern gerichtet.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_595081_25292" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266697_299056_27041" name="referenzAbfrage" visibility="private" type="_19_0_3_940029b_1591038023050_502647_13346">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282583_36169_34053" annotatedElement="_19_0_3_136d03d4_1611871266697_299056_27041" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282583_33861_34054" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282583_395261_34052" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668599020567_472200_18367" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668599020570_228652_18369" annotatedElement="_19_0_3_129a03b9_1668599020567_472200_18367" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668599020570_412146_18370" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668599020569_193055_18368" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266697_129618_27042" name="angabenAnfrage" visibility="private" type="_19_0_4_b6602da_1728384229446_765580_29301" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282584_769347_34057" annotatedElement="_19_0_3_136d03d4_1611871266697_129618_27042" body="&lt;para>Eine Instanz dieses Elements enthält die Merkmale, auf deren Basis ein Datensatz im Verzeichnis einer Architekten- oder Ingenieurkammer identifiziert werden soll. Es muss  mitgliedsnummer, personennummer oder name  (oder auch alle drei) instantiiert sein.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282584_269001_34058" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282584_629766_34056" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871249413_801124_24307" name="kammernverzeichnis.auskunft.0931" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871266698_696119_27044" annotatedElement="_19_0_3_136d03d4_1611871249413_801124_24307" body="&lt;para>Diese Nachricht liefert die Auskunft des Verzeichnisdienstes der Kammern.&lt;/para>&#xA;&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_80902_25318" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266698_183300_27045" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282584_71054_34062" annotatedElement="_19_0_3_136d03d4_1611871266698_183300_27045" body="&lt;para>In diesem Objekt werden Eintragungen vorgenommen, um auf die Anfrage Bezug zu nehmen, zu der die vorliegende Nachricht Auskünfte enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282584_56824_34063" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282584_536432_34061" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266698_319591_27046" name="angabenAnfrage" visibility="private" type="_19_0_4_b6602da_1728384229446_765580_29301" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282585_567581_34066" annotatedElement="_19_0_3_136d03d4_1611871266698_319591_27046" body="&lt;para>Hier sind die Merkmale einzutragen, die in der korrespondierenden Anfrage übermittelt wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282585_777615_34067" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282585_772001_34065" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871266699_361432_27047" name="auskunftKammernverzeichnis" visibility="private" type="_19_0_3_136d03d4_1611871266699_712869_27049" isReadOnly="true" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282585_731383_34070" annotatedElement="_19_0_3_136d03d4_1611871266699_361432_27047" body="&lt;para>In einer Instanz dieses Elements werden die Daten aus dem angefragten Kammernverzeichnis zur Person mit der angefragten Mitgliedsnummer,  Personennummer oder Namen übermittelt.&lt;/para>&#xA;&lt;para>Ein Fehlen dieses Elements zeigt an, dass die Anfrage korrekt bearbeitet werden konnte, das angefragte Kammernverzeichnis zu den übermittelten Merkmalen aber keinen Eintrag enthält (es wird keine Person mit der angegebenen Mitgliedsnummer, Personennummer oder Namen geführt).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282585_697740_34071" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282585_210324_34069" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752481429820_291554_31041" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752481717372_439257_31047" annotatedElement="_19_0_4_b8702dd_1752481429820_291554_31041" body="&lt;para>Wurden die Informationen aus dem Kammernverzeichnis per automatisiertem Nachweisabruf bereitgestellt, kann hier die XNachweis-Datei beigefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752481668013_701141_31045" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752481668013_828143_31046" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871249414_812689_24308" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871266699_712869_27049" name="Anonym_Auskunft" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282586_844939_34074" annotatedElement="_19_0_3_136d03d4_1611871266699_712869_27049" body="&#xA;"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282586_390174_34075" name="name" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283374_407188_37209" annotatedElement="_19_0_3_136d03d4_1611871282586_390174_34075" body="&lt;para>Namensangaben zur angefragten Person&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283374_319458_37210" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283373_804250_37208" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282586_15058_34076" name="nummernKammernverzeichnis" visibility="private" type="_19_0_3_940029b_1669717113595_748613_21898">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283374_692400_37213" annotatedElement="_19_0_3_136d03d4_1611871282586_15058_34076" body="&lt;para>In diesem Objekt werden die im Datensatz im Kammernverzeichnis gespeicherten Nummern zur angefragten Person übermittelt. Zu Personen, die laut Verzeichnis mehrere Personennummern habe, können diese alle in einer Ergebnisnachricht übermittelt werden.&lt;/para>&#xA;&lt;para>Wenn die vorliegende Nachrichteninstanz Daten aus einem Kammernverzeichnis liefert, dann muss dieses Objekt gefüllt sein. Es sind die gespeicherten Nummern zu übermitteln&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283374_703201_37214" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283374_866296_37212" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282587_407735_34077" name="berufsbezeichnung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283375_275540_37217" annotatedElement="_19_0_3_136d03d4_1611871282587_407735_34077" body="&lt;para>Angaben zur Berufsbezeichnung (Architekt, Stadtplaner usw.). Pro Angabe ist ein separates Element zu instantiieren.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283375_515008_37218" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283375_730657_37216" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282587_373830_34078" name="nachweisBerechtigung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283375_157183_37221" annotatedElement="_19_0_3_136d03d4_1611871282587_373830_34078" body="&lt;para>Angaben zu Nachweis und Prüfberechtigung.&lt;/para>&#xA;&lt;para>Pro Angabe ist ein separates Element zu befüllen.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283375_549248_37222" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283375_350635_37220" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1752481090355_864718_30967" name="sperrung" visibility="private" type="_19_0_4_b8702dd_1752480895187_569505_30955">
                <ownedComment xmi:id="_19_0_4_b8702dd_1752481188384_441564_30971" annotatedElement="_19_0_4_b8702dd_1752481090355_864718_30967" body="&lt;para>Falls Informationen über eine Sperrung im Kammernverzeichnis vorliegen (z.B. aufgrund von entzogener Bauvorlageberechtigung, Disziplinarmaßnahmen, Ablauf der Registrierung, fehlenden Nachweisen), können diese hier angegeben werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752481090356_190459_30969" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752481090356_376104_30968" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1758112752647_137245_31569" name="status" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_4_b8702dd_1758113066692_163347_31572" annotatedElement="_19_0_4_b8702dd_1758112752647_137245_31569" body="&lt;para>Zur detaillierten Beurteilung der Bauvorlageberechtigung durch die Bauaufsicht kann hier der Status der Person, z.B. selbständig oder angestellt bei einer Behörde, übermittelt werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1758113014781_879108_31570" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1758113014781_946939_31571" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1669717113595_748613_21898" name="Anonym_AuskunftKammerneintrag" visibility="public">
              <ownedComment xmi:id="_19_0_3_940029b_1669717113601_570972_21899" annotatedElement="_19_0_3_940029b_1669717113595_748613_21898" body=""/>
              <ownedAttribute xmi:id="_19_0_3_940029b_1669717113601_938488_21900" name="mitgliedsnummer" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                <ownedComment xmi:id="_19_0_3_940029b_1669717113605_98574_21905" annotatedElement="_19_0_3_940029b_1669717113601_938488_21900" body="&lt;para>Dieses Elements übermittelt die Mitgliedsnummer aus dem Kammernverzeichnis.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1669717113605_883436_21906" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1669717113604_615603_21904" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_940029b_1669717113602_678008_21901" name="personennummer" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                <ownedComment xmi:id="_19_0_3_940029b_1669717113606_521680_21909" annotatedElement="_19_0_3_940029b_1669717113602_678008_21901" body="&lt;para>Dieses Element wird instantiiert, wenn im Kammerverzeichnis gespeicherte Personennummern für Nichtmitglieder übermittelt werden sollen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1669717113607_982047_21910" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1669717113606_220370_21908" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_940029b_1669717113603_454948_21902" name="kammer" visibility="private" type="_19_0_3_136d03d4_1611871239775_637786_22806">
                <ownedComment xmi:id="_19_0_3_940029b_1669717113608_889839_21913" annotatedElement="_19_0_3_940029b_1669717113603_454948_21902" body="&lt;para>Dieses Element enthält die Bezeichnung der Architekten- oder Ingenieurkammer, aus deren Verzeichnis die Daten übermittelt wurden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1669717113608_585720_21914" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1669717113607_998005_21912" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1752480895187_569505_30955" name="Anonym_SperrungKammernverzeichnis" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752480895200_779161_30956" annotatedElement="_19_0_4_b8702dd_1752480895187_569505_30955" body="&lt;para>In diesem Element können Informationen zu einer Sperrung einer Person oder Berechtigung im Kammernverzeichnis gegeben werden.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1752480895201_737035_30957" name="statusSperrung" visibility="private" type="_19_0_4_b8702dd_1752481231840_162257_30972">
                <ownedComment xmi:id="_19_0_4_b8702dd_1752480895203_369053_30960" annotatedElement="_19_0_4_b8702dd_1752480895201_737035_30957" body="&lt;para>In diesem Element ist anzugeben, in welchem Status sich die Sperrung befindet.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752481349378_397302_31039" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752481349378_942299_31040" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1752480895202_256731_30958" name="gesperrtSeit" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_4_b8702dd_1752480895205_385184_30962" annotatedElement="_19_0_4_b8702dd_1752480895202_256731_30958" body="&lt;para>Falls im Kammernverzeichnis aktuell eine Sperrung eingetragen ist, kann hier der Beginn des Sperrungszeitraums angegeben werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752480895207_995917_30963" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752480895205_710442_30961" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1752480895203_374996_30959" name="bemerkungen" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_4_b8702dd_1752480895207_865923_30965" annotatedElement="_19_0_4_b8702dd_1752480895203_374996_30959" body="&lt;para>In diesem Element können weitere Hinweise zur Sperrung eingetragen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752480895208_498314_30966" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752480895207_996822_30964" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761335195_314334_16856" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_31515_23114" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1629802089996_144532_17427" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_31515_23114" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679317927843_970849_22494" name="" visibility="public" client="_19_0_3_136d03d4_1611871241082_31515_23114" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_131403da_1619533750082_46231_16852" name="Bauberatung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1619533871979_974353_16853" name="bauberatung.anfrage.0110" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1619537718414_406894_16961" annotatedElement="_19_0_131403da_1619533871979_974353_16853" body="&lt;para> Mit dieser Nachricht wird eine formlose Anfrage zur Bauberatung an die Bauaufsichtsbehörde übermittelt.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1619537615633_61196_16960" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1619930631398_74089_17089" name="referenzAnfrageservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_940029b_1619930631416_865853_17091" annotatedElement="_19_0_3_940029b_1619930631398_74089_17089" body="&lt;para>Eine vom Anfrageservice (bzw. OZG-Portal) vergebene eindeutige Kennung des Anfragevorgangs. Sofern die Bauaufsichtsbehörde auf die Anfrage reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1619930631418_471866_17092" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1619930631413_457188_17090" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1619536570822_617582_16936" name="anfragendePerson" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_131403da_1619711795079_994073_16920" annotatedElement="_19_0_131403da_1619536570822_617582_16936" body="&lt;para>Mit diesem Element werden die Daten der anfragenden Person übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619536740990_565370_16938" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619536740991_532752_16939" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1670241697667_16479_22187" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1670241697672_843023_22189" annotatedElement="_19_0_3_129a03b9_1670241697667_16479_22187" body="&lt;para>Hier können Eintragungen vorgenommen werden, falls sich die Anfrage auf vorhandene Vorgänge bezieht.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1670241697673_23350_22190" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1670241697672_474045_22188" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1619537174953_580198_16948" name="anfrage" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_131403da_1619711811456_723116_16922" annotatedElement="_19_0_131403da_1619537174953_580198_16948" body="&lt;para>In diesem Element wird der Inhalt der Anfrage übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619537268184_293424_16952" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619537268187_301278_16953" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1619537296962_522309_16954" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_131403da_1619711813495_772244_16923" annotatedElement="_19_0_131403da_1619537296962_522309_16954" body="&lt;para>Dieses Element kann für Bauvorlagen verwendet werden, die der Anfrage beigelegt werden sollen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619537318010_837568_16955" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619537318010_68338_16956" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1619592738555_523175_17032" name="bauberatung.auskunft.0111" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1619593699622_699034_17051" annotatedElement="_19_0_131403da_1619592738555_523175_17032" body="&lt;para>Diese Nachricht enthält die Auskunft der Bauaufsichtsbehörde zur Anfrage Bauberatung.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1619602077931_556930_17148" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1619593224830_195404_17033" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1619593900234_917433_17053" annotatedElement="_19_0_131403da_1619593224830_195404_17033" body="&lt;para>Hier ist ein Aktenzeichen einzutragen, falls die Bauaufsichtsbehörde dem Anfragevorgang ein solches zuordnen will. Jedenfalls ist hier die Referenz (UUID) auf die Anfrage zu übermitteln.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619593460368_660092_17037" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619593460368_92909_17038" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1619593472993_600081_17039" name="auskunft" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_131403da_1619711818103_166801_16924" annotatedElement="_19_0_131403da_1619593472993_600081_17039" body="&lt;para>Mit diesem Element wird die Beratungsauskunft der Bauaufsichtsbehörde zu der formlosen Anfrage übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619593547754_532355_17043" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619593547754_838036_17044" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1619593589380_269381_17045" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_131403da_1619594249588_143918_17054" annotatedElement="_19_0_131403da_1619593589380_269381_17045" body="&lt;para>Dieses Element beinhaltet Anlagen zur Auskunft, falls solche übermittelt werden sollen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1619593598178_476119_17046" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1619593598179_769304_17047" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1619712926818_313824_17070" name="" visibility="public" client="_19_0_131403da_1619533750082_46231_16852" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1619712968625_547882_17071" name="" visibility="public" client="_19_0_131403da_1619533750082_46231_16852" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1619713237367_31530_17143" name="" visibility="public" client="_19_0_131403da_1619533750082_46231_16852" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_131403da_1620138588429_298745_16886" name="Grundstuecksteilung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620138664723_995850_16890" name="grundstuecksteilung.antrag.0240" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1620334799300_784318_17174" annotatedElement="_19_0_131403da_1620138664723_995850_16890" body="&lt;para>Mit dieser Nachricht wird der Antrag auf Grundstücksteilung oder auf Ausstellung eines Negativzeugnisses/Negativattests übermittelt.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1620143537619_125373_17419" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1620675140710_517660_17181" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_940029b_1620675140725_141654_17183" annotatedElement="_19_0_3_940029b_1620675140710_517660_17181" body="&lt;para>Eine vom Antragsservice vergebene Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1620675140726_432421_17184" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1620675140723_160139_17182" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620139998422_468441_16902" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_131403da_1620334467298_695029_17171" annotatedElement="_19_0_131403da_1620139998422_468441_16902" body="&lt;para>Mit diesem Element werden die Daten des Antragsstellers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620140048364_898129_16904" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620140048365_34907_16905" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1670268675766_796604_22187" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1670268675773_377117_22189" annotatedElement="_19_0_3_129a03b9_1670268675766_796604_22187" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1670268675774_100890_22190" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1670268675773_807456_22188" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620140109258_863515_16906" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_131403da_1620334484345_447184_17172" annotatedElement="_19_0_131403da_1620140109258_863515_16906" body="&lt;para>Mit diesem Element werden die Daten der Beteiligten (bspw. Katasteramt, Vermessungsingenieur) übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620140144988_697958_16907" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620140144988_655401_16908" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1740393154859_816809_29064" name="negativzeugnis" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1740393315964_457029_29078" annotatedElement="_19_0_4_b6602da_1740393154859_816809_29064" body="&lt;para>Mit diesem Element wird angegeben, ob die Ausstellung eines Negativzeugnisses/Negativattests beantragt wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1740393303322_734931_29076" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1740393303322_221059_29077" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620140192855_520866_16914" name="angabenGrundstueck" visibility="private" type="_19_0_131403da_1620140448079_230151_16920">
              <ownedComment xmi:id="_19_0_131403da_1620334647145_574790_17173" annotatedElement="_19_0_131403da_1620140192855_520866_16914" body="&lt;para>Mit diesem Element werden die Daten zu dem zu teilenden Grundstück übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1620676730042_88659_17228" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1620676730043_581644_17229" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620141893143_211407_17005" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_131403da_1620141963233_96623_17006" annotatedElement="_19_0_131403da_1620141893143_211407_17005" body="&lt;para>Mit diesem Element werden die Anlagen (u.a. Lageplan und  Bauzeichnungen) zu einem Teilungsantrag übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669377582628_367966_22438" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669377582628_550062_22439" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_131403da_1620140416046_881750_16919" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620140448079_230151_16920" name="Anonym_AngabenGrundstueck" visibility="public">
              <ownedAttribute xmi:id="_19_0_131403da_1620140696053_793359_16921" name="grundstueckIstBebaut" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_131403da_1620339718260_849004_17585" annotatedElement="_19_0_131403da_1620140696053_793359_16921" body="&lt;para>Mit diesem Element wird angegeben, ob das Grundstück bebaut oder unbebaut ist. Falls es bebaut ist, ist true einzutragen, andernfalls false.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1620676705753_178664_17224" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1620676705754_68514_17225" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1620141304193_982510_16923" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
                <ownedComment xmi:id="_19_0_131403da_1620339857378_801616_17586" annotatedElement="_19_0_131403da_1620141304193_982510_16923" body="&lt;para>Mit diesem Element werden die Daten zu dem Grundstück übermittelt, auf das sich die beantragte Teilung bezieht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1620676713456_550999_17226" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1620676713456_426267_17227" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1620142628077_724035_17270" name="" visibility="public" client="_19_0_131403da_1620138588429_298745_16886" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1620142653936_842329_17271" name="" visibility="public" client="_19_0_131403da_1620138588429_298745_16886" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620330841732_941405_17040" name="grundstuecksteilung.antragGeaendert.0242" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1620330841732_292434_17041" annotatedElement="_19_0_131403da_1620330841732_941405_17040" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten der Antragstellung zur Grundstücksteilung. Sie bezieht sich auf einen bereits gestellten Teilungsantrag, zu dem noch kein Bescheid erteilt wurde.&lt;/para>&#xA;&lt;para>Entweder ist sie eine Reaktion auf eine zum Teilungsantrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1620330841732_379747_17049" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1620330841732_108552_17042" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1620330841732_543177_17052" annotatedElement="_19_0_131403da_1620330841732_108552_17042" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang (oder den Antrag) und ggf. auf eine Nachricht grundstuecksteilung.antrag.0240, auf die die vorliegende Nachrichteninstanz eine Reaktion ist, Bezug zu nehmen.&lt;/para>&#xA;&#xA;&lt;para>Falls mit der Nachricht initiativ eine geänderte Planung eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620330841732_848968_17053" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620330841732_722250_17051" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1620675466144_422677_17188" name="beteiligteGeaendert" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_3_940029b_1620675466148_100379_17190" annotatedElement="_19_0_3_940029b_1620675466144_422677_17188" body="&lt;para>Mit diesem Element werden  ggf. korrigierte oder ergänzte Daten der Beteiligten (bspw. Katasteramt, Vermessungsingenieur) übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1620675466149_517947_17191" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1620675466147_629329_17189" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1620675479088_49166_17195" name="angabenGrundstueckGeaendert" visibility="private" type="_19_0_131403da_1620140448079_230151_16920">
              <ownedComment xmi:id="_19_0_3_940029b_1620675479089_193873_17196" annotatedElement="_19_0_3_940029b_1620675479088_49166_17195" body="&lt;para>Mit diesem Element werden  ggf. korrigierte oder ergänzte Daten zu dem zu teilenden Grundstück übermittelt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669370097422_135967_21656" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669370097422_628748_21657" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620330841732_340554_17048" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620330841732_687777_17076" annotatedElement="_19_0_131403da_1620330841732_340554_17048" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;&lt;para>Falls  der Antragsteller initiativ mit der Nachricht eine modifizierte  Planung einreicht, muss unter den Anlagen (je nach Landesbauordnung) ggf. eine Übereinstimmungserklärung enthalten sein. Außerdem muss unter den Anlagen eine Begründung bzw. Erläuterung zur eingereichten geänderten Planung enthalten sein. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620330841732_256088_17077" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620330841732_979868_17075" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620336708200_497300_17295" name="grundstuecksteilung.stellungnahme.0244" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1620336708216_108819_17296" annotatedElement="_19_0_131403da_1620336708200_497300_17295" body="&lt;para>Diese Nachricht bezieht sich auf einen bereits gestellten Teilungsantrag und auf eine zu diesem&#xA;vorliegende Anhörungsnachricht. Sie enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Teilungsvorhabens, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_131403da_1620336708216_120229_17301" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1620336708216_415808_17297" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1620336708216_893572_17304" annotatedElement="_19_0_131403da_1620336708216_415808_17297" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Teilungsantrag Bezug zu nehmen und außerdem auf die Nachricht grundstuecksteilung.anhoerung.0244, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620336708216_769189_17305" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620336708216_343197_17303" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620336708216_36079_17298" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620336708216_284374_17308" annotatedElement="_19_0_131403da_1620336708216_36079_17298" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620336708216_14776_17309" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620336708216_52689_17307" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620336708216_941396_17300" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620336708216_701503_17316" annotatedElement="_19_0_131403da_1620336708216_941396_17300" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620336708216_179256_17317" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620336708216_691748_17315" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620337299475_654670_17329" name="grundstuecksteilung.anhoerung.0243" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1620337299476_461926_17330" annotatedElement="_19_0_131403da_1620337299475_654670_17329" body="&lt;para>Diese Nachricht fordert den Bauherrn zur Stellungnahme auf, nachdem die materielle Prüfung des Teilungsantrags  ergeben hat, dass Gründe vorliegen, die zu seiner Ablehnung durch die Bauaufsichtsbehörde führen können. Es sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung sind. Diese werden hier aufgelistet bzw. im Anhang der Nachricht dokumentiert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1620337299481_392702_17337" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1620337299477_873204_17331" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1620337299482_535958_17340" annotatedElement="_19_0_131403da_1620337299477_873204_17331" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Teilungsantrag Bezug zu nehmen; außerdem ggf. auf die Nachricht grundstuecksteilung.antrag.0240, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337299483_109457_17341" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337299482_318464_17339" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337299477_902540_17332" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620337299484_905433_17344" annotatedElement="_19_0_131403da_1620337299477_902540_17332" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337299484_111066_17345" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337299483_202718_17343" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337299478_321141_17333" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_131403da_1620337299485_202277_17348" annotatedElement="_19_0_131403da_1620337299478_321141_17333" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Teilungsantrages ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337299485_968340_17349" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337299485_28849_17347" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337299479_761816_17334" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620337299486_189305_17352" annotatedElement="_19_0_131403da_1620337299479_761816_17334" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337299486_716475_17353" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337299486_613350_17351" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337299480_438027_17336" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620337299488_177042_17360" annotatedElement="_19_0_131403da_1620337299480_438027_17336" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337299488_217440_17361" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337299488_811965_17359" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1620337550088_496670_17377" name="grundstuecksteilung.bescheid.0245" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1620337550088_211030_17378" annotatedElement="_19_0_131403da_1620337550088_496670_17377" body="&lt;para>Diese Nachricht stellt den Bescheid dar, in den die Bauaufsichtsbehörde die Ergebnisse ihrer materiellen Prüfung einträgt. Das Absenden dieser Nachricht stellt das Erteilen des Bescheids dar.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1620337550103_754226_17382" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1620337550088_613398_17379" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1620337550103_792609_17385" annotatedElement="_19_0_131403da_1620337550088_613398_17379" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht grundstuecksteilung.antrag.0240 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337550103_8687_17386" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337550103_183998_17384" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337550088_676913_17380" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620337550103_543759_17389" annotatedElement="_19_0_131403da_1620337550088_676913_17380" body="&lt;para>Es handelt sich entweder um einen Bescheid zur Grundstücksteilung oder um ein Negativzeugnis.&#xA;In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337550103_997046_17390" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337550103_870048_17388" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1620337550103_338182_17381" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1620337550103_564413_17393" annotatedElement="_19_0_131403da_1620337550103_338182_17381" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1620337550103_127032_17394" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1620337550103_51895_17392" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1622535841925_237337_17249" name="Prozessnachrichten" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622536095652_643547_17253" name="prozessnachrichten.aenderungProjektraumdaten.0100" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1622536095667_940356_17254" annotatedElement="_19_0_3_136d03d4_1622536095652_643547_17253" body="&lt;para>Mittels dieser Nachricht kann die Bauaufsichtsbehörde bestimmte geänderte Daten zum Bauvorhaben im Projektraum aktualisieren.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1622536095667_66907_17258" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1666081001334_528256_18240" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1666081001350_907486_18242" annotatedElement="_19_0_3_129a03b9_1666081001334_528256_18240" body="&lt;para>In diesem Element wird die Nachricht eingetragen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1666081001350_765505_18243" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1666081001350_755794_18241" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536257126_441650_17285" name="geaenderteDaten" visibility="private" type="_19_0_3_136d03d4_1622536315768_545045_17287">
              <ownedComment xmi:id="_19_0_3_136d03d4_1622536910269_555792_17327" annotatedElement="_19_0_3_136d03d4_1622536257126_441650_17285" body="&lt;para>Eine Instanz dieses Elements umfasst die geänderten Daten zum Bauvorhaben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536394739_988676_17291" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536394739_281978_17292" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1622536175284_263223_17280" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622536315768_545045_17287" name="Anonym_GeaenderteDaten" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536331377_666691_17288" name="verfahrenskennzeichen" visibility="private" type="_19_0_3_136d03d4_1622536431783_27493_17299">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622537124014_235286_17328" annotatedElement="_19_0_3_136d03d4_1622536331377_666691_17288" body="&lt;para>In diesem Element werden geänderte Verfahrenskennzeichen übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536401155_159756_17293" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536401155_668010_17294" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536339435_405761_17289" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622537161332_291349_17329" annotatedElement="_19_0_3_136d03d4_1622536339435_405761_17289" body="&lt;para>In diesem Element wird die geänderte Bezeichnung des Bauvorhabens übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536405819_721156_17295" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536405819_826176_17296" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1639743816795_147093_17826" name="antragstellerdaten" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                <ownedComment xmi:id="_19_0_3_136d03d4_1639744047428_829915_17838" annotatedElement="_19_0_3_136d03d4_1639743816795_147093_17826" body="&lt;para>In diesem Element werden geänderte Daten zum Antragsteller übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1639743989318_559055_17834" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1639743989319_440207_17835" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1666194919737_515948_20550" name="beteiligteGeaendert" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
                <ownedComment xmi:id="_19_0_3_129a03b9_1666194919738_466887_20552" annotatedElement="_19_0_3_129a03b9_1666194919737_515948_20550" body="&lt;para>Mit diesem Element werden ggf. geänderte Daten zu Beteiligten am Verfahren übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1666194919738_764417_20553" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1666194919738_200017_20551" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536354119_245665_17290" name="datenBaugrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_572179_23532">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622537193490_158772_17330" annotatedElement="_19_0_3_136d03d4_1622536354119_245665_17290" body="&lt;para>In diesem Element werden geänderte Daten zum Baugrundstück übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536410893_614955_17297" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536410893_599493_17298" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622536431783_27493_17299" name="Anonym_Verfahrenskennzeichen" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536659430_150894_17313" name="verfahrensart" visibility="private" type="_19_0_3_136d03d4_1611871239791_257404_22869">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622537343923_934507_17331" annotatedElement="_19_0_3_136d03d4_1622536659430_150894_17313" body="&lt;para>In diesem Element wird die geänderte baurechtliche Verfahrensart übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536735041_719550_17321" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536735041_12977_17322" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1622536664975_169680_17314" name="artDerMassnahme" visibility="private" type="_19_0_3_136d03d4_1611871239752_686519_22726">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622537453831_983528_17332" annotatedElement="_19_0_3_136d03d4_1622536664975_169680_17314" body="&lt;para>In diesem Element wird die geänderte Art der Maßnahme übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622536741611_472843_17323" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622536741611_920014_17324" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1622536560809_877879_17300" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1622536600899_741952_17302" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1622536789333_288944_17325" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_19_0_3_136d03d4_1611871239054_886756_22662"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1639744512151_725510_17840" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679318004863_776157_22496" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1726761837673_443375_27791" name="prozessnachrichten.aktenraum.anlegen.0150" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1726761837752_553998_27823" annotatedElement="_19_0_3_129a03b9_1726761837673_443375_27791" body="&lt;para>Mit dieser Nachricht fordert die Bauaufsichtsbehörde die bereitstellende Komponente auf, einen Aktenraum anzulegen, diesen mit den erforderlichen Informationen aus der Datenbasis zu befüllen und der Bauaufsichtsbehörde die Identität des Aktenraums mitzuteilen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1726761837756_525192_27833" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837752_509338_27824" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837788_829934_27878" annotatedElement="_19_0_3_129a03b9_1726761837752_509338_27824" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang Bezug zu nehmen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837789_413480_27879" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837788_748930_27877" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837753_172599_27825" name="aktenzeichen" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837789_975472_27882" annotatedElement="_19_0_3_129a03b9_1726761837753_172599_27825" body="&lt;para>In dieses Element kann ein zusätzliches Aktenzeichen eingetragen werden, soweit die Vorgangsbezeichnung im Objekt bezug nicht ausreicht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837789_378719_27883" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837789_45814_27881" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837753_213279_27826" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837790_411555_27886" annotatedElement="_19_0_3_129a03b9_1726761837753_213279_27826" body="&lt;para>Dieses Element enthält die Bezeichnung des Bauvorhabens, unter dem es in der Bauaufsichtsbehörde geführt wurde bzw. wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837790_859315_27887" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837790_480433_27885" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837754_774145_27827" name="referenzBGV" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837790_621088_27890" annotatedElement="_19_0_3_129a03b9_1726761837754_774145_27827" body="&lt;para>In dieses Element ist die eindeutige Referenz im IT-Fachverfahren der Bauaufsichtsbehörde (BGV) einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837790_619270_27891" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837790_327151_27889" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837754_18218_27828" name="gegenstandDesAntrags" visibility="private" type="_19_0_3_c4f030d_1634123279762_31926_17808">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837791_29840_27894" annotatedElement="_19_0_3_129a03b9_1726761837754_18218_27828" body="&lt;para>Hier ist anzugeben, welche Dokumente eingesehen werden sollen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837791_678977_27895" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837791_593387_27893" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837754_977994_27829" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837791_178422_27898" annotatedElement="_19_0_3_129a03b9_1726761837754_977994_27829" body="&lt;para>Mit diesem Element werden die Daten zu dem Grundstück des Bauvorhabens übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837791_73843_27899" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837791_340899_27897" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837755_472352_27830" name="gueltigkeit" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837792_619497_27902" annotatedElement="_19_0_3_129a03b9_1726761837755_472352_27830" body="&lt;para>Hier ist das Datum anzugeben, bis zu dem der Aktenraum zur Einsichtsichtnahme zur Verfügung stehen soll.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837792_376859_27903" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837792_730052_27901" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837755_245172_27831" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837793_469357_27906" annotatedElement="_19_0_3_129a03b9_1726761837755_245172_27831" body="&lt;para>Hier sind die Anlagen zum Auftrag enthalten. Jede Instanz des Elements steht für ein angehängtes Dokument.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837793_57034_27907" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837793_911224_27905" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837755_343080_27832" name="mitStellungnahme" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837793_672815_27910" annotatedElement="_19_0_3_129a03b9_1726761837755_343080_27832" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass in der Antwortnachricht die Möglichkeit zur Stellungnahme gegeben werden soll.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837794_883341_27911" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837793_322121_27909" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1726761837794_939667_27912" name="" visibility="public" value="true"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1726761837680_702666_27792" name="prozessnachrichten.aktenraum.angelegt.0151" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1726761837785_505456_27864" annotatedElement="_19_0_3_129a03b9_1726761837680_702666_27792" body="&lt;para>Mit dieser Nachricht versendet die bereitstellende Komponente die Bestätigung, dass ein Aktenraum angelegt und mit den erforderlichen Informationen gefüllt wurde, an die Bauaufsichtsbehörde.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1726761837787_624476_27869" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837785_424603_27865" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837795_348564_27918" annotatedElement="_19_0_3_129a03b9_1726761837785_424603_27865" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Nachrichteninstanz Bezug zu nehmen, durch deren Eingang bei der bereitstellenden Komponente das Anlegen des Aktenraums ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837795_770937_27919" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837795_589260_27917" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837786_698717_27866" name="aktenraum" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837795_629364_27922" annotatedElement="_19_0_3_129a03b9_1726761837786_698717_27866" body="&lt;para>Dieses Element enthält Informationen zur Identität des angelegten Aktenraums bzw. die entsprechenden Zugangsdaten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837796_521443_27923" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837795_992935_27921" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837786_288151_27867" name="zugangslink" visibility="private" type="_19_0_3_c4f030d_1642416591066_427158_17824">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837796_556786_27926" annotatedElement="_19_0_3_129a03b9_1726761837786_288151_27867" body="&lt;para>In diesem Element kann der Zugang zum Aktenraum per Verlinkung zum Ablageort der Dokumente eingetragen werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837796_220252_27927" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837796_946643_27925" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837786_613741_27868" name="mitStellungnahme" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837797_965710_27930" annotatedElement="_19_0_3_129a03b9_1726761837786_613741_27868" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass in der Antwortnachricht die Möglichkeit zur Stellungnahme verschaffen worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837797_623570_27931" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837796_671312_27929" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1726761837797_296336_27932" name="" visibility="public" value="true"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1726761837681_135260_27793" name="prozessnachrichten.aktenraum.zugriffVerweigern.0152" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1726761837787_152207_27871" annotatedElement="_19_0_3_129a03b9_1726761837681_135260_27793" body="&lt;para>Mit dieser Nachricht initiiert die Bauaufsichtsbehörde den vorzeitigen Entzug von Zugriffsrechten auf den Aktenraum, z.B. bei Missbrauchsverdacht. Der Aktenraum soll damit vor dessen Gültigkeitsende unzugänglich gemacht werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1726761837787_282681_27874" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837787_188603_27872" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837797_495384_27937" annotatedElement="_19_0_3_129a03b9_1726761837787_188603_27872" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang bzw. die Nachricht Bezug zu nehmen, die das Anlegen des Aktenraums veranlasst hat.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837798_908951_27938" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837797_429317_27936" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1726761837787_104297_27873" name="zugriffVerweigern" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
              <ownedComment xmi:id="_19_0_3_129a03b9_1726761837798_784838_27941" annotatedElement="_19_0_3_129a03b9_1726761837787_104297_27873" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass der Zugangscode zu widerrufen ist und der Aktenraum unzugänglich gemacht werden soll.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1726761837798_463408_27942" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1726761837798_863949_27940" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1726761837798_17691_27943" name="" visibility="public" value="true"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1726764494032_196799_28135" name="" visibility="public" client="_19_0_3_136d03d4_1622535841925_237337_17249" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_131403da_1623846201806_100864_17139" name="Abgeschlossenheit" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1623873164573_481394_17219" name="abgeschlossenheit.antrag.0250" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1623873164578_368077_17220" annotatedElement="_19_0_131403da_1623873164573_481394_17219" body="&lt;para>Mit dieser Nachricht werden die Daten zum Antrag auf eine Abgeschlossenheitsbescheinigung für Wohneigentum nach § 7 WoEigG oder auf Dauerwohnrecht nach § 32 WoEigG an die Bauaufsichtsbehörde übermittelt.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1623873164583_826989_17227" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1702888682739_475917_24791" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b6602da_1702888682750_117291_24793" annotatedElement="_19_0_4_b6602da_1702888682739_475917_24791" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1702888682751_509988_24794" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1702888682749_995076_24792" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1623873164578_996819_17221" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_131403da_1623873164584_201319_17230" annotatedElement="_19_0_131403da_1623873164578_996819_17221" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623873164584_166224_17231" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623873164584_660323_17229" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1623873724409_510767_17267" name="aenderungsantrag" visibility="private" type="_19_0_131403da_1623874368209_599583_17275">
              <ownedComment xmi:id="_19_0_131403da_1623873724411_407047_17269" annotatedElement="_19_0_131403da_1623873724409_510767_17267" body="&lt;para>Falls der vorliegende Antrag ein Änderungsantrag ist, wird mit diesem Element das Aktenzeichen des ursprünglichen Antrags übermittelt, auf das sich der Änderungsantrag bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623873724412_863991_17270" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623873724411_211805_17268" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1623875618925_464612_17280" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_131403da_1623875618927_73890_17282" annotatedElement="_19_0_131403da_1623875618925_464612_17280" body="&lt;para>Mit diesem Element werden die Daten zu dem Grundstück übermittelt, auf das sich der Antrag der Abgeschlossenheitsbescheinigung bezieht. Falls mehrere Grundstücke betroffen sind, ist das Element mehrfach zu instantiieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623875618927_205900_17283" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623875618926_365693_17281" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1623918772564_164999_17361" name="abgeschlossenheitsbescheinigung" visibility="private" type="_19_0_131403da_1623918845237_309998_17362">
              <ownedComment xmi:id="_19_0_131403da_1623955275822_355506_17164" annotatedElement="_19_0_131403da_1623918772564_164999_17361" body="&lt;para>Mit diesem Element werden die Informationen zu den Räumlichkeiten und der Art der beantragten Abgeschlossenheitsbescheinigung übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623923275236_607995_17541" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623923275237_983545_17542" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1623923283969_700848_17543" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_131403da_1623928043588_787594_17799" annotatedElement="_19_0_131403da_1623923283969_700848_17543" body="&lt;para>Mit diesem Element werden Anlagen zum Antrag übermittelt wie bspw. Auszüge aus dem Liegenschaftskataster, Aufteilungspläne und weitere relevante sonstige Anlagen. Dazu kann optional auch ein Grundbuchauszug gehören.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623923283970_515810_17545" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623923283969_489000_17544" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785144109550_721947_34806" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785144109569_355542_34808" annotatedElement="_19_0_4_b8702dd_1785144109550_721947_34806" body="&lt;para>Mit diesem Element werden Daten zu Beteiligten am Verfahren übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785144109569_982581_34809" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785144109569_7668_34807" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_131403da_1623873784766_244256_17274" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1623874368209_599583_17275" name="BezugNeuantrag" visibility="public">
              <ownedComment xmi:id="_19_0_131403da_1623955041810_74990_17163" annotatedElement="_19_0_131403da_1623874368209_599583_17275" body="&lt;para> Dieser Typ beinhaltet das Aktenzeichen des ursprünglichen Antrags, auf das sich der Änderungsantrag bezieht.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_131403da_1623874396717_606645_17276" name="vorgang" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                <ownedComment xmi:id="_19_0_131403da_1623927594619_618959_17798" annotatedElement="_19_0_131403da_1623874396717_606645_17276" body="&lt;para>Sofern zu dem Gebäude ein Aktenzeichen einer beantragten oder genehmigten Baugenehmigung vorliegt, ist dieses mit diesem Element zu übermitteln.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623874416953_536459_17277" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623874416954_565902_17278" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1623918845237_309998_17362" name="AbgeschlossenheitsbescheinigungDaten" visibility="public">
              <ownedComment xmi:id="_19_0_131403da_1623954588741_928569_17162" annotatedElement="_19_0_131403da_1623918845237_309998_17362" body="&lt;para> Dieser Typ beinhaltet die Angaben zu einem Gebäude, die im Rahmen einer Abgeschlossenheitsbscheinigung relevant sind, sowie Angaben zu den einzelnen Räumlichkeiten, für die die Abgeschlossenheitsbscheinigung beantragt wird.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_131403da_1623919422974_372881_17363" name="angabenEinheiten" visibility="private" type="_19_0_131403da_1626161494937_770509_17690">
                <ownedComment xmi:id="_19_0_131403da_1626088975186_812029_17466" annotatedElement="_19_0_131403da_1623919422974_372881_17363" body="&lt;para>Mit diesem Element werden Informationen zu den Wohnungen bzw. Räumen übermittelt, für die eine Abgeschlossenheitsbescheinigung beantragt wird.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623921599702_583021_17464" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623921599702_966068_17465" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623921677900_850501_17466" name="angabenZumGebaeude" visibility="private" type="_19_0_131403da_1623921737148_386683_17486">
                <ownedComment xmi:id="_19_0_131403da_1626089045345_373016_17467" annotatedElement="_19_0_131403da_1623921677900_850501_17466" body="&lt;para> Mit diesem Element werden die Angaben zum Gebäude übermittelt, die für die Bearbeitung der Abgeschlossenheitsbescheinigung relevant sind. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623921677901_188589_17468" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623921677900_797239_17467" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623922681465_379995_17527" name="wohneigentum" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_131403da_1623922681468_846335_17529" annotatedElement="_19_0_131403da_1623922681465_379995_17527" body="&lt;para>Wird eine Abgeschlossenheitsbescheingung für Wohneigentum nach § 7 WoEigG beantragt, ist das Element mit Wert true zu instantiieren. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623922681468_533645_17530" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623922681468_800411_17528" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623922681880_281677_17534" name="dauerwohnrecht" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_131403da_1623922681884_34908_17536" annotatedElement="_19_0_131403da_1623922681880_281677_17534" body="&lt;para>Wird eine Abgeschlossenheitsbescheinigung für ein Dauerwohnrecht nach § 32 WoEigG beantragt, ist das Element mit Wert true zu instantiieren.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623922681886_42197_17537" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623922681883_460808_17535" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1623919926528_865352_17365" name="Anonym_EinheitenAnzahl" visibility="public">
              <ownedAttribute xmi:id="_19_0_131403da_1623920401438_941333_17368" name="anzahlGaragenUndStellplaetze" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_131403da_1623920556666_778410_17375" annotatedElement="_19_0_131403da_1623920401438_941333_17368" body="&lt;para>Dieses Element nennt die Anzahl der Garagen und Stellplätze (z.B. Parkplätze, Plätze in Tiefgaragen etc.).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623920489558_631582_17369" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623920489558_24443_17370" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623920563509_934955_17376" name="anzahlNichtbewohnbareRaeume" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_131403da_1623920563512_29000_17378" annotatedElement="_19_0_131403da_1623920563509_934955_17376" body="&lt;para> Mit diesem Element wird die Anzahl der nichtbewohnbaren Räume übermittelt. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623920563512_97223_17379" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623920563511_496364_17377" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623921357356_285916_17457" name="anzahlWohnungen" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_131403da_1623921357358_925651_17459" annotatedElement="_19_0_131403da_1623921357356_285916_17457" body="&lt;para> Mit diesem Element wird die Anzahl der Wohnungen übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623921357358_989077_17460" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623921357357_302238_17458" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1623921737148_386683_17486" name="Anonym_AngabenZumGebaeude" visibility="public">
              <ownedAttribute xmi:id="_19_0_131403da_1623921737149_61566_17487" name="gebaeudeBestehtBereits" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_131403da_1623921737151_352180_17491" annotatedElement="_19_0_131403da_1623921737149_61566_17487" body="&lt;para>Sofern das Gebäude bereits errichtet worden ist, ist der Wert true anzugeben, sonst false.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623921820374_151283_17502" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623921820374_304723_17503" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623921851309_505987_17504" name="baugenehmigungBeantragt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_131403da_1623921851310_142689_17506" annotatedElement="_19_0_131403da_1623921851309_505987_17504" body="&lt;para>Sofern eine Baugenehmigung beantragt wurde (und der Antragsprozess noch läuft), ist der Wert true anzugeben. Wurde die Baugenehmigung bereits erteilt, ist der Wert false einzutragen. Liegt eine Baugenehmigung nicht (mehr) vor, obwohl das Gebäude bereits errichtet wurde, ist dieses Element nicht zu instantiieren. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623921851310_675386_17507" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623921851310_889995_17505" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623922067578_775766_17513" name="vorgang" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_131403da_1623922067582_857768_17515" annotatedElement="_19_0_131403da_1623922067578_775766_17513" body="&lt;para>Hier ist das Akteinzeichen des laufenden bzw. des abgeschlossenen Baugenehmigungsverfahrens einzutragen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623922067583_491839_17516" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623922067581_773281_17514" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1623922193610_374351_17520" name="baujahr" visibility="private" type="_19_0_3_129a03b9_1684499158982_410199_8747">
                <ownedComment xmi:id="_19_0_131403da_1623922193612_951219_17522" annotatedElement="_19_0_131403da_1623922193610_374351_17520" body="&lt;para>Mit diesem Element wird das (ggf. geplante) Baujahr des Gebaeudes übermittelt. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1623922193612_159636_17523" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1623922193612_605736_17521" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1625741357224_941207_17218" name="Anonym_EinheitenNummern" visibility="public">
              <ownedAttribute xmi:id="_19_0_131403da_1625741357234_806999_17219" name="nummernGaragenUndStellplaetze" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_131403da_1625741357237_581222_17223" annotatedElement="_19_0_131403da_1625741357234_806999_17219" body="&lt;para> Mit diesem Element werden die Nummern der Garagen und Stellplätze (z.B. Parkplätze, Plätze in Tiefgaragen etc.) übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1625741357238_942654_17224" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1625741357237_534499_17222" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1625741357236_465299_17220" name="nummernNichtbewohnbareRaeume" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_131403da_1625741357238_734088_17227" annotatedElement="_19_0_131403da_1625741357236_465299_17220" body="&lt;para> Mit diesem Element werden die Nummern der nichtbewohnbaren Räume übermittelt. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1625741357239_663520_17228" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1625741357238_317492_17226" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1625741357236_708385_17221" name="nummernWohnungen" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_131403da_1625741357240_173952_17231" annotatedElement="_19_0_131403da_1625741357236_708385_17221" body="&lt;para> Mit diesem Element werden die Nummern der bewohnbaren Wohnungen übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1625741357240_493273_17232" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1625741357239_626192_17230" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1626161494937_770509_17690" name="Anonym_AngabenEinheiten" visibility="public">
              <ownedAttribute xmi:id="_19_0_131403da_1626161849510_982781_17691" name="einheitenNummern" visibility="private" type="_19_0_131403da_1625741357224_941207_17218">
                <ownedComment xmi:id="_19_0_4_b8702dd_1753874195693_418265_31251" annotatedElement="_19_0_131403da_1626161849510_982781_17691" body="&lt;para>Hier werden die Nummern der Wohnungen etc. übermittelt. Diese können als Bereiche angegeben werden (z.B. &quot;11A bis 21C&quot;) und müssen mit der Darstellung im Aufteilungsplan korrespondieren.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1626161875822_812242_17692" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1626161875823_410980_17693" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_131403da_1626161929085_202895_17695" name="einheitenAnzahl" visibility="private" type="_19_0_131403da_1623919926528_865352_17365">
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1626161929087_274648_17697" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1626161929086_283164_17696" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1623923548302_804792_17553" name="" visibility="public" client="_19_0_131403da_1623846201806_100864_17139" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1623923623036_307116_17555" name="" visibility="public" client="_19_0_131403da_1623846201806_100864_17139" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_131403da_1623924583811_619367_17567" name="" visibility="public" client="_19_0_131403da_1623846201806_100864_17139" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1624428975996_380331_17143" name="abgeschlossenheit.antragGeaendert.0252" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1624428975999_902500_17144" annotatedElement="_19_0_131403da_1624428975996_380331_17143" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten der Antragstellung zur Abgeschlossenheit. Sie bezieht sich auf einen bereits gestellten Antrag, zu dem noch kein Bescheid erteilt wurde.&lt;/para>&#xA;&#xA;&lt;para>Entweder ist sie eine Reaktion auf eine zum Antrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen einen modifizierten Antrag im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1624428976002_314585_17149" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1624428976000_244054_17145" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1624428976004_310730_17152" annotatedElement="_19_0_131403da_1624428976000_244054_17145" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf Gegenstände Bezug zu nehmen, auf die die vorliegende Nachrichteninstanz eine Reaktion ist.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624428976004_799735_17153" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624428976003_966450_17151" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624429414517_284272_17184" name="beteiligteGeaendert" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_131403da_1624429414519_236601_17186" annotatedElement="_19_0_131403da_1624429414517_284272_17184" body="&lt;para>Mit diesem Element werden ggf. geänderte Daten zu Beteiligten am Verfahren übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624429414520_344141_17187" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624429414519_23837_17185" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624429123200_950423_17177" name="abgeschlossenheitsbescheinigungGeaendert" visibility="private" type="_19_0_131403da_1623918845237_309998_17362">
              <ownedComment xmi:id="_19_0_131403da_1624429123202_93005_17179" annotatedElement="_19_0_131403da_1624429123200_950423_17177" body="&lt;para>Mit diesem Element werden ggf. geänderte Informationen zu den Räumlichkeiten und der Art der Abgeschlossenheitsbescheinigung übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624429123202_517211_17180" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624429123201_460233_17178" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624428976002_498109_17148" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624428976006_578827_17162" annotatedElement="_19_0_131403da_1624428976002_498109_17148" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Anlage übermittelt. &lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624428976006_508452_17163" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624428976006_756298_17161" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1624430493990_927750_17234" name="abgeschlossenheit.stellungnahme.0254" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1624430493992_990914_17235" annotatedElement="_19_0_131403da_1624430493990_927750_17234" body="&lt;para>Diese Nachricht bezieht sich auf einen bereits gestellten Antrag auf Abgeschlossenheit und auf eine zu diesem&#xA;vorliegende Anhörungsnachricht. Sie enthält Stellungnahmen des Bauherrn bzw. des Entwurfsverfassers zu den Eigenschaften des Vorhabens, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_131403da_1624430493995_372231_17239" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1624430493992_908696_17236" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1624430493996_770417_17242" annotatedElement="_19_0_131403da_1624430493992_908696_17236" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag auf Abgeschlossenheit Bezug zu nehmen und außerdem auf die Nachricht abgeschlossenheit.anhoerung.0254, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430493997_314468_17243" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430493996_564011_17241" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430493993_699598_17237" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430493998_449418_17246" annotatedElement="_19_0_131403da_1624430493993_699598_17237" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung des ursprünglichen Antrags sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430493999_9857_17247" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430493998_606442_17245" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430493994_290159_17238" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430494000_377549_17250" annotatedElement="_19_0_131403da_1624430493994_290159_17238" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430494000_604570_17251" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430493999_898174_17249" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1624430651251_903541_17263" name="abgeschlossenheit.anhoerung.0253" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1624430651252_582395_17264" annotatedElement="_19_0_131403da_1624430651251_903541_17263" body="&lt;para>Diese Nachricht fordert den Bauherrn zur Stellungnahme auf, nachdem die materielle Prüfung des Antrags auf Abgeschlossenheit  ergeben hat, dass Gründe vorliegen, die zu seiner Ablehnung durch die Bauaufsichtsbehörde führen können. Es sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung sind. Diese werden hier aufgelistet bzw. im Anhang der Nachricht dokumentiert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_131403da_1624430651256_891929_17270" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1624430651253_907010_17265" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1624430651257_809228_17273" annotatedElement="_19_0_131403da_1624430651253_907010_17265" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag auf Abgeschlossenheit Bezug zu nehmen; außerdem ggf. auf die Nachricht grundstuecksteilung.antrag.0250, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430651257_329030_17274" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430651256_599749_17272" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430651253_461835_17266" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430651258_443271_17277" annotatedElement="_19_0_131403da_1624430651253_461835_17266" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430651258_552819_17278" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430651257_575191_17276" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430651254_702823_17267" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_131403da_1624430651259_506119_17281" annotatedElement="_19_0_131403da_1624430651254_702823_17267" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Antrags auf Abgeschlossenheit ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430651259_883931_17282" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430651259_986834_17280" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430651255_847641_17268" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430651260_883152_17285" annotatedElement="_19_0_131403da_1624430651255_847641_17268" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430651260_350156_17286" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430651260_376652_17284" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430651255_830663_17269" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430651261_671140_17289" annotatedElement="_19_0_131403da_1624430651255_830663_17269" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430651262_336109_17290" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430651261_886902_17288" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_131403da_1624430970870_813254_17306" name="abgeschlossenheit.bescheid.0255" visibility="public">
            <ownedComment xmi:id="_19_0_131403da_1624430970872_128331_17307" annotatedElement="_19_0_131403da_1624430970870_813254_17306" body="&lt;para>Diese Nachricht stellt den Bescheid dar, in den die Bauaufsichtsbehörde die Ergebnisse der materiellen Prüfung einträgt. Ein Antrag auf Abgeschlossenheit wird entweder genehmigt oder abgelehnt (genehmigt mit Nebenbestimmungen ist nicht als Möglichkeit vorgesehen). Das Absenden dieser Nachricht stellt das Erteilen des Bescheids dar.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_131403da_1624430970876_838706_17311" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_131403da_1624430970873_277876_17308" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_131403da_1624430970877_979912_17314" annotatedElement="_19_0_131403da_1624430970873_277876_17308" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht abgeschlossenheit.antrag.0250 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430970877_329278_17315" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430970876_582090_17313" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430970874_527713_17309" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430970878_381619_17318" annotatedElement="_19_0_131403da_1624430970874_527713_17309" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430970879_662736_17319" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430970878_844319_17317" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_131403da_1624430970875_882924_17310" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_131403da_1624430970880_449871_17322" annotatedElement="_19_0_131403da_1624430970875_882924_17310" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_131403da_1624430970880_632491_17323" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_131403da_1624430970880_347225_17321" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679318037008_979602_22498" name="" visibility="public" client="_19_0_131403da_1623846201806_100864_17139" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1684834524490_317553_21483" name="" visibility="public" client="_19_0_131403da_1623846201806_100864_17139" supplier="_19_0_3_136d03d4_1612479012595_942167_9330"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_c4f030d_1634116921282_433277_17698" name="Akteneinsicht" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1634116921288_98660_17699" name="akteneinsicht.antrag.0120" visibility="public">
            <ownedComment xmi:id="_19_0_3_c4f030d_1634116921293_599155_17706" annotatedElement="_19_0_3_c4f030d_1634116921288_98660_17699" body="&lt;para>Mit dieser Nachricht wird ein Antrag auf Akteneinsicht an die Bauaufsichtsbehörde übermittelt.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_c4f030d_1634116921297_792932_17712" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634116921293_846707_17707" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634116921303_198652_17731" annotatedElement="_19_0_3_c4f030d_1634116921293_846707_17707" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634116921304_217764_17732" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634116921303_476672_17730" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634116921294_258201_17708" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634116921304_677036_17735" annotatedElement="_19_0_3_c4f030d_1634116921294_258201_17708" body="&lt;para>Mit diesem Element werden die Daten des Antragstellers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634116921304_73284_17736" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634116921304_965563_17734" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668598718982_226604_18244" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668598718984_291361_18246" annotatedElement="_19_0_3_129a03b9_1668598718982_226604_18244" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668598718984_789686_18247" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668598718984_976797_18245" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634116921295_336954_17709" name="rolleAntragsteller" visibility="private" type="_19_0_3_136d03d4_1619461935117_494709_16942">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634116921305_899255_17739" annotatedElement="_19_0_3_c4f030d_1634116921295_336954_17709" body="&lt;para>Hier ist die Rolle des Antragstellers anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634116921305_207550_17740" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634116921305_7339_17738" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634116921295_552625_17710" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634116921306_776770_17743" annotatedElement="_19_0_3_c4f030d_1634116921295_552625_17710" body="&lt;para>Mit diesem Element werden die Daten zu dem Grundstück übermittelt, auf das sich der Antrag bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634116921306_771290_17744" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634116921306_886306_17742" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634116921296_806918_17711" name="grundstueckseigentuemer" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634116921307_149310_17747" annotatedElement="_19_0_3_c4f030d_1634116921296_806918_17711" body="&lt;para>Mit diesem Element werden die Daten des Grundstückseigentümers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634116921307_605741_17748" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634116921307_458649_17746" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634123730946_598021_17824" name="gegenstandDesAntrags" visibility="private" type="_19_0_3_c4f030d_1634123279762_31926_17808">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634123730948_375557_17826" annotatedElement="_19_0_3_c4f030d_1634123730946_598021_17824" body="&lt;para>Hier ist anzugeben, welche Dokumente eingesehen werden sollen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634123730948_521475_17827" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634123730947_12891_17825" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634123796341_459725_17831" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634123796342_607226_17833" annotatedElement="_19_0_3_c4f030d_1634123796341_459725_17831" body="&lt;para>Hier sind die Anlagen zum Antrag enthalten. Jede Instanz des Elements steht für ein angehängtes Dokument.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669377773913_479343_22440" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669377773913_617767_22441" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_c4f030d_1634116921291_914627_17702" name="" visibility="public" client="_19_0_3_c4f030d_1634116921282_433277_17698" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_c4f030d_1634116921291_719812_17703" name="" visibility="public" client="_19_0_3_c4f030d_1634116921282_433277_17698" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_c4f030d_1634116921291_734296_17704" name="" visibility="public" client="_19_0_3_c4f030d_1634116921282_433277_17698" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_c4f030d_1634123227446_803309_17807" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1634123279762_31926_17808" name="Anonym_AuswahlGegenstandAntrag" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1634123316749_860229_17809" name="baugenehmigung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
                <ownedComment xmi:id="_19_0_3_c4f030d_1634123480393_926857_17812" annotatedElement="_19_0_3_c4f030d_1634123316749_860229_17809" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass der Bescheid zur Baugenehmigung nebst dazugehöriger Planungsdokumente eingesehen werden soll.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634123339518_754141_17810" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634123339519_771885_17811" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_c4f030d_1635514563438_501570_17896" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1634123520637_721122_17814" name="bautechnischeNachweise" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
                <ownedComment xmi:id="_19_0_3_c4f030d_1634123520639_889433_17816" annotatedElement="_19_0_3_c4f030d_1634123520637_721122_17814" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass bautechnische Nachweise eingesehen werden sollen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634123520639_566090_17817" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634123520638_124508_17815" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_c4f030d_1635514687025_958417_17897" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1634123574771_877375_17819" name="sonstiges" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_3_c4f030d_1634123574772_62441_17821" annotatedElement="_19_0_3_c4f030d_1634123574771_877375_17819" body="&lt;para>Hier ist anzugeben, welche sonstigen Dokumente eingesehen werden sollen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634123574772_618724_17822" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634123574772_45642_17820" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1642416591066_427158_17824" name="Anonym_Verlinkung" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1642416591080_409683_17825" name="link" visibility="private" type="_19_0_3_c4f030d_1642416653881_126121_17848">
                <ownedComment xmi:id="_19_0_3_c4f030d_1642416591086_359092_17829" annotatedElement="_19_0_3_c4f030d_1642416591080_409683_17825" body="&lt;para>Jedes instanziierte Element steht für einen Link auf eine Webseite oder Ressource.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1642416591087_14913_17830" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1642416591085_630683_17828" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1642416653881_126121_17848" name="Anonym_Zugangslink" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1642416653882_327699_17849" name="url" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                <ownedComment xmi:id="_19_0_3_c4f030d_1642416653884_273170_17851" annotatedElement="_19_0_3_c4f030d_1642416653882_327699_17849" body="&lt;para>Hier ist die URL einer Webseite oder Ressource anzugeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1642416653885_5904_17852" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1642416653884_508184_17850" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_c4f030d_1642416733009_162868_17857" name="beschreibung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_3_c4f030d_1642416733011_798225_17859" annotatedElement="_19_0_3_c4f030d_1642416733009_162868_17857" body="&lt;para>Hier kann die zur URL passende Beschreibung der Webseite oder Ressource eingetragen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1642416733011_321184_17860" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1642416733010_468564_17858" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694079133194_721035_22965" name="Anonym_Akte" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1694079186718_793725_22967" name="aktenzeichen" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                <ownedComment xmi:id="_19_0_3_129a03b9_1694079186718_30828_22969" annotatedElement="_19_0_3_129a03b9_1694079186718_793725_22967" body="&lt;para>In dieses Element ist das Aktenzeichen einzutragen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694079186718_492676_22970" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694079186718_998792_22968" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1694079224967_118664_22974" name="anlage" visibility="private" type="_19_0_3_940029b_1629322573635_742411_17796" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1694079224967_929865_22976" annotatedElement="_19_0_3_129a03b9_1694079224967_118664_22974" body="&lt;para>Jede Instanz dieses Elements steht für eine Anlage (Bauvorlage, Primärdokument) zum vorliegenden Antrag bzw. zur übermittelten XBau-Fachnachricht.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694079224967_743930_22977" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694079224967_460556_22975" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1634125226232_639294_17838" name="akteneinsicht.antragGeaendert.0122" visibility="public">
            <ownedComment xmi:id="_19_0_3_c4f030d_1634125226233_547266_17839" annotatedElement="_19_0_3_c4f030d_1634125226232_639294_17838" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Antrags auf Akteneinsicht. Sie bezieht sich also auf einen bereits gestellten Antrag und ist in der Regel eine Reaktion auf eine zum Antrag vorliegende Mängelliste der Bauaufsichtsbehörde.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_c4f030d_1634125226237_809979_17847" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226233_167888_17840" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226239_470262_17850" annotatedElement="_19_0_3_c4f030d_1634125226233_167888_17840" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang (oder den Antrag) bzw. die Nachricht akteneinsicht.antrag.0120 Bezug zu nehmen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226239_885240_17851" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226238_740305_17849" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226234_430679_17841" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226240_328748_17854" annotatedElement="_19_0_3_c4f030d_1634125226234_430679_17841" body="&lt;para>Mit diesem Element werden ggf. korriegierte oder ergänzte Daten des Antragstellers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226240_279320_17855" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226239_30397_17853" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226234_753308_17842" name="rolleAntragsteller" visibility="private" type="_19_0_3_136d03d4_1619461935117_494709_16942">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226241_479738_17858" annotatedElement="_19_0_3_c4f030d_1634125226234_753308_17842" body="&lt;para>Hier ist die ggf. korriegierte Rolle des Antragstellers anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226241_35706_17859" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226240_258990_17857" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226235_572131_17843" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226242_281177_17862" annotatedElement="_19_0_3_c4f030d_1634125226235_572131_17843" body="&lt;para>Mit diesem Element werden ggf. korriegierte oder ergänzte Daten zu dem Grundstück übermittelt, auf das sich der Antrag bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226242_114490_17863" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226241_529761_17861" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226236_638653_17844" name="grundstueckseigentuemer" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226243_177528_17866" annotatedElement="_19_0_3_c4f030d_1634125226236_638653_17844" body="&lt;para>Mit diesem Element werden ggf. korriegierte oder ergänzte Daten des Grundstückseigentümers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226243_89713_17867" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226242_623_17865" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634125226237_838856_17846" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634125226245_584726_17874" annotatedElement="_19_0_3_c4f030d_1634125226237_838856_17846" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634125226245_133453_17875" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634125226245_648059_17873" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1634126019820_858339_17893" name="akteneinsicht.formellePruefung.0121" visibility="public">
            <ownedComment xmi:id="_19_0_3_c4f030d_1634126019821_940249_17894" annotatedElement="_19_0_3_c4f030d_1634126019820_858339_17893" body="&lt;para>Diese Nachricht bezieht sich auf einen bereits gestellten Antrag auf Akteneinsicht. &#xA;Enthalten sind hier die Ergebnisse der formellen Prüfung (Befunde) sowie eine Frist, innerhalb derer der Antragsteller den Antrag auf Akteneinsicht bzw. die Bauunterlagen anzupassen hat, falls in der formellen Prüfung Mängel festgestellt wurden.&#xA;Falls im Rahmen der formellen Prüfung alle Merkmale positiv bewertet wurden (Zuständigkeit ist gegeben, Unterlagen liegen vollständig vor usw.), sind hier Angaben zur Genehmigungsfrist und zu den eingereichten Unterlagen enthalten.&#xA;&lt;/para>"/>
            <generalization xmi:id="_19_0_3_c4f030d_1634126019826_734801_17902" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634126019822_108180_17895" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634126019827_428504_17905" annotatedElement="_19_0_3_c4f030d_1634126019822_108180_17895" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang (oder den Antrag) bzw. die Nachricht akteneinsicht.antrag.0120 Bezug zu nehmen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>&#xA;&lt;para>Damit wird gleichzeitig dem Antragsteller die entsprechende Vorgangsnummer für künftige Referenzierung mitgeteilt. Dadurch ist der Bezug zum Antrag hergestellt, zu dessen formeller Prüfung die vorliegende Nachricht Ergebnisse enthält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634126019827_313918_17906" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634126019827_126708_17904" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1701856116261_972344_24880" name="antragVollstaendig" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1701856116274_87989_24882" annotatedElement="_19_0_4_b6602da_1701856116261_972344_24880" body="&lt;para>Mit diesem Element wird angegeben, ob der Antrag vollständig oder nicht vollständig ist. Falls der Antrag vollständig ist, ist true einzutragen, andernfalls false.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701856116275_663036_24883" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701856116272_906386_24881" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1701856120169_95935_24887" name="befundFrist" visibility="private" type="_19_0_4_b6602da_1701856263692_20128_24899">
              <ownedComment xmi:id="_19_0_4_b6602da_1701856120172_784551_24889" annotatedElement="_19_0_4_b6602da_1701856120169_95935_24887" body="&lt;para>Falls im Rahmen der formellen Prüfung Mängel festgestellt wurden, sind diese Angaben zu machen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701856120173_911765_24890" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701856120170_399320_24888" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634126019823_475613_17898" name="anschreiben" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634126019830_731149_17917" annotatedElement="_19_0_3_c4f030d_1634126019823_475613_17898" body="&lt;para>In dieses Element kann ein Anschreibentext eingetragen werden.&lt;/para>&#xA;&lt;para>Der Anschreibentext kann auch verwendet werden, um Informationen zu organisatorischen Themen zwischen Bauaufsicht und Bauvorhaben zu übermitteln, beispielsweise zur Mitteilung eines Anhörungstermins.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634126019830_770729_17918" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634126019829_44878_17916" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634126019824_491537_17899" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634126019831_484961_17921" annotatedElement="_19_0_3_c4f030d_1634126019824_491537_17899" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634126019831_388390_17922" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634126019830_721865_17920" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634126019825_769787_17901" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634126019833_260437_17929" annotatedElement="_19_0_3_c4f030d_1634126019825_769787_17901" body="&lt;para>Falls die Behörde der Nachricht Anlagen beifügen möchte, ist dieses Element zu verwenden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634126019833_190495_17930" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634126019832_920753_17928" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634129872230_494850_18077" name="eingangAnalog" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634129872231_627707_18079" annotatedElement="_19_0_3_c4f030d_1634129872230_494850_18077" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass der Antrag analog eingegangen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634129872232_485236_18080" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634129872231_146816_18078" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_c4f030d_1635516254125_79360_17905" name="" visibility="public" value="true"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_c4f030d_1634129011721_837692_18036" name="akteneinsicht.ergebnis.0123" visibility="public">
            <ownedComment xmi:id="_19_0_3_c4f030d_1634129011723_284394_18037" annotatedElement="_19_0_3_c4f030d_1634129011721_837692_18036" body="&lt;para>Mit dieser Nachricht wird als Ergebnis übermittelt, ob Akteneinsicht gewährt wird oder der Antrag abgelehnt wurde. Im Erfolgsfall ist der Zugangslink zum Aktenraum enthalten.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_c4f030d_1634129011724_830517_18041" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634129011723_294913_18038" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634129011725_724371_18044" annotatedElement="_19_0_3_c4f030d_1634129011723_294913_18038" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang (oder den Antrag) bzw. die Nachricht akteneinsicht.antrag.0120 Bezug zu nehmen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634129011726_593090_18045" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634129011725_885884_18043" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634129011723_329042_18039" name="istGenehmigung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634129011727_82504_18048" annotatedElement="_19_0_3_c4f030d_1634129011723_329042_18039" body="&lt;para>Mit diesem Element wird übermittelt, ob Akteneinsicht erteilt wird (true) oder nicht (false).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634129011727_860315_18049" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634129011726_447263_18047" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634129011724_735425_18040" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634129011728_849417_18052" annotatedElement="_19_0_3_c4f030d_1634129011724_735425_18040" body="&lt;para>In diesem Element kann im Falle einer Ablehnung eine Begründung hinterlegt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634129011728_292060_18053" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634129011728_311715_18051" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1634129202893_49322_18070" name="eingangAnalog" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
              <ownedComment xmi:id="_19_0_3_c4f030d_1634129202894_192399_18072" annotatedElement="_19_0_3_c4f030d_1634129202893_49322_18070" body="&lt;para>Durch die Übermittlung dieses Elementes wird mitgeteilt, dass der Antrag analog (Offline-Antrag per Brief oder am Serviceschalter) eingegangen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1634129202894_579099_18073" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1634129202894_393139_18071" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_c4f030d_1635516198710_295982_17904" name="" visibility="public" value="true"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1642416881866_827394_17864" name="zugangslink" visibility="private" type="_19_0_3_c4f030d_1642416591066_427158_17824">
              <ownedComment xmi:id="_19_0_3_c4f030d_1642416881868_11338_17866" annotatedElement="_19_0_3_c4f030d_1642416881866_827394_17864" body="&lt;para>In diesem Element kann im Falle einer Gewährung auf Akteneinsicht ein Link bzw. eine Linkliste zum Ablageort der Dokumente eingetragen werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1642416881868_187824_17867" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1642416881867_505167_17865" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694079023871_64659_22958" name="akte" visibility="private" type="_19_0_3_129a03b9_1694079133194_721035_22965">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694079252679_606504_22987" annotatedElement="_19_0_3_129a03b9_1694079023871_64659_22958" body="&lt;para>In diesem Element können im Falle einer Gewährung auf Akteneinsicht  mit dem Verweis auf Aktenzeichen die entsprechenden Dokumente angehängt oder ein Link zu den Dokumenten eingetragen werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694079241536_298461_22983" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694079241536_923192_22984" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694079558576_849191_22988" name="laufenderVorgang" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694079558576_734206_22990" annotatedElement="_19_0_3_129a03b9_1694079558576_849191_22988" body="&lt;para>Mit diesem Element wird hinterlegt, ob es sich um einen laufenden Vorgang handelt oder nicht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694079558576_904346_22991" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694079558576_732627_22989" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679318092256_733881_22500" name="" visibility="public" client="_19_0_3_c4f030d_1634116921282_433277_17698" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1694080163801_693633_23338" name="" visibility="public" client="_19_0_3_c4f030d_1634116921282_433277_17698" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694080969583_426330_23341" name="akteneinsicht.uebermittlungGrundbuchauszug.0126" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1694080969585_850263_23348" annotatedElement="_19_0_3_129a03b9_1694080969583_426330_23341" body="&lt;para>Mit dieser Nachricht wird der Grundbuchauszug zum im Antrag genannten Grundstück vom Grundbuchführenden Amt übermittelt.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1694080969586_434981_23351" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694080969585_283602_23349" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694080969589_211045_23364" annotatedElement="_19_0_3_129a03b9_1694080969585_283602_23349" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Anforderungsnachricht der Bauaufsichtsbehörde Bezug zu nehmen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694080969590_865645_23365" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694080969589_480340_23363" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694080969586_729610_23350" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694080969591_668706_23368" annotatedElement="_19_0_3_129a03b9_1694080969586_729610_23350" body="&lt;para>Mit diesem Element wird der angeforderte Grundbuchauszug übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694080969591_928733_23369" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694080969590_222804_23367" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694080969583_132282_23342" name="akteneinsicht.anforderungGrundbuchauszug.0125" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1694080969587_517447_23353" annotatedElement="_19_0_3_129a03b9_1694080969583_132282_23342" body="&lt;para>Mit dieser Nachricht wird der Grundbuchauszug zum im Antrag genannten Grundstück beim Grundbuchführenden Amt angefordert.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1694080969588_543887_23356" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694080969587_85010_23354" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694080969592_594835_23374" annotatedElement="_19_0_3_129a03b9_1694080969587_85010_23354" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Antragstellung (auf Akteneinsicht) Bezug zu nehmen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694080969592_361038_23375" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694080969592_221463_23373" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1694080969587_466232_23355" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_129a03b9_1694080969593_801941_23378" annotatedElement="_19_0_3_129a03b9_1694080969587_466232_23355" body="&lt;para>Mit diesem Element werden die Daten zu dem Grundstück übermittelt, zu welchem der Grundbuchauszug angefordert wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694080969593_487707_23379" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694080969593_584584_23377" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1651603240165_13709_17978" name="Baulastenverzeichnis" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1651603652559_912973_17984" name="baulastenverzeichnis.anfrage.0710" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1651603652566_323165_17985" annotatedElement="_19_0_3_136d03d4_1651603652559_912973_17984" body="&lt;para>Diese Nachricht stellt eine Anfrage auf Baulastauskunft an die Baulastverzeichnis führende Stelle dar. Durch das Senden dieser Nachricht fragt der Absender an, welche Baulasten zu dem in der Nachricht dokumentierten Grundstück gehören.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1651603652568_762816_17988" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1652258556462_418346_18269" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1652258602983_779750_18270" annotatedElement="_19_0_3_136d03d4_1652258556462_418346_18269" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Behörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669367131906_399690_20921" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669367131906_675946_20922" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1651603824070_80476_18011" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1651604188065_148722_18017" annotatedElement="_19_0_3_136d03d4_1651603824070_80476_18011" body="&lt;para>Dieses Element enthält die Angaben des Antragstellers.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1651604378123_552376_18020" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1651604378123_196891_18021" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1752138595619_219040_30836" name="rolleAntragsteller" visibility="private" type="_19_0_3_136d03d4_1619461935117_494709_16942">
              <ownedComment xmi:id="_19_0_4_b6602da_1752138595635_710314_30838" annotatedElement="_19_0_4_b6602da_1752138595619_219040_30836" body="&lt;para>Hier ist die Rolle des Antragstellers anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1752138595638_619025_30839" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1752138595633_468712_30837" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1651604272505_888312_18018" name="angabenGrundstuecke" visibility="private" type="_19_0_3_129a03b9_1658334000809_885284_18259">
              <ownedComment xmi:id="_19_0_3_136d03d4_1651604318262_347663_18019" annotatedElement="_19_0_3_136d03d4_1651604272505_888312_18018" body="&lt;para>Dieses Element enthält die Angaben des Grundstücks oder der Grundstücke, zu denen die Auskunft angefragt wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1651604383536_242024_18022" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1651604383538_279010_18023" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658127730730_833943_18206" name="berechtigtesInteresse" visibility="private" type="_19_0_3_129a03b9_1658127585185_917813_18202">
              <ownedComment xmi:id="_19_0_4_b6602da_1750059249442_77493_30306" annotatedElement="_19_0_3_129a03b9_1658127730730_833943_18206" body="&lt;para>In diesem Element können Angaben zu einem berechtigten Interesse gemacht werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658333845146_434743_18257" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658333845148_838142_18258" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668598903200_537347_18353" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668598903202_402201_18355" annotatedElement="_19_0_3_129a03b9_1668598903200_537347_18353" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668598903203_998164_18356" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668598903201_433592_18354" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1651603758786_601318_18005" name="baulastenverzeichnis.auskunft.0713" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1651603758787_817072_18006" annotatedElement="_19_0_3_136d03d4_1651603758786_601318_18005" body="&lt;para>Diese Nachricht liefert die Auskunft aus dem Baulastenverzeichnis.&lt;/para>&#xA;&lt;para>Die Nachricht bündelt sowohl alle Negativantworten (es liegt kein berechtigtes Interesse vor), alle positiven Ergebnisse (Information aus dem Baulastenverzeichnis kann abgerufen werden) als auch alle negativen Ergebnisse (Angabe zum Flurstück war nicht korrekt, keine Auskunft möglich).&lt;/para>&#xA;&lt;para> Somit erhält der Antragsteller nur eine gebündelte Antwortnachricht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1651603758788_670921_18007" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1652254158979_666239_18256" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1652254200182_509000_18257" annotatedElement="_19_0_3_136d03d4_1652254158979_666239_18256" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Anfrage Bezug zu nehmen, zu der die vorliegende&#xA;Nachricht Auskünfte enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1652256581079_654119_18261" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1652256581079_395791_18262" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1664554210414_157069_18224" name="ergebnis" visibility="private" type="_19_0_3_136d03d4_1652251114534_152277_18037">
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1664554312772_466756_18226" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1664554312772_267115_18227" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1651604834200_643824_18045" name="" visibility="public" client="_19_0_3_136d03d4_1651603240165_13709_17978" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1651604885909_900609_18047" name="" visibility="public" client="_19_0_3_136d03d4_1651603240165_13709_17978" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1655369468674_518134_18410" name="baulastenverzeichnis.formellePruefung.0711" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1655369468680_503923_18411" annotatedElement="_19_0_3_136d03d4_1655369468674_518134_18410" body="&lt;para>Diese Nachricht bezieht sich auf eine bereits gestellte Anfrage auf Baulastauskunft. Enthalten sind hier die Ergebnisse der formellen Prüfung (Befunde) sowie eine Frist, innerhalb derer der Antragsteller die Anfrage auf Baulastauskunft anzupassen hat, falls in der formellen Prüfung Mängel festgestellt wurden. &#xA;&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1655369468690_893671_18418" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369468681_755848_18412" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369468694_529620_18421" annotatedElement="_19_0_3_136d03d4_1655369468681_755848_18412" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Nachricht baulastenverzeichnis.anfrage.0710 Bezug zu nehmen, durch deren Eingang bei der Behörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369468695_55863_18422" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369468693_671501_18420" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1703144328566_650205_24970" name="antragVollstaendig" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_129a03b9_1703144328570_807637_24972" annotatedElement="_19_0_3_129a03b9_1703144328566_650205_24970" body="&lt;para>Mit diesem Element wird angegeben, ob der Antrag vollständig oder nicht vollständig ist. Falls der Antrag vollständig ist, ist true einzutragen, andernfalls false.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1703144328570_241587_24973" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1703144328570_632960_24971" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1703144339230_855749_24977" name="befundFrist" visibility="private" type="_19_0_4_b6602da_1756978536310_860233_31468">
              <ownedComment xmi:id="_19_0_3_129a03b9_1703144339231_256727_24979" annotatedElement="_19_0_3_129a03b9_1703144339230_855749_24977" body="&lt;para>Falls im Rahmen der formellen Prüfung Mängel festgestellt wurden, sind diese Angaben zu machen.&#xA;Die Befundliste enthält die Ergebnisse der formellen Prüfung durch die Bauaufsichtsbehörde. Enthalten ist außerdem eine Frist zur Anpassung der Anfrage auf Baulastauskunft durch den Antragsteller.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1703144339231_326977_24980" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1703144339230_889686_24978" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369468686_199007_18415" name="anschreiben" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369468702_898382_18433" annotatedElement="_19_0_3_136d03d4_1655369468686_199007_18415" body="&lt;para>In dieses Element kann ein Anschreibentext eingetragen werden.&lt;/para>&#xA;&lt;para>Der Anschreibentext kann auch verwendet werden, um Informationen zu organisatorischen Themen zwischen Bauaufsicht und Bauvorhaben zu übermitteln, beispielsweise zur Mitteilung eines Anhörungstermins.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369468702_855535_18434" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369468701_57920_18432" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369468687_483115_18416" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369468704_693626_18437" annotatedElement="_19_0_3_136d03d4_1655369468687_483115_18416" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369468705_437709_18438" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369468703_553134_18436" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369468689_284633_18417" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369468706_873566_18441" annotatedElement="_19_0_3_136d03d4_1655369468689_284633_18417" body="&lt;para>Falls die Behörde der Nachricht Anlagen beifügen möchte, ist dieses Element zu verwenden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369468706_388925_18442" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369468705_367767_18440" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1655369772337_429061_18460" name="baulastenverzeichnis.anfrageGeaendert.0712" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1655369772341_752376_18461" annotatedElement="_19_0_3_136d03d4_1655369772337_429061_18460" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten der Anfrage auf Baulastauskunft. Sie bezieht sich also auf eine bereits gestellte Anfrage und ist in der Regel eine Reaktion auf eine zur Anfrage vorliegenden Mängelliste der Behörde.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1655369772350_908218_18468" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772342_930853_18462" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772354_243349_18471" annotatedElement="_19_0_3_136d03d4_1655369772342_930853_18462" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Nachricht baulastenverzeichnis.anfrage.0710 Bezug zu nehmen, durch deren Eingang bei der Behörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772356_541781_18472" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772353_254075_18470" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772343_655033_18463" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772357_743860_18475" annotatedElement="_19_0_3_136d03d4_1655369772343_655033_18463" body="&lt;para>Mit diesem Element werden  ggf. korrigierte oder ergänzte Daten des Antragstellers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772359_64494_18476" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772357_425238_18474" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772344_943826_18464" name="rolleAntragsteller" visibility="private" type="_19_0_3_136d03d4_1619461935117_494709_16942">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772361_355676_18479" annotatedElement="_19_0_3_136d03d4_1655369772344_943826_18464" body="&lt;para>Hier ist die Rolle des Antragstellers anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772362_49288_18480" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772360_81782_18478" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772346_743271_18465" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772363_200865_18483" annotatedElement="_19_0_3_136d03d4_1655369772346_743271_18465" body="&lt;para>Mit diesem Element werden  ggf. korrigierte oder ergänzte Daten zu dem Grundstück übermittelt, auf das sich der Antrag bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772365_480704_18484" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772363_311140_18482" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772347_692692_18466" name="grundstueckseigentuemer" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772366_951562_18487" annotatedElement="_19_0_3_136d03d4_1655369772347_692692_18466" body="&lt;para>Mit diesem Element werden  ggf. korrigierte oder ergänzte Daten des Grundstückseigentümers übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772367_444293_18488" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772365_813312_18486" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655369772348_651931_18467" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655369772368_398520_18491" annotatedElement="_19_0_3_136d03d4_1655369772348_651931_18467" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655369772369_512950_18492" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655369772367_328581_18490" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679318133884_657678_22502" name="" visibility="public" client="_19_0_3_136d03d4_1651603240165_13709_17978" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b6602da_1689591962450_520794_21926" name="Verlaengerung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1689591962535_283093_21927" name="" visibility="public" client="_19_0_4_b6602da_1689591962450_520794_21926" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1689591962543_456283_21928" name="verlaengerung.antrag.0260" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1689591963773_290416_21967" annotatedElement="_19_0_4_b6602da_1689591962543_456283_21928" body="&lt;para>Mittels dieser Nachricht beantragt der Autor eine Verlängerung zu einer bereits bei der Bauaufsichtsbehörde vorliegenden Baugenehmigung, Teilbaugenehmigung oder eines Vorbescheids. Die Nachricht enthält die Daten zum Verlängerungsantrag.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1689591963796_691300_21975" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963775_217105_21968" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964276_847231_22200" annotatedElement="_19_0_4_b6602da_1689591963775_217105_21968" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964278_763093_22201" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964273_500803_22199" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963784_942595_21970" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964282_486010_22208" annotatedElement="_19_0_4_b6602da_1689591963784_942595_21970" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964282_959814_22209" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964282_165592_22207" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689592355995_960055_22961" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1689592355997_397266_22963" annotatedElement="_19_0_4_b6602da_1689592355995_960055_22961" body="&lt;para>Dieses Element dient der Bezugnahme auf die von der Behörde erteilte Baugenehmigung, Teilbaugenehmigung oder den erteilten Vorbescheid, zu der oder dem die vorliegende Nachricht eine Verlängerung beantragt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689592355997_126306_22964" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689592355997_831356_22962" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1703148725388_873091_25006" name="begehrteVerlaengerung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_129a03b9_1703148790795_795714_25015" annotatedElement="_19_0_3_129a03b9_1703148725388_873091_25006" body="&lt;para>In diesem Element kann ein Datum übermittelt werden, das die beantragte Gültigkeitsverlängerung anzeigt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1703148768323_535607_25013" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1703148768324_921776_25014" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1703149093512_633747_25018" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_129a03b9_1703149093514_732320_25020" annotatedElement="_19_0_3_129a03b9_1703149093512_633747_25018" body="&lt;para>Hier können weitere Unterlagen zum Verlängerungsantrag übermittelt werden, wie z.B. eine Vollmacht.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1703149093516_318578_25021" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1703149093514_161692_25019" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1689591962562_282954_21930" name="verlaengerung.antragGeaendert.0262" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1689591963925_939961_22044" annotatedElement="_19_0_4_b6602da_1689591962562_282954_21930" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Verlängerungsantrags bzw. geänderte oder ergänzte Bauvorlagen. Sie bezieht sich also auf einen bereits gestellten Verlängerungsantrag.&lt;/para>&#xA;&lt;para>Entweder ist sie eine Reaktion auf eine zum Verlängerungsantrag vorliegende Mängelliste der Bauaufsichtsbehörde oder der Antragsteller reicht aus anderen Gründen modifizierte Bauunterlagen ein.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1689591963931_227235_22050" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963926_811742_22045" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964328_153986_22258" annotatedElement="_19_0_4_b6602da_1689591963926_811742_22045" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang und ggf. auf die Nachricht 0261, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para>&#xA;&lt;para>Falls die vorliegende Nachrichteninstanz geänderte Bauunterlagen initiativ einreicht, ist der Bezug auf eine solche Nachricht nicht enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964328_848067_22259" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964327_796620_22257" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963927_663833_22046" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964329_259081_22262" annotatedElement="_19_0_4_b6602da_1689591963927_663833_22046" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert&#xA;sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964329_437713_22263" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964329_920813_22261" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963928_494835_22047" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964329_657259_22266" annotatedElement="_19_0_4_b6602da_1689591963928_494835_22047" body="&lt;para>Hier sind ggf. geänderte oder ergänzte Daten zu den beantragten Abweichungen enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964330_964990_22267" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964329_961233_22265" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963929_238882_22048" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964331_367448_22270" annotatedElement="_19_0_4_b6602da_1689591963929_238882_22048" body="&lt;para>Ggf. sind in diesem Element korrigierte oder ergänzte Daten zum Bauvorhaben (Wer, Was, Wo)  zu übermitteln. Daten, die an dieser Stelle eingetragen sind, sollen die aufgeführten Mängel im Antragsumfang beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964331_207600_22271" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964331_857136_22269" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_940029b_1703698029459_76946_24994" name="begehrteVerlaengerung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_4_940029b_1703698029463_630385_24996" annotatedElement="_19_0_4_940029b_1703698029459_76946_24994" body="&lt;para>In diesem Element kann ggf. ein geändertes Datum für die Gültigkeitsverlängerung übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_940029b_1703698029465_950645_24997" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_940029b_1703698029463_97238_24995" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591963931_108565_22049" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964332_330770_22274" annotatedElement="_19_0_4_b6602da_1689591963931_108565_22049" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964333_285099_22275" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964332_873986_22273" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1689591962569_207962_21931" name="verlaengerung.anhoerung.0263" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1689591964004_220693_22081" annotatedElement="_19_0_4_b6602da_1689591962569_207962_21931" body="&lt;para>In dieser Nachricht sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung waren. Diese werden hier aufgelistet bzw. erläutert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1689591964014_183418_22088" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964005_917631_22082" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964336_345921_22281" annotatedElement="_19_0_4_b6602da_1689591964005_917631_22082" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Bauantrag Bezug zu nehmen; außerdem ggf. auf die Nachricht 0260, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964337_796886_22282" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964335_740177_22280" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964009_562027_22083" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964339_96158_22285" annotatedElement="_19_0_4_b6602da_1689591964009_562027_22083" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964339_858569_22286" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964338_511543_22284" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964010_217964_22084" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964340_70813_22289" annotatedElement="_19_0_4_b6602da_1689591964010_217964_22084" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Verlängerungsantrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964340_251043_22290" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964340_298616_22288" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964011_595040_22085" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964343_531999_22293" annotatedElement="_19_0_4_b6602da_1689591964011_595040_22085" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964343_135827_22294" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964342_311433_22292" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964012_758219_22086" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964344_941765_22297" annotatedElement="_19_0_4_b6602da_1689591964012_758219_22086" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964344_195259_22298" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964343_75692_22296" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964013_16009_22087" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964346_421570_22301" annotatedElement="_19_0_4_b6602da_1689591964013_16009_22087" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;>BIM Collaboration Format (BCF)&lt;/emphasis>. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964347_819159_22302" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964346_260249_22300" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1689591962574_37757_21932" name="verlaengerung.bescheid.0265" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1689591964094_195219_22119" annotatedElement="_19_0_4_b6602da_1689591962574_37757_21932" body="&lt;para>In dieser Nachricht sind die Inhalte des erteilten Bescheids enthalten. Das Senden dieser Nachricht stellt das Erteilen des Verlängerungsbescheids dar.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1689591964100_933861_22123" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964095_827371_22120" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964349_515625_22308" annotatedElement="_19_0_4_b6602da_1689591964095_827371_22120" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang (oder den Antrag) bzw. die Nachricht 0260 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964350_534642_22309" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964349_340036_22307" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964096_797192_22121" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964351_197186_22312" annotatedElement="_19_0_4_b6602da_1689591964096_797192_22121" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&lt;para>Ein Bescheid mit positivem Tenor  geht mit zugelassenen Abweichungen (Element abweichung) einher. Nicht zugelassene Abweichungen können nur in einem Bescheid mit negativem Tenor enthalten sein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964351_461046_22313" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964351_504091_22311" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964098_210281_22122" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964353_723279_22316" annotatedElement="_19_0_4_b6602da_1689591964098_210281_22122" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964353_740596_22317" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964352_125710_22315" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689593484374_277193_22970" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689593484383_517972_22972" annotatedElement="_19_0_4_b6602da_1689593484374_277193_22970" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist der Verlängerung eingetragen werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689593484385_475204_22973" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689593484382_674288_22971" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1689591962582_757198_21934" name="verlaengerung.stellungnahme.0264" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1689591964264_664336_22189" annotatedElement="_19_0_4_b6602da_1689591962582_757198_21934" body="&lt;para>Diese Nachricht enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Verlängerungsantrags, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1689591964268_359454_22194" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964264_932025_22190" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964362_848973_22338" annotatedElement="_19_0_4_b6602da_1689591964264_932025_22190" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen und außerdem auf die Nachricht 0263, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964362_718784_22339" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964362_745861_22337" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964265_245590_22191" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964363_31992_22342" annotatedElement="_19_0_4_b6602da_1689591964265_245590_22191" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964363_548386_22343" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964363_556038_22341" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964266_670113_22192" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964365_78621_22346" annotatedElement="_19_0_4_b6602da_1689591964266_670113_22192" body="&lt;para>Ggf. sind hier geänderte oder ergänzte Daten zum Bauvorhaben enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964365_148672_22347" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964365_633930_22345" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1689591964267_705155_22193" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1689591964366_304960_22350" annotatedElement="_19_0_4_b6602da_1689591964267_705155_22193" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1689591964366_443112_22351" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1689591964365_106523_22349" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1689591962587_446307_21935" name="" visibility="public" client="_19_0_4_b6602da_1689591962450_520794_21926" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b6602da_1714115821937_189280_25220" name="Statistik" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1714115821968_810387_25221" name="" visibility="public" client="_19_0_4_b6602da_1714115821937_189280_25220" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1714115821973_698016_25222" name="" visibility="public" client="_19_0_4_b6602da_1714115821937_189280_25220" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b6602da_1714115821996_453584_25225" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823067_394992_25381" name="BeteiligteBauprojektStatistik" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823427_978167_25633" annotatedElement="_19_0_4_b6602da_1714115823067_394992_25381" body="&lt;para>Typ für die am Bauprojekt beteiligten Parteien (Personen und Organisationen), die für eine Meldung an die Statistik relevant sind.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823428_917896_25634" name="bauherr" visibility="private" type="_19_0_4_b6602da_1688632025529_352662_21872">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823582_747260_26033" annotatedElement="_19_0_4_b6602da_1714115823428_917896_25634" body="&lt;para>Hier ist derjenige einzutragen, der am Verfahren als Bauherr beteiligt ist, inklusive seiner Rolle.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823582_409936_26034" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823582_960354_26032" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823429_277352_25635" name="grundstueckseigentuemer" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823582_344138_26037" annotatedElement="_19_0_4_b6602da_1714115823429_277352_25635" body="&lt;para>Hier ist der Eigentümer des Baugrundstücks einzutragen, falls nicht der Bauherr Eigentümer ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823582_32547_26038" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823582_887002_26036" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823069_702069_25382" name="AllgemeineAngaben" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823430_528017_25637" annotatedElement="_19_0_4_b6602da_1714115823069_702069_25382" body="&lt;para>Dieses Element enthält die Daten, die zu jeder Statistikmeldung enthalten sind (alle Anlässe).&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1725527109343_626962_27253" name="anzahlDerGebaeudeImBauvorhaben" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
                <ownedComment xmi:id="_19_0_4_b6602da_1725527109353_278661_27255" annotatedElement="_19_0_4_b6602da_1725527109343_626962_27253" body="&lt;para> In diesem Element wird die Anzahl der Gebäude im Bauvorhaben angegeben.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp AnzahlDerGebaeude der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725527109355_558069_27256" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725527109351_165987_27254" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823430_704103_25638" name="beteiligteBauprojekt" visibility="private" type="_19_0_4_b6602da_1714115823067_394992_25381" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823583_361948_26041" annotatedElement="_19_0_4_b6602da_1714115823430_704103_25638" body="&lt;para>In diesem Element werden Daten zu den beteiligten Personen übermittelt, soweit für die Anlässe relevant. &lt;/para>&#xA;&lt;para>Der Inhalt des Elements &quot;bauherr&quot; ergibt sich aus dem Datentyp BeteiligteBauprojekt oder BeteiligteBauprojektStatistik der Eingangsnachricht.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements &quot;grundstueckseigentuemer&quot; ergibt sich aus dem Inhalt des Elements &quot;beteiligter&quot; im Datentyp WeitereBeteiligte (falls der Inhalt des Elements &quot;rolle&quot; im Datentyp WeitereBeteiligte gleich 02 Grundstückseigentümer ist) oder aus dem Datentyp BeteiligteBauprojektStatistik der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823583_137367_26042" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823583_74675_26040" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823431_196645_25639" name="baugrundstueck" visibility="private" type="_19_0_4_b6602da_1721639026632_995350_25901" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823583_774322_26045" annotatedElement="_19_0_4_b6602da_1714115823431_196645_25639" body="&lt;para>Hier werden Daten zum Baugrundstück übermittelt, soweit für die Anlässe relevant. &lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp Grundstueck, GrundstueckStatistik oder DatenBauabgangBeseitigungAbsicht der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823583_478000_26046" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823583_793987_26044" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823431_569130_25640" name="lageGebaeude" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823583_879224_26049" annotatedElement="_19_0_4_b6602da_1714115823431_569130_25640" body="&lt;para>In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp DatenEinzelnesGebaeudeImBauvorhaben oder DatenBauabgangBeseitigungAbsicht der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823583_928107_26050" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823583_445540_26048" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823431_199254_25641" name="verortungHausnummer" visibility="private" type="_19_0_3_136d03d4_1622093994597_608703_9426">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823584_16957_26053" annotatedElement="_19_0_4_b6602da_1714115823431_199254_25641" body="&lt;para>In diesem Element kann ergänzend eine Angabe zur georeferenzierten Lage der Hausnummer (Hauseingang) gemacht werden.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823584_148976_26054" name="" visibility="public"/>
