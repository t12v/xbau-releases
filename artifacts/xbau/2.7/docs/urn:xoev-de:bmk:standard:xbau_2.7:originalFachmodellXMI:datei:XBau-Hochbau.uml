              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619461448023_76262_16930" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619461448023_372376_16931" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619461411316_40676_16919" name="rolle" visibility="private" type="_19_0_3_136d03d4_1619461935117_494709_16942">
