            </node>
            <node xmi:type="uml:CentralBufferNode" xmi:id="_19_0_3_136d03d4_1611871270056_46827_27562" name="Angepasster &#xA;Prüfauftrag&#xA;Nachricht 0503" visibility="public" incoming="_19_0_3_136d03d4_1611871270066_252240_27612" outgoing="_19_0_4_78d0259_1728912465718_712565_29671 _19_0_4_78d0259_1728913236653_84103_30045">
