                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256987_549039_2309" name="domainOfValidity" visibility="public" type="_16_5_4_5b501fb_1387625256759_99066_1645"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256987_452219_2310" name="scope" visibility="public"/>
