                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287171_208247_5860" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287174_553583_5872 _16_5_4_5b501fb_1406633287322_503876_6881">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287321_227035_6880" annotatedElement="_16_5_4_5b501fb_1406633287171_208247_5860" body="Hier werden Angaben zur Religionszugehörigkeit einer natürlichen Person gemacht."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287322_503876_6881" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287171_208247_5860"/>
