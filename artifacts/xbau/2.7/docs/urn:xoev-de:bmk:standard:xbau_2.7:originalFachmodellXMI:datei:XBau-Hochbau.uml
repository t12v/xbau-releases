              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721716202920_438083_25569" name="kommunikation" visibility="private" type="_16_5_4_8a30247_1422894619924_503273_3379">
                <ownedComment xmi:id="_19_0_4_b6602da_1721716202922_345364_25571" annotatedElement="_19_0_4_b6602da_1721716202920_438083_25569" body="&lt;para>In dieses Objekt sind Angaben einzutragen, die benötigt werden, um mit der Person zu kommunizieren (z. B. per Brief oder per Telefon). &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721716202922_198893_25572" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721716202921_565239_25570" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1721720111671_932612_25944" name="DatenUnterDach" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1721720111701_790894_25974" annotatedElement="_19_0_4_b6602da_1721720111671_932612_25944" body="&lt;para>Dieser Typ enthält die Daten, die zum Anlass 'Daten unter Dach / Rohbaufertig' gehören.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721720163544_594051_26056" name="datumUnterDach" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
                <ownedComment xmi:id="_19_0_4_b6602da_1721720163546_326871_26058" annotatedElement="_19_0_4_b6602da_1721720163544_594051_26056" body="&lt;para>In dieses Element ist das Datum des Baufortschritts &quot;unter Dach&quot; oder &quot;rohbaufertig&quot; einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721720163546_269388_26059" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721720163545_397847_26057" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721720170444_865444_26063" name="aktenbereinigungRohbau" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1721720170445_380219_26065" annotatedElement="_19_0_4_b6602da_1721720170444_865444_26063" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass es sich bei dem übermittelten Datum zum Rohbau um eine Schätzung im Zuge einer Aktenbereinigung handelt. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721720170445_994689_26066" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721720170445_989091_26064" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1726122177071_818653_27698" name="AngabenGebaeude" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1726122404177_907737_27792" annotatedElement="_19_0_4_b6602da_1726122177071_818653_27698" body="&lt;para>Hier können Angaben zum Gebäude gemacht werden.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726122217043_675808_27700" name="artDesWohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239792_886892_22872">
                <ownedComment xmi:id="_19_0_4_b6602da_1726122217054_53046_27704" annotatedElement="_19_0_4_b6602da_1726122217043_675808_27700" body="&lt;para>Hier wird für bauliche Anlagen, die Wohngebäude sind, eine Klassifizierung vorgenommen gemäß Einteilung der amtlichen Statistik. Die Hauptnutzung muss klar erkennbar sein.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726122217055_236871_27705" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726122217051_332072_27703" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726122217049_949669_27702" name="haustypWohngebaeude" visibility="private" type="_19_0_3_136d03d4_1611871239792_655985_22874">
                <ownedComment xmi:id="_19_0_4_b6602da_1726122217060_383234_27712" annotatedElement="_19_0_4_b6602da_1726122217049_949669_27702" body="&lt;para>Falls es sich bei dem Gebäude um ein Wohngebäude handelt, ist hier eine Angabe zum Haustyps zu machen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726122217061_200559_27713" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726122217060_94114_27711" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726122217047_511375_27701" name="artDesNichtwohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239790_196517_22867">
                <ownedComment xmi:id="_19_0_4_b6602da_1726122217057_837610_27708" annotatedElement="_19_0_4_b6602da_1726122217047_511375_27701" body="&lt;para>Bauliche Anlagen, die nicht Wohngebäude sind, werden durch dieses Element klassifiziert gemäß Signierschlüsselverzeichnis des Statistischen Bundesamts.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726122217058_140455_27709" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726122217056_16271_27707" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1726229567101_707865_27871" name="artDesGebaeudes" visibility="private" type="_19_0_4_b6602da_1726230824530_629517_27898">
                <ownedComment xmi:id="_19_0_4_b6602da_1726229744853_783145_27880" annotatedElement="_19_0_4_b6602da_1726229567101_707865_27871" body="&lt;para>Angabe eines 6-stelligen Codes zur genauen Klassifizierung von Wohn- und Nichtwohngebäuden für die Statistik.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726229614191_808834_27876" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726229614195_561915_27877" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1726566387590_811697_28116" name="AllgemeineAngabenDatenBauvorhaben" visibility="public">
