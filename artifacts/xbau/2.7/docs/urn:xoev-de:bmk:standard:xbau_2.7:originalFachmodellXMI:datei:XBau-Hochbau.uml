                <ownedComment xmi:id="_19_0_4_b6602da_1726572957978_803004_28890" annotatedElement="_19_0_4_b6602da_1726572957974_106626_28878" body="&lt;para>Dieser Typ deckt Namen und Erreichbarkeit des Architekten oder Entwurfsverfassers für Rückfragen ab.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726572957978_993707_28891" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726572957978_794372_28889" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1760601420782_168778_31690" name="AnsprechpartnerMitEinwilligung" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1760603424677_80965_31893" annotatedElement="_19_0_4_b8702dd_1760601420782_168778_31690" body="&lt;para>Mit diesem Datentyp werden Angaben zu einem Ansprechpartner übermittelt sowie die Information, ob dieser der Weitergabe seiner Angaben an die Statistik zustimmt.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1760601490925_951637_31692" name="datenAnsprechpartner" visibility="private" type="_19_0_4_b6602da_1726572957919_327005_28845">
