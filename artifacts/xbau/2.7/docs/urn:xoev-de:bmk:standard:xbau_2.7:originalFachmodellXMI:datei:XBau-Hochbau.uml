            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753083568593_613677_31125" name="nachweisbezug" visibility="private" type="_19_0_4_b8702dd_1752843163628_281618_31760">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753083568608_599529_31127" annotatedElement="_19_0_4_b8702dd_1753083568593_613677_31125" body="&lt;para>Mit diesem Element wird der Bezug zu einem XNachweis-Abruf aus dem Kammernverzeichnis hergestellt. Das Element ist nur bei erfolgreichem Datenabruf zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753083568610_781541_31128" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753083568604_913968_31126" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1753083654246_934028_31139" name="BauvorlageberechtigungSachverhalt.NachweisbezugType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1753088854047_861477_31350" annotatedElement="_19_0_4_b8702dd_1753083654246_934028_31139" body="&lt;para>Dieser Datentyp beschreibt den Sachverhalt der Bauvorlageberechtigung.&lt;/para>&#xA;&lt;para>Diese Information kann aus dem Kammerregister abgerufen werden.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753083737035_704102_31141" name="grundlageBauvorlageBerechtigung" visibility="private" type="_19_0_3_136d03d4_1611871239750_848421_22723">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753083737035_998210_31143" annotatedElement="_19_0_4_b8702dd_1753083737035_704102_31141" body="&lt;para>Hier ist der Sachverhalt anzugeben, aufgrund dessen die Person bauvorlageberechtigt ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753083737038_797809_31144" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753083737035_117857_31142" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753083748619_519911_31148" name="nachweisbezug" visibility="private" type="_19_0_4_b8702dd_1752843163628_281618_31760">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753083748619_51217_31150" annotatedElement="_19_0_4_b8702dd_1753083748619_519911_31148" body="&lt;para>Mit diesem Element wird der Bezug zu einem XNachweis-Abruf aus dem Kammernverzeichnis hergestellt. Das Element ist nur bei erfolgreichem Datenabruf zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753083748619_504899_31151" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753083748619_979241_31149" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1753084233390_433219_31155" name="NachweisBerechtigung.NachweisbezugType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1758628459340_157788_31575" annotatedElement="_19_0_4_b8702dd_1753084233390_433219_31155" body="&lt;para>Dieser Datentyp enthält Nachweise zur Bauvorlageberechtigung einer Person.&lt;/para>&#xA;&lt;para>Diese Nachweise können aus dem Kammerregister abgerufen werden.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753084260969_717382_31156" name="nachweisBerechtigung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753084260971_712562_31158" annotatedElement="_19_0_4_b8702dd_1753084260969_717382_31156" body="&lt;para>Hier wird ein Nachweis zur Berechtigung angegeben.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753084260971_849579_31159" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753084260969_59547_31157" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753084267171_794556_31163" name="nachweisbezug" visibility="private" type="_19_0_4_b8702dd_1752843163628_281618_31760">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753084267171_632768_31165" annotatedElement="_19_0_4_b8702dd_1753084267171_794556_31163" body="&lt;para>Mit diesem Element wird der Bezug zu einem XNachweis-Abruf aus dem Kammernverzeichnis hergestellt. Das Element ist nur bei erfolgreichem Datenabruf zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1753084267171_879334_31166" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1753084267171_939066_31164" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_940029b_1622288266271_102306_17304" name="Bauvorlagen" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1616753758357_771153_16737" name="Anlagen" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1616753758368_633273_16738" annotatedElement="_19_0_3_136d03d4_1616753758357_771153_16737" body="&lt;para>Dieser Typ dient dazu, die Metadaten zu Dokumenten aufzunehmen, die einer XBau-Kommunikation (z.B. Antragstellung) als Anlagen beigefügt sind. Als Anlagen sind in erster Linie Bauvorlagen zu nennen, in vielen Fällen zusätzlich weitere Anlagen (wie Nachweise und ergänzende Dokumentationen).&lt;/para>&#xA;&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753758368_154050_16739" name="anlage" visibility="private" type="_19_0_3_940029b_1629322573635_742411_17796" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753758372_137791_16742" annotatedElement="_19_0_3_136d03d4_1616753758368_154050_16739" body="&lt;para>Jede Instanz dieses Elements steht für eine Anlage (Bauvorlage, Primärdokument) zum vorliegenden Antrag bzw. zur übermittelten XBau-Fachnachricht.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753758373_517597_16743" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753758372_965384_16741" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1616753803249_521047_16747" name="MetadatenAnlage" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1616753803251_668847_16748" annotatedElement="_19_0_3_136d03d4_1616753803249_521047_16747" body="&lt;para>Dieser Typ nimmt die Metadaten zu einer Bauvorlage bzw. sonstigen Anlage auf, die gemäß der Architektur der Übertragung von Primärdokumenten im Zusammenhang mit einer XBau-Fachnachricht benötigt werden.&lt;/para>&#xA;&lt;para>Die Anlage wird entweder als Anhang zur XBau-Fachnachricht übermittelt.&lt;/para>&#xA;&lt;para>Oder sie wird dem Adressaten per Verlinkung zur Verfügung gestellt, also über ein Quellsystem, das sich in seiner Kontrolle befindet.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1679397636591_721144_21347" general="_19_0_3_136d03d4_1611752450693_63128_15571"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753803251_31029_16749" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210780_355528_9523">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753803256_185031_16759" annotatedElement="_19_0_3_136d03d4_1616753803251_31029_16749" body="&lt;para>Hier ist eine deskriptive Bezeichnung der Bauvorlage bzw. sonstigen Anlage einzutragen, z. B. &quot;Grundriss 3. OG&quot;. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753803257_838116_16760" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753803256_581255_16758" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753803252_417219_16750" name="versionsnummer" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753803258_833604_16763" annotatedElement="_19_0_3_136d03d4_1616753803252_417219_16750" body="&lt;para>Hier wird eine Versionsnummer eingetragen. Sie dient dazu, (sequentiell eingereichte) Bauvorlagen (oder sonstige Anlagen) zu unterscheiden, die dieselbe Bezeichnung tragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753803258_213217_16764" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753803257_367886_16762" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753803252_342749_16751" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753803259_728587_16767" annotatedElement="_19_0_3_136d03d4_1616753803252_342749_16751" body="&lt;para>Hier ist das Datum der Erstellung bzw. der letzten Bearbeitung dieser Bauvorlage bzw. sonstigen Anlage einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753803259_320587_16768" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753803259_125891_16766" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753803253_192723_16752" name="anlageart" visibility="private" type="_19_0_3_136d03d4_1615201655963_472277_16611">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753803260_534358_16771" annotatedElement="_19_0_3_136d03d4_1616753803253_192723_16752" body="&lt;para>Unterhalb dieses Elements wird die Art dieser Bauvorlage oder sonstigen Anlage näher spezifiziert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753803260_568234_16772" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753803259_707569_16770" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1616753803253_796456_16753" name="mimeType" visibility="private" type="_16_5_4_940029b_1483303261965_543138_5139">
              <ownedComment xmi:id="_19_0_3_136d03d4_1616753803261_642357_16775" annotatedElement="_19_0_3_136d03d4_1616753803253_796456_16753" body="&lt;para>Dieses Element nennt - analog zur Übermittlung von E-Mail-Anlagen - den MIME-Typ der angehängten oder verlinkten Bauvorlage (z.B. text/xml, text/plain, application/gzip oder application/pdf). &lt;/para>&#xA;&lt;para>Die Angabe ist mandatorisch, weil eine für den Empfänger zur Verarbeitung der Daten notwendige Information.&lt;/para>&#xA;&lt;para>Als Anlagen können u.a. auch IFC-Darstellungen (gemäß der Technologie Building Information Modeling (BIM)) des Bauvorhabens übermittelt werden. Entsprechende Kennzeichnungen des mimeTypes (ifc, ifcXML, ifcZIP) sind dafür verfügbar.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1616753803261_426927_16776" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1616753803260_405750_16774" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1622019856324_725057_17221" name="anhangOderVerlinkung" visibility="private" type="_19_0_3_940029b_1621589626990_578637_9405">
              <ownedComment xmi:id="_19_0_3_136d03d4_1622019856324_673164_17223" annotatedElement="_19_0_3_136d03d4_1622019856324_725057_17221" body="&lt;para>Eine Instanz dieses Elements enthält passende Metadaten zur Bauvorlage bzw. sonstigen Anlage, je nachdem ob diese (i) als Anhang mit dieser XBau-Nachricht übermittelt wird oder ob sie (ii) über einen Link zugänglich gemacht  wird, der in diese XBau-Nachricht eingetragen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622019856324_453375_17224" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622019856324_204052_17222" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1629322573635_742411_17796" name="MetadatenAnlageErweitert" visibility="public">
            <ownedComment xmi:id="_19_0_3_940029b_1629323049064_991503_17827" annotatedElement="_19_0_3_940029b_1629322573635_742411_17796" body="&lt;para>Dieser Typ erweitert den Typ MetadatenAnlage um eine Kennzeichnung für Dokumente, die durch Übermittlung ihrer Metadaten bei der Antragstellung schon angekündigt werden, aber der Baufaufsichtsbehörde erst zu einem späteren Zeitpunkt übermittelt werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_940029b_1629322593120_998605_17823" general="_19_0_3_136d03d4_1616753803249_521047_16747"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1629322747630_22473_17825" name="wirdNachgereicht" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_940029b_1629323831029_131603_17833" annotatedElement="_19_0_3_940029b_1629322747630_22473_17825" body="&lt;para>Kennzeichnung für Dokumente, deren Metadaten hier schon übermittelt werden, die der Bauaufsichtsbehörde aber erst zu einem späteren Zeitpunkt übermittelt werden (als Datei, auf die sich die Metadaten beziehen).&lt;/para>&#xA;&#xA;&lt;para>Mit dem Bauantrag sind alle für die Beurteilung des Bauvorhabens und die Bearbeitung des Bauantrags erforderlichen Unterlagen (Bauvorlagen) einzureichen. Es kann gestattet werden, dass einzelne Bauvorlagen nachgereicht werden (vgl. MBO § 68) . Das betrifft nur die aufschiebungsfähigen Bestandteile des Antrags, die nicht zur Fristverzögerung führen.&lt;/para>&#xA;&#xA;&lt;para>Aus Sicht der Bauprüfer ist es wünschenswert, wenn die beabsichtigte Nachreichung von Bauvorlagen durch den Antragsteller erklärt wird. Damit können unnötige Nachforderungen vermieden werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1629323302618_530565_17831" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1629323302618_86217_17832" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_940029b_1662300582178_497392_18262" name="Anzeigen" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1662300598911_76890_18263" name="SachverhaltAbsichtBeseitigung" visibility="public">
            <ownedComment xmi:id="_19_0_3_940029b_1662300598929_261065_18268" annotatedElement="_19_0_3_940029b_1662300598911_76890_18263" body="&lt;para>Hier sind Eckdaten zum Sachverhalt der geplanten Beseitigung anzugeben.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598930_764579_18269" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598974_156433_18290" annotatedElement="_19_0_3_940029b_1662300598930_764579_18269" body="&lt;para>In dieses Element ist die Bezeichnung des Vorhabens einzutragen. Sie wird vom Bauherrn vergeben und später ggf. von der Bauaufsichtsbehörde geändert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598975_954767_18291" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598973_175968_18289" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598933_231927_18270" name="mboGebaeudeklasse" visibility="private" type="_19_0_3_136d03d4_1611871239759_272892_22742" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598978_257716_18294" annotatedElement="_19_0_3_940029b_1662300598933_231927_18270" body="&lt;para>In diesem Element wird die Art des Gebäudes übermittelt, das beseitigt werden soll. Es wird die Einteilung in Gebäudeklassen gemäß MBO verwendet.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598979_809957_18295" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598977_915682_18293" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598936_258576_18271" name="artDerBaulichenAnlage" visibility="private" type="_19_0_3_136d03d4_1611871244699_746777_23393">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598982_840042_18298" annotatedElement="_19_0_3_940029b_1662300598936_258576_18271" body="&lt;para>Hier kann die Art der baulichen Anlage näher spezifiziert werden. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598983_833662_18299" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598981_668405_18297" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598938_293149_18272" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598986_449084_18302" annotatedElement="_19_0_3_940029b_1662300598938_293149_18272" body="&lt;para>In diesem Element werden die Grundstücke und die Anschriften der Gebäude übermittelt, die beseitigt werden sollen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598987_376115_18303" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598985_153574_18301" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598940_152062_18273" name="istFreistehend" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598990_831573_18306" annotatedElement="_19_0_3_940029b_1662300598940_152062_18273" body="&lt;para>Falls das betreffende Gebäude freistehend ist, wird hier &quot;true&quot; eingetragen, andernfalls &quot;false&quot;.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598991_775065_18307" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598989_678814_18305" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598943_730155_18274" name="hoeheDerBaulichenAnlage" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662300598994_744474_18310" annotatedElement="_19_0_3_940029b_1662300598943_730155_18274" body="&lt;para>Falls die bauliche Anlage eine Höhe von mehr als 10 m hat, ist dieses Element zu übermitteln. Es ist die Höhe in Metern einzutragen (ohne Nachkommastellen). &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300598994_491600_18311" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598993_643360_18309" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1662300598916_548669_18264" name="SachverhaltBaubeginn" visibility="public">
            <ownedComment xmi:id="_19_0_3_940029b_1662300598953_135609_18278" annotatedElement="_19_0_3_940029b_1662300598916_548669_18264" body="&lt;para>Hier ist genau einer von drei möglichen Sachverhalten anzugeben, die einer Anzeige Baubeginn zu Grunde liegen können (MBO § 72 (6, 8)).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598954_413344_18279" name="baubeginn" visibility="private" type="_19_0_3_940029b_1662300598923_338376_18266" aggregation="composite" association="_19_0_3_940029b_1662300598952_659898_18277">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599001_236982_18317" annotatedElement="_19_0_3_940029b_1662300598954_413344_18279" body="&lt;para>Falls die Nachricht dazu dient, den  Baubeginn (Ausführung eines genehmigten Bauvorhabens oder einer zuvor angezeigten Beseitigung) anzuzeigen, dann ist dieses Element zu wählen unter Angabe des Datums des geplanten Baubeginns.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599002_500963_18318" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300598999_638154_18316" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598956_775501_18280" name="ausfuehrungBauabschnitt" visibility="private" type="_19_0_3_940029b_1662300598926_740778_18267" aggregation="composite" association="_19_0_3_940029b_1662300598950_855129_18276">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599005_292339_18321" annotatedElement="_19_0_3_940029b_1662300598956_775501_18280" body="&lt;para>Falls die Nachricht die Aufnahme von Bauarbeiten zur Ausführung eines bestimmten Bauabschnitts anzeigen soll, dann ist dieses Element zu wählen. Zusätzlich sind weitere Angaben zu machen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599005_979646_18322" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599004_47367_18320" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598958_258503_18281" name="wiederaufnahmeBauarbeiten" visibility="private" type="_19_0_3_940029b_1662300598923_338376_18266" aggregation="composite" association="_19_0_3_940029b_1662300598945_517401_18275">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599007_606201_18325" annotatedElement="_19_0_3_940029b_1662300598958_258503_18281" body="&lt;para>Falls die Nachricht die Wiederaufnahme von Bauarbeiten anzeigen soll, dann ist dieses Element zu wählen unter Angabe des Datums der geplanten Wiederaufnahme.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599008_723323_18326" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599007_467848_18324" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1662300598920_701507_18265" name="SachverhaltNutzungsaufnahme" visibility="public">
            <ownedComment xmi:id="_19_0_3_940029b_1662300598964_168988_18284" annotatedElement="_19_0_3_940029b_1662300598920_701507_18265" body="&lt;para>Dieser Typ deckt den Sachverhalt der geplanten Nutzungsaufnahme ab..&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598965_850354_18285" name="geplanteNutzungsaufnahme" visibility="private" type="_19_0_3_940029b_1662300598923_338376_18266" aggregation="composite" association="_19_0_3_940029b_1662300598962_38890_18283">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599011_425728_18330" annotatedElement="_19_0_3_940029b_1662300598965_850354_18285" body="&lt;para>Dieses Element dient dazu, den Zeitpunkt der geplanten Nutzungsaufnahme zu nennen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599012_966290_18331" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599011_974727_18329" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1662300598923_338376_18266" name="Anonym_A" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598967_682611_18286" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599013_436204_18334" annotatedElement="_19_0_3_940029b_1662300598967_682611_18286" body="&lt;para>Hier ist das Datum einzutragen, zu dem die angegebene Aktivität geplant ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599015_616670_18335" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599013_724906_18333" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1662300598926_740778_18267" name="Anonym_B" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598969_808884_18287" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599017_761970_18338" annotatedElement="_19_0_3_940029b_1662300598969_808884_18287" body="&lt;para>Hier ist das Datum einzutragen, zu dem die angegebene Aktivität geplant ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599017_852721_18339" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599015_705485_18337" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662300598971_330058_18288" name="bezeichnungBauabschnitt" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662300599020_685287_18342" annotatedElement="_19_0_3_940029b_1662300598971_330058_18288" body="&lt;para>Hier ist die Bezeichnung des Bauabschnitts einzutragen, dessen Arbeiten mittels der Nachricht angezeigt werden soll.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662300599020_593013_18343" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662300599019_415456_18341" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_940029b_1662300598945_517401_18275" name="" visibility="public" memberEnd="_19_0_3_940029b_1662300598958_258503_18281 _19_0_3_940029b_1662300598996_606082_18313">
            <ownedEnd xmi:id="_19_0_3_940029b_1662300598996_606082_18313" name="" visibility="private" type="_19_0_3_940029b_1662300598916_548669_18264" association="_19_0_3_940029b_1662300598945_517401_18275"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_940029b_1662300598950_855129_18276" name="" visibility="public" memberEnd="_19_0_3_940029b_1662300598956_775501_18280 _19_0_3_940029b_1662300598998_420596_18314">
            <ownedEnd xmi:id="_19_0_3_940029b_1662300598998_420596_18314" name="" visibility="private" type="_19_0_3_940029b_1662300598916_548669_18264" association="_19_0_3_940029b_1662300598950_855129_18276"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_940029b_1662300598952_659898_18277" name="" visibility="public" memberEnd="_19_0_3_940029b_1662300598954_413344_18279 _19_0_3_940029b_1662300598999_642728_18315">
            <ownedEnd xmi:id="_19_0_3_940029b_1662300598999_642728_18315" name="" visibility="private" type="_19_0_3_940029b_1662300598916_548669_18264" association="_19_0_3_940029b_1662300598952_659898_18277"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_940029b_1662300598962_38890_18283" name="" visibility="public" memberEnd="_19_0_3_940029b_1662300598965_850354_18285 _19_0_3_940029b_1662300599010_50749_18328">
            <ownedEnd xmi:id="_19_0_3_940029b_1662300599010_50749_18328" name="" visibility="private" type="_19_0_3_940029b_1662300598920_701507_18265" association="_19_0_3_940029b_1662300598962_38890_18283"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696418949854_483945_24030" name="ErfuellungserklaerungNeubau" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1696422520286_176959_24500" annotatedElement="_19_0_4_b6602da_1696418949854_483945_24030" body="&lt;para>Dieses Element ist zu befüllen, wenn es sich um einen Neubau handelt.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696418975349_155860_24031" name="einhaltungVorgabenGEG" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1696419029278_987989_24033" annotatedElement="_19_0_4_b6602da_1696418975349_155860_24031" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass die Vorgaben des GEG eingehalten werden. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696419268777_596373_24200" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696419268777_647377_24201" name="" visibility="public" value="1"/>
