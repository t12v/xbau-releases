            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823188_558712_25426" name="allgemeineAngaben" visibility="private" type="_19_0_4_b6602da_1714115823069_702069_25382" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823553_946416_25829" annotatedElement="_19_0_4_b6602da_1714115823188_558712_25426" body="&lt;para>Dieses Element enthält die Daten, die zu jeder Statistikmeldung enthalten sind (alle Anlässe). &lt;/para>"/>
