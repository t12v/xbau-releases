              <ownedComment xmi:id="_19_0_4_b6602da_1701858466200_511700_25064" annotatedElement="_19_0_4_b6602da_1701858466200_606230_25061" body="&lt;para>Hier können die Ergebnisse der formellen Prüfung in Form einer strukturierten Befundliste eingetragen werden (die Liste zählt Mängel des Teilungsantrags auf).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701858466200_167176_25065" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701858466200_173839_25063" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1701858466200_408406_25062" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1701858466201_546836_25068" annotatedElement="_19_0_4_b6602da_1701858466200_408406_25062" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist eingetragen werden, innerhalb derer die genannten Mängel durch den Antragsteller zu beseitigen sind und ein überarbeiteter Antrag einzureichen ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701858466201_941083_25069" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701858466200_600753_25067" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1701859231535_616243_25094" name="Anonym_BefundFristAbgeschlossenheit" visibility="public">
            <ownedAttribute xmi:id="_19_0_4_b6602da_1701859231535_351481_25095" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1701859231536_44375_25098" annotatedElement="_19_0_4_b6602da_1701859231535_351481_25095" body="&lt;para>Hier können die Ergebnisse der formellen Prüfung in Form einer strukturierten Befundliste eingetragen werden (die Liste zählt Mängel des Antrags auf Abgeschlossenheit auf).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701859231536_535080_25099" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701859231536_668063_25097" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1701859231536_698775_25096" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1701859231538_307817_25102" annotatedElement="_19_0_4_b6602da_1701859231536_698775_25096" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist eingetragen werden, innerhalb derer die genannten Mängel durch den Antragsteller zu beseitigen sind und ein überarbeiteter Antrag einzureichen ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1701859231538_440495_25103" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1701859231536_426874_25101" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1725002748026_786307_26572" name="AnzahlDerGebaeude" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1725002836797_412302_26574" annotatedElement="_19_0_4_b6602da_1725002748026_786307_26572" body="&lt;para>Dieser Datentyp enthält die Anzahl der Gebäude des Bauvorhabens und Informationen zur Identifikation der einzelnen Gebäude. Die Angabe, die im Element &quot;anzahlDerGebaeudeImBauvorhaben&quot; gemacht wurde, bedingt wie oft der Datentyp &quot;identifikationGebaeude&quot; befüllt werden muss.&#xA;Beispiel: Bei einer Baugenehmigung für ein Reihenhaus bestehend aus 3 Wohneinheiten (= Gebäuden) wird der Datentyp &quot;identifikationGebaeude&quot; dreimal befüllt. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1725002867937_507840_26575" name="anzahlDerGebaeudeImBauvorhaben" visibility="private" type="_14_0_1_6370212_1218191841406_826039_1460">
              <ownedComment xmi:id="_19_0_4_b6602da_1725003039507_145861_26578" annotatedElement="_19_0_4_b6602da_1725002867937_507840_26575" body="&lt;para> In diesem Element wird die Anzahl der Gebäude im Bauvorhaben angegeben. Falls der Vorgang keine Gebäude, sondern lediglich bauliche Anlagen wie Aufschüttungen, Abgrabungen, Werbeanlagen, Stell- und Lagerplätze betrifft, ist der Wert 0 einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725003273089_366338_26656" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725003273091_129137_26657" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1725002871495_279080_26576" name="identifikationGebaeude" type="_19_0_4_b6602da_1725003116971_550114_26581">
              <ownedComment xmi:id="_19_0_4_b6602da_1725003090149_704246_26580" annotatedElement="_19_0_4_b6602da_1725002871495_279080_26576" body="&lt;para>Dieser Datentyp enthält Angaben zur Identifikation des Gebäudes im Bauvorhaben. Beispiel: Bei einer Baugenehmigung für ein Reihenhaus bestehend aus 3 Wohneinheiten (= Gebäuden) wird dieser Datentyp dreimal befüllt. Zu UUID1 gehört &quot;Reihenendhaus Ost&quot;, zu UUID2 gehört &quot;Mittelhaus&quot; und zu UUID3 gehört &quot;Reihenendhaus West&quot;.&#xA;Bei einer Baugenehmigung für bauliche Anlagen wie Aufschüttungen, Abgrabungen, Werbeanlagen, Stell- und Lagerplätze wird dieser Datentyp nicht befüllt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725003277697_755294_26658" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725003277698_887199_26659" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1725003116971_550114_26581" name="IdentifikationGebaeude" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1725006199940_743771_26759" annotatedElement="_19_0_4_b6602da_1725003116971_550114_26581" body="&lt;para>Dieser Datentyp enthält Angaben zur Identifikation des Gebäudes im Bauvorhaben.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1725003636700_168715_26674" name="uuidGebaeude" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_4_b6602da_1725003966265_139441_26755" annotatedElement="_19_0_4_b6602da_1725003636700_168715_26674" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ des Gebäudes. Der UUID wird entsprechend&#xA;rfc4122 gebildet und ermöglicht das Gebäude eindeutig zu identifizieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725003930676_200884_26751" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725003930677_837828_26752" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1725003639829_376683_26675" name="gebaeudeBezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_4_b6602da_1725003968017_522638_26756" annotatedElement="_19_0_4_b6602da_1725003639829_376683_26675" body="&lt;para>Bezeichnung des einzelnen Gebäudes, z. B. &quot;Reihenendhaus Ost&quot;.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725003936872_397048_26753" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725003936873_863026_26754" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239746_770744_22706" name="Beteiligung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246523_190173_23499" name="AnliegenBeteiligung" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264218_487353_25601" annotatedElement="_19_0_3_136d03d4_1611871246523_190173_23499" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Beteiligungsanliegens der Bauaufsichtsbehörde gegenüber einem Träger öffentlicher Belange.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1774009759351_895742_31328" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_4_b8702dd_1774009759351_39195_31330" annotatedElement="_19_0_4_b8702dd_1774009759351_895742_31328" body="&lt;para>Dieses Element enthält den &quot;Universally Unique IDentifier (UUID)&quot; des Beteiligungsanliegens. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die eindeutige Zuordnung einer Stellungnahme zu einem Anliegen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774009759351_367459_31331" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774009759351_339143_31329" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264218_413043_25602" name="rolle" visibility="private" type="_19_0_3_136d03d4_1611871239758_514838_22738">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282152_965796_30638" annotatedElement="_19_0_3_136d03d4_1611871264218_413043_25602" body="&lt;para>Aus diesem Element geht die Rolle des Adressaten im Beteiligungsverfahren hervor.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282152_474089_30639" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282152_975867_30637" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264218_203306_25603" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282153_791733_30642" annotatedElement="_19_0_3_136d03d4_1611871264218_203306_25603" body="&lt;para>Dieses Element nennt den  Rechtsbereich, innerhalb dessen Anlass und angeforderte Stellungnahme liegen. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282153_836169_30643" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282153_461327_30641" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264218_724059_25604" name="grundDerBeteiligung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282153_801512_30646" annotatedElement="_19_0_3_136d03d4_1611871264218_724059_25604" body="&lt;para>Hier wird der Grund bzw. das Anliegen der Beteiligung mit Bezug auf die entsprechenden Eigenschaften des Bauvorhabens im Detail formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282153_577287_30647" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282153_282624_30645" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246524_449877_23500" name="Anonym_Stellungnahme" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264219_346584_25606" annotatedElement="_19_0_3_136d03d4_1611871246524_449877_23500" body=""/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264219_372698_25607" name="stellungnahmeStrukturiert" visibility="private" type="_19_0_3_136d03d4_1611871244697_588683_23383" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282154_721343_30650" annotatedElement="_19_0_3_136d03d4_1611871264219_372698_25607" body="&lt;para>Um hier eine strukturierte Stellungnahme einzutragen, ist eine bestimmte Form bei der Dokumentation der Stellungnahme einzuhalten.  Es sind die Parameter dieses Objekts zu füllen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282154_662868_30651" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282154_176060_30649" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264219_857741_25608" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282154_500750_30654" annotatedElement="_19_0_3_136d03d4_1611871264219_857741_25608" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zur Stellungnahme gegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282154_102462_30655" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282154_46116_30653" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264219_368468_25609" name="hinweise" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282155_422743_30658" annotatedElement="_19_0_3_136d03d4_1611871264219_368468_25609" body="&lt;para>Hier werden ggf. ergänzende Hinweise zur Stellungnahme gegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282155_714665_30659" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282154_946091_30657" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1697611488329_265944_24730" name="ReferenzAuftrag" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1697611703697_482527_24740" annotatedElement="_19_0_4_b6602da_1697611488329_265944_24730" body="&lt;para>Dieser Typ deckt Daten ab, durch die ein Auftrags- oder Beteiligungsvorgang eindeutig gekennzeichnet wird (Auftrag zur Prüfung bautechnischer Nachweise bzw. Aufforderung zur Stellungnahme in der Beteiligung öffentlicher Stellen).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697611520528_997131_24732" name="referenzAuftrag" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_4_b6602da_1697611520532_948262_24734" annotatedElement="_19_0_4_b6602da_1697611520528_997131_24732" body="&lt;para>Initial eingetragener i.d.R. maschinell erzeugter Identifier, der für den Auftrags- oder Beteiligungsvorgang steht.&#xA;Dieser Identifier geht mit den Beauftragungsnachrichten an Auftragnehmer bzw. zu beteiligende Stelle zu und muss von einem solchen Kommunikationspartner in den Reaktionsnachrichten referenziert werden. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697611520533_474849_24735" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697611520531_367579_24733" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239746_304574_22707" name="DatentypenBaulast" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246524_417951_23501" name="BaulastErklaerung" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264219_556035_25610" annotatedElement="_19_0_3_136d03d4_1611871246524_417951_23501" body="&lt;para>Dieser Typ beinhaltet die Daten zu Anlass und Inhalt einer Baulasterklärung.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264220_347532_25611" name="anlass" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282155_623249_30662" annotatedElement="_19_0_3_136d03d4_1611871264220_347532_25611" body="&lt;para>Hier wird die öffentlich-rechtliche Verpflichtung bezeichnet, die mit der einzutragenden Baulast einhergeht. Es wird der  Zweck bzw. das Ziel der einzurichtenden Baulast angegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282155_622755_30663" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282155_945963_30661" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264220_974705_25612" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282156_255218_30666" annotatedElement="_19_0_3_136d03d4_1611871264220_974705_25612" body="&lt;para>Hier ist Text einzutragen, der die Baulast mit Bezugnahme auf die in der Nachricht aufgeführten Grundstücke definiert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282156_774313_30667" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282155_504419_30665" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264220_189246_25613" name="sachverhalt" visibility="private" type="_19_0_3_136d03d4_1611871246524_764424_23502">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282156_57185_30670" annotatedElement="_19_0_3_136d03d4_1611871264220_189246_25613" body="&lt;para>Hier wird eine Beschreibung der Verpflichtung im Detail gegeben. Dies geschieht, indem georeferenziert auf die Gegenstände der Baulast Bezug genommen wird. Pro Element wird ein Baulast-Gegenstand genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282156_341529_30671" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282156_9903_30669" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246524_764424_23502" name="Anonym_Gegenstand" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264221_853560_25615" annotatedElement="_19_0_3_136d03d4_1611871246524_764424_23502" body="&lt;para>Typ für die an der Umsetzung eines Bauprojekts beteiligten Parteien (Personen und Organisationen).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264221_171028_25616" name="baulastgegenstand" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282156_141743_30674" annotatedElement="_19_0_3_136d03d4_1611871264221_171028_25616" body="&lt;para>In diesem Element wird ein Baulast-Gegenstand georeferenziert definiert. z.B. eine Baulastfläche (Abstandsfläche, die von der Bebauung freizuhalten ist) oder eine gemeinsame Brandwand (die nicht verändert werden darf in einem Bauvorhaben).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282156_203650_30675" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282156_484593_30673" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264221_640589_25617" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282157_406320_30678" annotatedElement="_19_0_3_136d03d4_1611871264221_640589_25617" body="&lt;para>Zum georeferenzierten Baulast-Gegenstand werden hier Erläuterungen eingefügt.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282157_838991_30679" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282157_55590_30677" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246524_125172_23503" name="Baulast" visibility="public">
