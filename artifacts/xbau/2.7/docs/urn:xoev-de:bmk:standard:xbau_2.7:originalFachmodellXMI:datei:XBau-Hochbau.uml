            <ownedAttribute xmi:id="_19_0_3_129a03b9_1710950532988_833672_25046" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_129a03b9_1710950532990_725996_25048" annotatedElement="_19_0_3_129a03b9_1710950532988_833672_25046" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Baulast. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Baulast eindeutig zu identifizieren.&lt;/para>"/>
