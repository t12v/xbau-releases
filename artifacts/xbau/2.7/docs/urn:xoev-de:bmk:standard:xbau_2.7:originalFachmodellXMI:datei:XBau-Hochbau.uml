        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241080_615950_23106" name="Informationsempfaenger" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_151488_23205" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_615950_23106" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242638_922893_23214" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_615950_23106" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247552_429428_24132" name="informationsempfaenger.benachrichtigung.0400" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265763_733206_26729" annotatedElement="_19_0_3_136d03d4_1611871247552_429428_24132" body="&lt;para>Diese Nachricht übermittelt Informationen über Stand bzw. Ergebnisse eines bauaufsichtlichen Vorgangs. Sie wird von der Bauaufsichtsbehörde an Behörden und sonstige öffentliche Stellen versendet, die diese Daten für ihre Aufgabenerfüllung benötigen. Die Übermittlungsanlässe (siehe Element anlass der Nachricht) können je nach landesrechtlichen Regelungen oder kommunaler Praxis variieren. Ein Beispiel hierfür ist, dass die Bauaufsichtsbehörden den kreisangehörigen Gemeinden unverzüglich den Bauantrag mit Bauvorlagen zur Verfügung stellen müssen. In einer gegebenen Nachrichteninstanz sind diejenigen Daten des Vorgangs enthalten, die zu diesem Anlass für diesen Informationsempfänger für seine Aufgabenerfüllung relevant sind.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_843191_25291" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265763_531564_26730" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282459_273869_33287" annotatedElement="_19_0_3_136d03d4_1611871265763_531564_26730" body="&lt;para>Dieses Element nennt den Vorgang der Bauaufsichtsbehörde, aus dem die Informationen entnommen sind. &lt;/para>&#xA;&lt;para>Eine Referenz auf eine Nachricht ist hier i.d.R. nicht einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282459_112465_33288" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282458_900148_33286" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752838757161_891965_31006" name="adressierteStelle" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752838757165_197592_31008" annotatedElement="_19_0_4_b8702dd_1752838757161_891965_31006" body="&lt;para>Die Information in diesem Element wird in den Fällen benötigt, wo die Nachrichteninstanz an eine Plattform geht, in der eine Vielzahl von Stellen einen Account haben. Die Stelle, für die die Nachrichteninstanz gedacht ist, muss im vorliegenden Element technisch eindeutig bezeichnet werden (z.B. durch die ID eines Unternehmenskontos oder eine Mail-Adresse), so dass die Plattform die Nachricht entsprechend zuordnen und zustellen kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752838757166_96892_31009" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752838757164_546610_31007" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265764_238367_26731" name="anlass" visibility="private" type="_19_0_3_136d03d4_1611871239763_75300_22754" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282459_461132_33291" annotatedElement="_19_0_3_136d03d4_1611871265764_238367_26731" body="&lt;para>Hier wird der Übermittlungsanlass genannt: Welches bauaufsichtliche Ereignis hat zu dieser Benachrichtigung geführt?&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282459_626149_33292" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282459_510738_33290" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265764_523850_26732" name="datenBescheid" visibility="private" type="_19_0_3_136d03d4_1611871265766_70753_26740" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282460_375365_33295" annotatedElement="_19_0_3_136d03d4_1611871265764_523850_26732" body="&lt;para>Übermittlungsanlass Bescheiderteilung: Hier werden Bescheiddaten übermittelt, soweit für den vorliegenden Anlass relevant. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282460_432602_33296" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282459_548064_33294" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265764_821662_26733" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282460_666727_33299" annotatedElement="_19_0_3_136d03d4_1611871265764_821662_26733" body="&lt;para>Hier werden Daten zum Bauvorhaben übermittelt, soweit für den vorliegenden Anlass relevant. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282460_553435_33300" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282460_222721_33298" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265764_504492_26734" name="verortungAbbruch" visibility="private" type="_19_0_3_136d03d4_1611871244693_625845_23369" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282460_104089_33303" annotatedElement="_19_0_3_136d03d4_1611871265764_504492_26734" body="&lt;para>Übermittlungsanlass Abbruch: Hier werden Daten zum geplanten Abbruch eingetragen, soweit für den vorliegenden Anlass relevant. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282461_635767_33304" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282460_569360_33302" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265765_58338_26735" name="verortungHausnummer" visibility="private" type="_19_0_3_136d03d4_1622093994597_608703_9426" aggregation="composite" association="_19_0_3_136d03d4_1611871247552_304944_24133">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282461_73796_33307" annotatedElement="_19_0_3_136d03d4_1611871265765_58338_26735" body="&lt;para>Je Element sind Angaben zur georeferenzierten Lage einer  Hausnummer (Hauseingang) abgebildet.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282461_837705_33308" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282461_47172_33306" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662298632736_832520_18237" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662298632764_29641_18239" annotatedElement="_19_0_3_940029b_1662298632736_832520_18237" body="&lt;para>Übermittlungsanlass Baulast: Zu einer vorliegenden Baulast können hier relevante Daten übermittelt werden (Zweck der Baulast, der geregelte Sachverhalt usw.). Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662298632766_490824_18240" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662298632763_988493_18238" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662301099207_950609_18373" name="sachverhaltBaubeginn" visibility="private" type="_19_0_3_940029b_1662300598916_548669_18264" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662301099216_745288_18375" annotatedElement="_19_0_3_940029b_1662301099207_950609_18373" body="&lt;para>Übermittlungsanlass Baubeginn: Hier kann einer der drei möglichen Sachverhalte zum Baubeginn angegeben werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662301099218_870145_18376" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662301099214_691536_18374" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662298780321_6869_18244" name="beteiligteBaubeginn" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662298780328_849518_18246" annotatedElement="_19_0_3_940029b_1662298780321_6869_18244" body="&lt;para>Hier können für den Übermittlungsanlass Baubeginn die an der Bauausführung beteiligten Parteien (Personen bzw. Organisationen) benannt werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662298780329_443316_18247" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662298780327_552799_18245" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662301124299_974709_18380" name="sachverhaltNutzungsaufnahme" visibility="private" type="_19_0_3_940029b_1662300598920_701507_18265" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662301124304_198195_18382" annotatedElement="_19_0_3_940029b_1662301124299_974709_18380" body="&lt;para>Übermittlungsanlass Nutzungsaufnahme: Hier kann der Sachverhalt einer geplanten Nutzungsaufnahme angegeben werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662301124305_127156_18383" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662301124303_2160_18381" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662301294413_322893_18387" name="sachverhaltAbsichtBeseitigung" visibility="private" type="_19_0_3_940029b_1662300598911_76890_18263" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_940029b_1662301294419_144723_18389" annotatedElement="_19_0_3_940029b_1662301294413_322893_18387" body="&lt;para>Übermittlungsanlass Anzeige Absicht Beseitigung: Hier können Eckdaten zum Sachverhalt der geplanten Beseitigung angegeben werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662301294420_422413_18390" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662301294417_204006_18388" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_940029b_1662298823836_241879_18251" name="anzeigenderAbsichtBeseitigung" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_940029b_1662298823842_758248_18253" annotatedElement="_19_0_3_940029b_1662298823836_241879_18251" body="&lt;para>Übermittlungsanlass Anzeige Absicht Beseitigung: Hier können die Daten der Personen eingetragen werden, die verantwortlich für die Anzeige zur beabsichtigen Beseitigung sind. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1662298823843_788003_18254" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1662298823840_110084_18252" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265765_807262_26736" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282461_661879_33311" annotatedElement="_19_0_3_136d03d4_1611871265765_807262_26736" body="&lt;para>Hier werden relevante Anlagen eingefügt, soweit für den vorliegenden Anlass relevant. &lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282461_611463_33312" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282461_574750_33310" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871247552_304944_24133" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871265765_58338_26735 _19_0_3_136d03d4_1611871265765_947140_26738">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871265765_947140_26738" name="" visibility="private" type="_19_0_3_136d03d4_1611871247552_429428_24132" association="_19_0_3_136d03d4_1611871247552_304944_24133"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871247552_835567_24134" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871265766_70753_26740" name="Anonym_DatenBescheid" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282462_352411_33316" name="datum" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283278_222628_36503" annotatedElement="_19_0_3_136d03d4_1611871282462_352411_33316" body="&lt;para>Hier ist das Datum der Bescheiderteilung wiederzugeben.&lt;/para>&#xA;&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283278_922491_36504" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283278_291065_36502" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282462_999707_33317" name="adressat" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283278_640169_36507" annotatedElement="_19_0_3_136d03d4_1611871282462_999707_33317" body="&lt;para>Hier ist die Partei einzutragen, an die sich der Bescheid gerichtet hat.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283279_776759_36508" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283278_118462_36506" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282463_142130_33318" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283279_885824_36511" annotatedElement="_19_0_3_136d03d4_1611871282463_142130_33318" body="&lt;para>In diesem Objekt sind die inhaltlichen Daten des Bescheides enthalten.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283279_1532_36512" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283279_821272_36510" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1725449419651_508583_26879" name="Anonym_BauvorhabenUV" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419791_484855_26910" name="anschrift" visibility="private" type="_19_0_3_136d03d4_1611871242650_289516_23265">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_334092_26952" annotatedElement="_19_0_4_78d0259_1725449419791_484855_26910" body="&lt;para>In diesem Element ist die Anschrift des Baugrundstücks einzutragen, soweit eine solche zugewiesen ist.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp &quot;Grundstueck&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_772321_26953" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_791193_26951" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419793_602399_26911" name="bauherr" visibility="private" type="_19_0_4_78d0259_1725449419651_813262_26880">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_485159_26956" annotatedElement="_19_0_4_78d0259_1725449419793_602399_26911" body="&lt;para>In dieses Element sind die Angaben zum Bauherrn einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente ergibt sich aus dem Datentyp &quot;BauherrBauprojekt&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_872855_26957" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_962614_26955" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419793_81869_26912" name="kodierungFlurstueck" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_792698_26960" annotatedElement="_19_0_4_78d0259_1725449419793_81869_26912" body="&lt;para>Hier sind die identifzierenden Angaben zum Flurstück gemäß Systematik des regionalen Liegenschaftskatasters einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp &quot;Grundstueck&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_447927_26961" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_449132_26959" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419794_922306_26913" name="datumBaubeginn" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_722173_26964" annotatedElement="_19_0_4_78d0259_1725449419794_922306_26913" body="&lt;para>In dieses Element ist das Datum des Baubeginns einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_588582_26965" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_862519_26963" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419794_123101_26914" name="datumBaufertigstellung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_257162_26968" annotatedElement="_19_0_4_78d0259_1725449419794_123101_26914" body="&lt;para>In dieses Element ist das Datum der Baufertigstellung (bzw. Bezugsfertigstellung) einzutragen. Die Baubehörde trägt hier typischerweise das Datum der geplanten Nutzungsaufnahme ein.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_873722_26969" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_936561_26967" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419795_564869_26916" name="bruttoRauminhaltBRI" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_258602_26976" annotatedElement="_19_0_4_78d0259_1725449419795_564869_26916" body="&lt;para>Angabe des Brutto-Rauminhalts (BRI).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp &quot;FlaechenDIN277&quot; oder &quot;DatenEinzelnesGebaeudeImBauvorhaben&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_179432_26977" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_329073_26975" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419796_778717_26917" name="bauSumme" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_909560_26980" annotatedElement="_19_0_4_78d0259_1725449419796_778717_26917" body="&lt;para>Hier ist die voraussichtliche Höhe der Gesamtbaukosten (ohne Grundstück) einzutragen (Einheit: Eurocent).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Element &quot;summeHerstellungskosten&quot; des Datentyps &quot;Herstellungskosten&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_826164_26981" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_728354_26979" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1747651634098_695141_29076" name="zuvnummer" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_4_b8702dd_1747651824077_844182_29080" annotatedElement="_19_0_4_b8702dd_1747651634098_695141_29076" body="&lt;para>Hier kann die Unternehmernummer (UNR) aus dem zentralen Unternehmerverzeichnis der gesetzlichen Unfallversicherung (ZUV) eingetragen werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1747651779478_791215_29078" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1747651779479_879627_29079" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1747652350171_114201_29249" name="artDerBaumassnahme" visibility="private" type="_19_0_3_136d03d4_1611871239752_686519_22726">
                <ownedComment xmi:id="_19_0_4_b8702dd_1747652350175_644450_29250" annotatedElement="_19_0_4_b8702dd_1747652350171_114201_29249" body="&lt;para>In diesem Element ist die Art der Baumaßnahme (Abbruch, Errichtung) einzutragen. Der Inhalt ergibt sich aus dem Element &quot;artDerMaßnahme&quot; im Datentyp &quot;Gegenstand&quot; der Eingangsnachricht.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1747652365924_591015_29254" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                <ownedComment xmi:id="_19_0_4_b8702dd_1747652419762_543544_29256" annotatedElement="_19_0_4_b8702dd_1747652365924_591015_29254" body="&lt;para>Hier ist die Bezeichnung des Bauvorhabens anzugeben. Der Inhalt ergibt sich aus dem Element &quot;bezeichnungDesBauvorhabens&quot; im Datentyp &quot;Bauvorhaben&quot; der Eingangsnachricht.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1747652499588_786775_29257" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1747652499588_375364_29258" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1725449419651_813262_26880" name="Anonym_BeteiligterBauherr" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419829_382025_26947" name="natuerlichePerson" visibility="private" type="_16_5_4_940029b_1460619307903_831925_3517">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_849963_26985" annotatedElement="_19_0_4_78d0259_1725449419829_382025_26947" body="&lt;para>In dieses Element sind die Angaben zu dem Bauherrn einzutragen, wenn es sich um eine natürlichen Person handelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_601322_26986" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_68105_26984" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1725449419829_575847_26948" name="organisation" visibility="private" type="_16_5_4_8a30247_1422977426041_172815_6757">
                <ownedComment xmi:id="_19_0_4_78d0259_1725449419833_45068_26989" annotatedElement="_19_0_4_78d0259_1725449419829_575847_26948" body="In dieses Element sind die Angaben zu dem Bauherrn einzutragen, wenn es sich um eine Organisation handelt."/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1725449419833_334625_26990" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1725449419833_935774_26988" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728632584077_708869_29497" name="Anonym_BauordnungsrechtlicheKlassifikation" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_78d0259_1728632611049_452350_29498" name="artDerBaumassnahme" visibility="private" type="_19_0_3_136d03d4_1611871239752_686519_22726">
                <ownedComment xmi:id="_19_0_4_78d0259_1728633190718_138300_29511" annotatedElement="_19_0_4_78d0259_1728632611049_452350_29498" body="&lt;para>In diesem Element ist die Art der Baumaßnahme (Abbruch, Errichtung) einzutragen.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_78d0259_1728632625281_651221_29499" name="klassifikation" visibility="private" type="_19_0_3_136d03d4_1611871244701_991956_23400">
