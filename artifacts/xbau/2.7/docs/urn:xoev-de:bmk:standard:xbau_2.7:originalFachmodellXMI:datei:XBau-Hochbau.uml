              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721639026826_159349_25933" name="flurstueck" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1721639026833_416627_25945" annotatedElement="_19_0_4_b6602da_1721639026826_159349_25933" body="&lt;para>Pro Instanziierung des Elements sind Angaben zu einem Flurstück vorzunehmen, das zum Grundstück gehört. &lt;/para>"/>
