              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282195_196009_31029" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282194_28348_31027" name="" visibility="public" value="*"/>
