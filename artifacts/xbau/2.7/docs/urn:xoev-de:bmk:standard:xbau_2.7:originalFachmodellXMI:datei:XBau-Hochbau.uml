      <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239057_93285_22664" name="Nachrichten" visibility="public" URI="">
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241078_102107_23101" name="Baugenehmigung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242634_584076_23197" name="" visibility="public" client="_19_0_3_136d03d4_1611871241078_102107_23101" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246621_502972_24048" name="baugenehmigung.antrag.0200" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264364_414511_26436" annotatedElement="_19_0_3_136d03d4_1611871246621_502972_24048" body="&lt;para>Diese Nachricht stellt einen Bauantrag dar, d.h. durch das Senden dieser Nachricht an die Bauaufsichtsbehörde beantragt der Absender die Genehmigung zu dem in der Nachricht dokumentierten Bauvorhaben. Die Nachricht enthält die Daten des Bauantrags und als Anlage die dazugehörigen Bauvorlagen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264149_551224_25272" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264364_932723_26437" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282371_159084_32647" annotatedElement="_19_0_3_136d03d4_1611871264364_932723_26437" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282371_856530_32648" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282371_645955_32646" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697631734779_927884_24777" name="empfangendeStelle" visibility="private" type="_19_0_4_41901a4_1664542664473_466147_6844">
              <ownedComment xmi:id="_19_0_4_b6602da_1697631883068_860902_24785" annotatedElement="_19_0_4_b6602da_1697631734779_927884_24777" body="&lt;para>In den Fällen, in denen Antragsplattformen verwendet werden, können an dieser Stelle die technischen Infor-&#xA;mationen zur Fachbehörde angegeben werden, an die der Antrag gerichtet ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697631800893_840427_24783" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697631800894_354014_24784" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264364_840833_26438" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282372_68367_32651" annotatedElement="_19_0_3_136d03d4_1611871264364_840833_26438" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282372_987357_32652" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282372_15833_32650" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264364_657330_26439" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282372_472791_32655" annotatedElement="_19_0_3_136d03d4_1611871264364_657330_26439" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282372_162974_32656" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282372_880135_32654" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668598883667_815855_18346" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668598883670_205244_18348" annotatedElement="_19_0_3_129a03b9_1668598883667_815855_18346" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668598883671_765980_18349" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668598883669_376107_18347" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264364_64670_26440" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite" association="_19_0_3_136d03d4_1611871246622_393297_24049">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282373_822208_32659" annotatedElement="_19_0_3_136d03d4_1611871264364_64670_26440" body="&lt;para>Hier sind die Daten zum  Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282373_655580_32660" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282372_639041_32658" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264365_367196_26441" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282373_432090_32663" annotatedElement="_19_0_3_136d03d4_1611871264365_367196_26441" body="&lt;para>Hier sind Daten zu ggf. beantragten Abweichungen einzutragen, über die im Baugenehmigungsverfahren entschieden werden muss. Jede Instanz des Elements steht für eine beantragte Abweichung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282373_865580_32664" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282373_407494_32662" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264365_530528_26442" name="angefragteErleichterung" visibility="private" type="_19_0_3_136d03d4_1611871244699_209513_23391" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282373_855183_32667" annotatedElement="_19_0_3_136d03d4_1611871264365_530528_26442" body="&lt;para>Falls im Rahmen des Baugenehmigungsverfahrens über Erleichterungen entschieden werden muss, sind hier die entsprechenden Daten einzufügen. Jede Instanz des Elements steht für eine angefragte Erleichterung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282374_470335_32668" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282373_88440_32666" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264365_114032_26443" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282374_58292_32671" annotatedElement="_19_0_3_136d03d4_1611871264365_114032_26443" body="&lt;para>Falls Baulasterklärungen im Rahmen des Baugenehmigungsverfahrens gefordert sind, können hier der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben werden. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282374_246931_32672" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282374_734925_32670" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264366_965635_26444" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282374_531426_32675" annotatedElement="_19_0_3_136d03d4_1611871264366_965635_26444" body="&lt;para>Die für die Planung des Vorhabens notwendigen Bauvorlagen sind dem Antrag als Anlage&#xA;beizufügen (MBO, MBauVorlV). In diesem Element sind die nötigen Daten enthalten. Anlagen zum Bauantrag sind in erster Linie, aber nicht ausschließlich, Bauvorlagen.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282374_630978_32676" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282374_911042_32674" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752844231811_658001_31945" name="datenabruf" visibility="private" type="_19_0_4_b8702dd_1752843163624_18262_31759">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752844346181_590768_31954" annotatedElement="_19_0_4_b8702dd_1752844231811_658001_31945" body="&lt;para>In diesem Element können die Metadaten eines Datenabrufs aus einem Register angegeben werden. Das Element ist nur bei erfolgreichem Datenabruf zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752844257656_229908_31949" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752844257656_563183_31950" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871246622_393297_24049" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264364_64670_26440 _19_0_3_136d03d4_1611871264366_714211_26446">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264366_714211_26446" name="" visibility="private" type="_19_0_3_136d03d4_1611871246621_502972_24048" association="_19_0_3_136d03d4_1611871246622_393297_24049"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246622_815598_24051" name="baugenehmigung.anhoerung.0203" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264368_824523_26455" annotatedElement="_19_0_3_136d03d4_1611871246622_815598_24051" body="&lt;para>Diese Nachricht fordert den Bauherrn zur Stellungnahme auf, nachdem die materielle Prüfung des Bauantrags ergeben hat, dass Gründe vorliegen, die zu seiner Ablehnung durch die Bauaufsichtsbehörde führen können. Es sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung sind. Diese werden hier aufgelistet bzw. im Anhang der Nachricht dokumentiert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_895232_25310" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264368_432809_26456" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282378_186909_32705" annotatedElement="_19_0_3_136d03d4_1611871264368_432809_26456" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Bauantrag Bezug zu nehmen; außerdem ggf. auf die Nachricht baugenehmigung.antrag.0200, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282378_881365_32706" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282378_188138_32704" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264368_558112_26457" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282378_331837_32709" annotatedElement="_19_0_3_136d03d4_1611871264368_558112_26457" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282378_83066_32710" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282378_714915_32708" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264368_73967_26458" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282379_323986_32713" annotatedElement="_19_0_3_136d03d4_1611871264368_73967_26458" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Bauantrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282379_774560_32714" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282379_722938_32712" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264369_636559_26459" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282379_653835_32717" annotatedElement="_19_0_3_136d03d4_1611871264369_636559_26459" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282379_620320_32718" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282379_884948_32716" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264369_909344_26460" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282380_140315_32721" annotatedElement="_19_0_3_136d03d4_1611871264369_909344_26460" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282380_80767_32722" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282379_456364_32720" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264369_756381_26461" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282380_410298_32725" annotatedElement="_19_0_3_136d03d4_1611871264369_756381_26461" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;>BIM Collaboration Format (BCF)&lt;/emphasis>. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282380_944630_32726" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282380_111419_32724" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246623_546914_24052" name="baugenehmigung.bescheid.0205" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264370_697188_26463" annotatedElement="_19_0_3_136d03d4_1611871246623_546914_24052" body="&lt;para>Diese Nachricht stellt den Bescheid dar, in den die Bauaufsichtsbehörde die Ergebnisse ihrer materiellen Prüfung einträgt. Der Bauantrag ist entweder genehmigt, genehmigt mit Nebenbestimmungen&#xA;(zum Beispiel unter Auflagen) oder abgelehnt. Das Absenden dieser Nachricht stellt das Erteilen des Bescheids dar.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264156_106388_25340" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264370_181386_26464" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282381_769749_32730" annotatedElement="_19_0_3_136d03d4_1611871264370_181386_26464" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht baugenehmigung.antrag.0200 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282381_782474_32731" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282380_781809_32729" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264370_884096_26465" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282381_902295_32734" annotatedElement="_19_0_3_136d03d4_1611871264370_884096_26465" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&lt;para>Ein Bescheid mit positivem Tenor kann zugelassene oder auch nicht zugelassene Abweichungen (Element abweichung) enthalten. Ein Bescheid mit negativem Tenor kann nur nicht zugelassene Abweichungen enthalten.&lt;/para>&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282381_803313_32735" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282381_719684_32733" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264370_991866_26466" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282381_925010_32738" annotatedElement="_19_0_3_136d03d4_1611871264370_991866_26466" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282382_256656_32739" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282381_486512_32737" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246623_62172_24054" name="baugenehmigung.antragGeaendert.0202" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264372_195966_26473" annotatedElement="_19_0_3_136d03d4_1611871246623_62172_24054" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Bauantrags bzw. geänderte oder ergänzte Bauvorlagen. Sie bezieht sich auf einen bereits gestellten Bauantrag, zu dem noch kein Bescheid erteilt wurde.&lt;/para>&#xA;&lt;para>Entweder  ist sie eine Reaktion auf eine zum Bauantrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_738905_25319" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264372_207656_26474" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282384_240890_32756" annotatedElement="_19_0_3_136d03d4_1611871264372_207656_26474" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang (oder den Antrag) und ggf. auf eine Nachricht prozessnachrichten.formellePruefungBefundliste.1140, auf die die vorliegende Nachrichteninstanz eine Reaktion ist, Bezug zu nehmen. &lt;/para>&#xA;&#xA;&lt;para>Falls mit der Nachricht initiativ eine geänderte Planung eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282384_225378_32757" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282383_879908_32755" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264372_870533_26475" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282384_905150_32760" annotatedElement="_19_0_3_136d03d4_1611871264372_870533_26475" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282384_750612_32761" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282384_768382_32759" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264372_411077_26476" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282384_549606_32764" annotatedElement="_19_0_3_136d03d4_1611871264372_411077_26476" body="&lt;para>Hier sind ggf. korrigierte oder ergänzte Daten zu der beantragten Abweichung eingefügt. Jede Instanz des Elements steht für eine beantragte Abweichung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282384_932367_32765" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282384_378665_32763" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264372_138273_26477" name="angefragteErleichterung" visibility="private" type="_19_0_3_136d03d4_1611871244699_209513_23391" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282385_216918_32768" annotatedElement="_19_0_3_136d03d4_1611871264372_138273_26477" body="&lt;para>Hier sind die ggf. korrigierte oder ergänzte Daten zu der beantragten Erleichterung eingefügt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282385_91534_32769" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282385_989335_32767" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264373_51257_26478" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282385_16550_32772" annotatedElement="_19_0_3_136d03d4_1611871264373_51257_26478" body="&lt;para>Ggf. sind in diesem Element korrigierte oder ergänzte Daten zum Bauvorhaben (Wer, Was, Wo) zu übermitteln. Daten, die an dieser Stelle eingetragen sind, sollen die aufgeführten Mängel beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;&lt;para>Dabei wird nicht informiert, welche Daten gestrichen, geändert oder ergänzt wurden. Der Datenempfänger wird das also eigenständig ermitteln, soweit auf seiner Seite notwendig. Auch ein Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der zur Änderung oder Ergänzung führte, ist nicht in der Nachricht enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282385_509481_32773" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282385_472683_32771" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264373_644453_26479" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282386_862732_32776" annotatedElement="_19_0_3_136d03d4_1611871264373_644453_26479" body="&lt;para>In diesem Element werden geänderte oder ergänzte Baulasterklärungen übermittelt. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282386_283742_32777" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282386_605804_32775" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264373_576343_26480" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282386_709028_32780" annotatedElement="_19_0_3_136d03d4_1611871264373_576343_26480" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;&lt;para>Falls  der Antragsteller initiativ mit der Nachricht eine modifizierte  Planung einreicht, muss unter den Anlagen (je nach Landesbauordnung) ggf. eine Übereinstimmungserklärung enthalten sein. Außerdem muss unter den Anlagen eine Begründung bzw. Erläuterung zur eingereichten geänderten Planung enthalten sein. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282386_638368_32781" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282386_370989_32779" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246624_669819_24055" name="baugenehmigung.stellungnahme.0204" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264374_573319_26482" annotatedElement="_19_0_3_136d03d4_1611871246624_669819_24055" body="&lt;para>Diese Nachricht bezieht sich auf einen bereits gestellten Bauantrag und auf eine zu diesem&#xA;vorliegende Anhörungsnachricht. Sie enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Bauvorhabens bzw. des Bauantrags, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_971427_25316" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264374_553309_26483" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282387_698471_32785" annotatedElement="_19_0_3_136d03d4_1611871264374_553309_26483" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Bauantrag Bezug zu nehmen und außerdem auf die Nachricht baugenehmigung.anhoerung.0203, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282387_918795_32786" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282387_828855_32784" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264374_77981_26484" name="stellungnahmeBelastenderVerwaltungsakt" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282387_848887_32789" annotatedElement="_19_0_3_136d03d4_1611871264374_77981_26484" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282387_495513_32790" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282387_887593_32788" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264374_840890_26485" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282388_188440_32793" annotatedElement="_19_0_3_136d03d4_1611871264374_840890_26485" body="&lt;para>Ggf. sind hier geänderte oder ergänzte Daten zum Bauvorhaben enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282388_414142_32794" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282387_779459_32792" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264374_270460_26486" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282388_264186_32797" annotatedElement="_19_0_3_136d03d4_1611871264374_270460_26486" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282388_229878_32798" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282388_461107_32796" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761078674_80549_16842" name="" visibility="public" client="_19_0_3_136d03d4_1611871241078_102107_23101" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1697632421291_263534_24786" name="" visibility="public" client="_19_0_3_136d03d4_1611871241078_102107_23101" supplier="_19_0_4_41901a4_1664542664473_505718_6837"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1699007221174_641899_24658" name="" visibility="public" client="_19_0_3_136d03d4_1611871241078_102107_23101" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241079_350322_23102" name="Beteiligung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242634_598188_23198" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_350322_23102" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246624_97012_24057" name="beteiligung.aufforderung.0300" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264375_394434_26489" annotatedElement="_19_0_3_136d03d4_1611871246624_97012_24057" body="&lt;para>Diese Nachricht enthält die Aufforderung der Bauaufsichtsbehörde zur Stellungnahme unter Angabe von Grund bzw. Anlass der Beteiligung. In der Anlage sind alle Unterlagen aus dem Antragsverfahren enthalten, die die adressierte Stelle braucht, um der Aufforderung zur Beteiligung nachzukommen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264152_677592_25298" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264375_201992_26490" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282389_767894_32803" annotatedElement="_19_0_3_136d03d4_1611871264375_201992_26490" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang der Bauaufsichtsbehörde zum Bauantrag Bezug zu nehmen. &lt;/para>&#xA;&lt;para>Eine Referenz auf eine Nachricht ist hier i.d.R. nicht einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282389_808571_32804" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282389_110651_32802" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697630339318_82639_24738" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1697630339329_50589_24740" annotatedElement="_19_0_4_b6602da_1697630339318_82639_24738" body="&lt;para>Eine vom Aufforderungsservice mit dieser Nachricht vergebene eindeutige Kennung des Aufforderungsvorgangs. Sofern die aufgeforderte Stelle auf die Aufforderung reagiert, muss sie sich in ihren Reaktionsnachrichten auf diese Kennung beziehen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697630339329_189024_24741" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697630339328_804748_24739" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697613890090_859409_24743" name="zuBeteiligendeStelle" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
              <ownedComment xmi:id="_19_0_4_b6602da_1697613967664_176698_24753" annotatedElement="_19_0_4_b6602da_1697613890090_859409_24743" body="&lt;para>Die Information in diesem Element wird in den Fällen benötigt, wo die Nachrichteninstanz an eine Plattform geht, in der eine Vielzahl von Stellen einen Account haben. Die Stelle, für die die Nachrichteninstanz gedacht ist, muss im vorliegenden Element technisch eindeutig bezeichnet werden (z.B. durch die ID eines Unternehmenskontos oder eine Mail-Adresse), so dass die Plattform die Nachricht entsprechend zuordnen und zustellen kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697613947700_136195_24751" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697613947701_215502_24752" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264375_468025_26491" name="anliegenBeteiligung" visibility="private" type="_19_0_3_136d03d4_1611871246523_190173_23499" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282389_628219_32807" annotatedElement="_19_0_3_136d03d4_1611871264375_468025_26491" body="&lt;para>Hier wird der Grund bzw. das Anliegen der Beteiligung genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282389_876819_32808" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282389_692826_32806" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264376_751292_26492" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282390_58174_32811" annotatedElement="_19_0_3_136d03d4_1611871264376_751292_26492" body="&lt;para>Hier werden die Daten des Bauantrags übermittelt, soweit für die adressierte Behörde von Relevanz für die Erstellung ihrer Stellungnahme.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282390_221609_32812" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282390_195590_32810" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264376_739559_26493" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282390_598937_32815" annotatedElement="_19_0_3_136d03d4_1611871264376_739559_26493" body="&lt;para>Es sind ggf. Dokumente zum geplanten Bauvorhaben anzulegen (Alternativ Verweise auf solche Dokumente), soweit von der adressierten Behörde benötigt für die Stellungnahme zu den Fragen, die ihr vorgelegt worden sind. &lt;/para>&#xA;&lt;para>Es muss sich nicht um dieselben Unterlagen handeln, die dem Bauantrag beilagen, sondern es können Bauvorlagen ggf. aufbereitet oder ergänzt worden sein, z.B. beim Raumbezug von Baugrundstücken, denen noch keine Adresse zugeordnet ist oder war.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282390_908685_32816" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282390_14737_32814" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264376_552951_26494" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282391_218101_32819" annotatedElement="_19_0_3_136d03d4_1611871264376_552951_26494" body="&lt;para>Dies ist die durch die Bauaufsichtsbehörde gesetzte Frist, innerhalb derer die Stellungnahme durch die adressierte Stelle vorliegen muss, so dass sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282391_471535_32820" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282391_822271_32818" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264376_560679_26495" name="rechtsfolgeFristversaeumnis" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282391_125782_32823" annotatedElement="_19_0_3_136d03d4_1611871264376_560679_26495" body="&lt;para>Hier werden gemäß geltendem Recht Angaben zu den Konsequenzen bei Fristversäumnis eingetragen (Zustimmung durch Untätigkeit).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282391_517859_32824" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282391_535118_32822" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785313133331_40819_34813" name="verfahrensart" visibility="private" type="_19_0_3_136d03d4_1611871239791_257404_22869">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785313317959_827369_34833" annotatedElement="_19_0_4_b8702dd_1785313133331_40819_34813" body="&lt;para>In diesem Element ist anzugeben, in welcher Art von Verfahren die Beteiligung erfolgt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785313143741_834201_34816" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785313143741_972742_34817" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246624_522173_24058" name="beteiligung.aufforderungKorrektur.0302" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264377_831105_26497" annotatedElement="_19_0_3_136d03d4_1611871246624_522173_24058" body="&lt;para>Die Bauaufsichtsbehörde hat Korrekturen und Ergänzungen der Unterlagen vom Bauherrn erhalten und versendet mittels dieser Nachricht die überarbeiteten Unterlagen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_164408_25332" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264377_884091_26498" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282392_254895_32828" annotatedElement="_19_0_3_136d03d4_1611871264377_884091_26498" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang der Bauaufsichtsbehörde Bezug zu nehmen; außerdem auf die Nachricht 0301, auf die die vorliegende Nachricht antwortet.&lt;/para>&#xA;&lt;para>Falls die Nachricht aufgrund einer geänderten Planung ohne vorhergehende Nachricht 0301 eingereicht wird, ist der Bezug auf eine solche Nachricht nicht enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282392_891882_32829" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282392_675116_32827" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697631203944_578700_24747" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1697631203965_868250_24749" annotatedElement="_19_0_4_b6602da_1697631203944_578700_24747" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Die aufgeforderte Stelle bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697631203965_992448_24750" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697631203962_74248_24748" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1697631208918_78374_24754" name="zuBeteiligendeStelle" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_4_b6602da_1697631208921_422367_24756" annotatedElement="_19_0_4_b6602da_1697631208918_78374_24754" body="&lt;para>In den Fällen, in denen Beteiligungsplattformen verwendet werden, sollte an dieser Stelle, die Bezeichnung der zu beteiligenden Dienststelle angegeben werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1697631208921_262376_24757" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1697631208921_913983_24755" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264377_58800_26499" name="anliegenBeteiligung" visibility="private" type="_19_0_3_136d03d4_1611871246523_190173_23499" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282392_900898_32832" annotatedElement="_19_0_3_136d03d4_1611871264377_58800_26499" body="&lt;para>Der Grund bzw. das Anliegen der Beteiligung wird in diesem Objekt reformuliert, insoweit Mängel korrigiert werden mussten, die in der Befundliste der Nachricht 0301 aufgeführten waren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282392_47833_32833" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282392_668727_32831" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264377_680985_26500" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282393_521393_32836" annotatedElement="_19_0_3_136d03d4_1611871264377_680985_26500" body="&lt;para>Hier sind korrigierte und ggf. ergänzte Daten zum Bauantrag enthalten. Die Daten, die an dieser Stelle eingetragen sind, sollen die in der Befundliste der Nachricht 0301 aufgeführten Mängel beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz übermittelt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282393_977873_32837" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282392_612440_32835" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264378_471690_26501" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282393_431335_32840" annotatedElement="_19_0_3_136d03d4_1611871264378_471690_26501" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten. Es wird damit auf in der Befundliste der Nachricht 0301 aufgeführten Mängel reagiert.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282393_54835_32841" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282393_458510_32839" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264378_664833_26502" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282393_938114_32844" annotatedElement="_19_0_3_136d03d4_1611871264378_664833_26502" body="&lt;para>Dies ist die aktualisierte durch die Bauaufsichtsbehörde gesetzte Frist, innerhalb derer die Stellungnahme durch die adressierte Stelle vorliegen muss, so dass sie berücksichtigt werden kann.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282394_796467_32845" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282393_162873_32843" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264378_337255_26503" name="rechtsfolgeFristversaeumnis" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282394_865379_32848" annotatedElement="_19_0_3_136d03d4_1611871264378_337255_26503" body="&lt;para>Hier werden gemäß geltendem Recht Angaben zu den Konsequenzen bei Fristversäumnis eingetragen (Zustimmung durch Untätigkeit).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282394_38185_32849" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282394_944364_32847" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785313398809_87951_34842" name="verfahrensart" visibility="private" type="_19_0_3_136d03d4_1611871239791_257404_22869">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785313398809_895871_34844" annotatedElement="_19_0_4_b8702dd_1785313398809_87951_34842" body="&lt;para>In diesem Element ist die ggf. korrigierte Art des Verfahrens anzugeben, in welchem die Beteiligung erfolgt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785313398809_913145_34845" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785313398809_876600_34843" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246625_482704_24059" name="beteiligung.formellePruefung.0301" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264379_314324_26505" annotatedElement="_19_0_3_136d03d4_1611871246625_482704_24059" body="&lt;para>Diese Nachricht adressiert die beteiligte Behörde an die Bauaufsichtsbehörde. Sie enthält die Ergebnisse der formellen Prüfung der vorliegenden Aufforderung zur Stellungnahme.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264156_775685_25336" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264379_436099_26506" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282394_116214_32853" annotatedElement="_19_0_3_136d03d4_1611871264379_436099_26506" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang der adressierten Bauaufsichtsbehörde Bezug zu nehmen; außerdem auf die Nachricht 0300, auf die die vorliegende Nachricht antwortet. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282395_743897_32854" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282394_993936_32852" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1699001216712_975330_24644" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1699001216722_375383_24646" annotatedElement="_19_0_4_b6602da_1699001216712_975330_24644" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Die aufgeforderte Stelle  bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1699001216723_422635_24647" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1699001216719_487864_24645" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264379_337866_26507" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282395_88227_32857" annotatedElement="_19_0_3_136d03d4_1611871264379_337866_26507" body="&lt;para>Hier sind die Ergebnisse der formellen Prüfung der Anfrage enthalten. Es handelt sich um Listen ggf. vorliegender Mängel der Anfrage bzw. der anliegenden Dokumentation (Nachricht 0300).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282395_603600_32858" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282395_283522_32856" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1728305672288_981976_29228" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1728305672314_148839_29230" annotatedElement="_19_0_4_b6602da_1728305672288_981976_29228" body="&lt;para>Falls die Behörde der Nachricht Anlagen beifügen möchte, ist dieses Element zu verwenden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1728305672316_951452_29231" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1728305672310_12900_29229" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246625_369894_24060" name="beteiligung.stellungnahme.0303" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264379_715504_26509" annotatedElement="_19_0_3_136d03d4_1611871246625_369894_24060" body="&lt;para>Diese Nachricht verwendet die beteiligte Behörde, um der  Bauaufsichtsbehörde ihre Stellungnahme zuzustellen. &#xA;&lt;/para>&#xA;&lt;para>&#xA;In der Regel wird die Gemeinde von der Bauaufsichtsbehörde zur Stellungnahme aufgerufen und antwortet daraufhin mit dieser Nachricht.&#xA;Die Gemeinde kann aber auch initiativ, d.h. unaufgefordert eine Stellungnahme einreichen, wenn sie eine Information über den eingereichten Bauantrag erhält.&#xA;&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264156_87243_25337" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264379_482242_26510" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282396_651133_32862" annotatedElement="_19_0_3_136d03d4_1611871264379_482242_26510" body="&lt;para>In diesem Element werden Eintragungen vorgenommen, die den Zusammenhang zum laufenden Vorgang der adressierten Bauaufsichtsbehörde herstellen. Außerdem wird Bezug genommen auf die entsprechende Nachricht, auf die mit der vorliegenden Nachricht geantwortet wird. &#xA;&lt;/para>&#xA;&lt;para>&#xA;Dabei kann es sich um die Beteiligungsaufforderung (Nachricht 0300), die angepasste Beteiligungsaufforderung (Nachricht 0302) oder bei einer initiativ von der Gemeinde eingereichten Stellungnahme um den Bauantrag (Nachricht 0200) handeln.&#xA;&lt;/para>&#xA;&lt;para>&#xA;Bei initiativen Stellungnahmen wird im Unterelement &quot;referenz&quot; die Antrags-UUID aus Nachricht 0200 angegeben, das Unterelement &quot;bezugnachricht&quot; wird nicht befüllt, das Unterelement &quot;vorgang&quot; muss nicht befüllt werden, da die Vorgangsnummer der Bauaufsichtsbehörde der Gemeinde gegebenenfalls nicht bekannt ist.&#xA;&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282396_308044_32863" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282395_191479_32861" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1699002717006_191279_24731" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1699002717008_968411_24733" annotatedElement="_19_0_4_b6602da_1699002717006_191279_24731" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Die aufgeforderte Stelle bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1699002717008_685730_24734" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1699002717008_118464_24732" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264380_927758_26511" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871246524_449877_23500" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282396_678801_32866" annotatedElement="_19_0_3_136d03d4_1611871264380_927758_26511" body="&lt;para>Unterhalb dieses Elements ist die Stellungnahme eingefügt, die aus der materiellen Prüfung durch die beteiligte Behörde hervorgegangen ist. Die Stellungnahme wird in der Nachricht in einer von zwei alternativen Formaten übermittelt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282396_694492_32867" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282396_192505_32865" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761197322_315691_16850" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_350322_23102" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1658324258049_356155_18208" name="beteiligung.ruecknahme.0304" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1658324258052_44372_18209" annotatedElement="_19_0_3_129a03b9_1658324258049_356155_18208" body="&lt;para>Diese Nachricht kann durch die Bauaufsichtsbehörde verwendet werden, um eine in der Vergangenheit gestellte Aufforderung zur Stellungnahme bzw. Beteiligung zurückzuziehen.&lt;/para>&#xA;&lt;para>Wenn der Kommunikationskanal offen bleiben soll, dann muss für den Abbruch einer Beteiligung statt dieser Nachricht die Nachricht beteiligung.zwischennachricht.0305 genutzt werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_78d0259_1727867031630_154946_28984" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658324258053_377202_18210" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658324258061_126927_18216" annotatedElement="_19_0_3_129a03b9_1658324258053_377202_18210" body="&lt;para>In dieses Element sind die Referenzen von Antragsteller und ggf. Behörde einzutragen.&lt;/para>&#xA;&#xA;&lt;para>Eine Referenzierung auf eine Nachricht wird in diese Nachricht nicht eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658324258062_927729_18217" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658324258061_376254_18215" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1699002833166_578280_24809" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1699002833167_784315_24811" annotatedElement="_19_0_4_b6602da_1699002833166_578280_24809" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1699002833167_978884_24812" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1699002833167_860383_24810" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658324258054_328596_18211" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658324258063_885159_18220" annotatedElement="_19_0_3_129a03b9_1658324258054_328596_18211" body="&lt;para>Hier kann optional durch die Bauaufsichtsbehörde eine Begründung  eingetragen werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658324258063_612644_18221" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658324258063_566226_18219" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1658324258057_779521_18212" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_129a03b9_1658324258064_588424_18224" annotatedElement="_19_0_3_129a03b9_1658324258057_779521_18212" body="&lt;para>Ggf. will die Bauaufsichtsbehörde der Rücknahme der Aufforderung ein Schreiben beilegen. Das lässt sich mit diesem Element abbilden.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1658324258064_801535_18225" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1658324258064_761234_18223" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1691564863802_385519_22572" name="beteiligung.zwischennachricht.0305" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1691564863958_97614_22602" annotatedElement="_19_0_4_b8702dd_1691564863802_385519_22572" body="&lt;para>Diese Nachricht ermöglicht einerseits der beteiligten Behörde, der Bauaufsichtsbehörde eine Zwischennachricht zukommen zu lassen. Dabei kann es sich beispielsweise um eine Bitte um Fristverlängerung oder um einen Hinweis auf ein laufendes immissionsschutzrechtliches Verfahren handeln. Ebenso können fachliche Nachfragen, Benachrichtigungen über eigene Tätigkeiten im Zusammenhang mit dem Baugenehmigungsverfahren oder die Organisation der Mitwirkung bei Abnahmen durchgeführt werden.&lt;/para>&#xA;&lt;para>Andererseits kann auch die Bauaufsicht der beteiligten Stelle Nachrichten übermitteln, zum Beispiel die Meldung der Erreichung eines Bauzustands, der Tätigkeiten der beteiligten Stelle auslöst, oder Informationen zur Mitwirkung bei Abnahmen. Die Nachricht kann auch zum Setzen einer neuen Frist für die Stellungnahme verwendet werden oder zur Mitteilung des Abbruchs der Beteiligung (z.B. bei Eintritt der Zustimmungsfiktion).&lt;/para>&#xA;&lt;para>Wenn der Kommunikationskanal nach Abbruch der Beteiligung geschlossen werden soll, dann muss statt dieser Nachricht die Nachricht beteiligung.ruecknahme.0304 genutzt werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b8702dd_1691564863971_210527_22609" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691564863959_397406_22603" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691564863977_388557_22613" annotatedElement="_19_0_4_b8702dd_1691564863959_397406_22603" body="&lt;para>In diesem Element werden Eintragungen vorgenommen, die den Zusammenhang zum laufenden Vorgang der adressierten Bauaufsichtsbehörde herstellen. Außerdem wird Bezug genommen auf die entsprechende Nachricht 0300 oder 0302, auf die mit der vorliegenden Nachricht geantwortet wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691564863979_648578_22614" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691564863975_690088_22612" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1699002834783_145987_24816" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1699002834784_48247_24818" annotatedElement="_19_0_4_b6602da_1699002834783_145987_24816" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Die aufgeforderte Stelle  bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1699002834784_452114_24819" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1699002834784_219778_24817" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691564863962_92513_22604" name="anliegenZwischennachricht" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691564863982_376167_22617" annotatedElement="_19_0_4_b8702dd_1691564863962_92513_22604" body="&lt;para>Hier wird der Grund bzw. das Anliegen der Zwischennachricht genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691564863983_385555_22618" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691564863982_531417_22616" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1775569062674_857621_30782" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1775569062682_143812_30784" annotatedElement="_19_0_4_b8702dd_1775569062674_857621_30782" body="&lt;para>Sollte die adressierte Stelle nicht innerhalb der gesetzten Frist die Stellungnahme vorgelegt haben, kann in diesem Element eine neue Frist gesetzt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1775569062684_319658_30785" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1775569062680_272829_30783" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691564863966_577849_22606" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691564863986_679114_22625" annotatedElement="_19_0_4_b8702dd_1691564863966_577849_22606" body="&lt;para>Es sind ggf. Dokumente anzulegen (Alternativ Verweise auf solche Dokumente), die mit der Zwischennachricht in Zusammenhang stehen.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691564863986_982786_22626" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691564863985_344044_22624" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1691566004063_655551_22731" name="beteiligung.reaktionZwischennachricht.0306" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1691566004119_458168_22761" annotatedElement="_19_0_4_b8702dd_1691566004063_655551_22731" body="&lt;para>Diese Nachricht kann die Bauaufsichtsbehörde verwenden, um auf die Zwischennachricht der beteiligten Behörde zu reagieren. Es kann zum Beispiel eine neue Frist für die Stellungnahme mitgeteilt werden.&lt;/para>&#xA;&lt;para>Entsprechend kann auch die beteiligte Stelle auf Zwischennachrichten der Bauaufsichtsbehörde reagieren.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b8702dd_1691566004122_690198_22768" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691566004119_75253_22762" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691566004123_262895_22772" annotatedElement="_19_0_4_b8702dd_1691566004119_75253_22762" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf die Zwischennachricht 0305, auf die reagiert wird, Bezug zu nehmen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691566004123_366467_22773" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691566004123_520421_22771" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1699002836036_593262_24823" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_4_b6602da_1699002836036_205255_24825" annotatedElement="_19_0_4_b6602da_1699002836036_593262_24823" body="&lt;para>Eine vom Aufforderungsservice vergebene eindeutige Kennung des Aufforderungsvorgangs. Sofern die aufgeforderte Stelle auf die Zwischennachricht reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1699002836036_395244_24826" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1699002836036_26158_24824" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691566004120_925720_22763" name="reaktionZwischennachricht" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691566004124_468265_22776" annotatedElement="_19_0_4_b8702dd_1691566004120_925720_22763" body="&lt;para>Hier wird die Antwort der Bauaufsichtsbehörde auf die Zwischennachricht eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691566004124_248217_22777" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691566004124_852336_22775" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691566004121_44593_22765" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691566004127_252109_22784" annotatedElement="_19_0_4_b8702dd_1691566004121_44593_22765" body="&lt;para>Es sind ggf. Dokumente anzulegen (Alternativ Verweise auf solche Dokumente), die mit der Reaktion auf die Zwischennachricht in Zusammenhang stehen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691566004127_486753_22785" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691566004127_782293_22783" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691566004121_406529_22766" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691566004128_729674_22788" annotatedElement="_19_0_4_b8702dd_1691566004121_406529_22766" body="&lt;para>Dies ist die durch die Bauaufsichtsbehörde ggf. gesetzte Frist, innerhalb derer die Stellungnahme durch die adressierte Stelle vorliegen muss, so dass sie berücksichtigt werden kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691566004128_559942_22789" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691566004128_819657_22787" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1691566004121_79759_22767" name="rechtsfolgeFristversaeumnis" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1691566004129_314985_22792" annotatedElement="_19_0_4_b8702dd_1691566004121_79759_22767" body="&lt;para>Ggf. können hier gemäß geltendem Recht Angaben zu den Konsequenzen bei Fristversäumnis eingetragen werden (Zustimmung durch Untätigkeit).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1691566004129_992926_22793" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1691566004129_752364_22791" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1697615981745_648613_24778" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_350322_23102" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1699002483938_785291_24729" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_350322_23102" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241079_65679_23103" name="Vorbescheid" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_501917_23201" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_65679_23103" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247062_568343_24083" name="vorbescheid.antrag.0210" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264382_387902_26515" annotatedElement="_19_0_3_136d03d4_1611871247062_568343_24083" body="&lt;para>Durch das Senden dieser Nachricht an die Bauaufsichtsbehörde beantragt der Absender einen Vorbescheid zu den in der Nachricht dokumentierten Fragen zum Bauvorhaben.&lt;/para>&#xA;&lt;para>Die Nachricht enthält die Daten des Vorbescheidantrags, die auf diese Fragen fokussieren. Außerdem sind Bauvorlagen enthalten, soweit solche für die Bewertung des Anliegens erforderlich sind.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264152_614838_25297" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264382_351572_26516" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282397_592222_32875" annotatedElement="_19_0_3_136d03d4_1611871264382_351572_26516" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282397_720630_32876" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282397_813067_32874" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264382_280276_26517" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282398_882786_32879" annotatedElement="_19_0_3_136d03d4_1611871264382_280276_26517" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282398_381271_32880" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282397_803623_32878" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264383_484769_26518" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282398_584936_32883" annotatedElement="_19_0_3_136d03d4_1611871264383_484769_26518" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282398_491329_32884" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282398_202687_32882" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264383_910275_26519" name="beantragterVorbescheid" visibility="private" type="_19_0_3_136d03d4_1611871244699_341220_23390">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282398_374741_32887" annotatedElement="_19_0_3_136d03d4_1611871264383_910275_26519" body="&lt;para>Jedes Element steht für eine Fragestellung, die im Rahmen eines Vorbescheids durch die Bauaufsichtsbehörde beantwortet werden soll.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282399_21152_32888" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282398_254250_32886" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264383_370424_26520" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282399_466638_32891" annotatedElement="_19_0_3_136d03d4_1611871264383_370424_26520" body="&lt;para>Hier sind die Daten zum  Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282399_133067_32892" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282399_694544_32890" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264383_594273_26521" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282399_69812_32895" annotatedElement="_19_0_3_136d03d4_1611871264383_594273_26521" body="&lt;para>Falls Baulasterklärungen im Rahmen des vorliegenden Verfahrens gefordert sind, können hier der Zweck der angestrebten Baulast sowie der zu regelnde Sachverhalt beschrieben werden. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282399_123277_32896" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282399_104491_32894" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264384_198885_26522" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282400_835283_32899" annotatedElement="_19_0_3_136d03d4_1611871264384_198885_26522" body="&lt;para>Hier sind die Anlagen zum Antrag  bzw. Verweise auf diese Anlagen enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282400_601508_32900" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282400_610364_32898" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668599075877_39115_18381" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668599075878_754559_18383" annotatedElement="_19_0_3_129a03b9_1668599075877_39115_18381" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668599075878_309706_18384" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668599075878_151791_18382" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247063_14589_24084" name="vorbescheid.anhoerung.0213" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264384_217493_26524" annotatedElement="_19_0_3_136d03d4_1611871247063_14589_24084" body="&lt;para>In dieser  Nachricht sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung waren. Diese werden hier aufgelistet bzw. erläutert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264157_548938_25343" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264384_425644_26525" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282400_940187_32904" annotatedElement="_19_0_3_136d03d4_1611871264384_425644_26525" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen; außerdem ggf. auf die Nachricht 0210, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282400_375921_32905" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282400_101599_32903" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264384_706937_26526" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282401_158693_32908" annotatedElement="_19_0_3_136d03d4_1611871264384_706937_26526" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282401_865814_32909" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282401_29240_32907" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264385_864755_26527" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282401_573297_32912" annotatedElement="_19_0_3_136d03d4_1611871264385_864755_26527" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Bauantrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282401_520311_32913" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282401_777344_32911" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264385_339373_26528" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282402_739660_32916" annotatedElement="_19_0_3_136d03d4_1611871264385_339373_26528" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282402_11859_32917" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282402_721056_32915" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264385_279729_26529" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282402_442329_32920" annotatedElement="_19_0_3_136d03d4_1611871264385_279729_26529" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282402_851434_32921" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282402_333828_32919" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264385_572741_26530" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282403_744426_32924" annotatedElement="_19_0_3_136d03d4_1611871264385_572741_26530" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;>BIM Collaboration Format (BCF)&lt;/emphasis>. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282403_15873_32925" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282402_766156_32923" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247063_9056_24085" name="vorbescheid.antragGeaendert.0212" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264386_554132_26532" annotatedElement="_19_0_3_136d03d4_1611871247063_9056_24085" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Vorbescheidantrags bzw. geänderte oder ergänzte Bauvorlagen. Sie bezieht sich also auf einen bereits gestellten Vorbescheidantrag .&lt;/para>&#xA;&lt;para>Entweder  ist sie eine Reaktion auf eine zum Bauantrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_189691_25327" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264386_351382_26533" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282403_189927_32929" annotatedElement="_19_0_3_136d03d4_1611871264386_351382_26533" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang (oder den Antrag) und auf eine Nachricht 1140, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para>&#xA;&lt;para>Falls die vorliegende Nachrichteninstanz eine geänderte Planung initiativ einreicht, ist der Bezug auf eine solche Nachricht nicht enthalten. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282403_388697_32930" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282403_400808_32928" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264386_995423_26534" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282404_28092_32933" annotatedElement="_19_0_3_136d03d4_1611871264386_995423_26534" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282404_555499_32934" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282403_259220_32932" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264386_839608_26535" name="beantragterVorbescheid" visibility="private" type="_19_0_3_136d03d4_1611871244699_341220_23390">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282404_357873_32937" annotatedElement="_19_0_3_136d03d4_1611871264386_839608_26535" body="&lt;para>Hier sind die ggf. angepassten Fragen zum Vorbescheid formuliert. Jedes Element steht für eine Fragestellung, die im Rahmen eines Vorbescheids durch die Bauaufsichtsbehörde beantwortet werden soll.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282404_929479_32938" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282404_626524_32936" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264387_882019_26536" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282404_44000_32941" annotatedElement="_19_0_3_136d03d4_1611871264387_882019_26536" body="&lt;para>Ggf. sind in diesem Element korrigierte oder ergänzte Daten zum Bauvorhaben (Wer, Was, Wo)  zu übermitteln. Daten, die an dieser Stelle eingetragen sind, sollen die aufgeführten Mängel im Antragsumfang beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282405_883896_32942" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282404_960893_32940" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264387_66594_26537" name="baulast" visibility="private" type="_19_0_3_136d03d4_1611871246524_125172_23503" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282405_312214_32945" annotatedElement="_19_0_3_136d03d4_1611871264387_66594_26537" body="&lt;para>In diesem Element werden geänderte oder ergänzte Baulasterklärungen übermittelt. Ein passendes Dokument Baulasterklärung muss sich dann unter den Anlagen dieser Nachricht finden. Jede Instanz des Elements steht für eine erklärte Baulast.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282405_855572_32946" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282405_665853_32944" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264387_431500_26538" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282405_691578_32949" annotatedElement="_19_0_3_136d03d4_1611871264387_431500_26538" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;&lt;para>Falls die Nachrichteninstanz eine modifizierte Planung aus Gründen des Antragstellers im laufenden Verfahren einbringt, muss unter den Anlagen (je nach Landesbauordnung) ggf. eine Übereinstimmungserklärung enthalten sein. Außerdem muss unter den Anlagen eine Begründung bzw. Erläuterung zur eingereichten geänderten Planung enthalten sein. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282405_297769_32950" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282405_208393_32948" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247063_848867_24086" name="vorbescheid.bescheid.0215" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264388_949698_26540" annotatedElement="_19_0_3_136d03d4_1611871247063_848867_24086" body="&lt;para>In dieser Nachricht sind die Inhalte des erteilten Bescheids enthalten. Das Senden dieser Nachricht stellt das Erteilen des Vorbescheids dar.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264152_273530_25301" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264388_49058_26541" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282406_531511_32954" annotatedElement="_19_0_3_136d03d4_1611871264388_49058_26541" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht 0210 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282406_900002_32955" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282406_375890_32953" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264388_669640_26542" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282406_407496_32958" annotatedElement="_19_0_3_136d03d4_1611871264388_669640_26542" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282406_874092_32959" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282406_727613_32957" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264388_829596_26543" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282407_621392_32962" annotatedElement="_19_0_3_136d03d4_1611871264388_829596_26543" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282407_483547_32963" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282407_851843_32961" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247064_296994_24089" name="vorbescheid.stellungnahme.0214" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264392_635098_26558" annotatedElement="_19_0_3_136d03d4_1611871247064_296994_24089" body="&lt;para>Diese Nachricht enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Vorbescheidantrags, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264149_63676_25273" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264392_989777_26560" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282412_21429_33009" annotatedElement="_19_0_3_136d03d4_1611871264392_989777_26560" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen und außerdem auf die Nachricht 0213, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282412_332108_33010" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282412_774521_33008" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264392_793414_26559" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282412_950852_33005" annotatedElement="_19_0_3_136d03d4_1611871264392_793414_26559" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282412_907780_33006" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282412_186934_33004" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264392_985250_26561" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282413_501888_33013" annotatedElement="_19_0_3_136d03d4_1611871264392_985250_26561" body="&lt;para>Ggf. sind hier geänderte oder ergänzte Daten zum Bauvorhaben enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282413_405001_33014" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282413_627098_33012" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264393_482383_26562" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282413_499271_33017" annotatedElement="_19_0_3_136d03d4_1611871264393_482383_26562" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282413_334652_33018" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282413_118544_33016" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761437503_789715_16862" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_65679_23103" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241079_525772_23104" name="Abweichung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_886627_23200" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_525772_23104" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247065_137519_24091" name="abweichung.antrag.0220" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264393_724243_26565" annotatedElement="_19_0_3_136d03d4_1611871247065_137519_24091" body="&lt;para>Durch das Senden dieser Nachricht an die Bauaufsichtsbehörde beantragt der Absender die Genehmigung einer oder mehrerer Abweichungen.&lt;/para>&#xA;&lt;para>Die Nachricht enthält zu jeder beantragten Abweichung die Vorschrift, von der in der Planung abgewichen werden soll und die Gesetzesgrundlage, nach der von dieser Vorschrift abgewichen werden kann. Außerdem sind enthalten die Begründung für die beantragte Abweichung und die Unterlagen, die benötigt werden, um das Anliegen zu bewerten.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_611449_25284" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264393_224661_26566" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282414_624458_33023" annotatedElement="_19_0_3_136d03d4_1611871264393_224661_26566" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Bauaufsichtsbehörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282414_601579_33024" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282414_624231_33022" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668597091437_863427_18235" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668597182754_736833_18238" annotatedElement="_19_0_3_129a03b9_1668597091437_863427_18235" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668597119086_647314_18236" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668597119087_126284_18237" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264393_775752_26567" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282414_309783_33027" annotatedElement="_19_0_3_136d03d4_1611871264393_775752_26567" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282414_996128_33028" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282414_9634_33026" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1618156947634_156052_16809" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1618156947649_385463_16811" annotatedElement="_19_0_3_136d03d4_1618156947634_156052_16809" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert sind. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1618156947649_300067_16812" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1618156947649_224688_16810" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264394_673511_26568" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282415_313149_33031" annotatedElement="_19_0_3_136d03d4_1611871264394_673511_26568" body="&lt;para>Hier sind die Daten zum Abweichungsantrag enthalten. Jedes Element betrifft eine beantragte Abweichung. Die betreffenden Aspekte der Abweichung werden dargestellt und das Ersuchen um Zulassung formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282415_791990_33032" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282415_551151_33030" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264394_177198_26569" name="bauvorhaben" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282415_412469_33035" annotatedElement="_19_0_3_136d03d4_1611871264394_177198_26569" body="&lt;para>Hier sind die Daten zum  Bauvorhaben (Wer, Was, Wo) enthalten.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282415_647632_33036" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282415_317534_33034" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264394_376666_26570" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282416_126078_33039" annotatedElement="_19_0_3_136d03d4_1611871264394_376666_26570" body="&lt;para>Hier sind die Anlagen zum Abweichungsantrag  bzw. Verweise auf diese Anlagen enthalten. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282416_332367_33040" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282416_125412_33038" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247065_237302_24093" name="abweichung.antragGeaendert.0222" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264396_638471_26580" annotatedElement="_19_0_3_136d03d4_1611871247065_237302_24093" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Abweichungsantrags bzw. geänderte oder ergänzte Bauvorlagen. Sie bezieht sich also auf einen bereits gestellten Abweichungsantrag.&lt;/para>&#xA;&lt;para>Entweder  ist sie eine Reaktion auf eine zum Bauantrag vorliegende Mängelliste der Bauaufsichtsbehörde, oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren nach.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264152_188749_25299" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264396_463777_26581" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282419_304224_33069" annotatedElement="_19_0_3_136d03d4_1611871264396_463777_26581" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang und ggf. auf die Nachricht 0221, die im Rahmen dieses Vorgangs gesendet worden ist, Bezug zu nehmen. &lt;/para>&#xA;&lt;para>Falls die vorliegende Nachrichteninstanz eine geänderte Planung initiativ einreicht, ist der Bezug auf eine solche Nachricht nicht enthalten. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282419_800510_33070" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282419_79386_33068" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619778779780_268104_17247" name="prozessmerkmale" visibility="private" type="_19_0_3_136d03d4_1611871244702_582549_23403">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619778876036_781399_17253" annotatedElement="_19_0_3_136d03d4_1619778779780_268104_17247" body="&lt;para>Dieses Element steht für Angaben zu Modalitäten zum Verfahren, soweit sie von der Bauaufsichtsbehörde gefordert&#xA;sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619778860243_380814_17251" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619778860253_110031_17252" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264397_19257_26582" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282419_605665_33073" annotatedElement="_19_0_3_136d03d4_1611871264397_19257_26582" body="&lt;para>Hier sind ggf. geänderte oder ergänzte Daten zu den beantragten Abweichungen enthalten.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282420_802193_33074" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282419_969913_33072" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264397_192357_26583" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282420_682778_33077" annotatedElement="_19_0_3_136d03d4_1611871264397_192357_26583" body="&lt;para>Ggf. sind in diesem Element korrigierte oder ergänzte Daten zum Bauvorhaben (Wer, Was, Wo)  zu übermitteln. Daten, die an dieser Stelle eingetragen sind, sollen die aufgeführten Mängel im Antragsumfang beheben.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282420_842193_33078" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282420_379318_33076" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264397_830654_26584" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282420_591317_33081" annotatedElement="_19_0_3_136d03d4_1611871264397_830654_26584" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;&lt;para>Falls die Nachrichteninstanz eine modifizierte Planung aus Gründen des Antragstellers im laufenden Verfahren einbringt, muss unter den Anlagen (je nach Landesbauordnung) ggf. eine Übereinstimmungserklärung enthalten sein. Außerdem muss unter den Anlagen eine Begründung bzw. Erläuterung zur eingereichten geänderten Planung enthalten sein. &lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282420_540901_33082" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282420_42683_33080" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247066_922537_24094" name="abweichung.anhoerung.0223" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264398_94592_26586" annotatedElement="_19_0_3_136d03d4_1611871247066_922537_24094" body="&lt;para>In dieser  Nachricht sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung waren. Diese werden hier aufgelistet bzw. erläutert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_132444_25325" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264398_321328_26587" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282421_784314_33086" annotatedElement="_19_0_3_136d03d4_1611871264398_321328_26587" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Bauantrag Bezug zu nehmen; außerdem ggf. auf die Nachricht 0220, die den Vorgang ausgelöst hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282421_6442_33087" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282421_379241_33085" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264398_978225_26588" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282422_292048_33090" annotatedElement="_19_0_3_136d03d4_1611871264398_978225_26588" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282422_758008_33091" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282421_226633_33089" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264398_887767_26589" name="bescheidlage" visibility="private" type="_19_0_3_136d03d4_1611871244696_372837_23381">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282422_785067_33094" annotatedElement="_19_0_3_136d03d4_1611871264398_887767_26589" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die Bauaufsichtsbehörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Bauantrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282422_993837_33095" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282422_546067_33093" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264398_192904_26590" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282422_332246_33098" annotatedElement="_19_0_3_136d03d4_1611871264398_192904_26590" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282423_662537_33099" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282422_254149_33097" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264399_523243_26591" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282423_979325_33102" annotatedElement="_19_0_3_136d03d4_1611871264399_523243_26591" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282423_709153_33103" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282423_472810_33101" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264399_199918_26592" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282423_819467_33106" annotatedElement="_19_0_3_136d03d4_1611871264399_199918_26592" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden. Gedacht ist dabei auch an Dokumente im Format &lt;emphasis role=&quot;italics&quot;>BIM Collaboration Format (BCF)&lt;/emphasis>. BCF kann Kommentare und Hinweise auf Inkonsistenzen in BIM-Modellen maschinenlesbar kodieren (Austausch von Informationen zwischen BIM-Softwaresystemen ).&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282423_284764_33107" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282423_248026_33105" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247066_6616_24095" name="abweichung.bescheid.0225" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264399_566032_26594" annotatedElement="_19_0_3_136d03d4_1611871247066_6616_24095" body="&lt;para>In dieser Nachricht sind die Inhalte des erteilten Bescheids enthalten. Das Senden dieser Nachricht stellt das Erteilen des Abweichungsbescheids dar.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_486163_25285" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264399_394698_26595" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282424_235745_33111" annotatedElement="_19_0_3_136d03d4_1611871264399_394698_26595" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang (oder den Antrag) bzw. die Nachricht 0220 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282424_607939_33112" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282424_251526_33110" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264400_366591_26596" name="bescheid" visibility="private" type="_19_0_3_136d03d4_1611871244700_476704_23397" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282424_201119_33115" annotatedElement="_19_0_3_136d03d4_1611871264400_366591_26596" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&lt;para>Ein Bescheid mit positivem Tenor  geht mit zugelassenen Abweichungen (Element abweichung) einher. Nicht zugelassene Abweichungen können nur in einem Bescheid mit negativem Tenor enthalten sein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282425_222995_33116" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282424_290335_33114" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264400_157853_26597" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282425_334861_33119" annotatedElement="_19_0_3_136d03d4_1611871264400_157853_26597" body="&lt;para>Hier sind die Anlagen zum Bescheid  bzw. Verweise auf diese Anlagen enthalten. Es handelt sich ggf. um Bauvorlagen, die von der Bauaufsichtsbehörde fortgeschrieben wurden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282425_134610_33120" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282425_442705_33118" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247067_940980_24097" name="abweichung.stellungnahme.0224" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264401_729424_26604" annotatedElement="_19_0_3_136d03d4_1611871247067_940980_24097" body="&lt;para>Diese Nachricht enthält Stellungnahmen des Bauherrn zu den Eigenschaften des Abweichungsantrags, die von der Bauaufsichtsbehörde beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Bauvorlagen.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264149_144434_25274" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264401_581259_26606" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282428_4256_33141" annotatedElement="_19_0_3_136d03d4_1611871264401_581259_26606" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen und außerdem auf die Nachricht 0223, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282428_433755_33142" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282427_255680_33140" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264401_848885_26605" name="stellungnahme" visibility="private" type="_19_0_3_136d03d4_1611871244697_819552_23382" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282427_240932_33137" annotatedElement="_19_0_3_136d03d4_1611871264401_848885_26605" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall im Abschnitt Anpassungen dokumentiert ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282427_85688_33138" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282427_296467_33136" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264402_983876_26607" name="bauvorhabenAenderungsdaten" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282428_366745_33145" annotatedElement="_19_0_3_136d03d4_1611871264402_983876_26607" body="&lt;para>Ggf. sind hier geänderte oder ergänzte Daten zum Bauvorhaben enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282428_616061_33146" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282428_579987_33144" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264403_963042_26608" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282428_764863_33149" annotatedElement="_19_0_3_136d03d4_1611871264403_963042_26608" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282428_979438_33150" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282428_448932_33148" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616760897993_562869_16838" name="" visibility="public" client="_19_0_3_136d03d4_1611871241079_525772_23104" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871241080_972479_23105" name="Anzeige" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_426909_23202" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_972479_23105" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1611871242635_458971_23203" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_972479_23105" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247067_177794_24099" name="anzeige.baubeginn.0900" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264403_185590_26611" annotatedElement="_19_0_3_136d03d4_1611871247067_177794_24099" body="&lt;para>Mit dieser Nachricht teilt der Bauherr der Bauaufsichtsbehörde mit, dass der Start der Umsetzung des Bauprojekts (Baubeginn, ggf. auch Beseitigung) zu einem bestimmten Termin geplant ist (Baubeginnanzeige).&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264157_494271_25342" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264403_572873_26612" name="bezug" visibility="private" type="_19_0_3_136d03d4_1619787338760_271682_17254">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282429_244959_33155" annotatedElement="_19_0_3_136d03d4_1611871264403_572873_26612" body="&lt;para>Referenz auf ein Vorhaben, ein Bauprojekt bzw. eine Baugenehmigung: abgebildet als Bezug auf einen Vorgang, beispielsweise eine vorliegende Anzeige oder ein durchlaufenes Baugenehmigungsverfahren mit Bescheid. Der Bescheid kann durch die Übermittlung einer Nachricht baugenehmigung.bescheid.0205 erteilt worden sein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282429_695711_33156" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282429_643368_33154" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264404_259428_26614" name="sachverhalt" visibility="private" type="_19_0_3_940029b_1662300598916_548669_18264" aggregation="composite" association="_19_0_3_136d03d4_1611871247068_463332_24102">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282430_15999_33163" annotatedElement="_19_0_3_136d03d4_1611871264404_259428_26614" body="&lt;para>Hier ist genau einer von drei möglichen Sachverhalten anzugeben, deren Anzeige die vorliegende Nachricht dienen kann (MBO § 72 (6, 8)).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282430_214665_33164" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282430_238930_33162" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1721641481684_41681_26082" name="voraussichtlicheFertigstellung" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
              <ownedComment xmi:id="_19_0_4_b6602da_1721641481685_284832_26084" annotatedElement="_19_0_4_b6602da_1721641481684_41681_26082" body="&lt;para>Hier kann das Datum der voraussichhtlichen Baufertigstellung eingetragen werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721641481685_502678_26085" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721641481685_385324_26083" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619793682676_703455_17303" name="nachweise" visibility="private" type="_19_0_3_136d03d4_1619793821501_211226_17307">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619794730977_901316_17314" annotatedElement="_19_0_3_136d03d4_1619793682676_703455_17303" body="&lt;para>Dieses Element enthält Nachweise zum Sachverhalt der Baubeginnsanzeige.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669365386392_171185_19986" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669365386392_895499_19987" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264403_608917_26613" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282430_251861_33159" annotatedElement="_19_0_3_136d03d4_1611871264403_608917_26613" body="&lt;para>Hier sind die an der Bauausführung beteiligten Parteien (Personen bzw. Organisationen) benannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282430_817524_33160" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282429_1582_33158" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619258377807_800862_16899" name="verortung" visibility="private" type="_19_0_3_136d03d4_1611871244693_625845_23369">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619259897029_990029_16926" annotatedElement="_19_0_3_136d03d4_1619258377807_800862_16899" body="&lt;para>Dieses Element erfasst Angaben zur Lokalisierung des Vorhabens. Dies ist nur bei Hybridverfahren zu befüllen, d. h. wenn zuvor ein analoger Bauantrag eingereicht und eine analoge Baugenehmigung ausgestellt wurde. In diesen Fällen liegen keine digitalen Informationen vor, so dass nicht mittels des Elements &lt;emphasis role=&quot;codebf&quot;>bezug&lt;/emphasis> auf die XBau-Nachrichten referenziert werden kann, um auf die relevanten Angaben zur Verortung des Vorhabens Bezug zu nehmen.&lt;/para> "/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619258448309_719052_16900" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619258448309_493671_16901" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264404_341026_26615" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282430_745750_33167" annotatedElement="_19_0_3_136d03d4_1611871264404_341026_26615" body="&lt;para>Hier sind die Anlagen bzw. Verweise auf solche Anlagen beizufügen, die die Bauaufsichtsbehörde für Prüfung und Entscheidung benötigt. Dies sind beispielsweise 'Nachweise vor Baubeginn', soweit sie bei der Erteilung der Baugenehmigung durch die Bauaufsichtsbehörde als Auflage genannt worden sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282431_800921_33168" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282430_607688_33166" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1724228805117_73187_26561" name="statusSozialerWohnungsbau" visibility="private" type="_19_0_4_78d0259_1724140852426_673060_26520">
              <ownedComment xmi:id="_19_0_4_78d0259_1724228805133_935853_26563" annotatedElement="_19_0_4_78d0259_1724228805117_73187_26561" body="&lt;para>Dieses Element enthält die Angabe zum Status der Beantragung sozialer Wohnraumförderung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1724228805133_212634_26564" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1724228805133_661926_26562" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785753580509_29563_35393" name="referenzAnzeigeservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785753580522_847119_35395" annotatedElement="_19_0_4_b8702dd_1785753580509_29563_35393" body="&lt;para>Eine vom Antragsservice (Anzeigeservice) vergebene eindeutige Kennung des Anzeigevorgangs. Sofern die Bauaufsichtsbehörde auf die Anzeige reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785753580522_133526_35396" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785753580522_376242_35394" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247067_507_24100" name="anzeige.baubeginnUntersagung.0901" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264404_82260_26617" annotatedElement="_19_0_3_136d03d4_1611871247067_507_24100" body="&lt;para>Diese Nachricht enthält den Hinweis, dass die geplante Maßnahme die Voraussetzungen nicht erfüllt und benennt entsprechende Mängel. Die Bauaufsichtsbehörde fordert zur Nachbesserung auf und untersagt vorläufig die Aufnahme der Bautätigkeiten.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264155_320803_25335" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264404_485008_26618" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282431_528819_33172" annotatedElement="_19_0_3_136d03d4_1611871264404_485008_26618" body="&lt;para>Bezug auf den Vorgang einer Baubeginnanzeige und ggf. auf die Nachricht einer Äußerung zum untersagten Baubeginn.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282431_50089_33173" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282431_506324_33171" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264405_997512_26619" name="untersagung" visibility="private" type="_19_0_3_136d03d4_1611871264408_360318_26632" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282431_278105_33176" annotatedElement="_19_0_3_136d03d4_1611871264405_997512_26619" body="&lt;para>Dieses Objekt enthält die nötigen Informationen zur verfügten Untersagung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282432_114807_33177" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282431_385326_33175" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991021673_440676_23690" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991021679_397172_23692" annotatedElement="_19_0_4_b8702dd_1695991021673_440676_23690" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zur Untersagung gegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991021681_567772_23693" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991021679_18184_23691" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991166159_783702_23697" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991166160_510857_23699" annotatedElement="_19_0_4_b8702dd_1695991166159_783702_23697" body="&lt;para>Hier sind die Anlagen zur Untersagung bzw. Verweise auf diese Anlagen enthalten. Die Behörde muss die Dokumentation zur Beschlusslage der Untersagung, die sie ausgefertigt hat, an das Bauprojekt geben, so dass dieses seine Aktenlage fortschreiben kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991166160_476192_23700" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991166160_364617_23698" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871247068_592230_24101" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871264407_871335_26627" name="Anonym_Unterlage" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282435_102703_33192" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210780_355528_9523" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283263_192529_36415" annotatedElement="_19_0_3_136d03d4_1611871282435_102703_33192" body="&lt;para>Hier ist die Bezeichnung der Unterlage einzutragen.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283263_525842_36416" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283262_225706_36414" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282435_175212_33191" name="erlaeuterung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283262_312921_36411" annotatedElement="_19_0_3_136d03d4_1611871282435_175212_33191" body="&lt;para>Hier ist ggf. eine Erläuterung zur fehlenden Unterlage zu geben.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283262_826676_36412" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283262_862567_36410" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871264407_40415_26628" name="FehlendeUnterlagen" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282435_613511_33193" name="unterlage" visibility="private" type="_19_0_3_136d03d4_1611871264407_871335_26627" aggregation="composite" association="_19_0_3_136d03d4_1611871264407_248204_26629">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283263_227399_36419" annotatedElement="_19_0_3_136d03d4_1611871282435_613511_33193" body="&lt;para>Dieses Element steht für eine Unterlage, auf deren Fehlen hingewiesen wird. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283263_553623_36420" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283263_815177_36418" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871264407_248204_26629" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871282435_613511_33193 _19_0_3_136d03d4_1611871282436_814920_33194">
              <ownedEnd xmi:id="_19_0_3_136d03d4_1611871282436_814920_33194" name="" visibility="private" type="_19_0_3_136d03d4_1611871264407_40415_26628" association="_19_0_3_136d03d4_1611871264407_248204_26629"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871264408_360318_26632" name="Untersagung" visibility="public">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282436_445993_33198" annotatedElement="_19_0_3_136d03d4_1611871264408_360318_26632" body="&lt;para>Dieser Typ deckt alle Informationen ab, die zu einer verfügten Untersagung als Reaktion auf eine Anzeige gehören können.&lt;/para>&#xA;"/>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282436_114040_33199" name="anordnung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283264_618573_36427" annotatedElement="_19_0_3_136d03d4_1611871282436_114040_33199" body="&lt;para>Die Anordnung besteht aus einem Sachverhalt (Verstoß wird genannt, z.B. &quot;fehlende Absteckung&quot;), einer Begründung (die Rechtsnorm, die zur Untersagung führt) sowie einer Rechtsbehelfsbelehrung (Textbaustein, ggf. §-Referenz, ggf. als Anlage, z.B. pdf-Datei o.ä.).&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283264_296734_36428" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283264_643154_36426" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871282437_111669_33200" name="fehlendeUnterlagen" visibility="private" type="_19_0_3_136d03d4_1611871264407_40415_26628" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1611871283265_273345_36431" annotatedElement="_19_0_3_136d03d4_1611871282437_111669_33200" body="&lt;para>Hinweise auf fehlende Voraussetzungen (Mängelliste) werden benannt. Es werden die Unterlagen genannt, deren Fehlen zur Untersagung geführt hat.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871283265_295721_36432" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871283265_592769_36430" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619787338760_271682_17254" name="Anonym_BezugBaubeginn" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619787358658_455850_17255" name="mitAktenzeichen" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619788578331_222490_17277" annotatedElement="_19_0_3_136d03d4_1619787358658_455850_17255" body="&lt;para>Dieses Element ist zu befüllen, wenn ein Aktenzeichen zum Verfahren vorhanden ist (bei genehmigten Bauverfahren).&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619787364752_762097_17256" name="ohneAktenzeichen" visibility="private" type="_19_0_3_136d03d4_1619787440576_90366_17263">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619788601044_121541_17278" annotatedElement="_19_0_3_136d03d4_1619787364752_762097_17256" body="&lt;para>Dieses Element ist zu befüllen, wenn kein Aktenzeichen zum Verfahren vorhanden ist (z. B. bei genehmigungsfreigestellten Verfahren).&lt;/para>"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619787440576_90366_17263" name="Anonym_OhneAktenzeichen" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619787503999_359556_17264" name="datumEingereicht" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619788926052_91379_17285" annotatedElement="_19_0_3_136d03d4_1619787503999_359556_17264" body="&lt;para>Hier ist das Datum der Einreichung der Bauunterlagen anzugeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619788746804_932495_17279" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619788746805_534107_17280" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619787513896_275406_17265" name="datumBaubeginnanzeige" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619789230342_294394_17286" annotatedElement="_19_0_3_136d03d4_1619787513896_275406_17265" body="&lt;para>Hier ist das Datum der Baubeginnsanzeige anzugeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619788791978_553738_17281" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619788791979_966780_17282" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619787525767_507754_17266" name="datumGenehmigungErteilt" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619789568021_971227_17287" annotatedElement="_19_0_3_136d03d4_1619787525767_507754_17266" body="&lt;para>Hier ist das Datum der erteilten Genehmigung anzugeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619788796866_291983_17283" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619788796866_715263_17284" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619792177041_697869_17288" name="Anonym_verortungAnzeige" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619792177042_175215_17289" name="baugrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_572179_23532">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619792177045_261533_17292" annotatedElement="_19_0_3_136d03d4_1619792177042_175215_17289" body="&lt;para>In diesem Element sind Daten enthalten, die das Baugrundstück (ein Grundstück, auf dem das Vorhaben stattfinden soll bzw. auf dem es durchgeführt wurde) identifizieren. Ein Baugrundstück kann mehrere Grundstücke umfassen.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619792177045_472756_17293" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619792177044_360377_17291" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619792177044_421579_17290" name="lageBauvorhaben" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619792177047_186892_17296" annotatedElement="_19_0_3_136d03d4_1619792177044_421579_17290" body="&lt;para>In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Bauvorhabens bzw. Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para>&#xA;&#xA;&lt;para>Falls beispielsweise ein Umbau geplant wurde und auf dem Grundstück mehrere Gebäude bestehen, muss aus diesen Angaben hervorgehen, was der Gegenstand des Anbaus ist.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619792177047_431376_17297" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619792177046_301561_17295" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619793821501_211226_17307" name="Anonym_NachweiseBaubeginn" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619259527166_672026_16920" name="pruefungStandsicherheitsnachweisErforderlich" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619260748353_877695_16927" annotatedElement="_19_0_3_136d03d4_1619259527166_672026_16920" body="&lt;para>Wenn die Erklärung des Tragwerksplaner ergibt, dass eine Prüfung des Standsicherheitsnachweises erforderlich ist, dann ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para> "/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619259630092_146504_16924" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619259630093_185353_16925" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619793975053_346550_17310" name="Anonym_NachweiseNutzungsaufnahme" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262519639_854555_16935" name="bezeichnungVorhaben" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619263419653_404355_16955" annotatedElement="_19_0_3_136d03d4_1619262519639_854555_16935" body="&lt;para>Hier ist die Bezeichnung des Vorhabens anzugeben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619796408969_762091_17326" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619796408971_290991_17327" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262532438_625061_16936" name="standsicherheitBescheinigt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619263653086_471936_16956" annotatedElement="_19_0_3_136d03d4_1619262532438_625061_16936" body="&lt;para>Wenn die ordnungsgemäße Ausführung von Standsicherheit bescheinigt wurde, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln und der entsprechende Nachweis mit dem Element &lt;emphasis role=&quot;codebf&quot;>anlagen&lt;/emphasis> beizufügen. Der Wert &quot;false&quot; ist zu übermitteln, wenn kein Nachweis für die Standsicherheit erforderlich ist.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262551446_478589_16937" name="brandschutzBescheinigt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619263840118_910799_16957" annotatedElement="_19_0_3_136d03d4_1619262551446_478589_16937" body="&lt;para>Wenn die ordnungsgemäße Ausführung von Brandschutz bescheinigt wurde, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln und der entsprechende Nachweis mit dem Element &lt;emphasis role=&quot;codebf&quot;>anlagen&lt;/emphasis> beizufügen. Der Wert &quot;false&quot; ist zu übermitteln, wenn kein Nachweis für den Brandschutz erforderlich ist.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262561430_735855_16938" name="gebaeudeDerKlasse4" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619264059672_749623_16958" annotatedElement="_19_0_3_136d03d4_1619262561430_735855_16938" body="&lt;para>Handelt es sich um ein Gebäude der Klasse 4, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262571590_895789_16939" name="wiederkehrendePruefungenErforderlich" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619264134431_653191_16959" annotatedElement="_19_0_3_136d03d4_1619262571590_895789_16939" body="&lt;para>Sind wiederkehrende Prüfungen erforderlich, dann ist in diesem Element der Wert &quot;true&quot; zu übermitteln; andernfalls &quot;false&quot;.&lt;/para>"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1620371731159_104197_17159" name="Anonym_NachweiseBeseitigung" visibility="public">
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619466990228_734236_17234" name="standsicherheitsnachweisDurchTragwerksplaner" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619467127012_342236_17242" annotatedElement="_19_0_3_136d03d4_1619466990228_734236_17234" body="&lt;para>Ist ein Standsicherheitsnachweis durch einen Tragwerkplaner erforderlich, dann ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619467167325_89663_17244" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619467167325_685239_17245" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_136d03d4_1619467005497_912192_17235" name="ueberwachungDurchTragwerksplaner" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_3_136d03d4_1619467132106_576113_17243" annotatedElement="_19_0_3_136d03d4_1619467005497_912192_17235" body="&lt;para>Ist die Beseitigung durch den Tragwerksplaner zu überwachen, dann ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls &quot;false&quot;.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619467171147_115049_17246" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619467171148_772903_17247" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1688633603573_687014_21890" name="AnzeigenderBeseitigung" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1688634185928_252133_21905" annotatedElement="_19_0_4_b6602da_1688633603573_687014_21890" body="&lt;para>Hier sind die Daten der Person einzutragen, die verantwortlich für die Anzeige ist, inklusive ihrer Rolle.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1688633899357_932265_21895" name="anzeigender" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                <ownedComment xmi:id="_19_0_4_b6602da_1688633899358_870898_21897" annotatedElement="_19_0_4_b6602da_1688633899357_932265_21895" body="&lt;para>Hier sind die Daten der Person einzutragen, die verantwortlich für die Anzeige ist (meist der Bauherr). &lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1688633899358_723272_21898" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1688633899357_72659_21896" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1688633656709_794983_21891" name="artDesAnzeigenden" visibility="private" type="_19_0_3_136d03d4_1611871239791_577866_22870">
                <ownedComment xmi:id="_19_0_4_b6602da_1688634159654_186212_21904" annotatedElement="_19_0_4_b6602da_1688633656709_794983_21891" body="&lt;para>Die Art des Anzeigenden ist hier nach einem Katalog der amtlichen Statistik anzugeben (Codeliste &quot;Statistik Bauherr oder Eigentümer Art&quot;). Die Bauaufsichtsbehörde benötigt diese Information für ihre Informationspflichten gegenüber dem statistischen Landesamt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1688633735890_155219_21893" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1688633735894_819572_21894" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696231048363_68384_23946" name="Anonym_ErklaerungGEG" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696231048364_588302_23947" name="mitAktenzeichen" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                <ownedComment xmi:id="_19_0_4_b6602da_1696231048367_876988_23950" annotatedElement="_19_0_4_b6602da_1696231048364_588302_23947" body="&lt;para>Dieses Element ist zu befüllen, wenn ein Aktenzeichen zum Verfahren vorhanden ist (bei genehmigten Bauverfahren.)&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696231048365_371694_23948" name="ohneAktenzeichen" visibility="private" type="_19_0_3_136d03d4_1619787440576_90366_17263">
                <ownedComment xmi:id="_19_0_4_b6602da_1696231048367_428860_23952" annotatedElement="_19_0_4_b6602da_1696231048365_371694_23948" body="&lt;para>Dieses Element ist zu befüllen, wenn kein Aktenzeichen zum Verfahren vorhanden ist.&lt;/para>"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696234823669_746536_24040" name="Anonym_ErklaerenderErfuellungserklaerung" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696590823926_150887_24477" name="erklaerenderRolle" visibility="private" type="_19_0_4_b6602da_1696591602211_539416_24586">
                <ownedComment xmi:id="_19_0_4_b6602da_1696590915320_871650_24485" annotatedElement="_19_0_4_b6602da_1696590823926_150887_24477" body="&lt;para>Angabe für die Rolle des Erklärenden. Hinweis: Der Entwurfsverfasser kann nur die Rolle Vertreter des Bauherrn oder Vertreter des Eigentümers innehaben.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696590889571_3972_24483" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696590889572_811777_24484" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696234866751_348035_24042" name="erklaerenderDaten" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                <ownedComment xmi:id="_19_0_4_b6602da_1696235003715_531065_24048" annotatedElement="_19_0_4_b6602da_1696234866751_348035_24042" body="&lt;para>In diesem Element werden Daten zum Erklärenden übermittelt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696235503550_824497_24126" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696235503550_698603_24127" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696234877884_177992_24043" name="erklaerenderVertretung" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
                <ownedComment xmi:id="_19_0_4_b6602da_1696235024076_804053_24049" annotatedElement="_19_0_4_b6602da_1696234877884_177992_24043" body="&lt;para>Falls es sich beim Erklärenden um einen Vertreter des Bauherrn oder des Eigentümer handelt, ist hier der Nachweis der Vertretungserlaubnis (Befugnis, Vollmacht etc.) einzufügen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696235512533_410191_24130" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696235512533_367444_24131" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696235106074_641750_24050" name="akteur" visibility="public"/>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696236079614_510665_24134" name="Anonym_AngabenGebaeude" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1696236678928_363175_24142" annotatedElement="_19_0_4_b6602da_1696236079614_510665_24134" body="&lt;para>Hier sind Angaben zum Gebäude zu machen.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696236090687_277845_24135" name="gebaeudetyp" visibility="private" type="_19_0_3_136d03d4_1611871244699_746777_23393">
                <ownedComment xmi:id="_19_0_4_b6602da_1696236570710_459443_24140" annotatedElement="_19_0_4_b6602da_1696236090687_277845_24135" body="&lt;para>Hier sind Angaben zum Gebäudetyp zu machen. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696238650169_374228_24225" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696238650169_101474_24226" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696236349654_747219_24138" name="gebaeudeteil" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                <ownedComment xmi:id="_19_0_4_b6602da_1696236597877_111529_24141" annotatedElement="_19_0_4_b6602da_1696236349654_747219_24138" body="&lt;para>In diesem Element ist der betreffende Gebäudeteil zu benennen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696238646555_796349_24223" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696238646556_934304_24224" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696236695390_862177_24143" name="datumBaufertigstellung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_4_b6602da_1696236877849_165516_24145" annotatedElement="_19_0_4_b6602da_1696236695390_862177_24143" body="&lt;para>In dieses Element ist das Datum der Baufertigstellung (bzw. Bezugsfertigstellung) einzutragen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696238653377_84593_24227" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696238653377_372689_24228" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696418768050_908174_24022" name="Anonym_Erfuellungserklaerung" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696418821816_997171_24024" name="erfuellungserklaerungNeubau" visibility="private" type="_19_0_4_b6602da_1696418949854_483945_24030">
                <ownedComment xmi:id="_19_0_4_b6602da_1696418874873_906095_24026" annotatedElement="_19_0_4_b6602da_1696418821816_997171_24024" body="&lt;para>Dieses Element ist zu befüllen, wenn es sich um einen Neubau handelt.&lt;/para>"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696418885296_528838_24027" name="erfuellungserklaerungBestandsbau" visibility="private" type="_19_0_4_b6602da_1696422846317_916292_24503">
                <ownedComment xmi:id="_19_0_4_b6602da_1696418885302_190987_24028" annotatedElement="_19_0_4_b6602da_1696418885296_528838_24027" body="&lt;para>Dieses Element ist zu befüllen, wenn es sich um einen Bestandsbau handelt.&lt;/para>"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696424234394_258537_24852" name="Anonym_NachweisbefreiungenErfuellungserklaerung" visibility="public">
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696424300181_334073_24854" name="anwendungInnovationsklausel" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1696424501003_464159_24948" annotatedElement="_19_0_4_b6602da_1696424300181_334073_24854" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass zur Befreiung die Innovationsklausel nach § 103 Abs. 1 GEG angewandt wird. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696424474808_491135_24932" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696424474809_551076_24933" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696424311399_763048_24855" name="befreiungGEG" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1696424502245_509735_24949" annotatedElement="_19_0_4_b6602da_1696424311399_763048_24855" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass zur Befreiung andere Gründe nach § 102 GEG vorliegen. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696424479147_757610_24936" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696424479147_242040_24937" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1696424320406_822936_24856" name="bescheidBefreiungGEG" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
                <ownedComment xmi:id="_19_0_4_b6602da_1696424505800_210034_24951" annotatedElement="_19_0_4_b6602da_1696424320406_822936_24856" body="&lt;para>Hier ist der Bescheid für die Befreiung beizufügen.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696424481595_857913_24938" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696424481596_546120_24939" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1723793408705_132020_26445" name="DatenBauabgangBeseitigungAbsicht" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1723793408817_818067_26475" annotatedElement="_19_0_4_b6602da_1723793408705_132020_26445" body="&lt;para>Dieser Typ enthält die Daten, die zum Anlass 'Bauabgang' gehören. &lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1728642767807_458203_29352" name="anschrift" visibility="private" type="_19_0_3_c4f030d_1635864354709_685445_17884" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1728642767831_478108_29355" annotatedElement="_19_0_4_b6602da_1728642767807_458203_29352" body="&lt;para>In diesem Element wird die Anschrift des Grundstücks eingetragen. Falls dem Grundstück von der Kommune keine Anschrift zugewiesen ist, wird dieses Element nicht instanziiert.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1728642767832_514535_29356" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1728642767829_309404_29354" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1728642767826_355598_29353" name="flurstueck" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1728642767837_597720_29359" annotatedElement="_19_0_4_b6602da_1728642767826_355598_29353" body="&lt;para>Pro Instanziierung des Elements sind Angaben zu einem Flurstück vorzunehmen, das zum Grundstück gehört. &lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1728642767838_796030_29360" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1728642767836_182753_29358" name="" visibility="public" value="*"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1728643281850_829040_29372" name="lageGebaeude" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1728643281869_836833_29374" annotatedElement="_19_0_4_b6602da_1728643281850_829040_29372" body="&lt;para>In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1728643281873_230002_29375" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1728643281865_88089_29373" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1723793408821_930054_26478" name="bauabgang" visibility="private" type="_19_0_3_136d03d4_1611871246537_551575_23558">
                <ownedComment xmi:id="_19_0_4_b6602da_1723793408833_12382_26495" annotatedElement="_19_0_4_b6602da_1723793408821_930054_26478" body="&lt;para>Dieses Element enthält weitere Daten zum Bauabgang.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793408834_331296_26496" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793408833_866992_26494" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1723793408822_758103_26479" name="artDesEigentuemers" visibility="private" type="_19_0_3_136d03d4_1611871239791_577866_22870">
                <ownedComment xmi:id="_19_0_4_b6602da_1723793408836_521164_26499" annotatedElement="_19_0_4_b6602da_1723793408822_758103_26479" body="&lt;para>Angabe der Art des Eigentümers&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793408836_142724_26500" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793408836_123440_26498" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1723793408824_607116_26480" name="artDesWohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239792_886892_22872">
                <ownedComment xmi:id="_19_0_4_b6602da_1723793408836_142848_26503" annotatedElement="_19_0_4_b6602da_1723793408824_607116_26480" body="&lt;para>Hier wird für bauliche Anlagen, die Wohngebäude sind, eine Klassifizierung vorgenommen gemäß Einteilung der amtlichen Statistik. Die Hauptnutzung muss klar erkennbar sein.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793408837_938303_26504" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793408836_618213_26502" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1723793408825_189825_26481" name="artDesNichtwohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239790_196517_22867">
                <ownedComment xmi:id="_19_0_4_b6602da_1723793408838_757485_26507" annotatedElement="_19_0_4_b6602da_1723793408825_189825_26481" body="&lt;para>Bauliche Anlagen, die nicht Wohngebäude sind, werden durch dieses Element klassifiziert gemäß Signierschlüsselverzeichnis des Statistischen Bundesamts.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793408838_470042_26508" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793408838_867049_26506" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1723793408827_565805_26483" name="ueberbauteFlaeche" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
                <ownedComment xmi:id="_19_0_4_b6602da_1723793408842_941875_26515" annotatedElement="_19_0_4_b6602da_1723793408827_565805_26483" body="&lt;para>Flächen der Bauwerke oberhalb der Geländeoberfläche. Angabe: Anzahl Quadratmeter mit zwei Nachkommastellen&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793408842_979090_26516" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793408841_4512_26514" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871247068_463332_24102" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264404_259428_26614 _19_0_3_136d03d4_1611871265754_218210_26697">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871265754_218210_26697" name="" visibility="private" type="_19_0_3_136d03d4_1611871247067_177794_24099" association="_19_0_3_136d03d4_1611871247068_463332_24102"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871247068_558248_24103" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871265755_153464_26699 _19_0_3_136d03d4_1611871265755_901300_26698">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871265755_901300_26698" name="" visibility="private" type="_19_0_3_136d03d4_1611871247069_720916_24105" association="_19_0_3_136d03d4_1611871247068_558248_24103"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247069_785599_24104" name="anzeige.nutzungsaufnahmeUntersagung.0911" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265756_355288_26700" annotatedElement="_19_0_3_136d03d4_1611871247069_785599_24104" body="&lt;para>Die Nachricht enthält den Hinweis, dass die geplante Maßnahme die Voraussetzungen nicht erfüllt und benennt entsprechende Mängel. Sie fordert zur Nachbesserung auf.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264153_588779_25314" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265757_988637_26701" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282450_347750_33217" annotatedElement="_19_0_3_136d03d4_1611871265757_988637_26701" body="&lt;para>Bezug auf den Vorgang einer Nutzungsbeginnanzeige und ggf. auf die Nachricht einer Äußerung zur untersagten Nutzungsaufnahme&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282450_927355_33218" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282450_933397_33216" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265757_714942_26702" name="untersagung" visibility="private" type="_19_0_3_136d03d4_1611871264408_360318_26632" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282450_673870_33221" annotatedElement="_19_0_3_136d03d4_1611871265757_714942_26702" body="&lt;para>Dieses Objekt enthält die nötigen Informationen zur verfügten Untersagung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282450_360511_33222" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282450_250398_33220" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991441155_303690_23704" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991441156_438556_23707" annotatedElement="_19_0_4_b8702dd_1695991441155_303690_23704" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zur Untersagung gegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991441157_18320_23708" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991441156_850041_23706" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991441156_921222_23705" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991441158_107668_23711" annotatedElement="_19_0_4_b8702dd_1695991441156_921222_23705" body="&lt;para>Hier sind die Anlagen zur Untersagung bzw. Verweise auf diese Anlagen enthalten. Die Behörde muss die Dokumentation zur Beschlusslage der Untersagung, die sie ausgefertigt hat, an das Bauprojekt geben, so dass dieses seine Aktenlage fortschreiben kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991441158_103372_23712" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991441158_355670_23710" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247069_720916_24105" name="anzeige.nutzungsaufnahme.0910" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265758_15458_26704" annotatedElement="_19_0_3_136d03d4_1611871247069_720916_24105" body="&lt;para>Mit dieser Nachricht teilt der Bauherr der Bauaufsichtsbehörde mit, dass die Aufnahme der Nutzung des errichteten Gebäudes zu einem bestimmten Termin geplant ist. Mit dieser Anzeige werden (sofern eine Prüfung durch einen Prüfsachverständigen vorgesehen ist) die Bescheinigungen über die ordnungsgemäße Ausführung von Brandschutz und Standsicherheit mitvorgelegt.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_249247_25287" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265758_728346_26705" name="bezug" visibility="private" type="_19_0_3_136d03d4_1619787338760_271682_17254">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282451_833421_33226" annotatedElement="_19_0_3_136d03d4_1611871265758_728346_26705" body="&lt;para>Referenz auf einen Vorgang der Bauaufsichtsbehörde (ein durchlaufenes Baugenehmigungsverfahren) und ggf. auf eine Nachricht, die im Zusammenhang des Vorgangs verschickt worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282451_124769_33227" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282451_691990_33225" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265755_153464_26699" name="sachverhalt" visibility="private" type="_19_0_3_940029b_1662300598920_701507_18265" aggregation="composite" association="_19_0_3_136d03d4_1611871247068_558248_24103">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282449_329900_33213" annotatedElement="_19_0_3_136d03d4_1611871265755_153464_26699" body="&lt;para>Hier ist der Sachverhalt der geplanten Nutzungsaufnahme angegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282449_394618_33214" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282449_279917_33212" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619793896404_236194_17308" name="nachweise" visibility="private" type="_19_0_3_136d03d4_1619793975053_346550_17310">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619794995392_947804_17315" annotatedElement="_19_0_3_136d03d4_1619793896404_236194_17308" body="&lt;para>Dieses Element enthält Nachweise zum Sachverhalt der geplanten Nutzungsaufnahme.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669365689487_280505_20142" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669365689488_506933_20143" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619467815477_379676_17248" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619467935769_285959_17254" annotatedElement="_19_0_3_136d03d4_1619467815477_379676_17248" body="&lt;para>Hier sind die beteiligten Parteien (Personen bzw. Organisationen) benannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619467899044_553334_17252" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619467899044_675470_17253" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619262166206_376304_16928" name="verortung" visibility="private" type="_19_0_3_136d03d4_1619792177041_697869_17288">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619262166213_509793_16930" annotatedElement="_19_0_3_136d03d4_1619262166206_376304_16928" body="&lt;para>Dieses Element erfasst Angaben zur Lokalisierung des Vorhabens. Dies ist nur bei Hybridverfahren zu befüllen, d. h. wenn zuvor ein papierbasierter Bauantrag eingereicht und eine papierbasierte Baugenehmigung ausgestellt wurde. In diesen Fällen liegen keine digitalen Informationen vor, sodass nicht mittels dem Element &lt;emphasis role=&quot;codebf&quot;>bezug&lt;/emphasis> auf die XBau-Nachrichten referenziert werden kann, um auf die relevanten Angaben zur Verortung des Vorhabens Bezug zu nehmen.&lt;/para> "/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619262166214_549246_16931" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619262166211_180647_16929" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265758_134046_26706" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282451_629980_33230" annotatedElement="_19_0_3_136d03d4_1611871265758_134046_26706" body="&lt;para>Hier können Anlagen bzw. Verweise auf solche Anlagen eingefügt werden. Das sind insbesondere Bescheinigungen über die ordnungsgemäße Ausführung von Brandschutz und Standsicherheit und ggf. weitere Unterlagen, die für die Prüfung durch die Bauaufsichtsbehörde benötigt werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282451_895657_33231" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282451_163461_33229" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_78d0259_1724228812310_101294_26568" name="statusSozialerWohnungsbau" visibility="private" type="_19_0_4_78d0259_1724140852426_673060_26520">
              <ownedComment xmi:id="_19_0_4_78d0259_1724228812310_286327_26570" annotatedElement="_19_0_4_78d0259_1724228812310_101294_26568" body="&lt;para>Dieses Element enthält die Angabe zum Status der Beantragung sozialer Wohnraumförderung.&lt;/para>"/>
              <ownedComment xmi:id="_19_0_4_78d0259_1724918535013_25369_26597" annotatedElement="_19_0_4_78d0259_1724228812310_101294_26568" body=""/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1724228812310_187935_26571" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1724228812310_868956_26569" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1785753657727_157534_35403" name="referenzAnzeigeservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b8702dd_1785753657727_213054_35405" annotatedElement="_19_0_4_b8702dd_1785753657727_157534_35403" body="&lt;para>Eine vom Antragsservice (Anzeigeservice) vergebene eindeutige Kennung des Anzeigevorgangs. Sofern die Bauaufsichtsbehörde auf die Anzeige reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785753657727_679268_35406" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785753657727_280221_35404" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247069_184387_24106" name="anzeige.beseitigungAbsicht.0950" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265758_163911_26708" annotatedElement="_19_0_3_136d03d4_1611871247069_184387_24106" body="&lt;para>Mit dieser Nachricht teilt der Bauherr der Bauaufsichtsbehörde mit, dass die Beseitigung einer baulichen Anlage geplant ist.&lt;/para>"/>
            <ownedRule xmi:id="_19_0_4_b8702dd_1761124542610_304698_31675" name="sch-anz-001" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1761124881795_821058_31677" annotatedElement="_19_0_4_b8702dd_1761124542610_304698_31675" body="Zur Weiterleitung an die Statistik ist ein Anzeigender anzugeben. Die Nachricht enthält kein Element &quot;anzeigender&quot;."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1761124542610_937620_31676" name="" visibility="public">
                <language>English</language>
                <body>exists(xbau:anzeigender)</body>
              </specification>
            </ownedRule>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264154_716877_25315" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265759_463995_26709" name="referenzAnzeigeservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282452_912005_33235" annotatedElement="_19_0_3_136d03d4_1611871265759_463995_26709" body="&lt;para>Eine vom Antragsservice (Anzeigeservice) vergebene eindeutige Kennung des Anzeigevorgangs. Sofern die Bauaufsichtsbehörde auf die Anzeige reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282452_775338_33236" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282452_787070_33234" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265759_198097_26710" name="anzeigender" visibility="private" type="_19_0_4_b6602da_1688633603573_687014_21890">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282452_484281_33239" annotatedElement="_19_0_3_136d03d4_1611871265759_198097_26710" body="&lt;para>Hier können die Daten der Person eingetragen werden, die für die Anzeige verantwortlich ist, inklusive ihrer Rolle. Pro Anzeigendem ist ein Element zu instanziieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282452_40235_33240" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282452_657308_33238" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1668598835482_504105_18332" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
              <ownedComment xmi:id="_19_0_3_129a03b9_1668598835485_219634_18334" annotatedElement="_19_0_3_129a03b9_1668598835482_504105_18332" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668598835485_325136_18335" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668598835484_618856_18333" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265759_783581_26711" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282453_422789_33243" annotatedElement="_19_0_3_136d03d4_1611871265759_783581_26711" body="&lt;para>Hier sind die beteiligten Parteien (Personen bzw. Organisationen) benannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282453_162137_33244" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282453_571656_33242" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1726126924968_313082_27873" name="anzahlDerGebaeude" visibility="private" type="_19_0_4_b6602da_1725002748026_786307_26572">
              <ownedComment xmi:id="_19_0_4_b6602da_1726126924973_284377_27875" annotatedElement="_19_0_4_b6602da_1726126924968_313082_27873" body="&lt;para>Dieser Datentyp enthält die Anzahl der Gebäude des Bauvorhabens und Informationen zur Identifikation der einzelnen Gebäude. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726126924973_292670_27876" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1726126924973_585991_27874" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1723793262559_340263_26438" name="datenBauabgang" visibility="private" type="_19_0_4_b6602da_1723793408705_132020_26445" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1723793262579_246673_26440" annotatedElement="_19_0_4_b6602da_1723793262559_340263_26438" body="&lt;para>Dieses Element enthält die Daten, die speziell zum Bauabgang zu übermitteln sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1723793262580_972404_26441" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1723793262576_891939_26439" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265759_568647_26712" name="sachverhalt" visibility="private" type="_19_0_3_940029b_1662300598911_76890_18263" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282453_762938_33247" annotatedElement="_19_0_3_136d03d4_1611871265759_568647_26712" body="&lt;para>Hier sind Eckdaten zum Sachverhalt der geplanten Beseitigung anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282453_89967_33248" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282453_396848_33246" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1620371606702_414449_17155" name="nachweise" visibility="private" type="_19_0_3_136d03d4_1620371731159_104197_17159">
              <ownedComment xmi:id="_19_0_3_136d03d4_1620371656407_896924_17158" annotatedElement="_19_0_3_136d03d4_1620371606702_414449_17155" body="&lt;para>Dieses Element enthält Nachweise zum Sachverhalt der geplanten Beseitigung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1620371636652_957970_17156" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1620371636653_735748_17157" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265760_853156_26713" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282454_188974_33251" annotatedElement="_19_0_3_136d03d4_1611871265760_853156_26713" body="&lt;para>Hier sind die Anlagen bzw. Verweise auf solche Anlagen einzufügen. Dies sind die Unterlagen, die für die Bearbeitung der Anzeige durch die adressierte Bauaufsichtsbehörde benötigt werden.&lt;/para>&#xA;&lt;para>Falls erforderlich, kann hier ein Befähigungsnachweis für Abbrucharbeiten beigefügt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282454_245033_33252" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282454_963244_33250" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247070_815807_24107" name="anzeige.beseitigungUntersagung.0953" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265760_529111_26715" annotatedElement="_19_0_3_136d03d4_1611871247070_815807_24107" body="&lt;para>Diese Nachricht enthält den Hinweis, dass die geplante Maßnahme die Voraussetzungen nicht erfüllt und benennt entsprechende Mängel. Die Bauaufsichtsbehörde fordert zur Nachbesserung auf und untersagt vorläufig die geplante Beseitigung.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264156_368941_25338" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265760_28427_26716" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282454_321539_33256" annotatedElement="_19_0_3_136d03d4_1611871265760_28427_26716" body="&lt;para>Bezug auf Vorgang und Nachricht einer Anzeige Beseitigung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282454_774710_33257" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282454_425020_33255" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265760_532967_26717" name="untersagung" visibility="private" type="_19_0_3_136d03d4_1611871264408_360318_26632" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282455_259246_33260" annotatedElement="_19_0_3_136d03d4_1611871265760_532967_26717" body="&lt;para>Dieses Objekt enthält die nötigen Informationen zur verfügten Untersagung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282455_782114_33261" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282455_894466_33259" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991443818_744191_23718" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991443819_221612_23721" annotatedElement="_19_0_4_b8702dd_1695991443818_744191_23718" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zur Untersagung gegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991443819_168243_23722" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991443819_543332_23720" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1695991443819_733732_23719" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b8702dd_1695991443820_916924_23725" annotatedElement="_19_0_4_b8702dd_1695991443819_733732_23719" body="&lt;para>Hier sind die Anlagen zur Untersagung bzw. Verweise auf diese Anlagen enthalten. Die Behörde muss die Dokumentation zur Beschlusslage der Untersagung, die sie ausgefertigt hat, an das Bauprojekt geben, so dass dieses seine Aktenlage fortschreiben kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1695991443820_759899_23726" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1695991443820_950200_23724" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247070_277870_24108" name="anzeige.beseitigungBestaetigung.0955" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265761_937234_26719" annotatedElement="_19_0_3_136d03d4_1611871247070_277870_24108" body="&lt;para>Mit dieser Nachricht bestätigt die Baubehörde, dass für die geplante Beseitigung kein Genehmigungsverfahren durchgeführt werden muss.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264150_261028_25283" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265761_663924_26720" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282455_531998_33265" annotatedElement="_19_0_3_136d03d4_1611871265761_663924_26720" body="&lt;para>Bezug auf Vorgang und Nachricht einer Anzeige Beseitigung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282456_809666_33266" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282455_617306_33264" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871247070_598335_24109" name="anzeige.beseitigungGeaendert.0952" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871265761_990244_26722" annotatedElement="_19_0_3_136d03d4_1611871247070_598335_24109" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten zur angezeigten Absicht der Beseitigung einer baulichen Anlage. Sie bezieht sich auf eine bereits übermittelte Anzeige.&lt;/para>&#xA;&#xA;&lt;para>Entweder  ist sie eine Reaktion auf eine vorliegende Mängelliste der Bauaufsichtsbehörde. Oder es wird eine modifizierte Planung aus Gründen des Anzeigenden nachgereicht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1611871264151_846424_25290" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265761_25603_26723" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282456_355970_33270" annotatedElement="_19_0_3_136d03d4_1611871265761_25603_26723" body="&lt;para>Bezug auf Vorgang und Nachricht einer Anzeige Beseitigung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282456_44387_33271" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282456_212797_33269" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265762_952607_26724" name="sachverhalt" visibility="private" type="_19_0_3_940029b_1662300598911_76890_18263" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282456_568174_33274" annotatedElement="_19_0_3_136d03d4_1611871265762_952607_26724" body="&lt;para>Hier sind (geänderte) Eckdaten zum Sachverhalt der geplanten Beseitigung anzugeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282457_835657_33275" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282456_103278_33273" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871265762_922944_26725" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282457_339442_33278" annotatedElement="_19_0_3_136d03d4_1611871265762_922944_26725" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Bauvorlage übermittelt. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282457_843242_33279" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282457_715462_33277" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616760996113_244465_16840" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_972479_23105" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1618174799957_256327_17232" name="anzeige.nutzungsaufnahmeBauabnahme.0912" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1618174799960_597149_17233" annotatedElement="_19_0_3_136d03d4_1618174799957_256327_17232" body="&lt;para>Mit dieser Nachricht teilt die Bauaufsichtsbehörde dem Bauherrn das Ergebnis der Bauabnahme mit und stellt ggf. den Abnahmeschein aus.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1618174799963_248689_17236" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1618174799961_22810_17234" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1618174799965_751752_17239" annotatedElement="_19_0_3_136d03d4_1618174799961_22810_17234" body="&lt;para>Bezug auf den Vorgang einer Nutzungsbeginnanzeige und ggf. auf die Nachricht einer Äußerung zur untersagten Nutzungsaufnahme&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1618174799966_717716_17240" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1618174799964_403910_17238" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619187402769_846814_16934" name="abnahmeErteilt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619187687098_570076_16945" annotatedElement="_19_0_3_136d03d4_1619187402769_846814_16934" body="&lt;para>Falls die Bauabnahme positiv ausgefallen ist und ein Abnahmeschein ausgestellt wird, so wird in diesem Element &quot;true&quot; übermittelt, andernfalls &quot;false&quot;.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1669365759922_940727_20221" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1669365759923_148995_20222" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619187411465_631547_16935" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619187628858_955483_16944" annotatedElement="_19_0_3_136d03d4_1619187411465_631547_16935" body="&lt;para>Falls die Bauabnahme ablehnend ausgefallen ist, wird in diesem Element die entsprechende Begründung geliefert.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619187558308_547626_16942" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619187558309_813087_16943" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1624868615619_389732_17391" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
              <ownedComment xmi:id="_19_0_3_136d03d4_1624868710300_543912_17403" annotatedElement="_19_0_3_136d03d4_1624868615619_389732_17391" body="&lt;para>Hier werden ggf. die Nebenbestimmungen zum erteilten Abnahmeschein eingefügt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1624868815196_689964_17406" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1624868815197_70585_17407" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1624868636942_353736_17392" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
              <ownedComment xmi:id="_19_0_3_136d03d4_1624868726060_120022_17404" annotatedElement="_19_0_3_136d03d4_1624868636942_353736_17392" body="&lt;para>Falls Mängel festgestellt worden sind, kann hier eine Frist eingetragen werden, innerhalb derer die genannten Mängel durch den Bauherrn zu beseitigen sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1624868823504_179841_17408" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1624868823505_456243_17409" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1624868644094_203287_17393" name="anlage" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_136d03d4_1624868755182_924325_17405" annotatedElement="_19_0_3_136d03d4_1624868644094_203287_17393" body="&lt;para>Dieses Element beinhaltet die Metadaten des Bauabnahmescheins.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1624869145701_704937_17416" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1624869145702_716407_17417" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619774820291_479510_17184" name="anzeige.baubeginnBaufreigabe.0902" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1619774924894_756953_17186" annotatedElement="_19_0_3_136d03d4_1619774820291_479510_17184" body="&lt;para>Mit dieser Nachricht erteilt die Bauaufsichtsbehörde den Baufreigabeschein (sog. &quot;Roter Punkt&quot;).&lt;/para>"/>
            <generalization xmi:id="_19_0_3_136d03d4_1619776555609_427249_17201" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619775392217_152815_17187" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619775563683_982014_17189" annotatedElement="_19_0_3_136d03d4_1619775392217_152815_17187" body="&lt;para>Bezug auf den Vorgang einer Baubeginnanzeige und ggf. auf die Nachricht einer Äußerung zum untersagten Baubeginn.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619776726743_315416_17202" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619776726744_321688_17203" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619775399646_665083_17188" name="datenBaufreigabeschein" visibility="private" type="_19_0_3_136d03d4_1618167987509_265374_16937">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619775912828_248322_17190" annotatedElement="_19_0_3_136d03d4_1619775399646_665083_17188" body="&lt;para>Dieses Element enthält die Daten zum Baufreigabeschein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619776731998_603476_17204" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619776731998_291386_17205" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1679317860558_741668_22492" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_972479_23105" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1696230848441_333562_23789" name="anzeige.erklaerungGEG.0903" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1696230848677_566040_23819" annotatedElement="_19_0_4_b6602da_1696230848441_333562_23789" body="&lt;para>Mit dieser Nachricht teilt der Bauherr der Bauaufsichtsbehörde die Erfüllungserklärung nach Gebäudeenergiegesetz (GEG) mit. Diese Nachricht muss für jedes neu zu errichtende Gebäude verschickt werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1696230848684_489430_23826" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696230848678_688929_23820" name="bezug" visibility="private" type="_19_0_4_b6602da_1696231048363_68384_23946">
              <ownedComment xmi:id="_19_0_4_b6602da_1696230848689_801398_23830" annotatedElement="_19_0_4_b6602da_1696230848678_688929_23820" body="&lt;para>Referenz auf ein Vorhaben, ein Bauprojekt bzw. eine Baugenehmigung: abgebildet als Bezug auf einen Vorgang, beispielsweise ein durchlaufenes Baugenehmigungsverfahren mit Bescheid. Der Bescheid kann durch die Übermittlung einer Nachricht baugenehmigung.bescheid.0205 erteilt worden sein. Bei Neubauten sollte die Option &quot;mitAktenzeichen&quot; befüllt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696230848691_526302_23831" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696230848689_734137_23829" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696234716603_248045_24029" name="erklaerenderErfuellungserklaerung" visibility="private" type="_19_0_4_b6602da_1696234823669_746536_24040">
              <ownedComment xmi:id="_19_0_4_b6602da_1696234756393_944357_24037" annotatedElement="_19_0_4_b6602da_1696234716603_248045_24029" body="&lt;para>Hier sind Angaben zum Erklärenden zu machen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696234736046_945080_24032" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696234736047_147233_24033" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696230848682_693338_23824" name="verortung" visibility="private" type="_19_0_3_136d03d4_1611871244693_625845_23369">
              <ownedComment xmi:id="_19_0_4_b6602da_1696230848695_478590_23846" annotatedElement="_19_0_4_b6602da_1696230848682_693338_23824" body="&lt;para>Dieses Element erfasst Angaben zur Lokalisierung des Vorhabens. Dies ist nur bei Hybridverfahren zu befüllen, d. h. wenn zuvor einer analoger Bauantrag eingereicht und eine analoge Baugenehmigung ausgestellt wurde. In diesen Fällen liegen keine digitalen Informationen vor, sodass nicht mittels dem Element &lt;emphasis role=&quot;codebf&quot;>bezug&lt;/emphasis> auf die XBau-Nachrichten referenziert werden kann, um auf die relevanten Angaben zur Verortung des Vorhabens Bezug zu nehmen.&lt;/para> "/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696230848695_45835_23847" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696230848695_663618_23845" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696239551086_321404_24243" name="angabenGebaeude" visibility="private" type="_19_0_4_b6602da_1696236079614_510665_24134">
              <ownedComment xmi:id="_19_0_4_b6602da_1696239630798_795688_24251" annotatedElement="_19_0_4_b6602da_1696239551086_321404_24243" body="&lt;para>Hier sind Angaben zum Gebäude zu machen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696239607088_556048_24249" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696239607089_6910_24250" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696418554191_945407_24013" name="erfuellungserklaerung" visibility="private" type="_19_0_4_b6602da_1696418768050_908174_24022">
              <ownedComment xmi:id="_19_0_4_b6602da_1696418678246_194057_24021" annotatedElement="_19_0_4_b6602da_1696418554191_945407_24013" body="&lt;para>Hier sind Angaben zur Erfüllungserklärung zu machen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1696418589354_70324_24017" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696418589356_822889_24018" name="" visibility="public" value="1"/>
