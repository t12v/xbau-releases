    <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611870246893_430711_7583" name="Akteure &amp; Use Cases" visibility="public" URI="">
      <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611870246900_278267_7584" name="Akteure" visibility="public" URI="">
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246902_789057_7586" name="Bauaufsichtsbehörde" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247457_469361_7631" annotatedElement="_19_0_3_136d03d4_1611870246902_789057_7586" body="&lt;para>Die Bauaufsichtsbehörde (BAB) prüft die Einhaltung der öffentlich-rechtlichen Vorschriften (vgl. §58 Abs.2 MBO).&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246904_263601_7587" name="Bauherr" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247457_427614_7632" annotatedElement="_19_0_3_136d03d4_1611870246904_263601_7587" body="&lt;para>Natürliche oder juristische  Person mit Bauvorhaben oder Bauprojekt. Verantwortlich für das Stellen von Anträgen., Anzeigen und Nachweisen. Bestellung der am Bau Beteiligten. (vgl. §53 MBO)&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246905_579674_7588" name="Prüfsachverständiger" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247458_432225_7633" annotatedElement="_19_0_3_136d03d4_1611870246905_579674_7588" body="&lt;para>Prüft im Auftrag des Bauherrn an Stelle der Bauaufsichtsbehörde. Verantwortlich für die Prufung von bautechnischen Nachweisen unter Beachtung der Schutzziele.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246906_807967_7589" name="Entwurfsverfasser" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247458_632836_7634" annotatedElement="_19_0_3_136d03d4_1611870246906_807967_7589" body="&lt;para>Vom Bauherrn mit der fachlichen Betreuung des Bauvorhabens beauftragt. Kann ein Architekt sein / kann ein  Ingenieur sein.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246907_160324_7590" name="Fachbehörde" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247458_778060_7635" annotatedElement="_19_0_3_136d03d4_1611870246907_160324_7590" body="&lt;para>Behörde mit Expertise für ein Fachgebiet. Nimmt im Beteiligungsverfahren Stellung zu entsprechenden Sach- und Fachfragen.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246908_446292_7591" name="Fachplaner" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247459_566325_7636" annotatedElement="_19_0_3_136d03d4_1611870246908_446292_7591" body="&lt;para>Arbeitet im Auftrag des Entwurfsverfassers. Hat Sachkunde auf speziellen Gebieten.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246908_913128_7592" name="Prüfingenieur" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247459_486009_7637" annotatedElement="_19_0_3_136d03d4_1611870246908_913128_7592" body="&lt;para>Prüft im Auftrag der Bauaufsichtsbehörde als beliehener Unternehmer. Verantwortlich für die Prufung von bautechnischen Nachweisen unter Beachtung der Schutzziele.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246909_567406_7593" name="Zuständige Behörde" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247459_989752_7638" annotatedElement="_19_0_3_136d03d4_1611870246909_567406_7593" body="&lt;para>Diese Behörde prüft, ob die öffentlich-rechtlichen Vorschriften ihres Zuständigkeitsbereichs eingehalten sind.&lt;/para>"/>
          <generalization xmi:id="_19_0_3_c4f030d_1632746086778_324980_18660" general="_19_0_3_940029b_1619933652637_247045_17476"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246909_516735_7594" name="Informationsempfänger" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247459_520827_7639" annotatedElement="_19_0_3_136d03d4_1611870246909_516735_7594" body="&lt;para>Datenempfänger im Rahmen eines Informationsverfahrens.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246910_43159_7595" name="Nachbar" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247460_322355_7640" annotatedElement="_19_0_3_136d03d4_1611870246910_43159_7595" body="&lt;para>Eigentümer eines benachbarten (nach SEVESO III betroffenen) Grundstücks (vgl. §70 Abs. 1). / &lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Actor" xmi:id="_19_0_3_136d03d4_1611870246910_698536_7596" name="Gemeinde" visibility="public">
          <ownedComment xmi:id="_19_0_3_136d03d4_1611870247460_868161_7641" annotatedElement="_19_0_3_136d03d4_1611870246910_698536_7596" body="&lt;para>Gemeinde, in der das Bauvorhaben gelegen ist. Sie ist Trägerin der kommunalen Planungshoheit.&lt;/para>"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611870246911_72139_7597" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611870247460_20461_7642 _19_0_3_136d03d4_1611870247461_27057_7643" navigableOwnedEnd="_19_0_3_136d03d4_1611870247461_27057_7643 _19_0_3_136d03d4_1611870247460_20461_7642">
          <ownedEnd xmi:id="_19_0_3_136d03d4_1611870247460_20461_7642" name="" visibility="private" type="_19_0_3_136d03d4_1611870248198_574201_7696" association="_19_0_3_136d03d4_1611870246911_72139_7597"/>
          <ownedEnd xmi:id="_19_0_3_136d03d4_1611870247461_27057_7643" name="" visibility="private" type="_19_0_3_136d03d4_1611870246904_263601_7587" association="_19_0_3_136d03d4_1611870246911_72139_7597"/>
