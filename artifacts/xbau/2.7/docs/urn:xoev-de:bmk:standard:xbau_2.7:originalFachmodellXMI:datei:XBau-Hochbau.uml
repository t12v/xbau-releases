  <XOEVProfil:xoevCodeliste xmi:id="_ngzhMZDEEfGoGvl6Hw52FA" nameTechnisch="textofficemimetypes" kennung="urn:xoev-de:xbau:codeliste:textofficemimetypes" base_Class="_19_0_3_940029b_1666692668925_476182_9694">
