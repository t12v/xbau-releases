              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1387625291118_990786_5197" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1387625291180_980612_5464 _16_5_4_5b501fb_1387625291316_899749_6025">
                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291316_879477_6024" annotatedElement="_16_5_4_5b501fb_1387625291118_990786_5197" body="Unter &quot;ausweisdokument&quot; werden Informationen zu allen vorkommenden Ausweisarten einer natürlichen Person abgebildet. "/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291316_899749_6025" name="" visibility="private" type="_16_5_4_5b501fb_1387625291102_608193_5164" association="_16_5_4_5b501fb_1387625291118_990786_5197"/>
