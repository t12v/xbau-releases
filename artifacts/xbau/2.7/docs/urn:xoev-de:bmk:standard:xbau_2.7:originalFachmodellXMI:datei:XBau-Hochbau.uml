                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1760601550346_429490_31694" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1760601550346_614516_31695" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b8702dd_1760601508979_50387_31693" name="einwilligungAnsprechpartner" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true">
