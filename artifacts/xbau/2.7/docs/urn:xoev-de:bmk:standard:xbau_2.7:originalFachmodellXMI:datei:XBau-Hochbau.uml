                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598571521_274206_8994" annotatedElement="_19_0_3_129a03b9_1694598571521_16955_8993" body="&lt;para>[nd]&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598571521_629786_8995" name="position" visibility="private" type="_19_0_3_129a03b9_1694598499127_784904_8976" aggregation="composite">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598571521_244203_8997" annotatedElement="_19_0_3_129a03b9_1694598571521_629786_8995" body="&lt;para>Hier sind die Daten zu einer Position der Auslage einzutragen.&lt;/para>"/>
