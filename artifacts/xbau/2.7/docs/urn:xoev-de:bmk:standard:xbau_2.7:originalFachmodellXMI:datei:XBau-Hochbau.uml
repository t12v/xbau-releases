          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115822019_258446_25232" name="statistik.baubeginn.0423" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1714115823240_694972_25485" annotatedElement="_19_0_4_b6602da_1714115822019_258446_25232" body="&lt;para>Diese Nachricht übermittelt der amtlichen Statistik zu einer in der Vergangenheit übermittelten Baugenehmigung, dass mit der Umsetzung des Bauvorhabens begonnen wurde (Baubeginn).&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1714115823244_966801_25491" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823240_780044_25486" name="bezug" visibility="private" type="_19_0_4_b6602da_1714115823078_454737_25385">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823565_64107_25910" annotatedElement="_19_0_4_b6602da_1714115823240_780044_25486" body="&lt;para>Dieses Element nennt den Vorgang der Bauaufsichtsbehörde, aus dem die Informationen entnommen sind.&#xA;Für Zwecke der Bezugnahme auf der Seite der Statistik ist auch die entsprechende Gebäude-UUID und ggf. die Ordnungsnummer der Statistik eingetragen.&#xA;Durch die Baubehörde ist die Gebäude-UUID und Ordnungsnummer zu verwenden, die sie im Rahmen der Statistikmeldung Baugenehmigung bereits verwendet hat.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823565_132756_25911" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823565_372061_25909" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823241_130539_25487" name="allgemeineAngaben" visibility="private" type="_19_0_4_b6602da_1714115823069_702069_25382" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823566_581989_25914" annotatedElement="_19_0_4_b6602da_1714115823241_130539_25487" body="&lt;para>Dieses Element enthält die Daten, die zu jeder Statistikmeldung enthalten sind (alle Anlässe). &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823566_117036_25915" name="" visibility="public" value="1"/>
