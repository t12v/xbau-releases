            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264165_985850_25390" name="produkt" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282083_178604_30085" annotatedElement="_19_0_3_136d03d4_1611871264165_985850_25390" body="&lt;para>In diesem Attribut ist der Name des Produktes (der Software) einzutragen, mit dem diese Nachricht erstellt worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282083_188660_30086" name="" visibility="public" value="1"/>
