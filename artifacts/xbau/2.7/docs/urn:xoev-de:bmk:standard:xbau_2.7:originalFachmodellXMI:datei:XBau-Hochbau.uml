          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1619461293037_566894_16917" name="WeitereBeteiligte" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1726125364313_141260_27797" annotatedElement="_19_0_3_136d03d4_1619461293037_566894_16917" body="&lt;para>Dieser Abschnitt fasst Daten zu weiteren Beteiligten zusammen. Pro Beteiligter ist ein Element zu instanziieren.&#xA;Hat ein weiterer Beteiligter die Rolle &quot;Fachplaner&quot;, &quot;Prüfsachverständiger&quot; oder &quot;Verantwortlicher&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot;, &quot;mitgliedschaftInland&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. Falls die Person nicht im Inland niedergelassen ist, sollte „Ausland“ befüllt werden. &#xA;Hat ein weiterer Beteiligter die Rolle &quot;Prüfingenieur&quot; oder &quot;Prüfsachverständiger&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619461395500_39953_16918" name="beteiligter" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
