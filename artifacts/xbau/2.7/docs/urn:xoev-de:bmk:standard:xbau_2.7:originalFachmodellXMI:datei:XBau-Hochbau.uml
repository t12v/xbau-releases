          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1753083510332_936641_31123" name="Berufsbezeichnung.NachweisbezugType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1753089860915_946468_31351" annotatedElement="_19_0_4_b8702dd_1753083510332_936641_31123" body="&lt;para>Dieser Datentyp enthält die Berufsbezeichnung einer Person.&lt;/para>&#xA;&lt;para>Diese Information kann aus dem Kammerregister abgerufen werden.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1753083580977_856574_31132" name="berufsbezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
