            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823076_205359_25384" name="DatenBaufertigstellung" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823433_475329_25647" annotatedElement="_19_0_4_b6602da_1714115823076_205359_25384" body="&lt;para>Dieser Typ enthält die Daten, die zum Anlass 'Baufertigstellung' gehören.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823433_501723_25651" name="datumBaufertigstellung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                <ownedComment xmi:id="_19_0_4_b6602da_1714115823587_534067_26077" annotatedElement="_19_0_4_b6602da_1714115823433_501723_25651" body="&lt;para>In dieses Element ist das Datum der Baufertigstellung (bzw. Bezugsfertigstellung) einzutragen. Die Baubehörde trägt hier typischerweise das Datum der geplanten Nutzungsaufnahme ein.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823587_468963_26078" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823587_45316_26076" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721719957933_307650_25791" name="aktenbereinigungBaufertigstellung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1721719957939_509922_25793" annotatedElement="_19_0_4_b6602da_1721719957933_307650_25791" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass es sich bei dem übermittelten Datum zur Baufertigstellung um eine Schätzung im Zuge einer Aktenbereinigung handelt. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721719957941_890895_25794" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721719957938_210795_25792" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823078_454737_25385" name="BezugStatistikmeldung" visibility="public">
