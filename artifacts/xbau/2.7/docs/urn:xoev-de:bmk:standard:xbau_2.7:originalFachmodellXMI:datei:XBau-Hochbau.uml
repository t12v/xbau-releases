              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1616761260501_992826_16854" name="" visibility="public" client="_19_0_3_136d03d4_1611871241080_615950_23106" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
