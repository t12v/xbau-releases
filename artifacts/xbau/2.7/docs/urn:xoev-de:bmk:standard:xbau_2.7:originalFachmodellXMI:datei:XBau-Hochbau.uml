              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282212_191853_31196" annotatedElement="_19_0_3_136d03d4_1611871264261_476671_25814" body="&lt;para>Gesamtfläche aller Grundrissebenen des Bauwerks.&lt;/para>"/>
