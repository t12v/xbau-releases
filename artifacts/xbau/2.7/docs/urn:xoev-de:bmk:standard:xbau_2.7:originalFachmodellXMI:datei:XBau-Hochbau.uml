            </node>
            <node xmi:type="uml:CentralBufferNode" xmi:id="_19_0_3_136d03d4_1611871270057_429938_27563" name="Ergebnis der formellen Prüfung&#xA;Nachricht 0502" visibility="public" incoming="_19_0_4_78d0259_1728913473255_782315_30067" outgoing="_19_0_3_136d03d4_1611871270066_656668_27611">
