            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1652712257082_268784_18047" name="einwilligungOeffentlicheBekanntmachungArt" visibility="private" type="_19_0_3_136d03d4_1652712313339_558262_18051">
              <ownedComment xmi:id="_19_0_3_136d03d4_1652712281039_526022_18048" annotatedElement="_19_0_3_136d03d4_1652712257082_268784_18047" body="&lt;para>Falls eingewilligt wird, das Bauvorhaben über konkret definierte Medien öffentlich bekannt zu machen, sind in&#xA;diesem Element diese Medien zu spezifizieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1652712288177_992368_18049" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1652712288177_610048_18050" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1660667455391_257345_18239" name="ZweckDerNutzungsaenderung" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1664552169948_760818_18223" annotatedElement="_19_0_3_129a03b9_1660667455391_257345_18239" body="&lt;para>Wenn das Bauvorhaben eine Nutzungsänderung der baulichen Anlage beabsichtigt, ist in diesem Feld die bisherige und die beabsichtigte Nutzung der baulichen Anlage anzugeben. Es ist jeweils aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1660667485120_33884_18240" name="bisherigeNutzung" visibility="private" type="_19_0_3_136d03d4_1611871244699_746777_23393">
              <ownedComment xmi:id="_19_0_3_129a03b9_1660668727411_288956_18248" annotatedElement="_19_0_3_129a03b9_1660667485120_33884_18240" body="&lt;para>Um den Zweck der Nutzungsänderung näher zu spezifizieren, ist hier die bisherige Nutzung des Gegenstandes vom Bauvorhaben anzugeben. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1664551514886_353394_18218" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1664551514887_306352_18219" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1660667568369_712376_18241" name="beabsichtigteNutzung" visibility="private" type="_19_0_3_136d03d4_1611871244699_746777_23393">
              <ownedComment xmi:id="_19_0_3_129a03b9_1660668983825_379465_18249" annotatedElement="_19_0_3_129a03b9_1660667568369_712376_18241" body="&lt;para>Um den Zweck der Nutzungsänderung näher zu spezifizieren, ist hier die beabsichtigte  Nutzung des Gegenstandes vom Bauvorhaben anzugegeben. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1664551531880_499981_18220" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1664551531880_991482_18221" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1666180418426_300417_18601" name="Anonym_Baudenkmal" visibility="public">
