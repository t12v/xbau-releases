              <ownedAttribute xmi:id="_19_0_4_b6602da_1721639026823_504623_25932" name="anschrift" visibility="private" type="_19_0_3_c4f030d_1635864354709_685445_17884" aggregation="composite">
                <ownedComment xmi:id="_19_0_4_b6602da_1721639026832_16541_25941" annotatedElement="_19_0_4_b6602da_1721639026823_504623_25932" body="&lt;para>In diesem Element wird die Anschrift des Grundstücks eingetragen. Falls dem Grundstück von der Kommune keine Anschrift zugewiesen ist, wird dieses Element nicht instanziiert.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721639026833_653045_25942" name="" visibility="public"/>
