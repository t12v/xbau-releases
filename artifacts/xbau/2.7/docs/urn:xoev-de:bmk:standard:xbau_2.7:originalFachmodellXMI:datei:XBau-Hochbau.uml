            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264259_841935_25807" name="baumassenzahlSoll" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282210_477203_31172" annotatedElement="_19_0_3_136d03d4_1611871264259_841935_25807" body="&lt;para>Baumassenzahl (BMZ) (Soll) nach § 21 Bau NVO.&lt;/para>"/>
