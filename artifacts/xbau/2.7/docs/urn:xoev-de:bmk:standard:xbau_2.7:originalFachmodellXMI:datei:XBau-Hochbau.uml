                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291315_972003_6003" annotatedElement="_16_5_4_5b501fb_1387625291117_476987_5190" body="Angaben zum Gültigkeitszeitraum einer Identifikationsnummer."/>
