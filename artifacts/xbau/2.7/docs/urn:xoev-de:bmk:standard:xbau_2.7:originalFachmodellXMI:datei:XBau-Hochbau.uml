              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282235_385854_31405" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282235_905296_31403" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264276_852712_25884" name="anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282235_302970_31408" annotatedElement="_19_0_3_136d03d4_1611871264276_852712_25884" body="&lt;para>Wenn eine Wohnung sieben oder mehr als sieben Räume hat, ist hier die konkrete Anzahl der Räume anzugeben.&lt;/para>"/>
