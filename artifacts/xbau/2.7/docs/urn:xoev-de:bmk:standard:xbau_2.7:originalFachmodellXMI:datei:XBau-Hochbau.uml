                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598473346_862352_8957" name="position" visibility="private" type="_19_0_3_129a03b9_1694598499127_784904_8976" aggregation="composite">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598473346_192135_8967" annotatedElement="_19_0_3_129a03b9_1694598473346_862352_8957" body="&lt;para>Hier sind die Daten zu einer Position des Gebührenbescheids einzutragen.&lt;/para>"/>
