          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1754476447533_61486_31262" name="ruleset.statistik.01" visibility="public">
            <ownedRule xmi:id="_19_0_4_b8702dd_1753707792092_56879_31642" name="sch-stat-006" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753707792093_872691_31646" annotatedElement="_19_0_4_b8702dd_1753707792092_56879_31642" body="Die angegebene Anzahl Vollgeschosse überschreitet den Maximalwert drei, der für Wohngebäude mit nur einer Wohnung zulässig ist."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753707792093_827135_31645" name="" visibility="public">
                <language>English</language>
                <body>if (exists(xbau:anzahlVollgeschosse) and xbau:angabenGebaeude/xbau:artDesWohngebaeudes/code = ('1','2') and  xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = ('1','2') and xbau:anzahlDerWohnungen/xbau:gesamtanzahlWohnungen = 1) then (xbau:anzahlVollgeschosse &lt;= 3) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1753707792093_217484_31644" name="sch-stat-008" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753707792094_769662_31650" annotatedElement="_19_0_4_b8702dd_1753707792093_217484_31644" body="Die Angabe des Haustyps des Wohngebäudes ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753707792094_548414_31649" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then (not(exists(xbau:angabenGebaeude/xbau:haustypWohngebaeude))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1753707792093_270779_31643" name="sch-stat-007" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753707792093_5904_31648" annotatedElement="_19_0_4_b8702dd_1753707792093_270779_31643" body="Die veranschlagten Baukosten je Kubikmeter liegen außerhalb des Rahmens von 150 bis 400 € bei einem neu errichteten Wohngebäude."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753707792093_905500_31647" name="" visibility="public">
                <language>English</language>
                <body>if (exists(xbau:baukosten[xbau:kostengruppe300 or xbau:kostengruppe400]) and xbau:angabenGebaeude/xbau:artDesWohngebaeudes/code = ('1','2') and xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = ('1','2') and (xbau:bruttoRauminhaltBRI > 0)) then (((xbau:baukosten/xbau:kostengruppe300+xbau:baukosten/xbau:kostengruppe400) div (100*xbau:bruttoRauminhaltBRI) >= 150) and ((xbau:baukosten/xbau:kostengruppe300+xbau:baukosten/xbau:kostengruppe400) div (100*xbau:bruttoRauminhaltBRI) &lt;= 400)) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969400812_939402_31271" name="sch-stat-009" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969400825_548713_31273" annotatedElement="_19_0_4_b8702dd_1756969400812_939402_31271" body="Die Angabe des überwiegend verwendeten Baustoffs ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969400823_28666_31272" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:ueberwiegendVerwendeterBaustoff))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969401783_36508_31274" name="sch-stat-010" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969401785_789610_31276" annotatedElement="_19_0_4_b8702dd_1756969401783_36508_31274" body="Angaben zur Heizung und zur Heizenergie sind nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969401783_980843_31275" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:heizungHeizenergie))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969403216_856383_31277" name="sch-stat-011" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969403216_560768_31279" annotatedElement="_19_0_4_b8702dd_1756969403216_856383_31277" body="Die Angabe des Bruttorauminhalts ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969403216_341327_31278" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:bruttoRauminhaltBRI))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969404016_449681_31280" name="sch-stat-012" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969404016_828456_31282" annotatedElement="_19_0_4_b8702dd_1756969404016_449681_31280" body="Die Angabe der Anzahl der Vollgeschosse ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969404016_222122_31281" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:anzahlVollgeschosse))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969404609_41463_31283" name="sch-stat-013" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969404609_383528_31285" annotatedElement="_19_0_4_b8702dd_1756969404609_41463_31283" body="Die Angabe zu Lüftungsanlagen ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969404609_513095_31284" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:sonstigeLueftungsanlagen))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969405121_896498_31286" name="sch-stat-014" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969405125_594876_31288" annotatedElement="_19_0_4_b8702dd_1756969405121_896498_31286" body="Die Angabe zur Kühlung ist nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969405121_524915_31287" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then (not(exists(xbau:kuehlung))) else true()</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1756969405598_320669_31289" name="sch-stat-015" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1756969405598_541883_31291" annotatedElement="_19_0_4_b8702dd_1756969405598_320669_31289" body="Angaben zur Erfüllung des Gebäudeenergiegesetzes sind nur für Neubauten zulässig."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1756969405598_548993_31290" name="" visibility="public">
                <language>English</language>
                <body>if (xbau:baugenehmigung/xbau:artDerBautaetigkeit/code = '3') then ( not(exists(xbau:erfuellungGEG))) else true()</body>
              </specification>
            </ownedRule>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1754476546279_40511_31266" name="" visibility="public" client="_19_0_4_b8702dd_1754476447533_61486_31262" supplier="_19_0_4_b6602da_1714115823086_573174_25388"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1754476557755_881599_31267" name="" visibility="public" client="_19_0_4_b8702dd_1754476447533_61486_31262" supplier="_19_0_4_b6602da_1726571206703_949495_28380"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1754477270740_259672_31451" name="ruleset.statistik.03" visibility="public">
            <ownedRule xmi:id="_19_0_4_b8702dd_1753710605043_146615_31676" name="sch-stat-002" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753710605044_323371_31678" annotatedElement="_19_0_4_b8702dd_1753710605043_146615_31676" body="Der Bauherr muss angegeben werden."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753710605043_7543_31677" name="" visibility="public">
                <language>English</language>
                <body>not(normalize-space(//xbau:bauherr//familienname/name) = '' and normalize-space(//xbau:bauherr/organisation/name) = '')</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1755515914709_138278_31743" name="sch-stat-001" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1755515914715_987815_31745" annotatedElement="_19_0_4_b8702dd_1755515914709_138278_31743" body="Die Angabe des Bundeslandes fehlt."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1755515914714_72490_31744" name="" visibility="public">
                <language>English</language>
                <body>exists(//xbau:flurstueck/bundesland)</body>
              </specification>
            </ownedRule>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1754477347488_918402_31455" name="" visibility="public" client="_19_0_4_b8702dd_1754477270740_259672_31451" supplier="_19_0_4_b6602da_1714115823069_702069_25382"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1754477357392_809089_31456" name="" visibility="public" client="_19_0_4_b8702dd_1754477270740_259672_31451" supplier="_19_0_4_b6602da_1726566387590_811697_28116"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1754391572868_945441_31438" name="ruleset.statistik.04" visibility="public">
            <ownedRule xmi:id="_19_0_4_b8702dd_1753433706920_431938_31374" name="sch-stat-005" visibility="public" constrainedElement="_19_0_3_136d03d4_1611871246540_458471_23565">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753433706962_81620_31419" annotatedElement="_19_0_4_b8702dd_1753433706920_431938_31374" body="Bei Wohnungen mit sieben oder mehr Räumen muss die Gesamtzahl der Räume mindestens das Siebenfache der Wohnungsanzahl betragen. Die angegebene Raumanzahl ist zu gering."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753433706962_909316_31418" name="" visibility="public">
                <language>English</language>
                <body>not(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen &lt; 7*xbau:anzahlWohnungen)</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1753433706920_923999_31373" name="sch-stat-004" visibility="public" constrainedElement="_19_0_3_136d03d4_1611871246540_458471_23565">
              <ownedComment xmi:id="_19_0_4_b8702dd_1753433706962_305718_31417" annotatedElement="_19_0_4_b8702dd_1753433706920_923999_31373" body="Wenn die Wohnungskategorie &quot;7 oder mehr als 7 Räume&quot; gewählt wird, muss die Anzahl der Räume angegeben werden und umgekehrt."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1753433706962_442226_31416" name="" visibility="public">
                <language>English</language>
                <body>if (exists(xbau:kategorie)) then ((xbau:kategorie/code='7' and exists(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen)) or (xbau:kategorie/code != '7' and not(exists(xbau:anzahlRaeumebeiWohnungenMitSiebenOderMehrRaeumen)))) else true()</body>
              </specification>
            </ownedRule>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1755525117456_67519_31757" name="" visibility="public" client="_19_0_4_b8702dd_1754391572868_945441_31438" supplier="_19_0_4_b6602da_1721382124872_703313_25307"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_129a03b9_1715339742997_974829_25845" name="Angrenzer" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1708002012670_87284_24651" name="angrenzer.stellungnahme.0310" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1708002012711_542072_24681" annotatedElement="_19_0_3_129a03b9_1708002012670_87284_24651" body="&lt;para>Diese Nachricht verwendet die beteiligte Partei, um der  Bauaufsichtsbehörde ihre Stellungnahme zuzustellen. &#xA;&lt;/para>&#xA;&lt;para>&#xA;In der Regel werden die Nachbarn und die Inhaber von angrenzenden Grundstücken von der Bauaufsichtsbehörde zur Stellungnahme über den eingereichten Bauantrag aufgerufen und antworten daraufhin mit dieser Nachricht.&lt;/para>"/>
            <generalization xmi:id="_19_0_3_129a03b9_1708002012714_381489_24685" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1708002012713_346579_24683" name="referenzAufforderung" visibility="private" type="_19_0_4_b6602da_1697611488329_265944_24730">
              <ownedComment xmi:id="_19_0_3_129a03b9_1708002012715_489243_24693" annotatedElement="_19_0_3_129a03b9_1708002012713_346579_24683" body="&lt;para>Eine eindeutige Kennung des Akteneinsichtvorgangs. Die zu beteiligende Partei bezieht sich in ihren Reaktionsnachrichten auf diese Kennung. Die Kennung ist in der Regel in dem Brief zu finden, mit dem der Empfänger zur Beteiligung zugelassen oder aufgefordert  wurde.  &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708002012716_469388_24694" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708002012715_223372_24692" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1709042156626_206079_24927" name="stellungnahme" visibility="private" type="_19_0_3_129a03b9_1708002949618_225493_24878" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_129a03b9_1709042156629_727652_24931" annotatedElement="_19_0_3_129a03b9_1709042156626_206079_24927" body="&lt;para>Unterhalb dieses Elements ist die Stellungnahme eingefügt, die aus der Einsichtnahme durch die beteiligte Partei hervorgegangen ist.&lt;/para>&#xA;&lt;para>Um hier eine strukturierte Stellungnahme einzutragen, ist eine bestimmte Form bei der Dokumentation der Stellungnahme einzuhalten. Es sind die Parameter dieses Objekts zu füllen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1709042156630_90136_24932" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1709042156629_905462_24930" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1715350109743_568053_25869" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_129a03b9_1715350109744_287884_25871" annotatedElement="_19_0_3_129a03b9_1715350109743_568053_25869" body="&lt;para>Die für das Verständnis der Stellungnahme notwendigen Bauvorlagen werden in diesem Objekt eingefügt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1715350109744_639657_25872" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1715350109744_424376_25870" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_129a03b9_1715349678710_925277_25861" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1708002949618_225493_24878" name="Anonym_StellungnahmeAngrenzer" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1708002949620_298591_24879" annotatedElement="_19_0_3_129a03b9_1708002949618_225493_24878" body="&#xA;"/>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708002949620_321455_24880" name="istZustimmung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708002949621_552303_24882" annotatedElement="_19_0_3_129a03b9_1708002949620_321455_24880" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass die Stellungnahme positiv ausgefallen ist (Zustimmung).&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708002949621_851194_24883" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708002949620_709041_24881" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1715959338366_585191_25200" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708002996366_613767_24888" name="istZustimmungMitVoraussetzung" visibility="private" type="_19_0_3_129a03b9_1708003046027_9198_24895" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708002996367_220810_24890" annotatedElement="_19_0_3_129a03b9_1708002996366_613767_24888" body="&lt;para>Falls die Stellungnahme positiv ausfällt, sofern bestimmte Voraussetzungen umgesetzt werden (Zustimmung mit Voraussetzung), wird diese Option gewählt und die erforderliche Voraussetzung ist zu erläutern.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708002996367_829280_24891" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708002996366_30208_24889" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708003166147_135049_24962" name="keineZustimmung" visibility="private" type="_19_0_3_129a03b9_1708003137815_504172_24946" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708003166148_582382_24964" annotatedElement="_19_0_3_129a03b9_1708003166147_135049_24962" body="&lt;para>Falls die Stellungnahme negativ ausgefallen ist (keine Zustimmung), wird diese Option gewählt und die Begründung ist zu erläutern.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708003166148_176789_24965" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708003166148_646226_24963" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1708003046027_9198_24895" name="Anonym_istZustimmungMitVoraussetzung" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1708003046028_710621_24896" annotatedElement="_19_0_3_129a03b9_1708003046027_9198_24895" body="&lt;para>Dieser Typ beinhaltet die Stellungnahme, den die beteiligte Partei für die Zustellung ihrer Stellungnahme verwenden kann.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708003069506_819169_24939" name="istZustimmungMitVoraussetzung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708003069507_897673_24941" annotatedElement="_19_0_3_129a03b9_1708003069506_819169_24939" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass die Stellungnahme positiv ausfällt, sofern bestimmte Voraussetzungen umgesetzt werden (Zustimmung mit Voraussetzung).&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708003069507_798632_24942" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708003069507_577052_24940" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1715959354070_934323_25201" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708003046029_471633_24900" name="voraussetzung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708003046033_136335_24916" annotatedElement="_19_0_3_129a03b9_1708003046029_471633_24900" body="&lt;para>Hier werden ggf. Nebenbestimmungen zur Stellungnahme eingefügt.&lt;/para>"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708003046033_299813_24917" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708003046033_896718_24915" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1708003137815_504172_24946" name="Anonym_keineZustimmung" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1708003137816_193091_24947" annotatedElement="_19_0_3_129a03b9_1708003137815_504172_24946" body="&lt;para>Dieser Typ beinhaltet die Stellungnahme, den die beteiligte Partei für die Zustellung ihrer Stellungnahme verwenden kann.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708003137816_140362_24948" name="keineZustimmung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true" aggregation="composite">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708003137818_958922_24951" annotatedElement="_19_0_3_129a03b9_1708003137816_140362_24948" body="&lt;para>Durch die Übermittlung dieses Elements wird mitgeteilt, dass die Stellungnahme negativ ausgefallen ist (keine Zustimmung).&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708003137818_275957_24952" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708003137818_315668_24950" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_129a03b9_1715959719626_525601_25204" name="" visibility="public" value="true"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_3_129a03b9_1708003198677_113934_24969" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                <ownedComment xmi:id="_19_0_3_129a03b9_1708003198678_457965_24971" annotatedElement="_19_0_3_129a03b9_1708003198677_113934_24969" body="&lt;para>Falls die Stellungnahme nicht zustimmend ausgefallen ist, wird in diesem Element die entsprechende Begründung geliefert.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1708003198679_880122_24972" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1708003198678_55144_24970" name="" visibility="public" value="*"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1715351118213_484152_25878" name="" visibility="public" client="_19_0_3_129a03b9_1715339742997_974829_25845" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1715351242399_63072_25880" name="" visibility="public" client="_19_0_3_129a03b9_1715339742997_974829_25845" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b6602da_1754548351407_481997_31605" name="Baulastloeschung" visibility="public" URI="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1754548351419_454463_31606" name="" visibility="public" client="_19_0_4_b6602da_1754548351407_481997_31605" supplier="_19_0_3_136d03d4_1611871239053_307374_22661"/>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b6602da_1754548351435_260086_31610" name="Datentypen" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1754548351777_342178_31698" name="Anonym_Entscheidung" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351995_301137_31932" annotatedElement="_19_0_4_b6602da_1754548351777_342178_31698" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Bescheides, den die Bauaufsichtsbehörde nach Prüfung eines Antrags erlässt.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351995_954148_31933" name="baulastloeschungAkzeptiert" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                <ownedComment xmi:id="_19_0_4_b6602da_1754548352021_393321_32068" annotatedElement="_19_0_4_b6602da_1754548351995_954148_31933" body="&lt;para>Falls die Baulastlöschung akzeptiert und die Baulast gelöscht wurde, ist hier 'true' zu übermitteln, anderenfalls 'false'.&lt;/para>&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352021_583191_32069" name="" visibility="public" value="1"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352016_131549_32067" name="" visibility="public" value="1"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351995_707211_31934" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                <ownedComment xmi:id="_19_0_4_b6602da_1754548352021_468293_32072" annotatedElement="_19_0_4_b6602da_1754548351995_707211_31934" body="&lt;para>Falls die Baulastlöschung durch die Behörde nicht akzeptiert und die Baulast nicht gelöscht wurde, wird in diesem Element die Begründung für diese Entscheidung geliefert.&lt;/para>&#xA;&#xA;"/>
                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352021_685771_32073" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352021_456005_32071" name="" visibility="public" value="1"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b6602da_1754548351438_826519_31611" name="" visibility="public" client="_19_0_4_b6602da_1754548351407_481997_31605" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1754548351440_906143_31613" name="baulastloeschung.antrag.0720" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1754548351865_219543_31765" annotatedElement="_19_0_4_b6602da_1754548351440_906143_31613" body="&lt;para>Diese Nachricht dient dazu, der Bauaufsichtsbehörde den Antrag auf Baulastlöschung sowie ergänzende Dokumentationen zuzustellen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1754548351869_791229_31769" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351867_444403_31766" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351999_84412_31957" annotatedElement="_19_0_4_b6602da_1754548351867_444403_31766" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die Behörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548351999_781787_31958" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548351999_93921_31956" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351867_303024_31767" name="baulast" visibility="private" type="_19_0_4_b6602da_1750072055173_159705_31347" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351999_16741_31961" annotatedElement="_19_0_4_b6602da_1754548351867_303024_31767" body="&lt;para>Hier werden die Informationen zur zu löschenden Baulast angegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548351999_134993_31962" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548351999_888492_31960" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351867_132434_31768" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351999_153435_31965" annotatedElement="_19_0_4_b6602da_1754548351867_132434_31768" body="&lt;para>Hier können Anlagen eingefügt werden, die für die Löschung der Baulast relevant sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548351999_904257_31966" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548351999_729163_31964" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1754548351442_106237_31614" name="baulastloeschung.nachforderung.0721" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1754548351916_3131_31800" annotatedElement="_19_0_4_b6602da_1754548351442_106237_31614" body="&lt;para>Diese Nachricht enthält die Befunde der Bauaufsichtsbehörde zum eingereichten Antrag auf Löschung der Baulast.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1754548351926_95905_31803" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351916_35119_31801" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351999_621790_31973" annotatedElement="_19_0_4_b6602da_1754548351916_35119_31801" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt und die Nachricht baulastloeschung.antrag.0720 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548351999_142604_31974" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548351999_735634_31972" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351916_345669_31802" name="befundliste" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548351999_792782_31977" annotatedElement="_19_0_4_b6602da_1754548351916_345669_31802" body="&lt;para>Hier sind die Ergebnisse der formellen Prüfung enthalten. Die Liste nennt die  Mängel, die bei der Prüfung der Baulast-Löschung aufgefallen sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548351999_163212_31978" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548351999_145887_31976" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758010363979_452849_31646" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758010363983_171505_31648" annotatedElement="_19_0_4_b6602da_1758010363979_452849_31646" body="&lt;para>Hier können Anlagen eingefügt werden, die für die Nachforderung der Löschung der Baulast relevant sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758010363985_618485_31649" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758010363983_990628_31647" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1754548351442_628230_31615" name="baulastloeschung.information.0726" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1754548351947_926651_31834" annotatedElement="_19_0_4_b6602da_1754548351442_628230_31615" body="&lt;para>Die Akteure, die die Baulastlöschung vorgelegt haben, werden durch diese Nachricht über das Ergebnis der Prüfung informiert.&lt;/para>&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1754548351947_545160_31838" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351947_189074_31835" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548352005_612345_31984" annotatedElement="_19_0_4_b6602da_1754548351947_189074_31835" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt.&#xA;Falls der Vorgang der Baulastlöschung durch einen Antrag ausgelöst wurde, wird auch die Nachricht baulastloeschung.antrag.0720 genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352005_26228_31985" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352005_763021_31983" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351947_343568_31836" name="sachverhalt" visibility="private" type="_19_0_4_b6602da_1754548351777_342178_31698">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548352005_677941_31988" annotatedElement="_19_0_4_b6602da_1754548351947_343568_31836" body="&lt;para>Dieses Element enthält die Ergebnisse der Prüfung der Baulastlöschung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352005_302568_31989" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352005_434225_31987" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351947_123104_31837" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548352005_59223_31992" annotatedElement="_19_0_4_b6602da_1754548351947_123104_31837" body="&lt;para>Hier ist im Erfolgsfall die Dokumentation der vorgenommenen Löschung des Eintrags im Baulastenverzeichnis enthalten.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352005_933996_31993" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352005_289104_31991" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1754548351442_851112_31616" name="baulastloeschung.loeschungEintrag.0725" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1754548351982_363940_31869" annotatedElement="_19_0_4_b6602da_1754548351442_851112_31616" body="&lt;para>Diese Nachricht dient dazu, eine Löschung einer Baulast im Baulastenverzeichnis anzustoßen.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1754548351982_831866_31872" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351982_881003_31870" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548352005_565056_31999" annotatedElement="_19_0_4_b6602da_1754548351982_881003_31870" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt.&#xA;Falls der Vorgang der Baulastlöschung durch einen Antrag ausgelöst wurde, wird auch die Nachricht baulastloeschung.antrag.0720 genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352005_99184_32000" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352005_463068_31998" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1754548351982_367309_31871" name="baulast" visibility="private" type="_19_0_4_b6602da_1750072055173_159705_31347" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1754548352005_634672_32003" annotatedElement="_19_0_4_b6602da_1754548351982_367309_31871" body="&lt;para>Hier werden Angaben zur zu löschenden Baulast gemacht. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1754548352005_234369_32004" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1754548352005_60647_32002" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1758102015797_950900_32593" name="baulastloeschung.stellungnahmeAufforderung.0723" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1758102015859_521545_32623" annotatedElement="_19_0_4_b6602da_1758102015797_950900_32593" body="&lt;para>Diese Nachricht enthält die Aufforderung zur Stellungnahme der Baulastlöschung.&lt;/para>&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1758102015859_254872_32627" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758102015859_786208_32624" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1758102015862_908003_32631" annotatedElement="_19_0_4_b6602da_1758102015859_786208_32624" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt.&#xA;Falls der Vorgang der Baulastlöschung durch einen Antrag ausgelöst wurde, wird auch die Nachricht baulastloeschung.antrag.0720 genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758102015862_270100_32632" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758102015862_591244_32630" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758102377803_206469_32806" name="aufforderungStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758102377803_8107_32808" annotatedElement="_19_0_4_b6602da_1758102377803_206469_32806" body="&lt;para>In dieses Element wird die Aufforderung zur Stellungnahme eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758102377803_896968_32809" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758102377803_550923_32807" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758102458933_108773_32830" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758102458934_27516_32832" annotatedElement="_19_0_4_b6602da_1758102458933_108773_32830" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist eingetragen werden, innerhalb derer die Stellungnahme einzureichen ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758102458934_908195_32833" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758102458933_19260_32831" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758102015859_174055_32626" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758102015865_132159_32639" annotatedElement="_19_0_4_b6602da_1758102015859_174055_32626" body="&lt;para>Hier können im Bedarfsfall Anlagen übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758102015865_403835_32640" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758102015864_60404_32638" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1758107183579_722469_32869" name="baulastloeschung.stellungnahme.0724" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1758107183604_353793_32899" annotatedElement="_19_0_4_b6602da_1758107183579_722469_32869" body="&lt;para>Diese Nachricht enthält die Stellungnahme zur Baulastlöschung.&lt;/para>&#xA;&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1758107183605_375260_32904" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758107183604_912601_32900" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1758107183606_410449_32908" annotatedElement="_19_0_4_b6602da_1758107183604_912601_32900" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt.&#xA;Falls der Vorgang der Baulastlöschung durch einen Antrag ausgelöst wurde, wird auch die Nachricht baulastloeschung.antrag.0720 genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758107183606_635639_32909" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758107183606_703181_32907" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758107183604_768347_32901" name="stellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758107183607_125116_32912" annotatedElement="_19_0_4_b6602da_1758107183604_768347_32901" body="&lt;para>In dieses Element wird die Stellungnahme eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758107183607_938040_32913" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758107183606_525884_32911" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1758107183605_513598_32903" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1758107183608_769457_32920" annotatedElement="_19_0_4_b6602da_1758107183605_513598_32903" body="&lt;para>Hier können im Bedarfsfall Anlagen übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1758107183608_849361_32921" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1758107183608_289600_32919" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1760020510745_151503_32227" name="baulastloeschung.korrekturAntrag.0722" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1760020510765_764483_32257" annotatedElement="_19_0_4_b6602da_1760020510745_151503_32227" body="&lt;para>Diese Nachricht enthält eine Korrektur zum Antrag der Baulastlöschung. Sie bezieht sich also auf einen bereits gestellten Antrag und ist eine Reaktion auf eine zum Antrag vorliegenden Mängelliste der Behörde.&lt;/para>&#xA;&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1760020510765_805640_32261" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760021082928_151478_32447" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1760021082928_391321_32449" annotatedElement="_19_0_4_b6602da_1760021082928_151478_32447" body="&lt;para>In diesem Element wird der laufende Vorgang der Bearbeitung der Baulastlöschung genannt und die Nachricht baulastloeschung.antrag.0720 genannt, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760021082928_254850_32450" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760021082928_603156_32448" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760020510765_211901_32259" name="baulast" visibility="private" type="_19_0_4_b6602da_1750072055173_159705_31347" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1760020510772_376235_32269" annotatedElement="_19_0_4_b6602da_1760020510765_211901_32259" body="&lt;para>Hier werden die Informationen zur zu löschenden Baulast angegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760020510772_214859_32270" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760020510772_891960_32268" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1760020510765_266281_32260" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737" aggregation="composite">
              <ownedComment xmi:id="_19_0_4_b6602da_1760020510773_733989_32273" annotatedElement="_19_0_4_b6602da_1760020510765_266281_32260" body="&lt;para>Hier können Anlagen eingefügt werden, die für die Löschung der Baulast relevant sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1760020510773_642665_32274" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1760020510772_782225_32272" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
        </packagedElement>
