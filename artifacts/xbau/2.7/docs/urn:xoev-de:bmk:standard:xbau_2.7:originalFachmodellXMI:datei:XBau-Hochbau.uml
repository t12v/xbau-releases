    <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611870219010_196832_7582" name="Externe Modelle" visibility="public" URI="">
      <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1618236191328_282896_16855" name="XBau-Kernmodul" visibility="public" URI="">
        <packagedElement xmi:type="uml:Model" xmi:id="_16_5_4_1d100e5_1384794823532_59933_328" name="XBau-Kernmodul" visibility="public" URI="" viewpoint="">
          <packagedElement xmi:type="uml:Dependency" xmi:id="_16_5_4_5b501fb_1398421542326_660552_1933" name="" visibility="public" client="_16_5_4_1d100e5_1384794823532_59933_328" supplier="_16_5_4_5b501fb_1375258090807_886576_2132"/>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1614869261849_45392_9315" name="Dienste" visibility="public" URI="">
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1686153217981_727178_8802" name="anBauportal" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1686153217983_331430_8803" annotatedElement="_19_0_3_129a03b9_1686153217981_727178_8802" body="&lt;head>&lt;title>Datenübermittlungen allgemeiner Prozessnachrichten an die Online-Bauportale&lt;/title>&lt;/head>&#xA;&lt;body>&lt;p>Folgende Nachrichten des XBau-Schemas sind als Input der Operation &lt;i>sendeAnBauportal&lt;/i>zulässig:&#xA;&lt;ul>&amp;servicelist;&lt;/ul>&lt;/p>&#xA;&#xA;&lt;p>Organisationsschlüssel für &lt;i>find.servicedescription&lt;/i>-Anfragen sind die 12-stelligen Schlüssel für die Bauportale; der zu verwendende Präfix lautet &#xA;&quot;&lt;b>bap&lt;/b>&quot;.&lt;/p>&#xA;&#xA;&lt;p>Zulässige Dienstanbieter sind ausschließlich Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bauportal&lt;/b>&quot;. &#xA;Zulässige Dienstnutzer sind Organisationen der DVDV-Organisationskategorien &#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;, &#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;, &#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>&quot;.&lt;/p>&lt;/body>"/>
              <generalization xmi:id="_19_0_3_129a03b9_1686155496725_788834_8894" general="_19_0_3_129a03b9_1686153299885_829486_8830"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1686153260902_931193_8816" name="anFachbehoerde" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1686153260905_271678_8817" annotatedElement="_19_0_3_129a03b9_1686153260902_931193_8816" body="&lt;head>&lt;title>Datenübermittlungen allgemeiner Prozessnachrichten an die Fachbehörden&lt;/title>&lt;/head>&#xA;&lt;body>&lt;p> Folgende Nachrichten des XBau-Schemas sind als Input der Operation &lt;i>sendeAnFachbehoerde&lt;/i> zulässig:&#xA;&lt;ul>&amp;servicelist;&lt;/ul>&lt;/p>&#xA;&#xA;&lt;p>Organisationsschlüssel für &lt;i>find.servicedescription&lt;/i>-Anfragen sind die Fachbehörden von XBau/XTiefbau; die zu verwendende Präfixe lauten &#xA;&quot;&lt;b>dbs&lt;/b>&quot;,&#xA;&quot;&lt;b>bab&lt;/b>&quot;,&#xA;&quot;&lt;b>gba&lt;/b>&quot;,&#xA;&quot;&lt;b>aik&lt;/b>&quot;,&#xA;&quot;&lt;b>bet&lt;/b>&quot;,&#xA;&quot;&lt;b>pin&lt;/b>&quot;,&#xA;&quot;&lt;b>sbb&lt;/b>&quot;,&#xA;&quot;&lt;b>svb&lt;/b>&quot;,&#xA;&quot;&lt;b>bap&lt;/b>&quot;.&#xA;&#xA;Zulässige Dienstanbieter sind Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bundesbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Gemeindebauamt&lt;/b>&quot;,&#xA;&quot;&lt;b>Architekten- und Ingenieurkammer&lt;/b>&quot;,&#xA;&quot;&lt;b>Amtsgericht&lt;/b>&quot;,&#xA;&quot;&lt;b>Baubeteiligte Stelle&lt;/b>&quot;,&#xA;&quot;&lt;b>Prüfingenieur&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>. &#xA;&#xA;Zulässige Dienstnutzer sind ausschließlich Organisationen in der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bauportal&lt;/b>&quot;.&lt;/p>&lt;/body>"/>
              <generalization xmi:id="_19_0_3_129a03b9_1686155544140_39792_8895" general="_19_0_3_129a03b9_1686153299885_829486_8830"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1686153299885_829486_8830" name="Asynchron" visibility="public"/>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1686153346668_278102_8844" name="FachlicheKommunikation" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1686153346669_566917_8845" annotatedElement="_19_0_3_129a03b9_1686153346668_278102_8844" body="&lt;head>&lt;title>Nachricht für die verfahrensbegleitende fachliche Kommunikation.&lt;/title>&lt;/head>&#xA;&lt;body>&lt;p> Folgende Nachrichten des XBau-Kernmoduls sind als Input der Operation &lt;i>sendeRueckweisung&lt;/i> zulässig:&#xA; &lt;ul>&amp;servicelist;&lt;/ul>&lt;/p>&#xA;&#xA;&lt;p>Organisationsschlüssel für &lt;i>find.servicedescription&lt;/i>-Anfragen sind die Fachbehörden von XBau/XTiefbau; die zu verwendende Präfixe lauten &#xA;&quot;&lt;b>dbs&lt;/b>&quot;,&#xA;&quot;&lt;b>bab&lt;/b>&quot;,&#xA;&quot;&lt;b>gba&lt;/b>&quot;,&#xA;&quot;&lt;b>aik&lt;/b>&quot;,&#xA;&quot;&lt;b>bet&lt;/b>&quot;,&#xA;&quot;&lt;b>pin&lt;/b>&quot;,&#xA;&quot;&lt;b>sbb&lt;/b>&quot;,&#xA;&quot;&lt;b>svb&lt;/b>&quot;,&#xA;&quot;&lt;b>bap&lt;/b>&quot;.&lt;/p>&#xA;&#xA;&lt;p>Zulässige Dienstanbieter sind Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bundesbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Gemeindebauamt&lt;/b>&quot;,&#xA;&quot;&lt;b>Architekten- und Ingenieurkammer&lt;/b>&quot;,&#xA;&quot;&lt;b>Amtsgericht&lt;/b>&quot;,&#xA;&quot;&lt;b>Baubeteiligte Stelle&lt;/b>&quot;,&#xA;&quot;&lt;b>Prüfingenieur&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>.&#xA;&#xA;Zulässige Dienstnutzer sind ebenfalls Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bundesbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Gemeindebauamt&lt;/b>&quot;,&#xA;&quot;&lt;b>Architekten- und Ingenieurkammer&lt;/b>&quot;,&#xA;&quot;&lt;b>Amtsgericht&lt;/b>&quot;,&#xA;&quot;&lt;b>Baubeteiligte Stelle&lt;/b>&quot;,&#xA;&quot;&lt;b>Prüfingenieur&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>.&#xA;&#xA;&lt;/p>&lt;/body>"/>
              <generalization xmi:id="_19_0_3_129a03b9_1686155562398_916077_8896" general="_19_0_3_129a03b9_1686153299885_829486_8830"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1686153386257_974924_8858" name="Rueckweisung" visibility="public">
              <ownedComment xmi:id="_19_0_3_129a03b9_1686153386258_10639_8859" annotatedElement="_19_0_3_129a03b9_1686153386257_974924_8858" body="&lt;head>&lt;title>Ein Kommunikationspartner bei XBau/XTiefbau weist eine nicht spezifikationskonforme Nachricht ab.&lt;/title>&lt;/head>&#xA; &lt;body>&lt;p>&#xA; Folgende Nachrichten des XBau-Kernmoduls sind als Input der Operation &lt;i>sendeRueckweisung&lt;/i> zulässig:&#xA; &lt;ul>&amp;servicelist;&lt;/ul>&lt;/p>&#xA;&#xA;&lt;p>Organisationsschlüssel für &lt;i>find.servicedescription&lt;/i>-Anfragen sind die Fachbehörden von XBau/XTiefbau; die zu verwendende Präfixe lauten &#xA;&quot;&lt;b>dbs&lt;/b>&quot;,&#xA;&quot;&lt;b>bab&lt;/b>&quot;,&#xA;&quot;&lt;b>gba&lt;/b>&quot;,&#xA;&quot;&lt;b>aik&lt;/b>&quot;,&#xA;&quot;&lt;b>bet&lt;/b>&quot;,&#xA;&quot;&lt;b>pin&lt;/b>&quot;,&#xA;&quot;&lt;b>sbb&lt;/b>&quot;,&#xA;&quot;&lt;b>svb&lt;/b>&quot;,&#xA;&quot;&lt;b>bap&lt;/b>&quot;.&lt;/p>&#xA;&#xA;&lt;p>Zulässige Dienstanbieter sind Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bundesbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Gemeindebauamt&lt;/b>&quot;,&#xA;&quot;&lt;b>Architekten- und Ingenieurkammer&lt;/b>&quot;,&#xA;&quot;&lt;b>Amtsgericht&lt;/b>&quot;,&#xA;&quot;&lt;b>Baubeteiligte Stelle&lt;/b>&quot;,&#xA;&quot;&lt;b>Prüfingenieur&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>.&#xA;&#xA;Zulässige Dienstnutzer sind ebenfalls Organisationen der DVDV-Organisationskategorie &#xA;&quot;&lt;b>Bundesbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauaufsichtsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Gemeindebauamt&lt;/b>&quot;,&#xA;&quot;&lt;b>Architekten- und Ingenieurkammer&lt;/b>&quot;,&#xA;&quot;&lt;b>Amtsgericht&lt;/b>&quot;,&#xA;&quot;&lt;b>Baubeteiligte Stelle&lt;/b>&quot;,&#xA;&quot;&lt;b>Prüfingenieur&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenbaubehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Straßenverkehrsbehörde&lt;/b>&quot;,&#xA;&quot;&lt;b>Bauportal&lt;/b>.&#xA;&#xA;&lt;/p>&lt;/body>"/>
              <generalization xmi:id="_19_0_3_129a03b9_1686155573795_188781_8897" general="_19_0_3_129a03b9_1686153299885_829486_8830"/>
            </packagedElement>
