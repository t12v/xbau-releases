          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1728384229446_765580_29301" name="MerkmaleKammerneintragErweitert" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1728384229450_619447_29302" annotatedElement="_19_0_4_b6602da_1728384229446_765580_29301" body="&lt;para>Dieser Typ deckt die ID-Merkmale ab, die eine Person als Eintrag im Verzeichnis einer Architekten- oder Ingenieurkammer hat.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1728384396204_187632_29323" general="_19_0_3_136d03d4_1611871246575_542891_23652"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1728384444827_987776_29325" name="name" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103" aggregation="composite">
