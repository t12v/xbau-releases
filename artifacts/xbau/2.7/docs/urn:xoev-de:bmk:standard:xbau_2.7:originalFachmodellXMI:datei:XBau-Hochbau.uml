        <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728910807055_626882_29519" name="" visibility="public" client="_19_0_3_136d03d4_1611871239053_307374_22661" supplier="_19_0_4_78d0259_1728657130758_501592_10029"/>
