          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1752843403629_55149_31932" name="MerkmaleKammerneintrag.NachweisbezugType" visibility="public">
            <ownedComment xmi:id="_19_0_4_b8702dd_1752845529657_298956_31958" annotatedElement="_19_0_4_b8702dd_1752843403629_55149_31932" body="&lt;para>Dieser Typ deckt die ID-Merkmale ab, die eine Person als Eintrag im Verzeichnis einer Architekten- oder Ingenieurkammer hat.&lt;/para>&#xA;&lt;para>Die enthaltenen Merkmale können aus dem Kammerregister abgerufen werden.&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b8702dd_1752843515264_343734_31934" general="_19_0_3_136d03d4_1611871246575_542891_23652"/>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1752843552756_304332_31935" name="nachweisbezug" visibility="private" type="_19_0_4_b8702dd_1752843163628_281618_31760">
              <ownedComment xmi:id="_19_0_4_b8702dd_1752845458214_414579_31957" annotatedElement="_19_0_4_b8702dd_1752843552756_304332_31935" body="&lt;para>Mit diesem Element wird der Bezug zu einem XNachweis-Abruf aus dem Kammernverzeichnis hergestellt. Das Element ist nur bei erfolgreichem Datenabruf zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1752843578424_587379_31936" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1752843578424_144802_31937" name="" visibility="public" value="1"/>
