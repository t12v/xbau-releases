            </node>
            <node xmi:type="uml:CentralBufferNode" xmi:id="_19_0_3_136d03d4_1611871270055_82205_27561" name="Beauftragung des Prüfingenieurs&#xA;Nachricht 0500" visibility="public" incoming="_19_0_3_136d03d4_1611871270065_628620_27601" outgoing="_19_0_4_78d0259_1728911936084_502884_29566">
