                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291316_62438_6018" annotatedElement="_16_5_4_5b501fb_1387625291118_46583_5195" body="Hier werden Angaben zum Tod einer natürlichen Person gemacht."/>
