              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282220_799192_31273" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282220_485487_31271" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264267_804703_25840" name="abgrabungenUndAufschuettungen" visibility="private" type="_19_0_3_136d03d4_1611871246534_500611_23545">
