                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256988_491348_2313" name="sourceCRS" visibility="public" type="_16_5_4_5b501fb_1387625256747_141215_1611"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256989_318046_2314" name="targetCRS" visibility="public" type="_16_5_4_5b501fb_1387625256747_141215_1611"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_5b501fb_1387625256718_578496_1516" name="AbstractCoordinateSystemType" visibility="public">
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256989_287669_2316" name="axisGroup" visibility="public"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256989_226777_2317" name="axis" visibility="public" type="_16_5_4_5b501fb_1387625256745_663803_1605"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256990_579328_2318" name="aggregationType" visibility="public"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_5b501fb_1387625256718_627968_1517" name="AbstractCoverageType" visibility="public">
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256990_661473_2320" name="domainSetGroup" visibility="public"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256990_302175_2321" name="domainSet" visibility="public" type="_16_5_4_5b501fb_1387625256759_706125_1646"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256991_315508_2322" name="rangeSet" visibility="public" type="_16_5_4_5b501fb_1387625256801_341544_1763"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_5b501fb_1387625256718_329497_1518" name="AbstractCRSType" visibility="public">
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256991_80110_2324" name="domainOfValidity" visibility="public" type="_16_5_4_5b501fb_1387625256759_99066_1645"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256991_319754_2325" name="scope" visibility="public"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_5b501fb_1387625256719_772823_1519" name="AbstractCurveSegmentType" visibility="public">
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256992_592329_2327" name="numDerivativeInterior" visibility="public"/>
                  <ownedAttribute xmi:id="_16_5_4_5b501fb_1387625256992_424193_2328" name="numDerivativesAtEnd" visibility="public"/>
