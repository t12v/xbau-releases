            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823546_375517_25808" name="befreiungGEG" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823652_902246_26314" annotatedElement="_19_0_4_b6602da_1714115823546_375517_25808" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass zur Befreiung andere Gründe nach § 102 GEG vorliegen. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823653_784993_26315" name="" visibility="public"/>
