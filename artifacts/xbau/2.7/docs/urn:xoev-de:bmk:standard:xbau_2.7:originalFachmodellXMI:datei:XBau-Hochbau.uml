          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871246540_458471_23565" name="Wohnungsprofil" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264275_724551_25881" annotatedElement="_19_0_3_136d03d4_1611871246540_458471_23565" body="&lt;para>In diesem Datentyp lässt sich abbilden, wie viele Wohnungen mit 1, 2, 3 oder mehr Wohnungen es in dem Bauvorhaben gibt. Diese Angaben werden von der Statistik in verschiedenen Kontexten angefragt.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264275_419248_25882" name="anzahlWohnungen" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
