                <node xmi:type="uml:CentralBufferNode" xmi:id="_19_0_4_b8702dd_1784535338881_588143_10934" name="Vorgangsraum schließen&#xA;Nachricht 1302" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_944525_10948" outgoing="_19_0_4_b8702dd_1784535338881_23027_10949"/>
                <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_4_b8702dd_1784535338881_111190_10935" name="Vorgangsraum schließen und Bestätigung erstellen" visibility="public" incoming="_19_0_4_b8702dd_1784535338881_23027_10949" outgoing="_19_0_4_b8702dd_1784535338881_600571_10950" inPartition="_19_0_4_b8702dd_1784535338881_552505_10937">
