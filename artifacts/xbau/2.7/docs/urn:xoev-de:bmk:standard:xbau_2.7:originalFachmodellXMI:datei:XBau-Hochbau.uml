                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287345_819109_7155" annotatedElement="_16_5_4_5b501fb_1406633287198_872635_5966" body="Hier werden Angaben zum Zeitraum der Gültigkeit einer &quot;Registrierung&quot; gemacht. "/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287345_52688_7156" name="" visibility="private" type="_16_5_4_5b501fb_1406633287061_546919_5374" association="_16_5_4_5b501fb_1406633287198_872635_5966"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287205_322694_5994" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287206_272041_5997 _16_5_4_5b501fb_1406633287349_923316_7196">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287349_413032_7195" annotatedElement="_16_5_4_5b501fb_1406633287205_322694_5994" body="Hier werden Angaben zum Zeitraum gemacht, in dem eine natürliche Person einer Religionsgemeinschaft angehört."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287349_923316_7196" name="" visibility="private" type="_16_5_4_5b501fb_1406633287061_543639_5375" association="_16_5_4_5b501fb_1406633287205_322694_5994"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287220_63138_6046" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287242_340080_6127 _16_5_4_5b501fb_1406633287353_481647_7240">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287353_528945_7239" annotatedElement="_16_5_4_5b501fb_1406633287220_63138_6046" body="Die Nation, der die Anschrift verwaltungspolitisch zugeordnet wird."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287353_481647_7240" name="" visibility="private" type="_16_5_4_5b501fb_1406633287063_733447_5380" association="_16_5_4_5b501fb_1406633287220_63138_6046"/>
                </packagedElement>
              </packagedElement>
            </packagedElement>
          </packagedElement>
        </packagedElement>
      </packagedElement>
