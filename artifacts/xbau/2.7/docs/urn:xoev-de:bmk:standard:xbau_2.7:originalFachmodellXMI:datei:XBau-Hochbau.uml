  <XOEVProfil:xoevCodeliste xmi:id="_ngzhMpDEEfGoGvl6Hw52FA" nameTechnisch="erreichbarkeit" kennung="urn:de:xoev:codeliste:erreichbarkeit" base_Class="_19_0_3_136d03d4_1612313332046_805113_9592">
