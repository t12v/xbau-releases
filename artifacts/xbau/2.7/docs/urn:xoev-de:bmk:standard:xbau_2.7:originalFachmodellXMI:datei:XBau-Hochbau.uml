            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264166_782299_25391" name="produkthersteller" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282084_768607_30089" annotatedElement="_19_0_3_136d03d4_1611871264166_782299_25391" body="&lt;para>In diesem Attribut ist der Name der Firma oder der Organisation einzutragen, die für das DV-Verfahren verantwortlich ist, mit dem diese Nachricht erstellt worden ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282084_152672_30090" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282083_568105_30088" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264166_389479_25392" name="produktversion" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282084_777056_30093" annotatedElement="_19_0_3_136d03d4_1611871264166_389479_25392" body="&lt;para>In diesem Attribut sollen ergänzende Hinweise zu dem Produkt, mit dem diese Nachricht erstellt worden ist, eingetragen werden. Dies sind Angaben, die für eine möglichst präzise Identifikation im Fehlerfall hilfreich sind, wie zum Beispiel Version und Patchlevel.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282084_536384_30094" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282084_419443_30092" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264166_63957_25393" name="test" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282084_898379_30097" annotatedElement="_19_0_3_136d03d4_1611871264166_63957_25393" body="&lt;para>Dieses Attribut ist optional. Ist es vorhanden, so sagt dies aus, dass es sich um eine Nachricht handelt, die (aus Sicht des Senders der Nachricht) nicht im normalen Produktivbetrieb behandelt werden soll. Über den Inhalt des Attributes wird nichts weiter ausgesagt, dies kann bilateral zwischen den Kommunikationspartnern vereinbart werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282084_151444_30098" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282084_877742_30096" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264166_265986_25394" name="nachrichtenkopf.G2privat" visibility="private" type="_19_0_3_136d03d4_1611871243173_72754_23299" aggregation="composite" association="_19_0_3_136d03d4_1611871243174_585689_23300">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282085_80025_30101" annotatedElement="_19_0_3_136d03d4_1611871264166_265986_25394" body="&lt;para>Dieses Element enthält die  Kopfinformationen zu Nachrichten des vorliegenden Typs.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282085_284372_30102" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282085_617764_30100" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871243173_72754_23299" name="Nachrichtenkopf.G2privat" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264167_14472_25396" annotatedElement="_19_0_3_136d03d4_1611871243173_72754_23299" body="&lt;para>Nachrichtenkopf für Nachrichten von Behörden an Private.&lt;/para>&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264167_866205_25397" name="identifikation.nachricht" visibility="private" type="_19_0_3_136d03d4_1611871243169_203077_23290" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282085_156277_30105" annotatedElement="_19_0_3_136d03d4_1611871264167_866205_25397" body="&lt;para>Hier werden die Identifkationsmerkmale zur vorliegenden Nachricht genannt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282085_473301_30106" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282085_306774_30104" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264167_310633_25398" name="leser" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282085_296200_30109" annotatedElement="_19_0_3_136d03d4_1611871264167_310633_25398" body="&lt;para>Hier wird die Fachbehörde bzw. Organisation genannt, für die die vorliegende Nachricht bestimmt ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282086_991522_30110" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282085_618897_30108" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264167_236554_25399" name="autor" visibility="private" type="_19_0_4_41901a4_1664881730539_613260_6890" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282086_747951_30113" annotatedElement="_19_0_3_136d03d4_1611871264167_236554_25399" body="&lt;para>Hier wird die Fachbehörde bzw. Organisation genannt, die die vorliegende Nachricht erstellt hat.&lt;/para>&#xA;&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282086_122871_30114" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282086_28948_30112" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871243174_585689_23300" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264166_265986_25394 _19_0_3_136d03d4_1611871264168_646219_25401">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264168_646219_25401" name="" visibility="private" type="_19_0_3_136d03d4_1611871243171_379957_23298" association="_19_0_3_136d03d4_1611871243174_585689_23300"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1779276533969_901509_30789" name="ruleset.anlagen" visibility="public">
            <ownedRule xmi:id="_19_0_4_b8702dd_1779276533979_426806_30790" name="sch-xbau-005" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1779276533979_679734_30795" annotatedElement="_19_0_4_b8702dd_1779276533979_426806_30790" body="URIs verlinkter Anlagen zu einer Nachricht müssen eindeutig sein."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779276533979_74665_30794" name="" visibility="public">
                <language>English</language>
                <body>count(//anhangOderVerlinkung/verlinkung/uriVerlinkung) = count(distinct-values(//anhangOderVerlinkung/verlinkung/uriVerlinkung)) </body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1779276533979_665437_30791" name="sch-xbau-003" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1779276533979_754731_30797" annotatedElement="_19_0_4_b8702dd_1779276533979_665437_30791" body="Dateinamen der Anlagen zu einer Nachricht müssen eindeutig sein."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779276533979_885562_30796" name="" visibility="public">
                <language>English</language>
                <body>count(//anhangOderVerlinkung/*/dateiname) = count(distinct-values(//anhangOderVerlinkung/*/dateiname)) </body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1779276533979_826023_30792" name="sch-xbau-004" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1779276533979_619956_30799" annotatedElement="_19_0_4_b8702dd_1779276533979_826023_30792" body="Dokument-IDs der Anlagen zu einer Nachricht müssen eindeutig sein."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779276533979_903368_30798" name="" visibility="public">
                <language>English</language>
                <body>count(//anhangOderVerlinkung/*/dokumentid) = count(distinct-values(//anhangOderVerlinkung/*/dokumentid)) </body>
              </specification>
            </ownedRule>
          </packagedElement>
          <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1779276816633_762636_30800" name="" visibility="public" client="_19_0_4_b8702dd_1779276533969_901509_30789" supplier="_19_0_3_136d03d4_1611871243167_733539_23288"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1611871239745_884339_22703" name="DatentypenBauantrag" visibility="public" URI="">
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244693_522565_23367" name="BeteiligteBauprojekt" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264175_207116_25405" annotatedElement="_19_0_3_136d03d4_1611871244693_522565_23367" body="&lt;para>Typ für die an einem Bauprojekt direkt oder indirekt beteiligten Parteien (Personen und Organisationen).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264175_856403_25406" name="bauherr" visibility="private" type="_19_0_4_b6602da_1688632025529_352662_21872">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282093_54194_30126" annotatedElement="_19_0_3_136d03d4_1611871264175_856403_25406" body="&lt;para>Hier ist derjenige einzutragen, der am Verfahren als Bauherr beteiligt ist, inklusive seiner Rolle. Pro Bauherrn ist ein Element zu instanziieren. Bei mehreren Bauherren sollte das Element artdesBauherren mindestens bei einer Instanziierung befüllt sein.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282093_2743_30127" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282092_333524_30125" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1652708576901_436704_18022" name="gruppenname" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1652708687137_764248_18028" annotatedElement="_19_0_3_136d03d4_1652708576901_436704_18022" body="&lt;para>Sofern eine Personengruppe vorliegt, kann in diesem Element der entsprechende Gruppenname dieser Personengruppe erfasst werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1652708654142_851982_18026" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1652708654142_288923_18027" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1630046246545_583738_17451" name="bevollmaechtigter" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1630046512697_262837_17455" annotatedElement="_19_0_3_136d03d4_1630046246545_583738_17451" body="&lt;para>Hier ist eine (natürliche oder juristische) Person einzutragen, die vom Bauherrn bevollmächtigt wurde.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1630046576563_405189_17460" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1630046576563_203908_17461" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264176_52936_25409" name="entwurfsverfasser" visibility="private" type="_19_0_3_136d03d4_1611871246574_751919_23648">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282094_113866_30138" annotatedElement="_19_0_3_136d03d4_1611871264176_52936_25409" body="&lt;para>Hier ist die Person einzutragen, die am Verfahren als Entwurfsverfasser beteiligt ist. Falls kein Entwurfsverfasser für das Bauvorhaben benötigt wird, kann dieses Element entfallen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282094_388804_30139" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282094_253076_30137" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264182_544710_25436" name="bauunternehmer" visibility="private" type="_16_5_4_8a30247_1422977426041_172815_6757">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282103_448514_30214" annotatedElement="_19_0_3_136d03d4_1611871264182_544710_25436" body="&lt;para>Als Bauunternehmer ist der Rohbau-Unternehmer einzutragen, benötigt wird die Firma mit Ansprechpartner.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282103_985554_30215" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282103_888669_30213" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264176_666670_25410" name="nachbar" visibility="private" type="_19_0_3_136d03d4_1611871244701_882762_23402">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282095_913616_30142" annotatedElement="_19_0_3_136d03d4_1611871264176_666670_25410" body="&lt;para>Hier sind ggf. Nachbarn des Baugrundstücks einzutragen, soweit sie in die Prüfung des Bauvorhabens durch die Bauaufsichtsbehörde einzubeziehen sind. Pro zu berücksichtigenden Nachbarn ist ein Element zu instanziieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282095_810691_30143" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282095_94691_30141" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1619461251925_697405_16911" name="weitereBeteiligte" visibility="private" type="_19_0_3_136d03d4_1619461293037_566894_16917">
              <ownedComment xmi:id="_19_0_3_136d03d4_1619461607696_269194_16936" annotatedElement="_19_0_3_136d03d4_1619461251925_697405_16911" body="&lt;para>Dieser Abschnitt fasst Daten zu weiteren Beteiligten zusammen. Pro Beteiligtem ist ein Element zu instanziieren.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1619461275869_218267_16915" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1619461275870_555837_16916" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1713433389247_172431_24860" name="gebuehrenpflichtiger" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_4_b6602da_1713433479135_704456_24868" annotatedElement="_19_0_4_b6602da_1713433389247_172431_24860" body="&lt;para>Hier sind die Personendaten des Gebührenpflichtigen anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1713433431785_307677_24864" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1713433431788_982660_24865" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244693_186561_23368" name="Gegenstand" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1725003416198_864276_26661" annotatedElement="_19_0_3_136d03d4_1611871244693_186561_23368" body="&lt;para>Dieser Abschnitt beschreibt, was der Gegenstand des Antrags ist.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1725003500892_995472_26665" name="anzahlDerGebaeude" visibility="private" type="_19_0_4_b6602da_1725002748026_786307_26572">
              <ownedComment xmi:id="_19_0_4_b6602da_1725003617713_429042_26670" annotatedElement="_19_0_4_b6602da_1725003500892_995472_26665" body="&lt;para>Dieser Datentyp enthält die Anzahl der Gebäude des Bauvorhabens und Informationen zur Identifikation der einzelnen Gebäude.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1725003593862_560397_26668" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1725003593862_236667_26669" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264177_560445_25412" name="artDerMassnahme" visibility="private" type="_19_0_3_136d03d4_1611871239752_686519_22726">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282095_904157_30146" annotatedElement="_19_0_3_136d03d4_1611871264177_560445_25412" body="&lt;para>In dieses Element ist einzutragen, von welcher Art (z. B. Errichtung, Änderung, Nutzungsänderung) die  Maßnahmen im Rahmen des Bauvorhabens sind.  &lt;/para>&#xA;&lt;para>Falls mehrere dieser Charakterisierungen signifikant zutreffen, so ist das Element mehrfach zu instanziieren. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282095_225177_30147" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282095_593152_30145" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264177_901511_25413" name="artDerBaulichenAnlage" visibility="private" type="_19_0_3_136d03d4_1611871244699_746777_23393">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282095_935130_30150" annotatedElement="_19_0_3_136d03d4_1611871264177_901511_25413" body="&lt;para>Für den Gegenstand des Bauvorhabens kann hier die Art der baulichen Anlage näher spezifiziert werden. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282096_52090_30151" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282095_316921_30149" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1660667310510_208115_18232" name="zweckDerNutzungsaenderung" visibility="private" type="_19_0_3_129a03b9_1660667455391_257345_18239">
              <ownedComment xmi:id="_19_0_3_129a03b9_1660667310511_562097_18234" annotatedElement="_19_0_3_129a03b9_1660667310510_208115_18232" body="&lt;para>Wenn das Bauvorhaben eine Nutzungsänderung der baulichen Anlage beabsichtigt, ist in diesem Feld die bisherige und die beabsichtigte Nutzung der baulichen Anlage anzugeben. Es ist jeweils aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1660667310512_408479_18235" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1660667310511_523504_18233" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264177_955150_25414" name="bauordnungsrechtlicheKlassifikation" visibility="private" type="_19_0_3_136d03d4_1611871244701_991956_23400">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282096_105861_30154" annotatedElement="_19_0_3_136d03d4_1611871264177_955150_25414" body="&lt;para>Dieses Element beinhaltet Zahlen zu bauordnungsrechtlichen Parametern des Vorhabens.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282096_580325_30155" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282096_987237_30153" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1660666966014_498422_18225" name="vorhandeneBindungen" visibility="private" type="_19_0_3_136d03d4_1611871246533_294346_23542">
              <ownedComment xmi:id="_19_0_3_129a03b9_1660666966016_270260_18227" annotatedElement="_19_0_3_129a03b9_1660666966014_498422_18225" body="&lt;para>In diesem Element können Informationen über vorhandene Bindungen zu dem Gegenstand des Bauvorhabens übermittelt werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1660666966016_153745_18228" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1660666966015_250776_18226" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1666179206722_971561_18593" name="baudenkmalBetroffen" visibility="private" type="_19_0_3_129a03b9_1666180418426_300417_18601">
              <ownedComment xmi:id="_19_0_3_129a03b9_1666183622192_304651_18610" annotatedElement="_19_0_3_129a03b9_1666179206722_971561_18593" body="&lt;para> In diesem Element können die Informationen über die vom Bauvorhaben betroffenen Denkmäler enthalten werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1666180444778_783684_18602" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1666180444779_529842_18603" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264177_156109_25415" name="bauvorhabenDatenblatt" visibility="private" type="_19_0_3_136d03d4_1611871246537_77701_23557">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282096_811340_30158" annotatedElement="_19_0_3_136d03d4_1611871264177_156109_25415" body="&lt;para>Dieses Objekt bietet Felder für die Übermittlung von technischen Daten und Kennzahlen zum Bauvorhaben.&lt;/para>&#xA;&lt;para>Falls das Bauvorhaben eine Errichtung ist, beziehen sich alle aufgeführten Parameter des Datenblatts naturgemäß auf das projektierte Gesamtbauwerk.&lt;/para>&#xA;&lt;para>Falls das Bauvorhaben eine Änderung ist, ist abzuwägen, ob Daten in Bezug auf den Erweiterungsbau oder auf das Gesamtbauwerk anzugeben sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282096_684434_30159" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282096_712395_30157" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264178_210389_25417" name="baubeschreibung" visibility="private" type="_19_0_3_136d03d4_1611871246545_228398_23585">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282097_387622_30166" annotatedElement="_19_0_3_136d03d4_1611871264178_210389_25417" body="&lt;para>Dieses Element gibt die Gliederung vor, in der das Bauvorhaben thematisch strukturiert beschrieben werden kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282097_190151_30167" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282097_725123_30165" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264178_8647_25418" name="betriebsbeschreibung" visibility="private" type="_19_0_3_136d03d4_1611871246540_202779_23566">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282098_622085_30170" annotatedElement="_19_0_3_136d03d4_1611871264178_8647_25418" body="&lt;para>Dieses Objekt nimmt Daten zur Betriebsbeschreibung nach § 5 BauPrüfVO NRW auf.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282098_123021_30171" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282097_329267_30169" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264178_33588_25419" name="pruefungBautechnischeNachweise" visibility="private" type="_19_0_3_136d03d4_1611871244702_569184_23406">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282098_778589_30174" annotatedElement="_19_0_3_136d03d4_1611871264178_33588_25419" body="&lt;para>Mit diesem Element wird die Angabe in Bezug auf die Prüfung der bautechnischen Nachweise (u.a. Brandschutznachweis) übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282098_908045_30175" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282098_287173_30173" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264179_592581_25420" name="herstellungskosten" visibility="private" type="_19_0_3_136d03d4_1611871244702_23191_23405">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282098_76304_30178" annotatedElement="_19_0_3_136d03d4_1611871264179_592581_25420" body="&lt;para>Hier sind die Herstellungskosten für die entsprechenden Kostengruppen der DIN 276 einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282098_909176_30179" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282098_346004_30177" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244693_625845_23369" name="Anonym_Verortung" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264179_708985_25421" name="baugrundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_572179_23532">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282099_154768_30182" annotatedElement="_19_0_3_136d03d4_1611871264179_708985_25421" body="&lt;para>In diesem Element sind Daten enthalten, die das Baugrundstück (ein Grundstück, auf dem das Vorhaben stattfinden soll bzw. auf dem es durchgeführt wurde) identifizieren. Ein Baugrundstück kann mehrere Grundstücke umfassen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282099_543708_30183" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282099_366057_30181" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264179_594853_25422" name="lageBauvorhaben" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777" aggregation="composite" association="_19_0_3_136d03d4_1611871244693_258041_23370">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282099_623803_30186" annotatedElement="_19_0_3_136d03d4_1611871264179_594853_25422" body="&lt;para>In diesem Element sollen ergänzend georeferenzierte Informationen zur genaueren Lage des Bauvorhabens bzw. Gebäudes auf dem Baugrundstück abgebildet werden.&lt;/para>&#xA;&#xA;&lt;para>Falls beispielsweise ein Umbau geplant ist und auf dem Grundstück mehrere Gebäude bestehen, muss aus diesen Angaben hervorgehen, was der Gegenstand des Anbaus ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282099_987811_30187" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282099_814149_30185" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244693_258041_23370" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264179_594853_25422 _19_0_3_136d03d4_1611871264179_506685_25423">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264179_506685_25423" name="" visibility="private" type="_19_0_3_136d03d4_1611871244693_625845_23369" association="_19_0_3_136d03d4_1611871244693_258041_23370"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244694_158760_23371" name="Bauvorhaben" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264180_547919_25424" annotatedElement="_19_0_3_136d03d4_1611871244694_158760_23371" body="&lt;para>Typ für die Daten eines Bauvorhabens, enthält Informationen zum Wer, Was und Wo des Bauvorhabens bzw. Vorhabens. Der Begriff 'Bauvorhaben' wird hier sehr weit gefasst, so dass auch Nutzungsänderungen ohne Baumaßnahmen abgedeckt sind. Der Typ wird in allen Nachrichten eingesetzt, in denen Eigenschaften eines Bauvorhabens (bzw. Vorhabens) anzugeben sind bzw. geprüft werden sollen. Er wird auch da eingesetzt, wo über ein Bauvorhaben (Vorhaben) oder über Maßnahmen im Zusammenhang eines Bauvorhabens (Vorhabens) zu informieren ist.&lt;/para>&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264180_704571_25425" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282100_908749_30190" annotatedElement="_19_0_3_136d03d4_1611871264180_704571_25425" body="&lt;para>In dieses Element ist die Bezeichnung des Vorhabens einzutragen. Sie wird vom Bauherrn vergeben und später ggf. von der Bauaufsichtsbehörde geändert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282100_929024_30191" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282100_57105_30189" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264180_625300_25426" name="beteiligte" visibility="private" type="_19_0_3_136d03d4_1611871244693_522565_23367" aggregation="composite" association="_19_0_3_136d03d4_1611871244694_678209_23372">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282100_651809_30194" annotatedElement="_19_0_3_136d03d4_1611871264180_625300_25426" body="&lt;para>Dieses Objekt steht für die am Bauvorhaben (Vorhaben) beteiligten Parteien (Personen und Organisationen), soweit sie der Bauaufsichtsbehörde bekannt sein müssen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282100_324950_30195" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282100_82107_30193" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264180_162261_25427" name="gegenstand" visibility="private" type="_19_0_3_136d03d4_1611871244693_186561_23368" aggregation="composite" association="_19_0_3_136d03d4_1611871244694_715675_23374">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282101_767174_30198" annotatedElement="_19_0_3_136d03d4_1611871264180_162261_25427" body="&lt;para>Dieser Abschnitt beschreibt, was der Gegenstand des Antrags ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282101_503407_30199" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282101_130971_30197" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264180_480489_25428" name="verortung" visibility="private" type="_19_0_3_136d03d4_1611871244693_625845_23369" aggregation="composite" association="_19_0_3_136d03d4_1611871244694_90971_23373">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282101_615789_30202" annotatedElement="_19_0_3_136d03d4_1611871264180_480489_25428" body="&lt;para>Dieser Abschnitt beschäftigt sich mit der Lokalisierung des Vorhabens in relevanten Bezugssystemen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282101_96482_30203" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282101_877071_30201" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1643217429667_115612_18015" name="weitereAngaben" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
              <ownedComment xmi:id="_19_0_3_136d03d4_1643217538110_848957_18021" annotatedElement="_19_0_3_136d03d4_1643217429667_115612_18015" body="&lt;para>Mit diesem Element können ausschließlich ergänzende textliche Erläuterungen zum Bauvorhaben übermittelt werden, die sich nicht mit den vorhandenen XBau-Attributen ausdrücken lassen.&lt;/para> "/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1643217466673_435088_18019" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1643217466673_541020_18020" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244694_678209_23372" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264180_625300_25426 _19_0_3_136d03d4_1611871264181_381156_25430">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264181_381156_25430" name="" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" association="_19_0_3_136d03d4_1611871244694_678209_23372"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244694_90971_23373" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264180_480489_25428 _19_0_3_136d03d4_1611871264181_745485_25431">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264181_745485_25431" name="" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" association="_19_0_3_136d03d4_1611871244694_90971_23373"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244694_715675_23374" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264180_162261_25427 _19_0_3_136d03d4_1611871264181_361899_25432">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264181_361899_25432" name="" visibility="private" type="_19_0_3_136d03d4_1611871244694_158760_23371" association="_19_0_3_136d03d4_1611871244694_715675_23374"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244695_85010_23376" name="Anonym_BefundFormell" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264182_903459_25439" annotatedElement="_19_0_3_136d03d4_1611871244695_85010_23376" body=""/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264182_259422_25440" name="artDesBefundes" visibility="private" type="_18_0_2_940029b_1552127588117_500969_14828">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282103_723201_30222" annotatedElement="_19_0_3_136d03d4_1611871264182_259422_25440" body="&lt;para>In diesem Element wird die Befundkategorie angegeben, der dieser Befund zugeordnet werden kann.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282104_448454_30223" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282103_743089_30221" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264182_932243_25441" name="refAnlage" visibility="private" type="_19_0_3_136d03d4_1611871244695_882280_23377">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282104_265973_30226" annotatedElement="_19_0_3_136d03d4_1611871264182_932243_25441" body="&lt;para>Für Befunde, die sich auf eine eingereichte Bauvorlage bzw. eine sonstige Anlage zum Antrag beziehen, wird in diesem Objekt der Bezug hergestellt.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282104_188029_30227" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282104_589268_30225" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264183_373949_25442" name="betroffeneAnlage" visibility="private" type="_19_0_3_136d03d4_1615201655963_472277_16611" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282104_413412_30230" annotatedElement="_19_0_3_136d03d4_1611871264183_373949_25442" body="&lt;para>Für Befunde, die Mängel an einer eingereichten Bauvorlage oder das Fehlen einer Bauvorlage (einer bestimmten Art) betreffen, wird in diesem Element die Art dieser Bauvorlage angegeben (die den Mangel hat bzw. die nachzureichen ist).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282104_287856_30231" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282104_664991_30229" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264183_218289_25443" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282105_690200_30234" annotatedElement="_19_0_3_136d03d4_1611871264183_218289_25443" body="&lt;para>Hier wird der Sachverhalt des Befundes beschrieben. Dieser Sachverhalt ist eine detailliertere Darstellung im Rahmen der parallel angegebenen Art des Befundes.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282105_170233_30235" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282105_823227_30233" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244695_882280_23377" name="RefAnlage" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264183_361676_25444" annotatedElement="_19_0_3_136d03d4_1611871244695_882280_23377" body="&lt;para>Typ für die Bezugnahme auf Bestandteile eines Antrags oder eines Auftrags. Dieser Typ wird im Kontext einer formellen Prüfung eingesetzt.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264183_894007_25445" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210780_355528_9523">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282105_849688_30238" annotatedElement="_19_0_3_136d03d4_1611871264183_894007_25445" body="&lt;para>Hier wird die Bezeichnung der referenzierten Bauvorlage angegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282105_46293_30239" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282105_155099_30237" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264183_759918_25446" name="versionsnummer" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282106_706668_30242" annotatedElement="_19_0_3_136d03d4_1611871264183_759918_25446" body="&lt;para>Hier ist die Versionsnummer der referenzierten Bauvorlage einzutragen. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282106_458163_30243" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282106_417340_30241" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244695_592401_23378" name="BefundlisteFormell" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264184_383172_25448" annotatedElement="_19_0_3_136d03d4_1611871244695_592401_23378" body="&lt;para>Dieser Typ beinhaltet die Befunde der formellen Prüfung eines Antrags oder einer Anfrage. Für jeden Befund sind die entsprechenden Parameter gefüllt, die Inhalt und Bezug des Befundes für den Antragsteller bzw. Anfragenden nachvollziehbar machen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264184_938031_25449" name="befund" visibility="private" type="_19_0_3_136d03d4_1611871244695_85010_23376" aggregation="composite" association="_19_0_3_136d03d4_1611871244696_538211_23379">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282107_450480_30246" annotatedElement="_19_0_3_136d03d4_1611871264184_938031_25449" body="&lt;para>Dieses Element stellt genau einen Befund der Befundliste dar.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282107_886571_30247" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282106_701188_30245" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244696_538211_23379" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264184_938031_25449 _19_0_3_136d03d4_1611871264184_796453_25451">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264184_796453_25451" name="" visibility="private" type="_19_0_3_136d03d4_1611871244695_592401_23378" association="_19_0_3_136d03d4_1611871244696_538211_23379"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244696_135967_23380" name="Anonym_BelastenderVerwaltungsaktGrund" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264184_206388_25452" annotatedElement="_19_0_3_136d03d4_1611871244696_135967_23380" body=""/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264184_839362_25453" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282107_759758_30250" annotatedElement="_19_0_3_136d03d4_1611871264184_839362_25453" body="&lt;para>Dieses Element nennt den  Rechtsbereich, innerhalb dessen der belastende Verwaltungsakt liegt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282107_740574_30251" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282107_608158_30249" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264185_118499_25454" name="bezeichnungRegelverstoss" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282108_314555_30254" annotatedElement="_19_0_3_136d03d4_1611871264185_118499_25454" body="&lt;para>Hier wird die Bezeichnung des betreffenden Regelverstoßes genannt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282108_359577_30255" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282108_995943_30253" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264185_846422_25455" name="begruendung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282108_107245_30258" annotatedElement="_19_0_3_136d03d4_1611871264185_846422_25455" body="&lt;para>Hier wird begründet, inwiefern es sich um einen Regelverstoß handelt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282109_752514_30259" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282108_436811_30257" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244696_372837_23381" name="BefundlisteMateriell" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264185_231072_25456" annotatedElement="_19_0_3_136d03d4_1611871244696_372837_23381" body="&lt;para>Eine Instanz dieses Typs steht für eine Befundliste der materiellen Prüfung eines Antrags. Jeder Befund beinhaltet die Parameter, die einen  belastenden Verwaltungsakt im Kontext eines Baugenehmigungsvorgangs definieren. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264185_676888_25457" name="befund" visibility="private" type="_19_0_3_136d03d4_1611871244696_135967_23380" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282109_290515_30262" annotatedElement="_19_0_3_136d03d4_1611871264185_676888_25457" body="&lt;para>Jedes Element steht für einen  belastenden Verwaltungsakt im Kontext des aktuellen Baugenehmigungsvorgang, zu dem der Adressat der Nachricht zu einer Stellungnahme aufgefordert ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282109_675064_30263" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282109_891208_30261" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244697_819552_23382" name="StellungnahmeBelastenderVerwaltungsakt" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264186_245842_25459" annotatedElement="_19_0_3_136d03d4_1611871244697_819552_23382" body="&lt;para>Dieser Typ nimmt die Parameter einer Stellungnahme auf, mit der sich ein Antragsteller zu einem  belastenden Verwaltungsakt äußert. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264186_729535_25460" name="bezeichnungRegelverstoss" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282110_168908_30266" annotatedElement="_19_0_3_136d03d4_1611871264186_729535_25460" body="&lt;para>Hier ist die Bezeichnung des betreffenden Regelverstoßes genannt.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282110_302978_30267" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282110_740895_30265" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264186_393367_25461" name="stellungnahme" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282110_339839_30270" annotatedElement="_19_0_3_136d03d4_1611871264186_393367_25461" body="&lt;para>Dieses Element enthält die Stellungnahme des Antragsstellers. Sie nimmt auf die Beanstandung Bezug.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282110_198092_30271" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282110_248779_30269" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244697_588683_23383" name="StellungnahmeStrukturiert" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264186_827817_25463" annotatedElement="_19_0_3_136d03d4_1611871244697_588683_23383" body="&lt;para>Dieser Typ beinhaltet die Parameter einer strukturierten Stellungnahme, die die beteiligte Behörde für die Zustellung ihrer Stellungnahme verwenden kann.&lt;/para>"/>
            <ownedRule xmi:id="_19_0_4_b8702dd_1773066322009_839117_31321" name="sch-bet-001" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1773066535430_993871_31323" annotatedElement="_19_0_4_b8702dd_1773066322009_839117_31321" body="Wenn der Tenor der Stellungnahme negativ ist, muss eine Begründung angegeben werden."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1773066322009_613593_31322" name="" visibility="public">
                <language>English</language>
                <body>not(xbau:tenor/xbau:istZustimmung='false' and string-length(normalize-space(xbau:begruendung/text))=0)</body>
              </specification>
            </ownedRule>
            <ownedRule xmi:id="_19_0_4_b8702dd_1773220194188_397467_31321" name="sch-bet-002" visibility="public">
              <ownedComment xmi:id="_19_0_4_b8702dd_1773220267673_654227_31323" annotatedElement="_19_0_4_b8702dd_1773220194188_397467_31321" body="Wenn der Tenor der Stellungnahme positiv ist, aber Nebenbestimmungen genannt werden (d.h. Tenor positiv mit Einschränkungen), muss eine Begründung angegeben werden."/>
              <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1773220194188_953158_31322" name="" visibility="public">
                <language>English</language>
                <body>not((xbau:tenor/xbau:istZustimmung='true' and xbau:nebenbestimmung) and string-length(normalize-space(xbau:begruendung/text))=0)</body>
              </specification>
            </ownedRule>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1774009364851_572925_31321" name="idAnliegen" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_4_b8702dd_1774009364859_13040_31323" annotatedElement="_19_0_4_b8702dd_1774009364851_572925_31321" body="&lt;para>Dieses Element enthält den &quot;Universally Unique IDentifier (UUID)&quot; des Beteiligungsanliegens. Der UUID ermöglicht es, die Stellungnahme dem Beteiligungsanliegen, auf das sie sich bezieht, eindeutig zuzuordnen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774009364859_432845_31324" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774009364859_835618_31322" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264186_198174_25464" name="tenor" visibility="private" type="_19_0_3_136d03d4_1611871244700_835390_23398">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282111_920598_30274" annotatedElement="_19_0_3_136d03d4_1611871264186_198174_25464" body="&lt;para>Hier wird der Tenor der Stellungnahme formuliert. Handelt es sich um eine Zustimmung, kann diese mit oder ohne Nebenbestimmung zugestellt werden. Falls eine Abweichungsentscheidung in diesem Fall vorliegt, kann diese positiv oder negativ ausfallen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282111_483297_30275" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282111_716713_30273" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264187_273175_25465" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282111_259843_30278" annotatedElement="_19_0_3_136d03d4_1611871264187_273175_25465" body="&lt;para>Dieses Element nennt den Rechtsbereich, innerhalb dessen die Stellungnahme zugestellt wird.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282111_143768_30279" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282111_97894_30277" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264187_131470_25466" name="abweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_52288_23387">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282112_525193_30282" annotatedElement="_19_0_3_136d03d4_1611871264187_131470_25466" body="&lt;para>Hier werden ggf. die Erläuterungen zur Stellungnahme geliefert, die eine beantragte Abweichung betreffen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282112_153897_30283" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282112_587059_30281" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264187_524856_25467" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282112_82974_30286" annotatedElement="_19_0_3_136d03d4_1611871264187_524856_25467" body="&lt;para>Hier werden ggf. Nebenbestimmungen zur Stellungnahme eingefügt. Falls Nebenbestimmungen angegeben werden, gilt das Ergebnis der Stellungnahme als &quot;positiv mit Einschränkungen&quot;.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282112_692948_30287" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282112_759591_30285" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264187_904203_25468" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282113_641833_30290" annotatedElement="_19_0_3_136d03d4_1611871264187_904203_25468" body="&lt;para>Falls die Stellungnahme nicht zustimmend ausgefallen ist, oder falls unter Angabe von Nebenbestimmungen zugestimmt wurde, muss in diesem Element die entsprechende Begründung geliefert werden.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282113_57100_30291" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282112_159679_30289" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264188_686414_25469" name="anlagen" visibility="private" type="_19_0_3_136d03d4_1616753758357_771153_16737">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282113_718836_30294" annotatedElement="_19_0_3_136d03d4_1611871264188_686414_25469" body="&lt;para>Die für das Verständnis der Stellungnahme notwendigen Bauvorlagen werden in diesem Objekt eingefügt. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282113_1554_30295" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282113_848075_30293" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1784897276148_30672_34805" name="gegenstand" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_4_b8702dd_1784898280448_112534_34831" annotatedElement="_19_0_4_b8702dd_1784897276148_30672_34805" body="&lt;para>In dieses Element können fachrechtlich zu erteilende Genehmigungen, Bewilligungen, Erlaubnisse oder Gestattungen der zuständig beteiligten Dienststelle eingetragen werden. Diese können dadurch bei konzentrierten Genehmigungsverfahren in einem einheitlichen Verwaltungsakt zusammenfasst werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784897359243_328944_34814" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784897359243_458361_34815" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1784897289366_683810_34808" name="stellungnahme" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_4_b8702dd_1784897674981_56408_34829" annotatedElement="_19_0_4_b8702dd_1784897289366_683810_34808" body="&lt;para>In diesem Element können bei der Beteiligung sachverständiger Stellen Angaben zur Nachvollziehbarkeit der Entscheidung gemacht oder fachliche Einschätzungen zu einem Sachverhalt erläutert werden.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784897361560_695019_34816" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784897361560_259289_34817" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b8702dd_1784897300297_560118_34811" name="zustaendigeStelle" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_4_b8702dd_1784897895281_502645_34830" annotatedElement="_19_0_4_b8702dd_1784897300297_560118_34811" body="&lt;para>In diesem Element können Kontaktdaten der für die Überwachung zuständigen Stelle gemacht werden. Diese können zur Kontaktaufnahme bezüglich der Auflagen und Hinweise des jeweiligen Fachbereichs dienen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784897363770_534689_34818" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784897363770_696426_34819" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244697_801218_23384" name="Anonym_TenorBescheid" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264188_430190_25471" annotatedElement="_19_0_3_136d03d4_1611871244697_801218_23384" body="&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264188_499475_25472" name="istGenehmigung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite" association="_19_0_3_136d03d4_1611871244700_309242_23396">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282113_104845_30298" annotatedElement="_19_0_3_136d03d4_1611871264188_499475_25472" body="&lt;para>Falls der Tenor positiv  ist (Genehmigung), so ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls (Ablehnung) &quot;false&quot;.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282113_153623_30299" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282113_311582_30297" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264188_597457_25473" name="kommentareFachrecht" visibility="private" type="_19_0_3_136d03d4_1611871244697_888697_23385" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282114_655369_30302" annotatedElement="_19_0_3_136d03d4_1611871264188_597457_25473" body="&lt;para>Unterhalb dieses Elements sind - falls solche vorliegen - zur Information die Kommentare bzw. Bewertungen aus den beteiligten Stellen nach Fachrecht festgehalten. Sie sind im Verfahren der Bauaufsichtsbehörde berücksichtigt worden, das zum vorliegenden Bescheid geführt hat. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282114_826158_30303" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282114_309247_30301" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244697_888697_23385" name="Anonym_KommentierungFachrecht" visibility="public">
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264189_925808_25474" name="kommentarFachrecht" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite" association="_19_0_3_136d03d4_1611871244698_470505_23386">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282114_913767_30306" annotatedElement="_19_0_3_136d03d4_1611871264189_925808_25474" body="&lt;para>Pro Kommentar aus einem Fachbereich ist ein eigenes Element (welches mehrere Absätze Text enthalten kann) zu füllen. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282114_30424_30307" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282114_684343_30305" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244698_470505_23386" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264189_925808_25474 _19_0_3_136d03d4_1611871264189_868065_25475">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264189_868065_25475" name="" visibility="private" type="_19_0_3_136d03d4_1611871244697_888697_23385" association="_19_0_3_136d03d4_1611871244698_470505_23386"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244698_52288_23387" name="AbweichungBearbeitet" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264189_527332_25476" annotatedElement="_19_0_3_136d03d4_1611871244698_52288_23387" body="&lt;para>Falls die Abweichung eines Bauvorhabens von öffentlich-rechtlichen Bestimmungen bearbeitet (und damit zugelassen bzw. nicht zugelassen) wurde, dient dieser Typ im entsprechenden Kontext zur Übermittlung der relevanten Parameter.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1710949091722_599595_24900" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_129a03b9_1710949091724_918572_24902" annotatedElement="_19_0_3_129a03b9_1710949091722_599595_24900" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Abweichung. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Abweichung eindeutig zu identifizieren.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1710949091725_60608_24903" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1710949091724_988309_24901" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264189_16692_25477" name="istZugelassen" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282115_785567_30310" annotatedElement="_19_0_3_136d03d4_1611871264189_16692_25477" body="&lt;para>Falls die beantragte Abweichung zugelassen wurde, ist hier 'true' einzutragen, andernfalls 'false'.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282115_738505_30311" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282115_906578_30309" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264189_929268_25478" name="art" visibility="private" type="_19_0_3_136d03d4_1611871239757_800883_22735">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282115_725867_30314" annotatedElement="_19_0_3_136d03d4_1611871264189_929268_25478" body="&lt;para>Hier ist einzutragen, als welche Art von Abweichung die beantragte Abweichung einzustufen ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282115_477548_30315" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282115_125566_30313" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264190_503786_25479" name="vorschrift" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282115_676155_30318" annotatedElement="_19_0_3_136d03d4_1611871264190_503786_25479" body="&lt;para>Vorschrift der materiellen Anforderung: Hier sind Referenzen auf die Rechtsnormen einzutragen, auf die sich die bearbeitete Abweichung bezieht.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282116_151610_30319" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282115_814448_30317" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264190_883807_25480" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282116_292583_30322" annotatedElement="_19_0_3_136d03d4_1611871264190_883807_25480" body="&lt;para>In diesem Element wird begründet, warum die Abweichung zugelassen bzw. nicht zugelassen wurde.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282116_581646_30323" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282116_661653_30321" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264190_786093_25481" name="nebenbestimmung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282116_844632_30326" annotatedElement="_19_0_3_136d03d4_1611871264190_786093_25481" body="&lt;para>Hier werden für den Fall der Zulassung der beantragten Abweichungen ggf. Nebenbestimmungen formuliert, deren Einhaltung die Bauaufsichtsbehörde zur Bedingung für die Zulassung gemacht hat.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282116_630099_30327" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282116_229137_30325" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244698_632785_23388" name="Nebenbestimmung" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264190_876855_25483" annotatedElement="_19_0_3_136d03d4_1611871244698_632785_23388" body="&lt;para>Dieser Typ beinhaltet die Parameter, die eine Nebenbestimmung definieren. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264190_811082_25484" name="art" visibility="private" type="_19_0_3_136d03d4_1611871239757_9671_22736">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282117_531264_30330" annotatedElement="_19_0_3_136d03d4_1611871264190_811082_25484" body="&lt;para>Hier wird die Art genannt, von der die erlassene Nebenbestimmung ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282117_933810_30331" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282117_37046_30329" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264191_832456_25485" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282117_861076_30334" annotatedElement="_19_0_3_136d03d4_1611871264191_832456_25485" body="&lt;para>Dieses Element nennt den  Rechtsbereich, innerhalb dessen die Nebenbestimmung erlassen ist. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282117_207451_30335" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282117_157601_30333" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264191_343647_25486" name="nebenbestimmung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282118_173643_30338" annotatedElement="_19_0_3_136d03d4_1611871264191_343647_25486" body="&lt;para>Hier wird die Nebenbestimmung formuliert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282118_799376_30339" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282117_105086_30337" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244698_478657_23389" name="AbweichungBeantragt" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264191_798964_25488" annotatedElement="_19_0_3_136d03d4_1611871244698_478657_23389" body="&lt;para>Dieser Typ beinhaltet die Parameter einer Abweichung von öffentlich-rechtlichen Bestimmungen, die der Bauaufsichtsbehörde zur Zulassung vorgelegt wird.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1710948501601_613760_24889" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_129a03b9_1710948501608_320969_24891" annotatedElement="_19_0_3_129a03b9_1710948501601_613760_24889" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Abweichung. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Abweichung eindeutig zu identifizieren.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1710948501609_795870_24892" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1710948501608_341121_24890" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264191_296535_25489" name="art" visibility="private" type="_19_0_3_136d03d4_1611871239757_800883_22735">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282118_341128_30342" annotatedElement="_19_0_3_136d03d4_1611871264191_296535_25489" body="&lt;para>Hier ist die beantragte Abweichungsart gemäß Codeliste einzutragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282118_682790_30343" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282118_794209_30341" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264191_370116_25490" name="vorschrift" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282118_182433_30346" annotatedElement="_19_0_3_136d03d4_1611871264191_370116_25490" body="&lt;para>In diesem Element ist die Vorschrift der materiellen Anforderung zu bezeichnen: Es sind Referenzen auf die Rechtsnormen einzutragen, auf die sich die bearbeitete Abweichung bezieht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282119_347366_30347" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282118_605658_30345" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264192_76453_25491" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282119_146551_30350" annotatedElement="_19_0_3_136d03d4_1611871264192_76453_25491" body="&lt;para>In diesem Objekt ist der Abweichungsgegenstand im Detail zu erläutern. &lt;/para>&#xA;&#xA;&lt;para>Alternativ kann hier auf eine oder mehrere Bauvorlagen verwiesen werden, in denen die detaillierte Spezifikation des Abweichungsgegenstands enthalten ist. Diese Bauvorlagen müssen der vorliegenden Nachrichteninstanz als Anlagen beigefügt und gekennzeichnet sein als Bauvorlagen von der Art, die zur Erläuterung oder Begründung von Abweichungen vorgesehen sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282119_119883_30351" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282119_145582_30349" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264192_849253_25492" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282119_377456_30354" annotatedElement="_19_0_3_136d03d4_1611871264192_849253_25492" body="&lt;para>In diesem Element ist zur beantragten Abweichung eine Erläuterung zu geben, warum die beantragte Zulassung aus Sicht des Antragstellers gerechtfertigt ist.&lt;/para>&#xA;&#xA;&lt;para>Alternativ kann hier auf eine Bauvorlage verwiesen werden, in der die detaillierte Legitimation der beantragten Abweichung enthalten ist. Diese Bauvorlage muss der vorliegenden Nachrichteninstanz als Anlagen beigefügt und gekennzeichnet sein als Bauvorlage von der Art, die zur Erläuterung oder Begründung von Abweichungen vorgesehen sind.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282119_287220_30355" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282119_114769_30353" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244699_341220_23390" name="VorbescheidBeantragt" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264192_854551_25494" annotatedElement="_19_0_3_136d03d4_1611871244699_341220_23390" body="&lt;para>Dieser Typ beinhaltet die Parameter einer Frage, die im Rahmen eines Vorbescheidantrags thematisiert wird. Insoweit diese Frage einen Abweichungsantrag bzw. eine beantragte Erleichterung betrifft, sind in einer Instanz des Typs Daten enthalten, die den entsprechenden Kontext verdeutlichen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264192_353359_25495" name="artDerFrage" visibility="private" type="_19_0_3_136d03d4_1611871239758_242532_22737">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282120_359784_30358" annotatedElement="_19_0_3_136d03d4_1611871264192_353359_25495" body="&lt;para>Falls dieses Element verwendet wird, ist einzutragen, in welche Kategorie die im Rahmen des Vorbescheidantrags thematisierte Fragestellung einzuordnen ist. &lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282120_21009_30359" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282120_813700_30357" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264193_918209_25496" name="vorbescheidfrage" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282120_962713_30362" annotatedElement="_19_0_3_136d03d4_1611871264193_918209_25496" body="&lt;para>Beschreibung der Fragestellung(en) im Rahmen eines Vorbescheids&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282120_510458_30363" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282120_201217_30361" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264193_64744_25497" name="beantragteAbweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_478657_23389" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282121_848878_30366" annotatedElement="_19_0_3_136d03d4_1611871264193_64744_25497" body="&lt;para>Hier sind die Daten zu einer möglichen Abweichung eingefügt, falls die Vorbescheidfrage eine solche betrifft.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282121_898352_30367" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282120_97422_30365" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264193_482819_25498" name="angefragteErleichterung" visibility="private" type="_19_0_3_136d03d4_1611871244699_209513_23391" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282121_895800_30370" annotatedElement="_19_0_3_136d03d4_1611871264193_482819_25498" body="&lt;para>Hier sind die Daten zu einer möglichen Erleichterung eingefügt, falls die Vorbescheidfrage eine solche betrifft.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282121_584960_30371" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282121_75510_30369" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244699_209513_23391" name="ErleichterungAngefragt" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264193_993931_25500" annotatedElement="_19_0_3_136d03d4_1611871244699_209513_23391" body="&lt;para>Dieser Typ beinhaltet die Parameter einer beantragten Erleichterung, die der Bauaufsichtsbehörde zur Genehmigung vorgelegt werden soll.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_129a03b9_1710950015169_233660_24973" name="id" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
              <ownedComment xmi:id="_19_0_3_129a03b9_1710950015171_234334_24975" annotatedElement="_19_0_3_129a03b9_1710950015169_233660_24973" body="&lt;para>Dieses Element enthält den „Universally Unique IDentifier (UUID)“ der Erleichterung. Der UUID wird entsprechend rfc4122 gebildet und ermöglicht die Erleichterung eindeutig zu identifizieren.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1710950015171_606672_24976" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1710950015170_96362_24974" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264194_312428_25501" name="gegenstand" visibility="private" type="_19_0_3_136d03d4_1611871239761_808731_22749">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282121_489246_30374" annotatedElement="_19_0_3_136d03d4_1611871264194_312428_25501" body="&lt;para>Hier wird angezeigt, auf welchen Aspekt des Bauvorhabens sich die beantragte Erleichterung bezieht.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282122_215560_30375" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282121_822594_30373" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264194_303817_25502" name="beschreibung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282122_291080_30378" annotatedElement="_19_0_3_136d03d4_1611871264194_303817_25502" body="&lt;para>Hier ist der Erleichterungsgegenstand zu konkretisieren. Es wird im Detail verdeutlicht, worum es bei dem Anliegen geht).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282122_199489_30379" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282122_266193_30377" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264194_252304_25503" name="begruendung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282122_358603_30382" annotatedElement="_19_0_3_136d03d4_1611871264194_252304_25503" body="&lt;para>In diesem Element wird ggf. eine Begründung zur beantragten Erleichterung gegeben, d.h. es wird erläutert, warum die beantragte Erleichterung benötigt wird bzw. gerechtfertigt ist.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282122_922156_30383" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282122_560882_30381" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244699_746777_23393" name="ArtDerBaulichenAnlage" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1696236209399_650827_24137" annotatedElement="_19_0_3_136d03d4_1611871244699_746777_23393" body="&lt;para>Für den Gegenstand des Bauvorhabens kann hier die Art der baulichen Anlage näher spezifiziert werden. Es ist aus einer der drei Codelisten eine Auswahl zu treffen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264195_389565_25509" name="artDesWohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239792_886892_22872">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282124_146015_30394" annotatedElement="_19_0_3_136d03d4_1611871264195_389565_25509" body="&lt;para>Hier wird für bauliche Anlagen, die Wohngebäude sind, eine Klassifizierung vorgenommen gemäß Einteilung der amtlichen Statistik. Die Hauptnutzung muss klar erkennbar sein.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282124_758305_30395" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282124_82107_30393" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264195_856048_25510" name="artDesNichtwohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239790_196517_22867">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282124_870042_30398" annotatedElement="_19_0_3_136d03d4_1611871264195_856048_25510" body="&lt;para>Bauliche Anlagen, die nicht Wohngebäude sind, werden durch dieses Element klassifiziert gemäß Signierschlüsselverzeichnis des Statistischen Bundesamts.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282124_118452_30399" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282124_657945_30397" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264195_153597_25511" name="artDerSonstigenAnlage" visibility="private" type="_19_0_3_136d03d4_1611871239760_582086_22745">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282124_297391_30402" annotatedElement="_19_0_3_136d03d4_1611871264195_153597_25511" body="&lt;para>Hier ist für sonstige bauliche Anlagen, also solche, die nicht Gebäude sind, eine Klassifizierung vorzunehmen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282125_692000_30403" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282124_278307_30401" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244700_807454_23394" name="BefundlistePruefungBauzustand" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264196_951316_25513" annotatedElement="_19_0_3_136d03d4_1611871244700_807454_23394" body="&lt;para>Eine Instanz dieses Typs steht für eine Befundliste der materiellen Prüfung eines Antrags. Jeder Befund beinhaltet die Parameter, die einen  belastenden Verwaltungsakt im Kontext eines Baugenehmigungsvorgangs definieren. &lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264196_266592_25514" name="befund" visibility="private" type="_19_0_3_136d03d4_1611871244700_787877_23395" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282125_136607_30406" annotatedElement="_19_0_3_136d03d4_1611871264196_266592_25514" body="&lt;para>Jedes Element steht für einen  belastenden Verwaltungsakt im Kontext des aktuellen Baugenehmigungsvorgang, zu dem der Adressat der Nachricht zu einer Stellungnahme aufgefordert ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282125_248975_30407" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282125_254048_30405" name="" visibility="public" value="*"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244700_787877_23395" name="Anonym_BefundPruefungBauzustand" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264196_465179_25516" annotatedElement="_19_0_3_136d03d4_1611871244700_787877_23395" body=""/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264196_478853_25517" name="beschreibung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282125_899508_30410" annotatedElement="_19_0_3_136d03d4_1611871264196_478853_25517" body="&lt;para>Hier wird der festgestellte Mangel beschrieben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282125_747886_30411" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282125_539817_30409" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264196_776398_25518" name="verweise" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282126_645960_30414" annotatedElement="_19_0_3_136d03d4_1611871264196_776398_25518" body="&lt;para>Hier kann ein Verweis auf eine Nebenbestimmung der Baugenehmigung eingefügt werden, oder auf z. B. den Prüfbericht Standsicherheit oder Brandschutz.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282126_331674_30415" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282126_559216_30413" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264197_443341_25519" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282126_977853_30418" annotatedElement="_19_0_3_136d03d4_1611871264197_443341_25519" body="&lt;para>Dieses Element nennt (falls zutreffend) den  Rechtsbereich, innerhalb dessen die Bestimmung liegt, gegen die im Kontext des Befundes verstoßen wurde. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282126_481970_30419" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282126_50320_30417" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Association" xmi:id="_19_0_3_136d03d4_1611871244700_309242_23396" name="" visibility="public" memberEnd="_19_0_3_136d03d4_1611871264188_499475_25472 _19_0_3_136d03d4_1611871264197_806511_25520">
            <ownedEnd xmi:id="_19_0_3_136d03d4_1611871264197_806511_25520" name="" visibility="private" type="_19_0_3_136d03d4_1611871244697_801218_23384" association="_19_0_3_136d03d4_1611871244700_309242_23396"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244700_476704_23397" name="Bescheid" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264197_258507_25521" annotatedElement="_19_0_3_136d03d4_1611871244700_476704_23397" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Bescheides, den die Bauaufsichtsbehörde nach Prüfung eines Antrags erlässt.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264197_247082_25522" name="tenor" visibility="private" type="_19_0_3_136d03d4_1611871244697_801218_23384">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282127_122182_30422" annotatedElement="_19_0_3_136d03d4_1611871264197_247082_25522" body="&lt;para>Hier wird der Bescheid formuliert. Es handelt sich entweder um eine Genehmigung oder um eine Ablehnung.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282127_596596_30423" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282127_473325_30421" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264198_459382_25526" name="abweichung" visibility="private" type="_19_0_3_136d03d4_1611871244698_52288_23387">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282128_878590_30438" annotatedElement="_19_0_3_136d03d4_1611871264198_459382_25526" body="&lt;para>Hier werden ggf. die Erläuterungen zur Genehmigung einer beantragten Abweichung eingetragen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282128_64705_30439" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282128_607049_30437" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264198_359065_25527" name="nebenbestimmung" visibility="private" type="_19_0_3_136d03d4_1611871244698_632785_23388">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282129_432905_30442" annotatedElement="_19_0_3_136d03d4_1611871264198_359065_25527" body="&lt;para>Hier werden ggf. die Nebenbestimmungen zum Bescheid eingefügt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282129_711905_30443" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282129_639881_30441" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264197_709045_25523" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282127_61241_30426" annotatedElement="_19_0_3_136d03d4_1611871264197_709045_25523" body="&lt;para>Falls der Bescheid ablehnend ausgefallen ist, wird in diesem Element die entsprechende Begründung geliefert.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282127_162441_30427" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282127_413725_30425" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1618167385995_295784_16929" name="baufreigabeschein" visibility="private" type="_19_0_3_136d03d4_1618167987509_265374_16937">
              <ownedComment xmi:id="_19_0_3_136d03d4_1618167504108_200575_16935" annotatedElement="_19_0_3_136d03d4_1618167385995_295784_16929" body="&lt;para>Hier sind die Daten zum Baufreigabeschein (sog. &quot;Roter Punkt&quot;) zu übermitteln. Falls die Baugenehmigung, auf die sich der Bescheid bezieht, Auflagen und Bedingungen enthält, ist die Baufreigabe separat mittels Nachricht anzeige.baubeginnBaufreigabe.0902 zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1618167477865_189107_16933" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1618167477866_616717_16934" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264198_373274_25524" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282127_317408_30430" annotatedElement="_19_0_3_136d03d4_1611871264198_373274_25524" body="&lt;para>Hier werden die Rechtshelfsbelehrungen zum Bescheid gegeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282128_384347_30431" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282127_587219_30429" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264198_280204_25525" name="hinweise" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282128_180623_30434" annotatedElement="_19_0_3_136d03d4_1611871264198_280204_25525" body="&lt;para>Hier werden ggf. ergänzende Hinweise zum Bescheid gegeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282128_600368_30435" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282128_506706_30433" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244700_835390_23398" name="Anonym_TenorStellungnahme" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264199_793226_25529" annotatedElement="_19_0_3_136d03d4_1611871244700_835390_23398" body="&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264199_400891_25530" name="istZustimmung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282129_718712_30446" annotatedElement="_19_0_3_136d03d4_1611871264199_400891_25530" body="&lt;para>Falls die Stellungnahme positiv ausgefallen ist (Zustimmung), so wird in diesem Element &quot;true&quot; übermittelt, andernfalls &quot;false&quot;.&lt;/para>&#xA;&lt;para>Falls die Zustimmung nur unter der Voraussetzung erteilt wird, dass die angegebenen Nebenbestimmungen eingehalten werden, wird der Tenor als &quot;positiv mit Einschränkungen&quot; betrachtet und ebenfalls &quot;true&quot; übermittelt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282129_329326_30447" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282129_448604_30445" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244701_991956_23400" name="BauordnungsrechtlicheKlassifikation" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264200_556605_25535" annotatedElement="_19_0_3_136d03d4_1611871244701_991956_23400" body="&lt;para>Eine Instanz dieses Typs stellt in Bezug auf den Gegenstand des Bauvorhabens die wichtigsten bauordnungsrechtlichen Parameter zusammen.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264200_257060_25536" name="gebaeudeklasse" visibility="private" type="_19_0_3_136d03d4_1611871239759_272892_22742">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282131_172690_30458" annotatedElement="_19_0_3_136d03d4_1611871264200_257060_25536" body="&lt;para>Für Gebäude: in diesem Element ist die Gebäudeklasse nach MBO des Bauvorhabens anzugeben.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282131_670852_30459" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282130_97994_30457" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264200_967467_25537" name="hoeheNachMBO" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282131_757621_30462" annotatedElement="_19_0_3_136d03d4_1611871264200_967467_25537" body="&lt;para>Höhe des höchsten Aufenthaltsraums&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282131_393420_30463" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282131_95269_30461" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264200_92705_25538" name="istFreistehend" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282131_746239_30466" annotatedElement="_19_0_3_136d03d4_1611871264200_92705_25538" body="&lt;para>Höhe des höchsten Aufenthaltsraums&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282131_880030_30467" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282131_438891_30465" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264200_774177_25539" name="sonderbau" visibility="private" type="_19_0_3_136d03d4_1611871239759_905594_22743" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282132_593997_30470" annotatedElement="_19_0_3_136d03d4_1611871264200_774177_25539" body="&lt;para>Für Sonderbauten ist pro Ausprägung ein Element zu füllen.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282132_260222_30471" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282132_961912_30469" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264201_671703_25540" name="mittelOderGrossGarage" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282132_269922_30474" annotatedElement="_19_0_3_136d03d4_1611871264201_671703_25540" body="&lt;para>Angabe, ob das Vorhaben eine Mittel- oder Großgarage gem. § 1 Abs. 7 Satz 1 Nr. 2, 3 GaStellV beinhaltet&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282132_793805_30475" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282132_397356_30473" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264201_252837_25541" name="garage" visibility="private" type="_19_0_3_136d03d4_1611871239760_159075_22744" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282133_820612_30478" annotatedElement="_19_0_3_136d03d4_1611871264201_252837_25541" body="&lt;para>Für Garagen ist der Garagentyp auszuwählen.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282133_112438_30479" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282133_714373_30477" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244701_882762_23402" name="Nachbarschaft" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264202_899258_25546" annotatedElement="_19_0_3_136d03d4_1611871244701_882762_23402" body="&lt;para>Typ zur Übermittlung der Daten eines im Rahmen der Prüfung des Bauvorhabens zu beteiligenden Nachbarn (Person oder Organisation).&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264202_165504_25547" name="eigentuemer" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282133_553252_30486" annotatedElement="_19_0_3_136d03d4_1611871264202_165504_25547" body="&lt;para>Pro Eigentümer des vom Bauvorhaben betroffenen Nachbargrundstücks ist ein Element zu instanziieren.&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282134_820545_30487" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282133_891791_30485" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264202_386808_25548" name="grundstueck" visibility="private" type="_19_0_3_136d03d4_1611871246531_270636_23533">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282134_929862_30490" annotatedElement="_19_0_3_136d03d4_1611871264202_386808_25548" body="&lt;para>In dieses Element sind die Daten zum Nachbargrundstück einzutragen, das den Eigentümer zum vom Bauvorhaben betroffenen Nachbarn macht. Pro Grundstück ist ein Element zu instanziieren.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282134_796959_30491" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282134_166661_30489" name="" visibility="public" value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264202_931783_25549" name="hatZugestimmt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282134_213351_30494" annotatedElement="_19_0_3_136d03d4_1611871264202_931783_25549" body="&lt;para>Wurde die Zustimmung durch diesen betroffenen Nachbarn bereits erteilt? Wenn ja, ist in dieses Element 'true' einzutragen, sonst 'false'.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282134_157634_30495" name="" visibility="public" value="1"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282134_347267_30493" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244702_582549_23403" name="Prozessmerkmale" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264203_578285_25551" annotatedElement="_19_0_3_136d03d4_1611871244702_582549_23403" body="&#xA;&lt;para>Dieser Typ bündelt Parameter zum Verfahren, die für eine Antragstellung relevant sein können.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264203_121683_25552" name="verfahrensart" visibility="private" type="_19_0_3_136d03d4_1611871239791_257404_22869" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282135_656988_30498" annotatedElement="_19_0_3_136d03d4_1611871264203_121683_25552" body="&lt;para>Dieses Element kann verwendet werden, um die baurechtliche Verfahrensart anzugeben. &lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282135_356084_30499" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282135_662410_30497" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1643614321085_39383_17963" name="absehenNachbarbeteiligungBeantragt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1643614495782_20388_17969" annotatedElement="_19_0_3_136d03d4_1643614321085_39383_17963" body="&lt;para>Wenn bei einer Bauvoranfrage beantragt wird, dass von einer Nachbarbeteiligung abzusehen ist, dann ist hier der Wert true zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1643614383125_550257_17967" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1643614383126_671499_17968" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264203_544393_25553" name="nachbarbeteiligungForm" visibility="private" type="_19_0_3_136d03d4_1611871244702_221674_23404" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282135_289774_30502" annotatedElement="_19_0_3_136d03d4_1611871264203_544393_25553" body="&lt;para>Dieses Element kann verwendet werden, um Modalitäten der Nachbarbeteiligung anzugeben.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282135_945082_30503" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282135_516447_30501" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1652711388343_134646_18034" name="einwilligung" visibility="private" type="_19_0_3_136d03d4_1652711472496_341236_18039">
              <ownedComment xmi:id="_19_0_3_136d03d4_1652711460710_277674_18038" annotatedElement="_19_0_3_136d03d4_1652711388343_134646_18034" body="&lt;para>Dieses Element kann verwendet werden, um Modalitäten der Einwilligung zur öffentlichen Bekanntmachung anzugeben.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1652711553081_805021_18041" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1652711553081_466767_18042" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264203_238954_25554" name="nachtragsbaugenehmigung" visibility="private" type="_19_0_3_136d03d4_1611871246529_313323_23523">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282136_368654_30506" annotatedElement="_19_0_3_136d03d4_1611871264203_238954_25554" body="&lt;para>Falls mit der vorliegenden Nachrichteninstanz ein Nachtrag zu einer bereits erteilten Baugenehmigung beantragt werden soll (Nachtragsbaugenehmigung), sind in dieses Element Angaben einzutragen, die die bereits erteilte Baugenehmigung identifizieren.&lt;/para>&#xA;&#xA;&lt;para>Durch diese Einträge wird der vorliegende Antrag zur Beantragung einer Nachtragsbaugenehmigung (auch Änderungsantrag genannt).&lt;/para>&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282136_906301_30507" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282135_347743_30505" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264204_46257_25555" name="vorbescheid" visibility="private" type="_19_0_3_136d03d4_1611871246530_701052_23524">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282136_136306_30510" annotatedElement="_19_0_3_136d03d4_1611871264204_46257_25555" body="&lt;para>Dieses Element erfasst die Angaben zu einem in der Vergangenheit erteilten Vorbescheid.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282136_353558_30511" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282136_637327_30509" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1655648511720_609847_18166" name="bauberatung" visibility="private" type="_19_0_3_136d03d4_1655648615965_361906_18170">
              <ownedComment xmi:id="_19_0_3_136d03d4_1655649016706_118055_18180" annotatedElement="_19_0_3_136d03d4_1655648511720_609847_18166" body="&lt;para>Dieses Element erfasst die Angaben zu einer in der Vergangenheit stattgefundenen Bauberatung.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1655649450165_754718_18185" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1655649450174_343666_18186" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1639993391401_370801_17826" name="istReferenzgebaeude" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" isReadOnly="true" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_c4f030d_1639993391412_581834_17828" annotatedElement="_19_0_3_c4f030d_1639993391401_370801_17826" body="&lt;para>Durch die Übermittlung dieses Elements (enthält, falls vorhanden, den Wert true) wird mitgeteilt, dass der Gegenstand des vorliegenden Antragsverfahrens als Referenzgebäude markiert werden soll, so dass in zukünftigen Anträgen oder Anzeigen Bezug auf diesen genommen werden kann.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1639993391413_113514_17829" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1639993391412_663363_17827" name="" visibility="public" value="1"/>
              <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_3_c4f030d_1639993447341_507129_17833" name="" visibility="public" value="true"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_c4f030d_1639995085238_636536_17853" name="referenzgebaeude" visibility="private" type="_19_0_3_c4f030d_1639993698856_4870_17834" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_c4f030d_1639995085241_459699_17855" annotatedElement="_19_0_3_c4f030d_1639995085238_636536_17853" body="&lt;para>Im Rahmen eines referenziellen Baugenehmigungsverfahrens sind in dieses Element Angaben einzutragen, die auf das Referenzgebäude (und den entsprechenden durchgeführten Vorgang) verweisen.&lt;/para>&#xA;&#xA;&lt;para>Dieses Element muss verwendet werden, wenn das Attribut &quot;verfahrensart&quot; den Code &quot;Referenzielles Baugenehmigungsverfahren&quot; enthält.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_c4f030d_1639995085241_10054_17856" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_c4f030d_1639995085240_555990_17854" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244702_221674_23404" name="Anonym_NachbarbeteiligungForm" visibility="public">
            <ownedComment xmi:id="_19_0_3_136d03d4_1611871264204_192859_25557" annotatedElement="_19_0_3_136d03d4_1611871244702_221674_23404" body="&#xA;"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264204_905463_25558" name="oeffentlicheBekanntmachung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282136_848419_30514" annotatedElement="_19_0_3_136d03d4_1611871264204_905463_25558" body="&lt;para>Falls beantragt wird, das Bauvorhaben öffentlich bekannt zu machen, ist in diesem Element &quot;true&quot; zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282136_397061_30515" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282136_272620_30513" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264204_503142_25559" name="oeffentlichkeitsbeteiligungVerpflichtend" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282137_371245_30518" annotatedElement="_19_0_3_136d03d4_1611871264204_503142_25559" body="&lt;para>Falls eine Öffentlichkeitsbeteiligung verpflichtend durchzuführen ist, wird in diesem Element &quot;true&quot; übermittelt.&lt;/para>&#xA;&#xA;"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282137_832012_30519" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282137_831458_30517" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1618157092995_610286_16820" name="zustellungPositiverBescheidAnNachbarn" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_3_136d03d4_1618157363057_299160_16826" annotatedElement="_19_0_3_136d03d4_1618157092995_610286_16820" body="&lt;para>Falls der Nachbarschaft ein positiver Bescheid zugestellt werden soll, ist in diesem Element &quot;true&quot; zu übermitteln.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1618157119839_289137_16824" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1618157119839_200681_16825" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1611871244702_23191_23405" name="Herstellungskosten" visibility="public">
            <ownedComment xmi:id="_19_0_3_129a03b9_1690814335133_779757_22447" annotatedElement="_19_0_3_136d03d4_1611871244702_23191_23405" body="&lt;para>Dieses Objekt biete die Felder für die Übermittlung von Herstellungskosten für die entsprechenden Kostengruppen der DIN 276.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264205_965560_25560" name="kostengruppe300" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282137_518437_30522" annotatedElement="_19_0_3_136d03d4_1611871264205_965560_25560" body="&lt;para>Hier sind die Herstellungskosten aus der Kostengruppe 300 einzutragen (Einheit: Eurocent).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282137_972152_30523" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282137_993211_30521" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264205_261036_25561" name="kostengruppe400" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282138_695524_30526" annotatedElement="_19_0_3_136d03d4_1611871264205_261036_25561" body="&lt;para>Hier sind die Herstellungskosten aus der Kostengruppe 400 einzutragen (Einheit: Eurocent).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282138_387319_30527" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1611871282138_206691_30525" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_3_136d03d4_1611871264205_910721_25562" name="kostengruppe500" visibility="private" type="_14_0_1_6370212_1218191855828_468108_1536">
              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282138_351109_30530" annotatedElement="_19_0_3_136d03d4_1611871264205_910721_25562" body="&lt;para>Hier sind die Herstellungskosten aus der Kostengruppe 500 einzutragen (Einheit: Eurocent).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1611871282138_523794_30531" name="" visibility="public"/>
