              </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1721716171795_709802_25561" name="AnsprechpartnerBauamtAlt" visibility="public">
              <ownedComment xmi:id="_19_0_4_b6602da_1721716226889_445068_25577" annotatedElement="_19_0_4_b6602da_1721716171795_709802_25561" body="&lt;para>Dieser Typ deckt Namen und Erreichbarkeit des Ansprechpartners im Bauamt für Rückfragen ab.&lt;/para>&#xA;&lt;para>Der Inhalt der Kindelemente wird in der Behörde gepflegt.&lt;/para>"/>
              <ownedAttribute xmi:id="_19_0_4_b6602da_1721716199385_338692_25562" name="nameNatuerlichePerson" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103">
                <ownedComment xmi:id="_19_0_4_b6602da_1721716199388_327284_25564" annotatedElement="_19_0_4_b6602da_1721716199385_338692_25562" body="&lt;para>In dieses Element sind die Angaben zu den Namen der Person einzutragen.&lt;/para>"/>
