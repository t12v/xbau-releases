                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291316_152211_6021" annotatedElement="_16_5_4_5b501fb_1387625291118_413461_5196" body="Unter &quot;kommunikation&quot; werden Angaben zur Erreichbarkeit einer &quot;NatuerlichenPerson&quot; über elektronische Telekommunikationskanäle zusammengefasst. "/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291316_180490_6022" name="" visibility="private" type="_16_5_4_5b501fb_1387625291102_608193_5164" association="_16_5_4_5b501fb_1387625291118_413461_5196"/>
