            <node xmi:type="uml:CentralBufferNode" xmi:id="_19_0_3_136d03d4_1611871270054_28595_27560" name="Prüfbericht des Auftragnehmers&#xA;Nachricht 0506" visibility="public" incoming="_19_0_3_136d03d4_1611871270067_163259_27613" outgoing="_19_0_3_136d03d4_1611871270065_345761_27602">
