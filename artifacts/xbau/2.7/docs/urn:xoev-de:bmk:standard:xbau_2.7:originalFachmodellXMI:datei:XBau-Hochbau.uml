                <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1760601772244_378195_31697" name="" visibility="public"/>
                <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1760601772244_81367_31698" name="" visibility="public" value="1"/>
                <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_19_0_4_b8702dd_1760603014347_841902_31892" name="" visibility="public" value="true"/>
              </ownedAttribute>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115822002_229138_25226" name="statistik.baufertigstellung.0425" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1714115823187_467732_25424" annotatedElement="_19_0_4_b6602da_1714115822002_229138_25226" body="&lt;para>Diese Nachricht übermittelt der amtlichen Statistik die Tatsache, dass das Bauvorhaben  fertig umgesetzt wurde (Baufertigstellung).&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1714115823190_422780_25430" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
