              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1387625291117_936331_5187" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1387625291279_920401_5855 _16_5_4_5b501fb_1387625291315_87552_5995">
                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291314_610639_5994" annotatedElement="_16_5_4_5b501fb_1387625291117_936331_5187" body="Hier werden Angaben zum Zeitraum der Existenz einer Organisation gemacht, der mit Gründungs- und Auflösungsdatum der Organisation angegeben wird."/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291315_87552_5995" name="" visibility="private" type="_16_5_4_5b501fb_1387625291114_133591_5178" association="_16_5_4_5b501fb_1387625291117_936331_5187"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1387625291117_964398_5188" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1387625291303_552513_5943 _16_5_4_5b501fb_1387625291315_420801_5998">
                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291315_37518_5997" annotatedElement="_16_5_4_5b501fb_1387625291117_964398_5188" body="Der Lebenspartnerschaftsname ist der von beiden Lebenspartnern durch Erklärung bestimmte gemeinsame Name der Lebenspartner. Zum Lebenspartnerschaftsnamen kann der Geburtsname eines der Lebenspartner oder der zur Zeit der Erklärung von einem Lebenspartner geführte Name bestimmt werden."/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291315_420801_5998" name="" visibility="private" type="_16_5_4_5b501fb_1387625291116_769920_5181" association="_16_5_4_5b501fb_1387625291117_964398_5188"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1387625291117_42596_5189" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1387625291307_32067_5953 _16_5_4_5b501fb_1387625291315_137212_6001">
                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291315_860569_6000" annotatedElement="_16_5_4_5b501fb_1387625291117_42596_5189" body="Ein Ordensname ist ein Name, der als Pseudonym von einer Ordensperson geführt wird. &#xA;&#xA;Es sind nur solche Ordensnamen anzugeben, die in den Personalausweis oder Pass eingetragen werden dürfen."/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291315_137212_6001" name="" visibility="private" type="_16_5_4_5b501fb_1387625291116_769920_5181" association="_16_5_4_5b501fb_1387625291117_42596_5189"/>
              </packagedElement>
