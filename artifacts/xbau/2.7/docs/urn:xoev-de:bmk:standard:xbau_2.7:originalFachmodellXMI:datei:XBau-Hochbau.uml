              <ownedComment xmi:id="_19_0_4_b6602da_1714115823640_513280_26290" annotatedElement="_19_0_4_b6602da_1714115823544_168997_25802" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass Wärmerückgewinnung nach § 68 GEG genutzt wird. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823641_656699_26291" name="" visibility="public"/>
