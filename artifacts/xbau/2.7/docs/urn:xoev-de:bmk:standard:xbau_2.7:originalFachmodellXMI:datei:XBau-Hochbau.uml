                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291315_21348_6009" annotatedElement="_16_5_4_5b501fb_1387625291118_400224_5192" body="Die &quot;nachgeordneteBehoerde&quot; erlaubt die Abbildung einer der Behörde nachgeordneten Stelle."/>
