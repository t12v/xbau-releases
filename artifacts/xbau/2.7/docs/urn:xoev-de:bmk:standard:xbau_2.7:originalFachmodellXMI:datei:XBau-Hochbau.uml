            <ownedAttribute xmi:id="_19_0_4_78d0259_1728629349791_733499_29481" name="nameNatuerlichePerson" visibility="private" type="_16_5_4_8a30247_1422955073653_603895_5103">
              <ownedComment xmi:id="_19_0_4_78d0259_1728629349791_986760_29485" annotatedElement="_19_0_4_78d0259_1728629349791_733499_29481" body="&lt;para>In dieses Element sind die Angaben zu den Namen der Person einzutragen.&lt;/para>"/>
