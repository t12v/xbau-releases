            <ownedAttribute xmi:id="_19_0_4_b6602da_1696424161380_612608_24842" name="nachweisbefreiungenErfuellungserklaerung" visibility="private" type="_19_0_4_b6602da_1696424234394_258537_24852">
              <ownedComment xmi:id="_19_0_4_b6602da_1696424216134_296766_24851" annotatedElement="_19_0_4_b6602da_1696424161380_612608_24842" body="&lt;para>Hier können Angaben zu möglichen Befreiungen gemacht werden.&lt;/para>"/>
