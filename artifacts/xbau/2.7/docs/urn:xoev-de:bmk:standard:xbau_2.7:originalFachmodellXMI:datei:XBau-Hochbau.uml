          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115822014_246587_25229" name="statistik.bauueberhang.0427" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1714115823197_101700_25446" annotatedElement="_19_0_4_b6602da_1714115822014_246587_25229" body="&lt;para>Mittels dieser Nachricht stellt die Bauaufsichtsbehörde der amtlichen Statistik stichtagsbezogen Daten für die Bauüberhangsstatistik bereit. Dafür werden zum Jahresende Daten zum Baufortschritt des aktiven Bauvorhabens gemeldet (selbst wenn bereits im Laufe des Jahres Baubeginn bzw. Rohbaufertigstellung gemeldet worden ist).&lt;/para>"/>
            <generalization xmi:id="_19_0_4_b6602da_1714115823200_218613_25452" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
