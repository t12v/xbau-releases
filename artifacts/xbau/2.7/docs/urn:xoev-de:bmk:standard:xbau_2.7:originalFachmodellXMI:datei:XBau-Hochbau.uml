            <ownedAttribute xmi:id="_19_0_4_b6602da_1721722017162_114369_26149" name="artDesWohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239792_886892_22872">
              <ownedComment xmi:id="_19_0_4_b6602da_1721722017179_459757_26151" annotatedElement="_19_0_4_b6602da_1721722017162_114369_26149" body="&lt;para>Hier wird für bauliche Anlagen, die Wohngebäude sind, eine Klassifizierung vorgenommen gemäß Einteilung der amtlichen Statistik. Die Hauptnutzung muss klar erkennbar sein.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp DatenBauabgangEingeschraenkt der Eingangsnachricht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1721722017181_970982_26152" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1721722017176_226639_26150" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823471_588069_25701" name="artDesNichtwohngebaeudes" visibility="private" type="_19_0_3_136d03d4_1611871239790_196517_22867">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823596_767906_26136" annotatedElement="_19_0_4_b6602da_1714115823471_588069_25701" body="&lt;para>Bauliche Anlagen, die nicht Wohngebäude sind, werden durch dieses Element klassifiziert gemäß Signierschlüsselverzeichnis des Statistischen Bundesamts.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp DatenBauabgangEingeschraenkt der Eingangsnachricht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823596_50760_26137" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823596_673121_26135" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823473_236942_25702" name="datumAntragstellung" visibility="private" type="_19_0_3_129a03b9_1684499176991_74723_8754">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823596_303715_26140" annotatedElement="_19_0_4_b6602da_1714115823473_236942_25702" body="&lt;para>Hier ist das Datum der Antragstellung einzutragen.&lt;/para>&#xA;&lt;para>Der Inhalt des Elements wird in der Behörde gepflegt.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823596_9934_26141" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823596_936893_26139" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823473_411790_25703" name="ueberbauteFlaeche" visibility="private" type="_18_0_6_8c5027b_1571829426918_186531_14360">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823596_360180_26144" annotatedElement="_19_0_4_b6602da_1714115823473_411790_25703" body="&lt;para>Flächen der Bauwerke oberhalb der Geländeoberfläche. Angabe: Anzahl Quadratmeter mit zwei Nachkommastellen&lt;/para>&#xA;&lt;para>Der Inhalt des Elements ergibt sich aus dem Datentyp DatenBauabgangEingeschraenkt der Eingangsnachricht.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823597_628175_26145" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823596_755140_26143" name="" visibility="public" value="1"/>
            </ownedAttribute>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1714115823091_433237_25390" name="ErfuellungGEG" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1714115823541_168701_25793" annotatedElement="_19_0_4_b6602da_1714115823091_433237_25390" body="&lt;para>Angabe, ob die Verpflichtungen des Gebäudeenergiegesetzes (GEG) erfüllt werden.&lt;/para>&#xA;&lt;para>Diese Daten müssen nur bei Neubauten übermittelt werden.&lt;/para>"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823542_262410_25794" name="erneuerbareEnergieFesteBiomasse" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823634_1617_26258" annotatedElement="_19_0_4_b6602da_1714115823542_262410_25794" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass feste Biomasse nach § 71ff GEG genutzt wird. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823635_121462_26259" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823634_100079_26257" name="" visibility="public" value="1"/>
