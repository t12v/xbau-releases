                <ownedComment xmi:id="_16_5_4_5b501fb_1387625291316_790569_6027" annotatedElement="_16_5_4_5b501fb_1387625291118_782168_5198" body="Angaben zum offiziellen Namen einer Organisation."/>
                <ownedEnd xmi:id="_16_5_4_5b501fb_1387625291316_336719_6028" name="" visibility="private" type="_16_5_4_5b501fb_1387625291114_133591_5178" association="_16_5_4_5b501fb_1387625291118_782168_5198"/>
