            <ownedAttribute xmi:id="_19_0_4_b6602da_1726570818336_850331_28295" name="bauvorhabenGebaeude" visibility="private" type="_19_0_4_b6602da_1726570890090_615170_28297">
              <ownedComment xmi:id="_19_0_4_b6602da_1726571114062_355394_28376" annotatedElement="_19_0_4_b6602da_1726570818336_850331_28295" body="&lt;para>Dieses Element enthält detaillierte Daten zu den einzelnen Gebäuden des Bauvorhabens.&lt;/para>"/>
