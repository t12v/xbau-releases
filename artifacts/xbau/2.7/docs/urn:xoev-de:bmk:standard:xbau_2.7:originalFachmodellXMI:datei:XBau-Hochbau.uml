          <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1726566053795_605443_27976" name="statistik.datenBauvorhaben.0420" visibility="public">
            <ownedComment xmi:id="_19_0_4_b6602da_1726566054552_715958_28006" annotatedElement="_19_0_4_b6602da_1726566053795_605443_27976" body="&lt;para>Diese Nachricht stellt der Bauaufsichtsbehörde die statistikrelevanten Daten des Bauvorhabens bereit.&lt;/para>&#xA;&#xA;&#xA;"/>
            <generalization xmi:id="_19_0_4_b6602da_1726566054570_318325_28011" general="_19_0_3_136d03d4_1611871243167_733539_23288"/>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1726566054556_548957_28007" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
              <ownedComment xmi:id="_19_0_4_b6602da_1726566054581_280690_28015" annotatedElement="_19_0_4_b6602da_1726566054556_548957_28007" body="&lt;para>Dieses Element nennt die Vorgangsnummer der Bauaufsichtsbehörde, unter der sie das Bauvorhaben prüft. Oder die referenzAntragsservice, unter der der Genehmigungsantrag vom Bauvorhaben eingereicht worden ist.&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1726566054583_839490_28016" name="" visibility="public" value="1"/>
