              <ownedComment xmi:id="_19_0_3_136d03d4_1611871282203_100327_31108" annotatedElement="_19_0_3_136d03d4_1611871264255_905348_25789" body="&lt;para>Größe aller Stellplatzflächen. Angabe: Anzahl Quadratmeter&lt;/para>"/>
