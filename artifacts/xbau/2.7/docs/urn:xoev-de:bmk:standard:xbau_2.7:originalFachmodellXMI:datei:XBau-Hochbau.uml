              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1779266915488_9161_9509" name="ruleset.anlagen" visibility="public">
                <ownedRule xmi:id="_19_0_4_b8702dd_1779266408332_697570_9489" name="sch-xbauk-003" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1779266408340_309646_9491" annotatedElement="_19_0_4_b8702dd_1779266408332_697570_9489" body="URIs verlinkter Anlagen zu einer Nachricht müssen eindeutig sein."/>
                  <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779266408339_312218_9490" name="" visibility="public">
                    <language>English</language>
                    <body>count(//anhangOderVerlinkung/verlinkung/uriVerlinkung) = count(distinct-values(//anhangOderVerlinkung/verlinkung/uriVerlinkung)) </body>
                  </specification>
                </ownedRule>
                <ownedRule xmi:id="_19_0_4_b8702dd_1779174914548_437358_9489" name="sch-xbauk-001" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1779175042471_410282_9491" annotatedElement="_19_0_4_b8702dd_1779174914548_437358_9489" body="Dateinamen der Anlagen zu einer Nachricht müssen eindeutig sein."/>
                  <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779174914548_877183_9490" name="" visibility="public">
                    <language>English</language>
                    <body>count(//anhangOderVerlinkung/*/dateiname) = count(distinct-values(//anhangOderVerlinkung/*/dateiname)) </body>
                  </specification>
                </ownedRule>
                <ownedRule xmi:id="_19_0_4_b8702dd_1779176764267_285484_9509" name="sch-xbauk-002" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1779176764267_137504_9511" annotatedElement="_19_0_4_b8702dd_1779176764267_285484_9509" body="Dokument-IDs der Anlagen zu einer Nachricht müssen eindeutig sein."/>
                  <specification xmi:type="uml:OpaqueExpression" xmi:id="_19_0_4_b8702dd_1779176764267_827866_9510" name="" visibility="public">
                    <language>English</language>
                    <body>count(//anhangOderVerlinkung/*/dokumentid) = count(distinct-values(//anhangOderVerlinkung/*/dokumentid)) </body>
                  </specification>
                </ownedRule>
              </packagedElement>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1779267813175_88077_9511" name="" visibility="public" client="_19_0_4_b8702dd_1779266915488_9161_9509" supplier="_19_0_3_136d03d4_1617018517570_525675_9422"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479083484_262093_9335" name="Verortung" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1589627283733_575112_12053" name="Anonym_Gemarkung" visibility="public">
                <ownedAttribute xmi:id="_19_0_3_940029b_1589627348453_384061_12061" name="nummer" visibility="private" type="_19_0_4_b8702dd_1782126210780_938004_9525" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_940029b_1589627348456_154304_12063" annotatedElement="_19_0_3_940029b_1589627348453_384061_12061" body="&lt;para>In dieses Element ist die Nummer der Gemarkung gemäß lokalem Liegenschaftskataster einzutragen (Gemarkungsnummer bestehend aus maximal 4 Stellen).&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1589627348457_910506_12064" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1589627348455_233611_12062" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1589627283747_482664_12054" name="bezeichnung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_940029b_1589627283752_243381_12056" annotatedElement="_19_0_3_940029b_1589627283747_482664_12054" body="&lt;para>Dieses Element steht für die deskriptive Bezeichnung der Gemarkung.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1589627283753_895163_12057" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1589627283751_765478_12055" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_940029b_1462299055656_708712_5047" name="GeometriePolygon" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1715001997263_38563_8279" annotatedElement="_16_5_4_940029b_1462299055656_708712_5047" body="&lt;para>Georeferenzierte Daten einer Fläche&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1720606576903_796333_9708" name="polygon" visibility="private" type="_19_0_3_129a03b9_1720606516991_787618_8612">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1720606742489_510502_9710" annotatedElement="_19_0_3_129a03b9_1720606576903_796333_9708" body="&lt;para>Das Element (globales Element gml:Polygon) enthält die GML-Darstellung einer Grundfläche (es können Außenkanten und Innenkanten dargestellt werden).&lt;/para>&#xA;&lt;para>Aus der GML-Dokumentation: &quot;A Polygon is a special surface that is defined by a single surface patch. The boundary of this patch is coplanar and the polygon uses planar interpolation in its interior. The elements exterior and interior describe the surface boundary of the polygon.&quot; Quelle: &lt;link xmlns:xlink=&quot;http://www.w3.org/1999/xlink&quot; xlink:href=&quot;http://www.datypic.com/sc/niem21/e-gml32_Polygon.html&quot;>http://www.datypic.com/sc/niem21/e-gml32_Polygon.html&lt;/link>  &lt;/para>&#xA;"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_8a30247_1408964097602_950511_3483" name="Flurstueckskennzeichen" visibility="public">
                <ownedComment xmi:id="_16_5_4_8a30247_1408964140406_260187_3502" annotatedElement="_16_5_4_8a30247_1408964097602_950511_3483" body="&lt;para>Typ zur eindeutigen Identifikation eines Flurstücks.&lt;/para>&#xA;&lt;para>Ein Flurstück ist ein amtlich vermessener Teil der Erdoberfläche. Das Liegenschaftskataster ordnet jedem Flurstück des jeweiligen Nummerierungsbezirks (Flur oder Gemarkung) eine Flurstücksnummer zu.&#xA;&lt;/para>&#xA;&#xA;&#xA;&#xA;"/>
                <ownedAttribute xmi:id="_16_5_4_8a30247_1408964599802_91559_3503" name="bundesland" visibility="private" type="_16_5_4_8a30247_1423044461203_939066_6394">
                  <ownedComment xmi:id="_16_5_4_8a30247_1410188461488_459574_3290" annotatedElement="_16_5_4_8a30247_1408964599802_91559_3503" body="&lt;para>Hier wird das Bundesland genannt, in dem sich das Flurstück befindet.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1465375451399_94626_5521" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1465375451399_21960_5522" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_8a30247_1422969627950_52913_6195" name="kodierungFlurstueck" visibility="private" type="_18_0_2_940029b_1577646723035_837384_15544" association="_16_5_4_8ae0277_1427194978142_462923_7460">
                  <ownedComment xmi:id="_16_5_4_940029b_1468227329223_484000_5573" annotatedElement="_16_5_4_8a30247_1422969627950_52913_6195" body="&lt;para>Hier sind die identifzierenden Angaben zum Flurstück gemäß Systematik des regionalen Liegenschaftskatasters einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1465375445297_154803_5519" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1465375445297_803876_5520" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_16_5_4_940029b_1460651165974_293124_3777" name="GeoreferenzierteFlaeche" visibility="public">
                <ownedComment xmi:id="_16_5_4_940029b_1461160878182_666896_5884" annotatedElement="_16_5_4_940029b_1460651165974_293124_3777" body="&lt;para>In eine Instanz diesen Typs werden die Geodaten eines Vorhabens oder einer sonstigen Entität in Form von Flächen eingetragen.&lt;/para>&#xA;"/>
                <ownedAttribute xmi:id="_16_5_4_940029b_1465269351210_845309_5051" name="flaeche" visibility="private" type="_16_5_4_940029b_1462299055656_708712_5047" aggregation="composite" association="_16_5_4_940029b_1465269351210_133361_5050">
                  <ownedComment xmi:id="_16_5_4_940029b_1465270497478_461035_5532" annotatedElement="_16_5_4_940029b_1465269351210_845309_5051" body="&lt;para>In diesem Element lassen sich georeferenzierte Daten zu Bauvorhaben, Baulasten oder sonstigen Objekten übermitteln, also zu Gegenständen, die im Zusammenhang von XBau-Prozessen näher bestimmt werden sollen. Es  lassen sich hier z. B. die äußeren Kanten eines geplanten Gebäudes (Bauvorhaben) georeferenziert abbilden.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1465375574948_447007_5525" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1465375574948_617106_5526" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_16_5_4_940029b_1460559782420_430828_3746" name="erlaeuterung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_16_5_4_940029b_1461160888499_448047_5886" annotatedElement="_16_5_4_940029b_1460559782420_430828_3746" body="&lt;para>Hier können ergänzend Erläuterungen zur Lage des Bauvorhabens (Vorhabens) auf dem Baugrundstück gegeben werden  (z. B. &quot;Anbau an Nordseite&quot;).&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_16_5_4_940029b_1460560067276_796836_3774" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_16_5_4_940029b_1460560067276_69329_3775" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1577646723035_837384_15544" name="KodierungFlurstueck" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1577646723071_147389_15566" annotatedElement="_18_0_2_940029b_1577646723035_837384_15544" body="&lt;para>Dieser Typ deckt Informationen zur Identifikation von Flurstücken (Liegenschaftskataster) ab.&lt;/para>"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1577646723072_898398_15569" name="gemarkung" visibility="private" type="_19_0_3_940029b_1589627283733_575112_12053">
                  <ownedComment xmi:id="_18_0_2_940029b_1577646723074_515398_15581" annotatedElement="_18_0_2_940029b_1577646723072_898398_15569" body="&lt;para>Durch dieses Elements wird die Gemarkung bezeichnet. Sie ist entweder deskriptiv oder als Nummer dargestellt.&lt;/para>&#xA;&#xA;&lt;para>Eine Gemarkung ist eine zusammenhängende, aus mehreren Fluren bestehende Fläche des Liegenschaftskatasters.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646723074_569880_15582" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1578177328357_722589_14515" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1577646859247_92204_15654" name="flur" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_18_0_2_940029b_1577646859249_382638_15659" annotatedElement="_18_0_2_940029b_1577646859247_92204_15654" body="&lt;para>Mit diesem Element kann die Flurbezeichnung (z.B. Nummer der Flur) angegeben werden.&lt;/para> &#xA;&lt;para>Die Flur ist eine zusammenhängende, aus mehreren Flurstücken bestehende Fläche des Liegenschaftskatasters.&lt;/para> &#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646859249_872927_15660" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646859249_727845_15658" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1577646859248_358183_15655" name="zaehler" visibility="private" type="_19_0_4_b8702dd_1782126210780_938004_9525">
                  <ownedComment xmi:id="_18_0_2_940029b_1577646859250_190473_15663" annotatedElement="_18_0_2_940029b_1577646859248_358183_15655" body="&lt;para>Dieses Element steht für den Zähler der Flurstücknummer (maximal 5 Stellen). Der Zähler ist der erste Teil der Flurstücksnummer und muss in jedem Fall angegeben werden.&lt;/para>  &#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646859250_85810_15664" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1577646859250_812646_15662" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1577646859248_144146_15656" name="nenner" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_18_0_2_940029b_1577646859250_485411_15667" annotatedElement="_18_0_2_940029b_1577646859248_144146_15656" body="&lt;para>Dieses Element steht für den ggf. anzuführenden Nenner der Flurstücknummer (maximal 4 Stellen). Der Nenner ist der zweite Teil der Flurstücksnummer, üblicherweise in einer Notation durch Schrägstrich vom Zähler getrennt. Die Angabe ist optional.&lt;/para>  &#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646859250_241269_15668" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1577646859250_335472_15666" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1577646859248_808671_15657" name="folge" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                  <ownedComment xmi:id="_18_0_2_940029b_1577646859251_248109_15671" annotatedElement="_18_0_2_940029b_1577646859248_808671_15657" body="&lt;para>Dieses Element bietet die Möglichkeit, im Rahmen der Flurstücksnummer auch eine  Flurstücksfolge anzugeben (maximal 2 Stellen). Die Folge ist eine weitere Präzisiserung einer Flurstücksnummer und kann ergänzend angegeben werden.&lt;/para>  "/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1577646859251_7797_15672" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1577646859251_460238_15670" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_8ae0277_1427194978142_462923_7460" name="" visibility="public" memberEnd="_16_5_4_8ae0277_1427194978142_497560_7461 _16_5_4_8a30247_1422969627950_52913_6195">
                <ownedEnd xmi:id="_16_5_4_8ae0277_1427194978142_497560_7461" name="" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483" association="_16_5_4_8ae0277_1427194978142_462923_7460"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_940029b_1465269351210_133361_5050" name="" visibility="public" memberEnd="_16_5_4_940029b_1465269351210_845309_5051 _16_5_4_940029b_1465269351210_590067_5052">
                <ownedEnd xmi:id="_16_5_4_940029b_1465269351210_590067_5052" name="" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777" association="_16_5_4_940029b_1465269351210_133361_5050"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_16_5_4_8ae0277_1427194878441_42353_7435" name="" visibility="public" client="_16_5_4_8a30247_1408964599802_91559_3503" supplier="_16_5_4_5b501fb_1387625291131_436878_5274"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1578181511276_378523_14636" name="" visibility="public" client="_18_0_2_940029b_1577646723035_837384_15544" supplier="_16_5_4_5b501fb_1387625291107_242212_5170"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1577648241816_245193_16272" name="" visibility="public" client="_18_0_2_940029b_1577646859247_92204_15654" supplier="_16_5_4_5b501fb_1387625291220_982318_5627"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1577649941781_529352_16534" name="" visibility="public" client="_18_0_2_940029b_1577646859248_808671_15657" supplier="_16_5_4_5b501fb_1387625291220_627720_5628"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1577649930830_845966_16531" name="" visibility="public" client="_18_0_2_940029b_1577646859248_144146_15656" supplier="_16_5_4_5b501fb_1387625291220_627720_5628"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_18_0_2_940029b_1577649919804_405032_16528" name="" visibility="public" client="_18_0_2_940029b_1577646859248_358183_15655" supplier="_16_5_4_5b501fb_1387625291220_627720_5628"/>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622093933836_802374_9409" name="GeoreferenziertePunkte" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622093933836_483822_9410" annotatedElement="_19_0_3_136d03d4_1622093933836_802374_9409" body="&lt;para>In eine Instanz diesen Typs werden die Geodaten eines Vorhabens oder einer sonstigen Entität als Punkte eingetragen.&lt;/para>&#xA;"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622093933836_165496_9411" name="punkt" visibility="private" type="_19_0_3_136d03d4_1622093994597_608703_9426" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622093933852_581053_9415" annotatedElement="_19_0_3_136d03d4_1622093933836_165496_9411" body="&lt;para>In diesem Element lassen sich georeferenzierte Daten zur punktförmigen Elementen übermitteln, z. B. die Lage von Schaltkästen, Schächten oder Baugruben.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622093933852_106751_9416" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622093933836_9302_9414" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622093933836_927750_9412" name="erlaeuterung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622093933852_633557_9419" annotatedElement="_19_0_3_136d03d4_1622093933836_927750_9412" body="&lt;para>Hier können ergänzend Erläuterungen zu den georeferenzierten Daten gegeben werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622093933852_687791_9420" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622093933852_769703_9418" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622093994597_608703_9426" name="GeometriePunkt" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1715002013351_362878_8280" annotatedElement="_19_0_3_136d03d4_1622093994597_608703_9426" body="&lt;para>Georeferenzierte Daten eines Punktes&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622093994597_415424_9427" name="punkt" visibility="private" type="_19_0_3_129a03b9_1720606516991_158161_8611" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622093994613_203692_9429" annotatedElement="_19_0_3_136d03d4_1622093994597_415424_9427" body="&lt;para>Das Element (globales Element gml:PointType) enthält die GML-Darstellung einer Grundfläche .&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622093994613_418321_9430" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622093994613_372967_9428" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622094358071_796476_9434" name="GeoreferenzierteLinie" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622094358071_99048_9435" annotatedElement="_19_0_3_136d03d4_1622094358071_796476_9434" body="&lt;para>In eine Instanz diesen Typs werden die Geodaten eines Vorhabens oder einer sonstigen Entität als Linie eingetragen.&lt;/para>&#xA;"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622094358071_613420_9436" name="linie" visibility="private" type="_19_0_3_136d03d4_1622094389299_293379_9451" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622094358087_315642_9440" annotatedElement="_19_0_3_136d03d4_1622094358071_613420_9436" body="&lt;para>In diesem Element lassen sich georeferenzierte Daten zu linienförmigen Elementen übermitteln, z. B. die Lage einer geplanten Breitbandtrasse.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622094358087_758165_9441" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622094358087_424931_9439" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622094358087_807902_9437" name="erlaeuterung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622094358087_136348_9444" annotatedElement="_19_0_3_136d03d4_1622094358087_807902_9437" body="&lt;para>Hier können ergänzend Erläuterungen zu den georeferenzierten Daten gegeben werden.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622094358087_643005_9445" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622094358087_56925_9443" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622094389299_293379_9451" name="GeometrieLinie" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1715001986770_76161_8278" annotatedElement="_19_0_3_136d03d4_1622094389299_293379_9451" body="&lt;para>Georeferenzierte Daten einer Linie&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622094389299_26750_9452" name="linie" visibility="private" type="_19_0_3_129a03b9_1720606516983_851977_8578" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622094389299_322266_9454" annotatedElement="_19_0_3_136d03d4_1622094389299_26750_9452" body="&lt;para>Das Element (globales Element gml:CurveType) enthält die GML-Darstellung einer Linie.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622094389299_989886_9455" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622094389299_253611_9453" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615217056852_880776_9603" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615217099584_734726_9606" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_16_5_4_5b501fb_1387625280030_115253_5005"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615221585090_709514_9335" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_3_136d03d4_1615208012576_880185_9581"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1678815570103_324386_9939" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_4_41901a4_1664542664473_505718_6837"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1678890160514_190687_10024" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1682096298005_504726_8748" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1718379891227_506528_25204" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_3_129a03b9_1718379636648_484209_8277"/>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_78d0259_1728654431552_557910_8865" name="universellerAntrag" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728550570080_667657_8953" name="Bescheid" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728550570083_519387_8954" annotatedElement="_19_0_4_78d0259_1728550570080_667657_8953" body="&lt;para>Dieser Typ beinhaltet die Parameter eines Bescheides, den die zuständige Behörde nach Prüfung eines Antrags erlässt.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550570083_927790_8955" name="tenor" visibility="private" type="_19_0_4_78d0259_1730472298432_446237_9018">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550570088_953426_8964" annotatedElement="_19_0_4_78d0259_1728550570083_927790_8955" body="&lt;para>Hier wird der Bescheid formuliert. Es handelt sich entweder um eine Genehmigung oder um eine Ablehnung.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550570088_157895_8965" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550570088_752036_8963" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550570087_626447_8960" name="rechtshelfsbelehrung" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550570093_699835_8984" annotatedElement="_19_0_4_78d0259_1728550570087_626447_8960" body="&lt;para>Falls anwendbar,  werden hier die Rechtshelfsbelehrungen zum Bescheid gegeben.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550570093_83458_8985" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550570093_727548_8983" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550570087_376823_8961" name="hinweise" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550570093_673155_8988" annotatedElement="_19_0_4_78d0259_1728550570087_376823_8961" body="&lt;para>Hier werden ggf. ergänzende Hinweise zum Bescheid gegeben. Diese können unter anderem Nebenbestimmungen oder Abweichungen enthalten.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550570093_327610_8989" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550570093_243345_8987" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728567443349_699489_10152" name="BefundlisteMateriell" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728567443349_67279_10153" annotatedElement="_19_0_4_78d0259_1728567443349_699489_10152" body="&lt;para>Eine Instanz diesen Typs steht für eine Befundliste der materiellen Prüfung eines Antrags. Jeder Befund beinhaltet die Parameter, die einen  belastenden Verwaltungsakt im Kontext eines Vorgangs definieren. &lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567443349_205359_10154" name="befund" visibility="private" type="_19_0_4_78d0259_1728569368403_469737_8874" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567443351_712664_10157" annotatedElement="_19_0_4_78d0259_1728567443349_205359_10154" body="&lt;para>Jedes Element steht für einen  belastenden Verwaltungsakt, im Kontext des aktuellen Antragsvorgangs, zu dem der Adressat der Nachricht zu einer Stellungnahme aufgefordert ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567443351_81038_10158" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567443350_79704_10156" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728569368403_469737_8874" name="Anonym_BefundMateriell" visibility="public">
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728569878472_880070_8878" name="rechtsbereich" visibility="private" type="_19_0_4_78d0259_1728567535312_938846_10185" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728569878475_395797_8882" annotatedElement="_19_0_4_78d0259_1728569878472_880070_8878" body="&lt;para>Dieses Element nennt den  Rechtsbereich, innerhalb dessen der belastende Verwaltungsakt liegt. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728569878476_378648_8883" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728569878475_373815_8881" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728569878474_661001_8879" name="bezeichnungRegelverstoss" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728569878477_372748_8886" annotatedElement="_19_0_4_78d0259_1728569878474_661001_8879" body="&lt;para>Hier wird die Bezeichnung des betreffenden Regelverstoßes genannt.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728569878477_288008_8887" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728569878477_111146_8885" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728569878474_328242_8880" name="begruendung" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728569878477_198106_8890" annotatedElement="_19_0_4_78d0259_1728569878474_328242_8880" body="&lt;para>Hier wird begründet, inwiefern es sich um einen Regelverstoß handelt.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728569878477_882886_8891" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728569878477_205007_8889" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728545175832_300303_8774" name="Anonym_Baugrundstueck" visibility="public">
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728545195631_371987_8775" name="lageVorhaben" visibility="private" type="_16_5_4_940029b_1460651165974_293124_3777">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728545726153_944090_8777" annotatedElement="_19_0_4_78d0259_1728545195631_371987_8775" body="&lt;para>In diesem Element können ergänzend georeferenzierte Informationen zur genaueren Lage des Vorhabens bzw. Gebäudes auf dem Grundstück abgebildet werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728545746850_154467_8779" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728545746853_50263_8780" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728545202676_63147_8776" name="anschriftGrundstueck" visibility="private" type="_16_5_4_8a30247_1422884384004_352244_4233">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728547089879_594227_8908" annotatedElement="_19_0_4_78d0259_1728545202676_63147_8776" body="&lt;para>In diesem Element wird die Anschrift des Grundstücks eingetragen. Falls dem Grundstück von der Kommune keine Anschrift zugewiesen ist, wird dieses Element nicht instanziiert.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728545784625_163440_8784" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728545784625_794591_8785" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728546786018_735372_8903" name="flurstueck" visibility="private" type="_16_5_4_8a30247_1408964097602_950511_3483">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728546814265_721203_8904" annotatedElement="_19_0_4_78d0259_1728546786018_735372_8903" body="&lt;para>Pro Instanziierung des Elements sind Angaben zu einem Flurstück vorzunehmen, das zum Grundstück gehört.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728546832404_112185_8906" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728546832404_106415_8907" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728568308217_499205_10331" name="Anonym_StellungnahmeBelastenderVerwaltungsakt" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728568308219_330040_10332" annotatedElement="_19_0_4_78d0259_1728568308217_499205_10331" body="&lt;para>Dieser Typ nimmt die Parameter einer Stellungnahme auf, mit der sich ein Antragsteller zu einem  belastenden Verwaltungsakt äußert. &lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728568308220_813407_10333" name="bezeichnungRegelverstoss" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728568308222_227673_10337" annotatedElement="_19_0_4_78d0259_1728568308220_813407_10333" body="&lt;para>Hier ist die Bezeichnung des betreffenden Regelverstoßes genannt.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728568308223_921111_10338" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728568308222_994025_10336" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728568308220_669527_10334" name="stellungnahme" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728568308223_218701_10341" annotatedElement="_19_0_4_78d0259_1728568308220_669527_10334" body="&lt;para>Dieses Element enthält die Stellungnahme des Antragstellers. Sie nimmt auf die Beanstandung Bezug.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728568308223_120288_10342" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728568308223_406277_10340" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1730472298432_446237_9018" name="Anonym_TenorBescheid" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1730472298435_595206_9024" annotatedElement="_19_0_4_78d0259_1730472298432_446237_9018" body="&#xA;"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730472298434_454001_9019" name="istGenehmigung" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730472298436_136327_9026" annotatedElement="_19_0_4_78d0259_1730472298434_454001_9019" body="&lt;para>Falls der Tenor positiv  ist (Genehmigung), so ist in diesem Element &quot;true&quot; zu übermitteln, andernfalls (Ablehnung) &quot;false&quot;.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730472298436_144821_9027" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730472298436_257270_9025" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730472298435_853417_9020" name="kommentar" visibility="private" type="_19_0_4_78d0259_1730473672011_669542_9123" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730472298437_812344_9030" annotatedElement="_19_0_4_78d0259_1730472298435_853417_9020" body="&lt;para>In diesem Element können Kommentare oder Erläuterungen zu dem Bescheid aufgeführt werden. Falls der Bescheid ablehnend ausgefallen ist, wird in diesem Element die entsprechende Begründung geliefert.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730472298437_177288_9031" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730472298437_539479_9029" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730472298435_359368_9022" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730472298437_235392_9038" annotatedElement="_19_0_4_78d0259_1730472298435_359368_9022" body="&lt;para>In dieses Element kann - falls im entsprechenden Vorgang vorgesehen - eine von der Behörde gesetzte Frist eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730472298437_923695_9039" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730472298437_107913_9037" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1730473672011_669542_9123" name="Anonym_KommentierungBescheid" visibility="public">
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730473672008_795271_9122" name="kommentar" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730473672013_743947_9125" annotatedElement="_19_0_4_78d0259_1730473672008_795271_9122" body="&lt;para>Pro Kommentar ist ein eigenes Element (welches mehrere Absätze Text enthalten kann) zu füllen. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730473672013_794589_9126" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730473672013_348499_9124" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_b8702dd_1765890953244_733520_9309" name="" visibility="public" client="_19_0_3_136d03d4_1615207989277_776469_9579" supplier="_19_0_3_136d03d4_1612479012595_942167_9330"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1615207998408_344623_9580" name="Nachrichten" visibility="public" URI="">
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_78d0259_1728656061722_63743_9000" name="prozessnachrichten" visibility="public" URI="">
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1541262088322_35304_11814" name="prozessnachrichten.rueckweisung.G2G.1100" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1541262088385_193603_11844" annotatedElement="_18_0_2_940029b_1541262088322_35304_11814" body="&lt;para>Mittels dieser Nachricht wird eine Nachricht abgewiesen, die Fehler enthält, so dass sie nicht zielführend verarbeitet werden kann (Behörde-Behörde-Kommunikation). Der Autor der fehlerhaften Nachricht wird über die Fehler unterrichtet. Die abgewiesene Nachricht wird zur Information aufgeführt. &lt;/para>&#xA;&lt;para>Hinweis: Eine Nachricht dieses Typs darf nicht wiederum mit einer solchen Nachricht zurückgewiesen werden.&#xA;&lt;/para>&#xA;&#xA;"/>
                <generalization xmi:id="_19_0_3_136d03d4_1622226638078_517257_9421" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1668581873413_143105_9706" name="anbindungFachverfahren" visibility="private" type="_19_0_3_129a03b9_1668163024704_848043_9712">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1668582083015_11073_9710" annotatedElement="_19_0_3_129a03b9_1668581873413_143105_9706" body="&lt;para>Dieses Element kann verwendet werden, um die behördliche Fachanwendung an das Antragsportal oder die Kollaborationsplattform anzubinden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1668581897346_508385_9707" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1668581897346_564096_9708" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541262088385_220444_11846" name="rueckweisungDaten" visibility="private" type="_18_0_2_940029b_1541324483751_614901_11350" aggregation="composite" association="_18_0_2_940029b_1541262088322_385508_11817">
                  <ownedComment xmi:id="_18_0_2_940029b_1541262170416_617292_11908" annotatedElement="_18_0_2_940029b_1541262088385_220444_11846" body="&lt;para>Mit diesem Element wird der Fehler einer gegebenenen Nachricht benannt, der zu der vorliegenden Rückweisung geführt hat.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541262170416_959474_11909" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541262170416_762886_11907" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1541322508385_460887_11132" name="prozessnachrichten.eingangsbestaetigung.1120" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1541322508385_41284_11133" annotatedElement="_18_0_2_940029b_1541322508385_460887_11132" body="&lt;para>Diese Nachricht wird durch die Fachbehörde verwendet, um als Reaktion auf einen Antrag (modifizierten Antrag, Rücknahme eines Antrags, Anzeige) zu informieren, dass das Anliegen eingegangen ist und sich in Bearbeitung befindet. &lt;/para>&#xA;&#xA;&lt;para>Sie enthält die nötigen Informationen, um den Bezug auf die Nachricht, deren Eingang sie bestätigt, herzustellen.&lt;/para>&#xA;"/>
                <generalization xmi:id="_19_0_3_136d03d4_1617019170318_734453_9466" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541322508385_732710_11134" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_18_0_2_940029b_1541322508385_165187_11139" annotatedElement="_18_0_2_940029b_1541322508385_732710_11134" body="&lt;para>Dieses Element enthält, um Bezug zu nehmen, die Vorgangsnummer bzw. die Referenz des Antrags (Zeichen des Antragstellers).&lt;/para>&#xA;&#xA;&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist in das Element referenz die UUID der Antragsnachricht (Element referenzAntragsservice) einzutragen, auf die sich die Eingangsbestätigung bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541322508385_702549_11140" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541322508385_491258_11138" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1541322508385_781677_11135" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1541322508385_845654_11143" annotatedElement="_18_0_2_940029b_1541322508385_781677_11135" body="&lt;para>Hier kann die Fachbehörde ergänzend erläuternden Text in die Nachricht einfügen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1541322508385_263053_11144" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1541322508385_744491_11142" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1544645191493_157552_17875" name="prozessnachrichten.aktenzeichen.1121" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1544645191508_896111_17876" annotatedElement="_18_0_2_940029b_1544645191493_157552_17875" body="&lt;para>Diese Nachricht wird durch die Fachbehörde verwendet, um einen Antragsteller über die zugewiesene Vorgangsnummer bzw. das zugewiesene Aktenzeichen zu informieren.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_940029b_1666770195117_56727_9692" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1544645191508_472848_17877" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_18_0_2_940029b_1544645191508_149079_17882" annotatedElement="_18_0_2_940029b_1544645191508_472848_17877" body="&lt;para>Dieses Element enthält zur Information die Vorgangsnummer bzw. das Aktenzeichen, unter der die Behörde das Anliegen bearbeitet. Mit der Angabe der Referenz des Antragstellers wird der Bezug für diesen hergestellt.&lt;/para>&#xA;&#xA;&lt;para>Eine Referenzierung auf eine Nachricht wird in diese Nachricht nicht eingetragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1544645191508_97486_17883" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1544645191508_975790_17881" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1546756092187_518710_11657" name="prozessnachrichten.ruecknahme.1130" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1546756092187_797342_11658" annotatedElement="_18_0_2_940029b_1546756092187_518710_11657" body="&lt;para>Diese Nachricht kann durch einen Antragsteller verwendet werden, um einen in der Vergangenheit gestellten Antrag zurückzuziehen bzw. die Absicht einer solchen Rücknahme zu kommunizieren.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1617019808089_194427_9469" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546756092187_987489_11659" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_18_0_2_940029b_1546756092187_816682_11663" annotatedElement="_18_0_2_940029b_1546756092187_987489_11659" body="&lt;para>In dieses Element sind die Referenzen von Antragsteller und ggf. Behörde einzutragen.&lt;/para>&#xA;&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist in das Element referenz die UUID der Antragsnachricht (Element referenzAntragsservice) einzutragen, auf die sich die Rücknahme bezieht.&lt;/para>&#xA;&lt;para>Eine Referenzierung auf eine Nachricht wird in diese Nachricht nicht eingetragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546756092187_550162_11664" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546756092187_189226_11662" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546757320148_429240_11989" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1546757320148_240062_11991" annotatedElement="_18_0_2_940029b_1546757320148_429240_11989" body="&lt;para>Hier kann optional durch den Antragsteller eine Begründung  eingetragen werden.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546757320148_318697_11992" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546757320148_412698_11990" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546777730975_736188_11859" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1546777730975_865952_11861" annotatedElement="_18_0_2_940029b_1546777730975_736188_11859" body="&lt;para>Ggf. will der Antragsteller der Rücknahme des Antrags ein Schreiben beilegen. Das lässt sich mit diesem Element abbilden.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546777730975_673821_11862" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546777730975_388993_11860" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1546778584008_952063_11942" name="prozessnachrichten.quittierungRuecknahme.1131" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1546778584008_602047_11943" annotatedElement="_18_0_2_940029b_1546778584008_952063_11942" body="&lt;para>Diese Nachricht wird von der Fachbehörde verwendet, um  die Rücknahme des Antrags durch den Antragsteller zu quittieren, also zu bestätigen, dass die Rücknahme durch die Behörde akzeptiert wurde (mit gegebenen Konsequenzen für den Antragsteller). Ggf. kann sie aber auch die Information enthalten, dass der Antrag nicht mehr zurückgenommen werden kann.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1617019769377_855644_9468" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546778584008_912671_11944" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_18_0_2_940029b_1546778584008_501771_11950" annotatedElement="_18_0_2_940029b_1546778584008_912671_11944" body="&lt;para>In dieses Element sind die Referenzen von Antragsteller und ggf. Behörde einzutragen.&lt;/para>&#xA;&#xA;&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist in das Element referenz die UUID der Antragsnachricht (Element referenzAntragsservice) einzutragen, auf die sich die Rücknahme bezieht.&lt;/para>&#xA;&#xA;&lt;para>Es ist die Nachricht des Antragstellers zu referenzieren, mittels derer er über seine Absicht informiert hat, den Antrag zurückzunehmen.&lt;/para>"/>
                  <ownedComment xmi:id="_19_0_4_b6602da_1727789053452_101212_8785" annotatedElement="_18_0_2_940029b_1546778584008_912671_11944" body=""/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546778584008_334154_11951" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546778584008_517372_11949" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546780686209_577757_12204" name="ruecknahmeAkzeptiert" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1546780686225_95989_12206" annotatedElement="_18_0_2_940029b_1546780686209_577757_12204" body="&lt;para>Falls die Rücknahme des Antrags durch die Fachbehörde akzeptiert wurde, wird in diesem Element &quot;true&quot; übermittelt. &lt;/para>&#xA;&lt;para>Andernfalls wird &quot;false&quot; übermittelt. Dann ist eine Rücknahme des Antrags nicht mehr möglich, weil bereits ein Bescheid erteilt wurde, der dem Antragsteller auf dem vorgesehenen Wege zugehen wird oder bereits zugegangen ist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546780686225_370147_12207" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546780686225_440054_12205" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_18_0_2_940029b_1546778584008_302817_11945" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_18_0_2_940029b_1546778584008_690799_11954" annotatedElement="_18_0_2_940029b_1546778584008_302817_11945" body="&lt;para>Hier kann optional eine Begründung oder Erläuterung der Fachbehörde eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1546778584008_365051_11955" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1546778584008_703346_11953" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_18_0_2_940029b_1552126388478_40002_14677" name="prozessnachrichten.formellePruefungBefundliste.1140" visibility="public">
                <ownedComment xmi:id="_18_0_2_940029b_1552126388479_448931_14678" annotatedElement="_18_0_2_940029b_1552126388478_40002_14677" body="&lt;para>Diese Nachricht bezieht sich auf einen gestellten Antrag oder eine übermittelte Anzeige oder Erklärung. Enthalten sind die Ergebnisse einer formellen Prüfung (Befunde) sowie ggf. eine Frist, innerhalb derer Antrag bzw. Anzeige anzupassen ist (bei einer Anpassung kann es sich um Korrekturen oder um eine Vervollständigung handeln).&lt;/para>&#xA;&lt;para>&#xA;Sind Mindestanforderungen an die Bearbeitbarkeit nicht gegeben und die Unterlagen nicht&#xA;sinnvoll anpassbar, kann die Bearbeitung des Antrags mit dieser Nachricht aus formellen Gründen&#xA;abgelehnt werden.&#xA;&lt;/para>&#xA;&lt;para>Es besteht außerdem die Möglichkeit, dem Leser textliche Informationen oder sonstige Ressourcen (als Anlage oder Verlinkung) zur Verfügung zu stellen.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1617019729277_465605_9467" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_18_0_2_940029b_1552126388479_186666_14679" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_18_0_2_940029b_1552126388480_952886_14685" annotatedElement="_18_0_2_940029b_1552126388479_186666_14679" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw.&#xA;die Nachricht Bezug zu nehmen, durch deren Eingang bei der Bauaufsichtsbehörde der Vorgang ausgelöst&#xA;worden ist.&lt;/para>&#xA;&lt;para>Damit wird gleichzeitig dem Antragsteller die entsprechende Vorgangsnummer für künftige Referenzierung mitgeteilt. Dadurch ist der Bezug zum Antrag oder zur Anzeige hergestellt, zu dessen/deren formeller Prüfung die vorliegende Nachricht Ergebnisse enthält.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_18_0_2_940029b_1552126388480_450655_14686" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_18_0_2_940029b_1552126388480_602088_14684" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730730218005_921399_8892" name="dokumentationVollstaendig" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730730356835_871450_8896" annotatedElement="_19_0_4_78d0259_1730730218005_921399_8892" body="&lt;para>Mit diesem Element wird angegeben, ob die Dokumentation zu dem Vorgang vollständig ist, das heißt, ob im Rahmen der formellen Prüfung alle Merkmale positiv bewertet wurden (Zuständigkeit ist gegeben, Unterlagen liegen vollständig vor usw.). Im Falle der Vollständigkeit ist &quot;true&quot; einzutragen, andernfalls &quot;false&quot;.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730730299760_377675_8894" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730730299765_196881_8895" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125504845_405320_9419" name="befundFrist" visibility="private" type="_19_0_4_b8702dd_1749125401449_564366_9333">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125807176_977016_9456" annotatedElement="_19_0_4_b8702dd_1749125504845_405320_9419" body="&lt;para>Falls im Rahmen der formellen Prüfung Mängel festgestellt wurden, sind diese Angaben zu machen. Die Befundliste enthält die Ergebnisse der formellen Prüfung durch die Bauaufsichtsbehörde. Enthalten ist außerdem eine Frist zur Anpassung von Vorhaben bzw. Unterlagen durch den Antragsteller.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125582846_117578_9422" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125582847_30527_9423" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1774959333540_602090_9290" name="unterlagenDokumentationVollstaendig" visibility="private" type="_19_0_4_b8702dd_1774959546286_204653_9300">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1774959333546_985312_9292" annotatedElement="_19_0_4_b8702dd_1774959333540_602090_9290" body="&lt;para> Falls im Rahmen der formellen Prüfung alle Merkmale positiv bewertet wurden (Zuständigkeit ist gegeben, Unterlagen liegen vollständig vor usw.), sind hier Angaben zu den eingereichten Unterlagen und ggf. zur Genehmigungsfrist zu machen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774959333547_959667_9293" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774959333545_777512_9291" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125675576_544411_9427" name="anschreiben" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125675577_590689_9431" annotatedElement="_19_0_4_b8702dd_1749125675576_544411_9427" body="&lt;para>In dieses Element kann ein Anschreibentext eingetragen werden.&lt;/para>&#xA;&lt;para>Der Anschreibentext kann auch verwendet werden, um Informationen zu organisatorischen Themen zwischen&#xA;Bauaufsicht und Bauvorhaben zu übermitteln, beispielsweise zur Mitteilung eines Anhörungstermins.&lt;/para>&#xA;&lt;para>Gegebenenfalls kann hier auch eine rechtlich geforderte Belehrung über die Rücknahmefiktion bei&#xA;nicht fristgerecht ergänzten oder korrigierten Unterlagen erfolgen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125675577_260656_9432" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125675577_639185_9430" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125675577_353408_9428" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125675577_28027_9435" annotatedElement="_19_0_4_b8702dd_1749125675577_353408_9428" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben.&#xD;&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125675578_532206_9436" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125675577_64359_9434" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125675577_997325_9429" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125675578_281146_9439" annotatedElement="_19_0_4_b8702dd_1749125675577_997325_9429" body="&lt;para>Falls die Behörde der Nachricht Anlagen beifügen möchte, ist dieses Element zu verwenden.&lt;/para>&#xA;&lt;para>Werden Mindestanforderungen für die Bearbeitung des Antrags nicht erfüllt, kann die Bauaufsicht die Bearbeitung ggf. sofort ablehnen. Sie kann dazu ein entsprechendes Dokument beifügen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125675579_15453_9440" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125675578_173371_9438" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_940029b_1594568645475_790674_14704" name="prozessnachrichten.zustellungSchreiben.1141" visibility="public">
                <ownedComment xmi:id="_19_0_3_940029b_1594568645482_334449_14705" annotatedElement="_19_0_3_940029b_1594568645475_790674_14704" body="&lt;para>Mittels dieser Nachricht kann die Fachbehörde einem Antragsteller oder sonstigem Beteiligten am Bauvorhaben eine Nachricht (Anschreiben mit Anlagen) zustellen. &lt;/para>&#xA;&lt;para>Hierzu gehören auch Mitteilungen zur Rücknahme- oder Genehmigungsfiktion. In diesen Fällen können ggf. auch rechtlich vorgesehene Dokumente übermittelt werden.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1617019925545_631167_9470" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_3_940029b_1594568645483_204126_14706" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_3_940029b_1594568645498_719889_14712" annotatedElement="_19_0_3_940029b_1594568645483_204126_14706" body="&lt;para>Bezug auf Vorgang und Nachricht, auf die sich die Inhalte der vorliegenden Nachricht beziehen. Oder Angabe einer Vorgangsnummer für zukünftige Bezugnahme auf diese Nachricht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1594568645500_752083_14713" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1594568645496_847085_14711" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1594568645486_545150_14707" name="anschreiben" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_940029b_1594568645506_942495_14716" annotatedElement="_19_0_3_940029b_1594568645486_545150_14707" body="&lt;para>In dieses Element ist der Anschreibentext der Nachricht einzutragen.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1594568645508_616119_14717" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1594568645504_949972_14715" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1594568645489_23350_14708" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_940029b_1594568645516_963848_14720" annotatedElement="_19_0_3_940029b_1594568645489_23350_14708" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1594568645517_394996_14721" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1594568645513_203653_14719" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_940029b_1594569105972_656913_14738" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_940029b_1594569105977_649827_14740" annotatedElement="_19_0_3_940029b_1594569105972_656913_14738" body="&lt;para>Dieses Element ist für Anlagen zur Nachricht zu verwenden.&lt;/para>&#xA;&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_940029b_1594569105978_295185_14741" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_940029b_1594569105976_786267_14739" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1780056651373_462792_9755" name="anlass" visibility="private" type="_19_0_4_b8702dd_1780055327083_309933_9489">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1780056795676_718933_9761" annotatedElement="_19_0_4_b8702dd_1780056651373_462792_9755" body="&lt;para>In diesem Element kann der Anlass der Mitteilung übermittelt werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1780056704933_423558_9757" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1780056704933_689029_9758" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622229844837_678922_9419" name="prozessnachrichten.fachlicheKommunikation.1142" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622229844837_380491_9420" annotatedElement="_19_0_3_136d03d4_1622229844837_678922_9419" body="&lt;para>Diese Nachricht dient der informellen, fachlichen Kommunikation innerhalb eines Verfahrens. Sie wird&#xA;zum einen für Rückfragen eines Beteiligten des Verfahrens und zum anderen für die zugehörige Antwort der Fachbehörde verwendet.&lt;/para>&#xA;&lt;para>Der Antragsteller kann diese Nachricht verwenden, um sich mit der Bauaufsicht über das vorübergehende Aussetzen der Bearbeitung eines Antrags zu verständigen (Bitte um Aussetzen, Bestätigung mit Fristsetzung, Bitte um Wiederaufnahme).&lt;/para>&#xA;&lt;para>Diese Nachricht darf nicht verwendet werden, wenn für den Kommunikationsanlass spezifische Fachnachrichten verfügbar sind. Ergänzungen zum Antrag sind beispielsweise mit der Fachmodulnachricht 0202 einzureichen.&lt;/para>&#xA;&lt;para>Die Portale sind angehalten, dafür zu sorgen, dass ein Missbrauch der Nachricht verhindert wird. Dies kann gegebenenfalls durch Einschränkung der Größe der Anlagen geschehen.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1622229844852_197825_9425" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622229844837_565061_9421" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622229844852_309835_9428" annotatedElement="_19_0_3_136d03d4_1622229844837_565061_9421" body="&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist in das Element referenz entweder die UUID (Element referenzAntragsservice) der Antragsnachricht, die Vorgangsnummer oder das Aktenzeichen (Element vorgang) einzutragen, auf die sich die fachliche Kommunikation bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622229844852_898721_9429" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622229844852_741815_9427" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622229844852_398538_9422" name="anschreiben" visibility="private" type="_19_0_3_136d03d4_1622230009808_308184_9453" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622229844852_465632_9432" annotatedElement="_19_0_3_136d03d4_1622229844852_398538_9422" body="&lt;para>In dieses Element ist der Anschreibentext der Nachricht (Rückfrage des Beteiligten oder Antwort der Behörde) einzutragen. Der Anschreibentext kann unformatiert oder formatiert übermittelt werden.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622229844852_165353_9433" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622229844852_777876_9431" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1624867753204_323298_9455" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1624867815721_146060_9459" annotatedElement="_19_0_3_136d03d4_1624867753204_323298_9455" body="&lt;para>Mit diesem Element können Metadaten zu Anlagen übermittelt werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1624867973148_256005_9460" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1624867973149_239875_9461" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_136d03d4_1622232026922_749916_9485" name="prozessnachrichten.einstellenDokumente.1150" visibility="public">
                <ownedComment xmi:id="_19_0_3_136d03d4_1622232026923_66704_9486" annotatedElement="_19_0_3_136d03d4_1622232026922_749916_9485" body="&lt;para>Mit dieser Nachricht kann die Aufsichtsbehörde Dokumente in einen Projektraum einstellen, z. B. ergänzende Dokumentation zum Antrag, zur Prüfung des Antrags oder zur Ämterbeteiligung; auch z. B. einen digitalisierten Papierantrag mit Anlagen.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_136d03d4_1622232026925_333773_9489" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622232026924_422768_9487" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622232026925_792077_9492" annotatedElement="_19_0_3_136d03d4_1622232026924_422768_9487" body="&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang oder Projektraum eindeutig zuordnen lässt. Dafür ist in das Element referenz die UUID der Antragsnachricht (Element referenzAntragsservice) einzutragen, auf die sich das Einstellen der Dokumente bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622232026926_521656_9493" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622232026925_217246_9491" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622232188108_112752_9507" name="ablageort" visibility="private" type="_19_0_3_136d03d4_1629826627962_517090_9457" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622232188109_210575_9509" annotatedElement="_19_0_3_136d03d4_1622232188108_112752_9507" body="&lt;para>Mit diesem Element kann ein Ablageort innerhalb der jeweiligen Struktur des Portals bzw. der Plattform für das Dokument angegeben werden.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622232188109_946462_9510" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622232188109_426446_9508" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_136d03d4_1622232026924_66327_9488" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826" aggregation="composite">
                  <ownedComment xmi:id="_19_0_3_136d03d4_1622232026926_762696_9496" annotatedElement="_19_0_3_136d03d4_1622232026924_66327_9488" body="&lt;para>In diesem Element werden die Metadaten zur Anlage übermittelt.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_136d03d4_1622232026927_991762_9497" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_136d03d4_1622232026926_209439_9495" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694597022421_979006_8832" name="prozessnachrichten.gebuehrenbescheid.1160" visibility="public">
                <ownedComment xmi:id="_19_0_3_129a03b9_1694597022437_981150_8833" annotatedElement="_19_0_3_129a03b9_1694597022421_979006_8832" body="&lt;para>Mittels dieser Nachricht kann die Aufsichtsbehörde dem Antragsteller (und anderen Gebührenschuldnern) einen Gebührenbescheid mit Gebührenberechnung und -begründung, sowie Zahlungsdaten zustellen.&lt;/para>"/>
                <generalization xmi:id="_19_0_3_129a03b9_1694597022443_778512_8837" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1694597022443_907380_8834" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694597022443_755427_8840" annotatedElement="_19_0_3_129a03b9_1694597022443_907380_8834" body="&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist in das Element referenz die UUID der Antragsnachricht (Element referenzAntragsservice) einzutragen, auf die sich der Gebührenbescheid bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694597022443_952623_8841" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694597022443_429949_8839" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598163978_735531_8869" name="gebuehrenbescheid" visibility="private" type="_19_0_3_129a03b9_1694598367137_540587_8877">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598163978_920767_8871" annotatedElement="_19_0_3_129a03b9_1694598163978_735531_8869" body="&lt;para>Unterhalb dieses Element finden sich die Angaben zur Gebührenberechnung und -begründung, sowie die Zahlungsdaten und weitere Informationen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598163978_411263_8872" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598163978_544222_8870" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598057338_332512_8862" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598113853_356328_8863" annotatedElement="_19_0_3_129a03b9_1694598057338_332512_8862" body="&lt;para>Dies ist die durch die Behörde gesetzte Zahlungsfrist.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598142854_376178_8867" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598142854_710277_8868" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b6602da_1727331693524_595912_8289" name="prozessnachrichten.statusFuerAntragsportal.1170" visibility="public">
                <ownedComment xmi:id="_19_0_4_b6602da_1727331693545_544417_8290" annotatedElement="_19_0_4_b6602da_1727331693524_595912_8289" body="&lt;para>Diese Nachricht kann durch eine Aufsichtsbehörde verwendet werden, um das Antragsportal über eine Statusänderung im Rahmen eines Vorgangs, der durch die Aufsichtsbehörde geführt wird, zu informieren. Das Antragsportal verwendet diese Information, um den im Antragsportal geführten Status zu diesem Vorgang anzupassen.&lt;/para>&#xA;&lt;para>Hinweis: Bei vorhandenen spezifischen Nachrichten darf diese generische Nachricht nicht&#xA;genutzt werden.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_b6602da_1727331693564_732144_8294" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_b6602da_1727331693548_506173_8291" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_b6602da_1727331693576_230259_8297" annotatedElement="_19_0_4_b6602da_1727331693548_506173_8291" body="&lt;para>Hier müssen Eintragungen vorgenommen werden, so dass sich die Nachricht einem vorhandenen Vorgang eindeutig zuordnen lässt. Dafür ist entweder in das Element referenz die UUID aus der Antrags- oder Anzeigenachricht, die den Vorgang initiiert hat oder in das Element vorgang die Vorgangsnummer oder das Aktenzeichen, unter dem das Verfahren in der Aufsichtsbehörde geführt wird.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1727331693579_845409_8298" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1727331693572_214561_8296" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b6602da_1727331980442_982540_8318" name="statusAntragsportal" visibility="private" type="_19_0_4_b6602da_1727331549013_612647_8287">
                  <ownedComment xmi:id="_19_0_4_b6602da_1727332411026_197839_8327" annotatedElement="_19_0_4_b6602da_1727331980442_982540_8318" body="&lt;para>In dieses Element wird der Status eingetragen, der ans Antragsportal übermittelt werden soll.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1727332495978_882450_8401" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1727332495978_477946_8402" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b6602da_1727331991236_38594_8319" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b6602da_1727331991239_747143_8321" annotatedElement="_19_0_4_b6602da_1727331991236_38594_8319" body="&lt;para>In dieses Element wird - falls im entsprechenden Status vorgesehen - eine von der Behörde gesetzte Frist eingetragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1727331991240_305297_8322" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1727331991239_709640_8320" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1730709848291_980124_8862" name="begruendung" visibility="private" type="_18_0_2_940029b_1535726187446_656135_10650">
                  <ownedComment xmi:id="_19_0_4_78d0259_1730710035168_261678_8866" annotatedElement="_19_0_4_78d0259_1730709848291_980124_8862" body="&lt;para>Mit diesem Element kann die Aufsichtsbehörde Information übermitteln, um den Statusübergang im Portal zu erläutern.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1730709924503_441143_8863" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1730709924503_811919_8864" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Association" xmi:id="_18_0_2_940029b_1541262088322_385508_11817" name="" visibility="public" memberEnd="_18_0_2_940029b_1541262088385_220444_11846 _18_0_2_940029b_1541262129452_125565_11874">
                <ownedEnd xmi:id="_18_0_2_940029b_1541262129452_125565_11874" name="" visibility="private" type="_18_0_2_940029b_1541262088322_35304_11814" association="_18_0_2_940029b_1541262088322_385508_11817"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1722965099706_436930_10057" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615221639744_534058_9337" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615221748239_121645_9339" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_19_0_3_136d03d4_1615208012576_880185_9581"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1629827775715_785466_9461" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_19_0_3_136d03d4_1612479012595_942167_9330"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_136d03d4_1615221901784_91044_9341" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_3_129a03b9_1722965048915_319361_10055" name="" visibility="public" client="_19_0_4_78d0259_1728656061722_63743_9000" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1748346511450_269150_8986" name="prozessnachrichten.generischeQuittierungEingang.1180" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1748346511533_244862_9017" annotatedElement="_19_0_4_b8702dd_1748346511450_269150_8986" body="&lt;para>Diese Nachricht wird durch die Fachbehörde oder das Bauportal verwendet, um den Eingang einer Nachricht zu quittieren.&lt;/para>&#xA;&lt;para>Sie ist nur zu verwenden, wenn für den zu quittierenden Nachrichtentyp keine spezifische Quittungsnachricht vorgesehen ist.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_b8702dd_1748346511535_253897_9021" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511533_457714_9018" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511565_967483_9061" annotatedElement="_19_0_4_b8702dd_1748346511533_457714_9018" body="&lt;para>Dieses Element enthält, um Bezug zu nehmen, die Vorgangsnummer bzw. die Referenz der zu quittierenden Nachricht.&lt;/para>&#xA;&#xA;&lt;para>Dafür ist in das Element referenz die UUID der Nachricht einzutragen, auf die sich die Eingangsbestätigung bezieht.&lt;/para>"/>
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511566_741203_9062" annotatedElement="_19_0_4_b8702dd_1748346511533_457714_9018" body=""/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511567_855718_9063" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511565_788342_9060" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511534_561911_9019" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511567_917087_9066" annotatedElement="_19_0_4_b8702dd_1748346511534_561911_9019" body="&lt;para>Hier kann optional eine Begründung oder Erläuterung  eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511567_510434_9067" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511567_656985_9065" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511534_390565_9020" name="nachrichtentyp" visibility="private" type="_19_0_4_b8702dd_1748346587734_248861_9621">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511567_878493_9070" annotatedElement="_19_0_4_b8702dd_1748346511534_390565_9020" body="&lt;para>Hier ist der Typ der Nachricht auszuwählen, die mit der vorliegenden Nachricht quittiert wird.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511567_243895_9071" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511567_213826_9069" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1784795831127_760885_10553" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1784795831127_655365_10555" annotatedElement="_19_0_4_b8702dd_1784795831127_760885_10553" body="&lt;para>Hier können Anlagen zur Quittierung beigefügt werden, beispielsweise ein Aktenvermerk.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784795831127_857055_10556" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784795831127_857538_10554" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1748346511457_661146_8987" name="prozessnachrichten.generischeRueckmeldungAbruf.1181" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1748346511562_43892_9052" annotatedElement="_19_0_4_b8702dd_1748346511457_661146_8987" body="&lt;para>Diese Nachricht ist vom Bauportal zu verwenden um der Fachbehörde rückzumelden, dass ein von der Behörde übermittelter Bescheid durch den Antragsteller abgerufen worden ist bzw. dass dies nicht innerhalb der vorgesehenen Frist erfolgt ist.&lt;/para>&#xA;&lt;para>Sie wird folglich in zwei Situationen versendet: Entweder, wenn der Abruf der referenzierten Bescheidnachricht innerhalb der vorgesehenen Frist erfolgte, oder wenn die Frist verstrichen ist und kein Abruf erfolgt ist.&lt;/para>&#xA;&lt;para>Die Nachricht enthält im Minimalfall lediglich den Bezug auf die abzurufende Bescheidnachricht und die Information, ob der Abruf fristgerecht erfolgt ist oder nicht. Zusätzlich kann die Frist und ggf. eine Zusatzinformation in der Nachricht enthalten sein.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_b8702dd_1748346511564_367627_9057" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511562_945369_9053" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511569_215592_9077" annotatedElement="_19_0_4_b8702dd_1748346511562_945369_9053" body="&lt;para>Dieses Element enthält, um Bezug zu nehmen, die Vorgangsnummer bzw. die Referenz der Nachricht, deren Abruf gemeldet werden soll.&lt;/para>&#xA;&#xA;&lt;para>Dafür ist in das Element referenz die UUID der Nachricht einzutragen, auf die sich die Rückmeldung bezieht.&lt;/para>"/>
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511569_861930_9078" annotatedElement="_19_0_4_b8702dd_1748346511562_945369_9053" body=""/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511569_304716_9079" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511568_295267_9076" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511563_727131_9054" name="information" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511569_878469_9082" annotatedElement="_19_0_4_b8702dd_1748346511563_727131_9054" body="&lt;para>Hier kann optional eine Zusatzinformation eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511569_572388_9083" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511569_297258_9081" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511563_191964_9055" name="fristinformation" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511570_57807_9086" annotatedElement="_19_0_4_b8702dd_1748346511563_191964_9055" body="&lt;para>Mit diesem Element kann darüber informiert werden, bis wann die referenzierte Nachricht hätte abgerufen werden müssen, so dass der Abruf als fristgerecht gilt.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511570_887188_9087" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511569_18814_9085" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1748346511564_929468_9056" name="abrufFristgerechtErfolgt" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1748346511570_557785_9090" annotatedElement="_19_0_4_b8702dd_1748346511564_929468_9056" body="&lt;para>Erfolgte der Abruf der referenzierten Nachricht fristgerecht, ist in diesem Element der Wert &quot;true&quot; zu übermitteln. Ist die Frist abgelaufen, ohne dass der Abruf erfolgte, ist &quot;false&quot; zu übermitteln.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1748346511570_83024_9091" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1748346511570_258542_9089" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b8702dd_1784534089687_256072_10108" name="bauaufsichtlichEingeleitetesVerfahren" visibility="public" URI="">
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534089694_967932_10109" name="prozessnachrichten.vorgangsraum.angelegt.1301" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1784534089775_297156_10143" annotatedElement="_19_0_4_b8702dd_1784534089694_967932_10109" body="&lt;para>Mit dieser Nachricht versendet die bereitstellende Komponente die Bestätigung, dass ein Vorgangsraum angelegt und mit den erforderlichen Informationen gefüllt wurde, an die Bauaufsichtsbehörde. Mit der Nachricht werden Daten zur Identität und Zugriffsdaten des Vorgangsraums mitgeteilt.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089775_613999_10144" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089865_305997_10259" annotatedElement="_19_0_4_b8702dd_1784534089775_613999_10144" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Nachrichteninstanz Bezug zu nehmen, durch deren Eingang bei der bereitstellenden Komponente das Anlegen des Vorgangsraums ausgelöst worden ist.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089867_284457_10260" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089865_984183_10258" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089777_836832_10145" name="vorgangsraum" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089867_356014_10263" annotatedElement="_19_0_4_b8702dd_1784534089777_836832_10145" body="&lt;para>Dieses Element enthält Informationen zur Identität des angelegten Vorgangsraums bzw. die entsprechenden Zugangsdaten.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089867_990993_10264" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089867_314579_10262" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089777_257368_10146" name="zugangslink" visibility="private" type="_19_0_4_b8702dd_1784534539920_355875_10858">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089867_850836_10267" annotatedElement="_19_0_4_b8702dd_1784534089777_257368_10146" body="&lt;para>In diesem Element kann der Zugang zum Vorgangsraum per Verlinkung zum Ablageort der Dokumente eingetragen werden.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089867_625955_10268" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089867_616888_10266" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534089696_434989_10110" name="prozessnachrichten.vorgangsraum.anlegen.1300" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1784534089807_136007_10177" annotatedElement="_19_0_4_b8702dd_1784534089696_434989_10110" body="&lt;para>Mit dieser Nachricht fordert die Bauaufsichtsbehörde die bereitstellende Komponente auf, einen Vorgangsraum anzulegen, diesen mit den erforderlichen Informationen aus der Datenbasis zu befüllen und der Bauaufsichtsbehörde die Identität des Vorgangsraums mitzuteilen.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089807_911912_10178" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089869_393351_10274" annotatedElement="_19_0_4_b8702dd_1784534089807_911912_10178" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang Bezug zu nehmen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089869_87047_10275" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089869_730562_10273" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089807_104727_10179" name="aktenzeichen" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089869_926230_10278" annotatedElement="_19_0_4_b8702dd_1784534089807_104727_10179" body="&lt;para>In dieses Element kann ein zusätzliches Aktenzeichen eingetragen werden, soweit die Vorgangsbezeichnung im Objekt bezug nicht ausreicht.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089869_451646_10279" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089869_705317_10277" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089809_770343_10182" name="grundstueck" visibility="private" type="_19_0_4_78d0259_1728545175832_300303_8774">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089871_839395_10290" annotatedElement="_19_0_4_b8702dd_1784534089809_770343_10182" body="&lt;para>Hier können Angaben zum Grundstück gemacht werden, auf das sich das Verfahren bezieht.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089873_258492_10291" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089871_657835_10289" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089809_49469_10183" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089873_935779_10294" annotatedElement="_19_0_4_b8702dd_1784534089809_49469_10183" body="&lt;para>Hier sind die Dokumente angegeben, die in den Vorgangsraum übertragen werden sollen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089873_816486_10295" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089873_632994_10293" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089809_623394_10184" name="artVerwaltungsverfahren" visibility="private" type="_19_0_4_b8702dd_1784534292028_495042_10855">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089873_729448_10298" annotatedElement="_19_0_4_b8702dd_1784534089809_623394_10184" body="&lt;para>Hier ist auszuwählen, welche Art von Verfahren eingeleitet werden soll.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089873_522269_10299" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089873_850063_10297" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089809_393210_10185" name="sachverhalt" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089875_535408_10302" annotatedElement="_19_0_4_b8702dd_1784534089809_393210_10185" body="&lt;para>In diesem Element ist einerseits ein Titel für das Verfahren zu vergeben, andererseits ist der Anlass zu benennen (z.B. Anlass, Beschwerde).&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089875_410112_10303" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089875_577257_10301" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089811_795913_10186" name="beteiligteVerfahren" visibility="private" type="_19_0_4_b8702dd_1784534089811_605313_10188">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089875_553268_10306" annotatedElement="_19_0_4_b8702dd_1784534089811_795913_10186" body="&lt;para>Hier können Akteure angegeben werden, die im eingeleiteten Verfahren relevant sind. Dies können unter anderem auch Anzeigengeber wie Bürger, TÜV etc. sein.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089875_384640_10307" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089875_41270_10305" name="" visibility="public" value="*"/>
                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_b8702dd_1784534089696_176504_10111" name="Datentypen" visibility="public" URI="">
                  <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534089811_605313_10188" name="BeteiligteVerfahren" visibility="public">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089898_210293_10340" annotatedElement="_19_0_4_b8702dd_1784534089811_605313_10188" body="&lt;para>Dieser Typ spezifiziert Akteure, die für die Durchführung des bauaufsichtlich eingeleiteten Verfahrens relevant sind. Gegebenenfalls können hier auch Anzeigengeber wie zum Beispiel der TÜV eingetragen werden.&lt;/para>"/>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089898_324107_10341" name="bauherr" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089910_804324_10439" annotatedElement="_19_0_4_b8702dd_1784534089898_324107_10341" body="&lt;para>Hier ist derjenige einzutragen, der am Verfahren als Bauherr beteiligt ist. Pro Bauherrn ist ein Element zu instanziieren.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089910_328222_10440" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089910_856427_10438" name="" visibility="public" value="*"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089898_56567_10342" name="gruppenname" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089910_537002_10443" annotatedElement="_19_0_4_b8702dd_1784534089898_56567_10342" body="&lt;para>Sofern eine Personengruppe vorliegt, kann in diesem Element der entsprechende Gruppenname dieser Personengruppe erfasst werden.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089910_498724_10444" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089910_573569_10442" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_667078_10343" name="bevollmaechtigter" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089910_161855_10447" annotatedElement="_19_0_4_b8702dd_1784534089900_667078_10343" body="&lt;para>Hier ist eine (natürliche oder juristische) Person einzutragen, die vom Bauherrn bevollmächtigt wurde.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089910_364310_10448" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089910_371726_10446" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_31151_10344" name="entwurfsverfasser" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089910_735793_10451" annotatedElement="_19_0_4_b8702dd_1784534089900_31151_10344" body="&lt;para>Hier ist die Person einzutragen, die am Verfahren als Entwurfsverfasser beteiligt ist. Falls kein Entwurfsverfasser für das Bauvorhaben benötigt wird, kann dieses Element entfallen.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089910_516146_10452" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089910_945070_10450" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_358283_10345" name="bauunternehmer" visibility="private" type="_16_5_4_8a30247_1422977426041_172815_6757">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089912_258331_10455" annotatedElement="_19_0_4_b8702dd_1784534089900_358283_10345" body="&lt;para>Als Bauunternehmer ist der Rohbau-Unternehmer einzutragen, benötigt wird die Firma mit Ansprechpartner.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089912_649462_10456" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089910_279933_10454" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_427126_10346" name="nachbar" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089912_756505_10459" annotatedElement="_19_0_4_b8702dd_1784534089900_427126_10346" body="&lt;para>Hier sind ggf. Nachbarn des Baugrundstücks einzutragen, soweit sie in die Prüfung des Bauvorhabens durch die Bauaufsichtsbehörde einzubeziehen sind. Pro zu berücksichtigenden Nachbarn ist ein Element zu instanziieren.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089912_559567_10460" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089912_163212_10458" name="" visibility="public" value="*"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_362576_10347" name="weitereBeteiligte" visibility="private" type="_19_0_4_b8702dd_1785499973816_165862_10664">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089912_864832_10463" annotatedElement="_19_0_4_b8702dd_1784534089900_362576_10347" body="&lt;para>Dieser Abschnitt fasst Daten zu weiteren Beteiligten zusammen. Pro Beteiligtem ist ein Element zu instanziieren.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089912_424388_10464" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089912_526233_10462" name="" visibility="public" value="*"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_251565_10348" name="gebuehrenpflichtiger" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089912_237501_10467" annotatedElement="_19_0_4_b8702dd_1784534089900_251565_10348" body="&lt;para>Hier sind die Personendaten des Gebührenpflichtigen anzugeben.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089912_981471_10468" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089912_645581_10466" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089900_28479_10349" name="anzeigengeber" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534089912_849715_10471" annotatedElement="_19_0_4_b8702dd_1784534089900_28479_10349" body="&lt;para>Hier können Daten einer Person oder Organisation angegeben werden, deren Meldung zur Einleitung des Verwaltungsverfahrens geführt hat, z.B. Bürger oder der TÜV.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089912_278671_10472" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089912_653092_10470" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534539920_355875_10858" name="Anonym_Zugangslink" visibility="public">
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534539935_18415_10859" name="url" visibility="private" type="_14_0_1_6370212_1218191702187_214129_966">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534539935_626010_10862" annotatedElement="_19_0_4_b8702dd_1784534539935_18415_10859" body="&lt;para>Hier ist die URL einer Webseite oder Ressource anzugeben.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534539935_755369_10863" name="" visibility="public" value="1"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534539935_40563_10861" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534539935_808382_10860" name="beschreibung" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1784534539935_559292_10866" annotatedElement="_19_0_4_b8702dd_1784534539935_808382_10860" body="&lt;para>Hier kann die zur URL passende Beschreibung der Webseite oder Ressource eingetragen werden.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534539935_939190_10867" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534539935_226526_10865" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1785148827461_574293_10548" name="AnlassgeberGenerisch" visibility="public">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785148827493_792833_10578" annotatedElement="_19_0_4_b8702dd_1785148827461_574293_10548" body="&lt;para>Dieser Typ spezifiziert einen Akteur, dessen Handlung die Bauaufsicht veranlasst, ein digitales Verwaltungsverfahren zu eröffnen.&lt;/para>"/>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1785148898161_475813_10746" name="rolle" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1785149090349_869171_10750" annotatedElement="_19_0_4_b8702dd_1785148898161_475813_10746" body="&lt;para>Hier ist die Rolle derjenigen Person oder Organisation anzugeben, deren Nachricht, Hinweis oder Feststellung die Bauaufsicht zur Einleitung des Verfahrens veranlasst hat.&lt;/para>&#xA;&lt;para>Beispiele sind Antragsteller, Hinweisgeber, beauftragter Prüfer, Mitarbeiter der Bauaufsicht etc.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785148964460_245752_10748" name="" visibility="public" value="1"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785148964460_506661_10749" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1785148827493_796179_10579" name="akteur" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1785148827493_861521_10591" annotatedElement="_19_0_4_b8702dd_1785148827493_796179_10579" body="&lt;para>Hier können, falls möglich und sinnvoll, Angaben zum Anlassgeber gemacht werden.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785148827493_911984_10592" name="" visibility="public"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785148827493_282440_10590" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1785499973816_165862_10664" name="Anonym_WeitereBeteiligte" visibility="public">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785499973864_387854_10694" annotatedElement="_19_0_4_b8702dd_1785499973816_165862_10664" body="&lt;para>Dieser Abschnitt fasst Daten zu weiteren Beteiligten zusammen. Pro Beteiligter ist ein Element zu instanziieren.&#xA;Hat ein weiterer Beteiligter die Rolle &quot;Fachplaner&quot;, &quot;Prüfsachverständiger&quot; oder &quot;Verantwortlicher&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot;, &quot;mitgliedschaftInland&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. Falls die Person nicht im Inland niedergelassen ist, sollte „Ausland“ befüllt werden. &#xA;Hat ein weiterer Beteiligter die Rolle &quot;Prüfingenieur&quot; oder &quot;Prüfsachverständiger&quot;, dann sollten im Datentyp die Elemente &quot;Berechtigung&quot; und &quot;Berufsbezeichnung&quot; befüllt werden. &lt;/para>"/>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1785499973864_920562_10695" name="beteiligter" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1785499973879_110141_10702" annotatedElement="_19_0_4_b8702dd_1785499973864_920562_10695" body="&lt;para>Hier sind die Personendaten des Beteiligten anzugeben.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785499973879_293379_10703" name="" visibility="public" value="1"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785499973879_262480_10701" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1785499973864_430341_10696" name="rolle" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1785499973879_525900_10706" annotatedElement="_19_0_4_b8702dd_1785499973864_430341_10696" body="&lt;para>Hier ist die Rolle des Beteiligten anzugeben.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785499973879_553110_10707" name="" visibility="public" value="1"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785499973879_249014_10705" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1785840185263_726488_10763" name="ReferenzVorgangsservice" visibility="public">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785840185263_708657_10764" annotatedElement="_19_0_4_b8702dd_1785840185263_726488_10763" body="&lt;para>Dieser Typ deckt Daten ab, durch die ein Service einen Vorgang eindeutig kennzeichnet.&lt;/para>&#xA;"/>
                    <ownedAttribute xmi:id="_19_0_4_b8702dd_1785840185263_383551_10765" name="referenzVorgangsservice" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                      <ownedComment xmi:id="_19_0_4_b8702dd_1785840185263_305987_10768" annotatedElement="_19_0_4_b8702dd_1785840185263_383551_10765" body="&lt;para>Initial eingetragener, i.d.R. maschinell erzeugter Identifier, der für den Vorgang steht (nicht für die das Verfahren einleitende Nachricht). &lt;/para>&#xA;&#xA;&lt;para>Dieser Identifier geht mit der das Verfahren einleitenden Nachricht der Fachbehörde zu und schafft dieser die Möglichkeit, in ihren Reaktionsnachrichten darauf zu referenzieren.&lt;/para>"/>
                      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785840185263_943724_10769" name="" visibility="public" value="1"/>
                      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785840185263_543540_10767" name="" visibility="public" value="1"/>
                    </ownedAttribute>
                  </packagedElement>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534089696_736177_10112" name="prozessnachrichten.vorgangsraum.schliessen.1302" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1784534089835_47319_10218" annotatedElement="_19_0_4_b8702dd_1784534089696_736177_10112" body="&lt;para>Mit dieser Nachricht fordert die Bauaufsichtsbehörde die bereitstellende Komponente auf, den angegebenen Vorgangsraum zu schließen und der Bauaufsichtsbehörde die Schließung des Vorgangsraums zu bestätigen.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089835_905267_10219" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089902_168536_10353" annotatedElement="_19_0_4_b8702dd_1784534089835_905267_10219" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Nachrichteninstanz Bezug zu nehmen, durch deren Eingang bei der bereitstellenden Komponente das Anlegen des Vorgangsraums ausgelöst worden ist.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089902_414133_10354" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089902_607881_10352" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089835_260460_10220" name="vorgangsraum" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089902_262281_10357" annotatedElement="_19_0_4_b8702dd_1784534089835_260460_10220" body="&lt;para>Dieses Element enthält Informationen zur Identität des angelegten Vorgangsraums bzw. die entsprechenden Zugangsdaten.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089902_345184_10358" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089902_483406_10356" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089835_813944_10221" name="zugangslink" visibility="private" type="_19_0_4_b8702dd_1784534539920_355875_10858">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089902_480654_10361" annotatedElement="_19_0_4_b8702dd_1784534089835_813944_10221" body="&lt;para>In diesem Element kann der Zugang zum Vorgangsraum per Verlinkung zum Ablageort der Dokumente eingetragen werden.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089902_222784_10362" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089902_645316_10360" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1784534089698_951857_10113" name="prozessnachrichten.vorgangsraum.geschlossen.1303" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1784534089863_10326_10252" annotatedElement="_19_0_4_b8702dd_1784534089698_951857_10113" body="&lt;para>Mit dieser Nachricht versendet die bereitstellende Komponente die Bestätigung, dass der angegebene Vorgangsraum geschlossen wurde, an die Bauaufsichtsbehörde.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089863_750952_10253" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089904_174640_10368" annotatedElement="_19_0_4_b8702dd_1784534089863_750952_10253" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den Vorgang bzw. die Nachrichteninstanz Bezug zu nehmen, durch deren Eingang bei der bereitstellenden Komponente das Anlegen des Vorgangsraums ausgelöst worden ist.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089904_401050_10369" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089904_717526_10367" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1784534089865_538718_10254" name="vorgangsraum" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1784534089904_719528_10372" annotatedElement="_19_0_4_b8702dd_1784534089865_538718_10254" body="&lt;para>Dieses Element enthält Informationen zur Identität des angelegten Vorgangsraums bzw. die entsprechenden Zugangsdaten.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1784534089904_441572_10373" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1784534089904_779265_10371" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1785149933261_591799_10800" name="prozessnachrichten.vorgangsraum.anlegen.1300.version1" visibility="public">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_325492_10830" annotatedElement="_19_0_4_b8702dd_1785149933261_591799_10800" body="&lt;para>Mit dieser Nachricht fordert die Bauaufsichtsbehörde die bereitstellende Komponente auf, einen Vorgangsraum anzulegen, diesen mit den erforderlichen Informationen aus der Datenbasis zu befüllen und der Bauaufsichtsbehörde die Identität des Vorgangsraums mitzuteilen.&lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_877652_10831" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_278008_10843" annotatedElement="_19_0_4_b8702dd_1785149933293_877652_10831" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf einen Vorgang Bezug zu nehmen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_546371_10844" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_173040_10842" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_727019_10832" name="aktenzeichen" visibility="private" type="_14_0_1_6370212_1218191873500_204582_1633">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_242300_10847" annotatedElement="_19_0_4_b8702dd_1785149933293_727019_10832" body="&lt;para>In dieses Element kann ein zusätzliches Aktenzeichen eingetragen werden, soweit die Vorgangsbezeichnung im Objekt bezug nicht ausreicht.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_184775_10848" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_374005_10846" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_485835_10833" name="bezeichnungDesBauvorhabens" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_496134_10851" annotatedElement="_19_0_4_b8702dd_1785149933293_485835_10833" body="&lt;para>Dieses Element enthält gegebenenfalls die Bezeichnung des Bauvorhabens, unter dem es in der Bauaufsichtsbehörde geführt wurde bzw. wird.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_823147_10852" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_926731_10850" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_315114_10834" name="referenzBGV" visibility="private" type="_19_0_4_41901a4_1664881730540_81040_6897">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_467440_10855" annotatedElement="_19_0_4_b8702dd_1785149933293_315114_10834" body="&lt;para>In dieses Element ist die eindeutige Referenz im IT-Fachverfahren der Bauaufsichtsbehörde (BGV) einzutragen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_689832_10856" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_803026_10854" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_193696_10835" name="grundstueck" visibility="private" type="_19_0_4_78d0259_1728545175832_300303_8774">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_531238_10859" annotatedElement="_19_0_4_b8702dd_1785149933293_193696_10835" body="&lt;para>Hier können Angaben zum Grundstück gemacht werden, auf das sich das Verfahren bezieht.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_325176_10860" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_799713_10858" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_212771_10836" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_256585_10863" annotatedElement="_19_0_4_b8702dd_1785149933293_212771_10836" body="&lt;para>Hier sind die Dokumente angegeben, die in den Vorgangsraum übertragen werden sollen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_651737_10864" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_648132_10862" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_774144_10837" name="artVerwaltungsverfahren" visibility="private" type="_19_0_4_b8702dd_1784534292028_495042_10855">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_312620_10867" annotatedElement="_19_0_4_b8702dd_1785149933293_774144_10837" body="&lt;para>Hier ist auszuwählen, welche Art von Verfahren eingeleitet werden soll.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_506748_10868" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_875846_10866" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_782258_10838" name="sachverhalt" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_593900_10871" annotatedElement="_19_0_4_b8702dd_1785149933293_782258_10838" body="&lt;para>Hier ist anzugeben, was der Anlass des von der Bauaufsicht eingeleiteten Verfahrens ist.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_599642_10872" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_306717_10870" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_4_b8702dd_1785149933293_580778_10839" name="anlassgeber" visibility="private" type="_19_0_4_b8702dd_1784534089811_605313_10188">
                    <ownedComment xmi:id="_19_0_4_b8702dd_1785149933293_887932_10875" annotatedElement="_19_0_4_b8702dd_1785149933293_580778_10839" body="&lt;para>Hier können Akteure angegeben werden, aufgrund deren Nachricht die Bauaufsicht das Verwaltungsverfahren angestoßen hat. Dies können Bürger, Antragsteller, Anzeigengeber wie der TÜV etc. sein.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1785149933293_440429_10876" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1785149933293_840355_10874" name="" visibility="public" value="*"/>
                  </ownedAttribute>
                </packagedElement>
              </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="_19_0_4_78d0259_1728657130758_501592_10029" name="universellerAntrag" visibility="public" URI="">
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130775_946406_10042" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_19_0_4_41901a4_1664881730536_329586_6881"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130775_102555_10043" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_19_0_3_136d03d4_1615207989277_776469_9579"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130775_11486_10044" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_19_0_3_136d03d4_1615208012576_880185_9581"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130775_885845_10045" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_19_0_3_136d03d4_1612479012595_942167_9330"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130775_657367_10046" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_16_5_4_5b501fb_1387625271062_845493_4821"/>
              <packagedElement xmi:type="uml:Dependency" xmi:id="_19_0_4_78d0259_1728657130776_914869_10047" name="" visibility="public" client="_19_0_4_78d0259_1728657130758_501592_10029" supplier="_19_0_4_41901a4_1659506109571_354848_6727"/>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728549533150_161612_8912" name="universellerAntrag.angepassterAntrag.1202" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728549828610_32079_8937" annotatedElement="_19_0_4_78d0259_1728549533150_161612_8912" body="&lt;para>Diese Nachricht enthält geänderte oder ergänzte Daten des Antrags bzw. geänderte oder ergänzte&#xA;Vorlagen. Sie bezieht sich auf einen bereits gestellten Antrag, zu dem noch kein Bescheid erteilt&#xA;wurde.&lt;/para>&#xA;&lt;para>Entweder ist sie eine Reaktion auf eine zum Antrag vorliegende Mängelliste der zuständigen Behörde,&#xA;oder der Antragsteller reicht aus anderen Gründen eine modifizierte Planung im laufenden Verfahren&#xA;nach.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_78d0259_1728568128324_737248_10330" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728549687069_514804_8916" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728549687081_455598_8918" annotatedElement="_19_0_4_78d0259_1728549687069_514804_8916" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen; außerdem ggf. auf die Nachrichten prozessnachrichten.formellePruefungBefundliste.1140 oder prozessnachrichten.fachlicheKommunikation.1142, wenn diese den Vorgang ausgelöst haben.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728549687081_332821_8919" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728549687077_683160_8917" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728549689328_831698_8923" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728549689331_439698_8925" annotatedElement="_19_0_4_78d0259_1728549689328_831698_8923" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten.&lt;/para>&#xA;&lt;para>Nachgereichte Anlagen: Aus der Beschreibung bzw. Bezeichnung der Anlage muss (wie immer) der Charakter der nachgereichten Unterlage hervorgehen. Ein gesonderter Bezug auf den Befund der Befundliste (z.B. Befund-Nr.), der ggf. zur Übermittlung dieser Unterlage führte, ist nicht erforderlich.&lt;/para>&#xA;&lt;para>Geänderte Anlagen: In diesem Fall wird eine neue Version (jüngeres Erstellungsdatum) einer bereits vorher gelieferten Anlagen übermittelt.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728549689331_752942_8926" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728549689330_781644_8924" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728544218826_934068_8756" name="universellerAntrag.antrag.1200" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728547146661_145488_8909" annotatedElement="_19_0_4_78d0259_1728544218826_934068_8756" body="&lt;para>Diese Nachricht stellt einen Antrag dar, d.h. durch das Senden dieser Nachricht an die zuständigen Behörden beantragt der Absender die Genehmigung zu dem in der Nachricht dokumentierten Vorhaben. Die Nachricht enthält die Daten des Antrags und als Anlage die dazugehörigen Vorlagen.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_78d0259_1728568108748_446052_10329" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728544651989_725055_8762" name="referenzAntragsservice" visibility="private" type="_18_0_2_940029b_1546716878558_771130_12819">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728544770273_847908_8764" annotatedElement="_19_0_4_78d0259_1728544651989_725055_8762" body="&lt;para>Eine vom Antragsservice vergebene eindeutige Kennung des Antragsvorgangs. Sofern die zuständige Behörde auf die Antragstellung reagiert, bezieht sie sich in ihren Reaktionsnachrichten auf diese Kennung.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728546167210_65040_8801" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728546167210_24813_8802" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1759998974567_997469_9409" name="artDesAntrags" visibility="private" type="_19_0_4_b8702dd_1757493765814_15882_9417">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1759998974589_769809_9410" annotatedElement="_19_0_4_b8702dd_1759998974567_997469_9409" body="&lt;para>In diesem Element wird die Art des Antrags angegeben.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1759999078121_268167_9414" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1759999078121_571767_9415" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728544794087_164621_8765" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728544794095_618664_8767" annotatedElement="_19_0_4_78d0259_1728544794087_164621_8765" body="&lt;para>Sofern anwendbar, kann hier ein Bezug zu einem anderen Vorgang angegeben werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728544794098_535642_8768" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728544794094_790282_8766" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728544935002_18201_8772" name="antragsteller" visibility="private" type="_16_5_4_8a30247_1408703057450_27821_3423">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728572879817_802499_8899" annotatedElement="_19_0_4_78d0259_1728544935002_18201_8772" body="&lt;para>In dieses Element sind die Daten des Antragstellers bzw. der Antragsteller einzutragen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728546158998_510562_8799" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728546158998_306108_8800" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728546018193_46867_8788" name="grundstueck" visibility="private" type="_19_0_4_78d0259_1728545175832_300303_8774">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728546089486_934077_8792" annotatedElement="_19_0_4_78d0259_1728546018193_46867_8788" body="&lt;para>In diesem Element sind Daten enthalten, die das Baugrundstück (ein Grundstück, auf dem das Vorhaben stattfinden soll bzw. auf dem es durchgeführt wurde) identifizieren. Ein Baugrundstück kann mehrere Grundstücke umfassen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728546038585_676860_8789" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728546038585_599291_8790" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728549721978_622334_8930" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728549721978_151081_8932" annotatedElement="_19_0_4_78d0259_1728549721978_622334_8930" body="&lt;para>Die für die Planung des Vorhabens notwendigen Vorlagen sind dem Antrag als Anlage  bzw. Verweise auf diese Anlagen beizufügen.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728549721978_468604_8933" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728549721978_469421_8931" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728567100074_911563_10014" name="universellerAntrag.materiellePruefungBefundliste.1203" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728567100085_381424_10023" annotatedElement="_19_0_4_78d0259_1728567100074_911563_10014" body="&lt;para>Diese Nachricht fordert den Antragsteller zur Stellungnahme auf, nachdem die materielle Prüfung des Antrags ergeben hat, dass Gründe vorliegen, die zu seiner Ablehnung durch die zuständige Behörde führen können. Es sind die Befunde enthalten, die das Ergebnis der materiellen Prüfung sind. Diese werden hier aufgelistet bzw. im Anhang der Nachricht dokumentiert mit dem Hinweis, dass Gelegenheit zu Stellungnahme bzw. Nachbesserung  besteht.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_78d0259_1728568070449_749955_10327" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100077_870119_10015" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100086_298737_10027" annotatedElement="_19_0_4_78d0259_1728567100077_870119_10015" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Antrag Bezug zu nehmen; außerdem ggf. auf die Nachricht universellerAntrag.antrag.1200, die den Vorgang ausgelöst hat. &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100087_64551_10028" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100086_81926_10026" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100079_378803_10016" name="aufforderungZurStellungnahme" visibility="private" type="_18_0_2_940029b_1535727067041_864259_10734" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100088_272224_10031" annotatedElement="_19_0_4_78d0259_1728567100079_378803_10016" body="&lt;para>Hier ist die Aufforderung zu Stellungnahme in Form eines Anschreibens formuliert.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100088_73155_10032" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100087_143166_10030" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100080_625314_10017" name="bescheidlage" visibility="private" type="_19_0_4_78d0259_1728567443349_699489_10152">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100089_961684_10035" annotatedElement="_19_0_4_78d0259_1728567100080_625314_10017" body="&lt;para>Hier können die Gründe, die nach aktueller Lage zur Ablehnung des Antrags durch die zuständige Behörde führen können, in Form einer strukturierten Liste angegeben werden. Es handelt sich um eine Liste von Abweichungen von den öffentlich-rechtlichen Vorschriften, die sich aus der laufenden Prüfung des Antrags ergeben hat. Zu jedem Eintrag der Liste fordert die Nachricht zu einer Stellungnahme bzw. Nachbesserung auf.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100089_38430_10036" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100088_493114_10034" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100081_230437_10019" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100090_80401_10043" annotatedElement="_19_0_4_78d0259_1728567100081_230437_10019" body="&lt;para>Hier kann eine durch die Behörde gesetzte Frist angegeben werden, innerhalb derer eine Stellungnahme des Antragstellers vorliegen muss, damit sie berücksichtigt werden kann.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100090_198554_10044" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100090_242867_10042" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100082_658230_10020" name="angebotFuerAntwortLeser" visibility="private" type="_19_0_3_136d03d4_1611781855355_662927_10055" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100091_430612_10047" annotatedElement="_19_0_4_78d0259_1728567100082_658230_10020" body="&lt;para>Dieses Element kann verwendet werden, um Webressourcen für ggf. nötige Reaktionen des Lesers auf die vorliegende Nachricht anzugeben . &lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100091_100353_10048" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100091_352589_10046" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567100082_543095_10021" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567100091_553819_10051" annotatedElement="_19_0_4_78d0259_1728567100082_543095_10021" body="&lt;para>Für die Aufforderung zur Stellungnahme ggf. notwendige Anhänge können hier der Nachricht als Anlage beigefügt werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567100092_19376_10052" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567100091_220322_10050" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728567750287_994975_10188" name="universellerAntrag.stellungnahme.1204" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728567750312_484629_10218" annotatedElement="_19_0_4_78d0259_1728567750287_994975_10188" body="&lt;para>Diese Nachricht bezieht sich auf einen bereits gestellten Antrag und auf eine zu diesem&#xA;vorliegende Anhörungsnachricht. Sie enthält Stellungnahmen  zu den Eigenschaften des Vorhabens bzw. des Antrags, die von der zuständigen Behörden beanstandet wurden. Sie enthält ggf. außerdem den nachgebesserten Antrag bzw. nachgebesserte Vorlagen.&lt;/para>&#xA;&#xA;"/>
                <generalization xmi:id="_19_0_4_78d0259_1728568048126_744103_10326" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567750313_491218_10219" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567750315_890799_10227" annotatedElement="_19_0_4_78d0259_1728567750313_491218_10219" body="&lt;para>Unterhalb dieses Elements werden Eintragungen vorgenommen, um auf den laufenden Vorgang zum Bauantrag Bezug zu nehmen und außerdem auf die Nachricht universellerAntrag.materiellePruefungBefundliste.1203, auf deren Inhalt sich die vorliegende Nachricht bezieht.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567750315_169251_10228" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567750315_698049_10226" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567750313_765728_10220" name="stellungnahmeBelastenderVerwaltungsakt" visibility="private" type="_19_0_4_78d0259_1728568308217_499205_10331" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567750315_428900_10231" annotatedElement="_19_0_4_78d0259_1728567750313_765728_10220" body="&lt;para>Hier ist die Reaktion auf die in der Anhörungsnachricht enthaltenen Punkte einzutragen. Dies kann eine Verteidigung der ursprünglichen Konzeption sein, dies kann aber auch eine geänderte Antragsunterlage sein, welche in diesem Fall in den Anlagen dokumentiert ist.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567750315_693105_10232" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567750315_676447_10230" name="" visibility="public" value="*"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728567750314_920150_10222" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728567750316_407968_10239" annotatedElement="_19_0_4_78d0259_1728567750314_920150_10222" body="&lt;para>Hier sind ggf. überarbeitete oder nachgereichte Anlagen bzw. Verweise auf überarbeitete oder nachgereichte Anlagen enthalten, passend zur weiter oben gegebenen Stellungnahme bzw. Erläuterung der Anpassung. &lt;/para>&#xA;&lt;para>Geänderte oder ergänzte Daten werden als Brutto-Datensatz geschickt. Es werden mit diesem Element also die bereinigten und ggf. ergänzten Daten vollständig gesendet, so dass der Empfänger einen 'Datensatz nach Änderung' erhält.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728567750316_362109_10240" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728567750316_717288_10238" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_78d0259_1728550330695_124171_8940" name="universellerAntrag.bescheid.1205" visibility="public">
                <ownedComment xmi:id="_19_0_4_78d0259_1728573045845_139709_8900" annotatedElement="_19_0_4_78d0259_1728550330695_124171_8940" body="&lt;para>Diese Nachricht stellt den Bescheid dar, in den die zuständige Behörde die Ergebnisse ihrer materiellen&#xA;Prüfung einträgt. Der Antrag ist entweder genehmigt, genehmigt mit Nebenbestimmungen&#xA;(zum Beispiel unter Auflagen) oder abgelehnt. Das Absenden dieser Nachricht stellt das Erteilen des&#xA;Bescheids dar.&lt;/para>"/>
                <generalization xmi:id="_19_0_4_78d0259_1728568089857_686666_10328" general="_19_0_3_136d03d4_1617018517570_525675_9422"/>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550484095_359632_8946" name="bezug" visibility="private" type="_19_0_3_129a03b9_1668162628374_570793_9692">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550484103_957747_8948" annotatedElement="_19_0_4_78d0259_1728550484095_359632_8946" body="&lt;para>Dieses Objekt enthält die Eintragungen, die auf den Vorgang bzw. die Nachricht universellerAntrag.antrag.1200 mit dem Antrag Bezug nehmen, zu dem die vorliegende Nachricht den Bescheid enthält.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550484104_236086_8949" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550484101_500105_8947" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550585578_893908_9005" name="anlagen" visibility="private" type="_16_5_4_940029b_1460560241523_867175_3826">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550585579_793006_9007" annotatedElement="_19_0_4_78d0259_1728550585578_893908_9005" body="&lt;para>Hier sind die Anlagen zum Bescheid bzw. Verweise auf diese Anlagen enthalten.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550585579_252674_9008" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550585579_655412_9006" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_78d0259_1728550591652_134872_9012" name="bescheid" visibility="private" type="_19_0_4_78d0259_1728550570080_667657_8953">
                  <ownedComment xmi:id="_19_0_4_78d0259_1728550684137_172176_9018" annotatedElement="_19_0_4_78d0259_1728550591652_134872_9012" body="&lt;para>In diesem Objekt sind die verschiedenen Komponenten des Bescheides enthalten.&lt;/para>&#xA;&lt;para>Ein Bescheid mit positivem Tenor kann zugelassene oder auch nicht zugelassene Abweichungen (Element abweichung) enthalten. Ein Bescheid mit negativem Tenor kann nur nicht zugelassene Abweichungen enthalten. Die Abweichungen sind in den Hinweisen anzugeben.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_78d0259_1728550607736_857894_9013" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_78d0259_1728550607738_640736_9014" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
            </packagedElement>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="_19_0_3_136d03d4_1612479039044_716623_9333" name="Prozesse" visibility="public" URI="">
            <packagedElement xmi:type="uml:Package" xmi:id="_18_0_2_940029b_1541265512624_204597_12556" name="Prozessmuster" visibility="public" URI="">
