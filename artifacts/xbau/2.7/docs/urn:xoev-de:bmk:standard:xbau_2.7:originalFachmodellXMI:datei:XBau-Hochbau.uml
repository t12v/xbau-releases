                  </ownedAttribute>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="_19_0_3_129a03b9_1694598818396_360789_9002" name="Zahlungsdaten" visibility="public">
                  <ownedComment xmi:id="_19_0_3_129a03b9_1694598818396_655246_9003" annotatedElement="_19_0_3_129a03b9_1694598818396_360789_9002" body="&lt;para>Dieser Typ enthält die Angaben, die für die bargeldlose Bezahlung gemäß SEPA benötigt werden. &lt;/para>"/>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598818396_644727_9004" name="iban" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598818396_839376_9009" annotatedElement="_19_0_3_129a03b9_1694598818396_644727_9004" body="&lt;para>IBAN des Kontos, auf das die Gebühr einzuzahlen ist.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598818396_308559_9010" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598818396_419914_9008" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598818396_183728_9005" name="bic" visibility="private" type="_19_0_4_41901a4_1659506109571_319729_6731">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598818396_771600_9013" annotatedElement="_19_0_3_129a03b9_1694598818396_183728_9005" body="&lt;para>Angabe zur Bank (BIC), bei der das Konto eingerichtet ist, auf das die Gebühr einzuzahlen ist. Für Überweisungen des Anwenders aus dem Ausland.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598818396_524895_9014" name="" visibility="public"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598818396_983135_9012" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                  <ownedAttribute xmi:id="_19_0_3_129a03b9_1694598818396_349596_9006" name="verwendungszweck" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                    <ownedComment xmi:id="_19_0_3_129a03b9_1694598818396_862454_9017" annotatedElement="_19_0_3_129a03b9_1694598818396_349596_9006" body="&lt;para>Hier ist das Kassenzeichen einzutragen, unter dem die Sollstellung durch die Behörde bei der lokalen Finanzverwaltung veranlasst wurde. Ist vom Gebührenzahler bei der Zahlung im Überweisungsformular in das Feld &quot;Verwendungszweck&quot; einzutragen.&lt;/para>"/>
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_3_129a03b9_1694598818396_823185_9018" name="" visibility="public" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_3_129a03b9_1694598818396_116871_9016" name="" visibility="public" value="1"/>
                  </ownedAttribute>
                </packagedElement>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1749125401449_564366_9333" name="Anonym_BefundFrist" visibility="public">
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125401455_663778_9334" name="befundliste" visibility="private" type="_18_0_2_940029b_1552127281868_654162_14786" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125401457_435499_9337" annotatedElement="_19_0_4_b8702dd_1749125401455_663778_9334" body="&lt;para>In diesem Element sind die Ergebnisse der formellen Prüfung enthalten. Sie haben die Form einer Liste von Mängeln des geprüften Gegenstandes.&lt;/para>&#xA;"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125401457_777237_9338" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125401456_703598_9336" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1749125401455_881898_9335" name="frist" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042" aggregation="composite">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1749125401458_468952_9341" annotatedElement="_19_0_4_b8702dd_1749125401455_881898_9335" body="&lt;para>Im Falle einer Unvollständigkeit der Dokumente kann in dieses Element - falls im entsprechenden Vorgang vorgesehen - eine durch die Behörde gesetzte Frist eingetragen werden, innerhalb derer die genannten Mängel zu beseitigen und die Unterlagen erneut einzureichen sind.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1749125401458_938333_9342" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1749125401458_886026_9340" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1774959546286_204653_9300" name="UnterlagenDokumentationVollstaendig" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1774959546319_981986_9330" annotatedElement="_19_0_4_b8702dd_1774959546286_204653_9300" body="&lt;para>Falls im Rahmen der formellen Prüfung alle Merkmale positiv bewertet wurden (Zuständigkeit ist gegeben, Unterlagen liegen vollständig vor usw.), sind die Angaben zur Genehmigungsfrist und zu den eingereichten Unterlagen hier zu machen.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1774959546319_863997_9331" name="genehmigungsdatum" visibility="private" type="_19_0_4_b8702dd_1774959686256_150688_9522">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1774959546319_292970_9336" annotatedElement="_19_0_4_b8702dd_1774959546319_863997_9331" body="&lt;para>Hier können bei Anträgen Angaben zum voraussichtlichen Genehmigungsdatum (optional) und spätesten Genehmigungsdatum (obligatorisch) gemacht werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774959546319_736392_9337" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774959546319_365425_9335" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1774959546319_1533_9332" name="eingereichteBauvorlagen" visibility="private" type="_19_0_4_b8702dd_1774959628538_569443_9410">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1774959546319_728008_9340" annotatedElement="_19_0_4_b8702dd_1774959546319_1533_9332" body="&lt;para>Hier können Angaben zu den eingereichten Bauvorlagen gemacht werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774959546319_433798_9341" name="" visibility="public"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774959546319_781109_9339" name="" visibility="public" value="*"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1774959628538_569443_9410" name="EingereichteBauvorlagen" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1774959628550_637650_9440" annotatedElement="_19_0_4_b8702dd_1774959628538_569443_9410" body="&lt;para>Hier kann die Kategorie der eingereichten Bauvorlage und die Bezeichnung der eingereichten Datei eingetragen werden.&lt;/para>"/>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1774959628550_951692_9441" name="kategorieBauvorlage" visibility="private" type="_19_0_3_940029b_1629982356132_732557_9504">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1774959628550_49669_9446" annotatedElement="_19_0_4_b8702dd_1774959628550_951692_9441" body="&lt;para>Hier kann die Kategorie der eingereichten Bauvorlage eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774959628550_861956_9447" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774959628550_524014_9445" name="" visibility="public" value="1"/>
                </ownedAttribute>
                <ownedAttribute xmi:id="_19_0_4_b8702dd_1774959628550_571638_9442" name="bezeichnungDatei" visibility="private" type="_19_0_4_b8702dd_1782126210777_148475_9522">
                  <ownedComment xmi:id="_19_0_4_b8702dd_1774959628550_481485_9450" annotatedElement="_19_0_4_b8702dd_1774959628550_571638_9442" body="&lt;para>Hier kann die Bezeichnung der eingereichten Bauvorlage eingetragen werden.&lt;/para>"/>
                  <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b8702dd_1774959628550_534732_9451" name="" visibility="public" value="1"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b8702dd_1774959628550_731624_9449" name="" visibility="public" value="1"/>
                </ownedAttribute>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="_19_0_4_b8702dd_1774959686256_150688_9522" name="Genehmigungsdatum" visibility="public">
                <ownedComment xmi:id="_19_0_4_b8702dd_1774959686256_465520_9552" annotatedElement="_19_0_4_b8702dd_1774959686256_150688_9522" body="&lt;para>Hier können bei Anträgen Angaben zum voraussichtlichen Genehmigungsdatum (optional) und spätesten Genehmigungsdatum (obligatorisch) gemacht werden.&lt;/para>"/>
