                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287322_310131_6884" annotatedElement="_16_5_4_5b501fb_1406633287172_485750_5862" body="Hier werden Angaben zum Tod einer natürlichen Person gemacht."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287322_525512_6885" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287172_485750_5862"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Association" xmi:id="_16_5_4_5b501fb_1406633287172_637798_5863" name="" visibility="public" memberEnd="_16_5_4_5b501fb_1406633287175_333952_5875 _16_5_4_5b501fb_1406633287322_105833_6887">
                  <ownedComment xmi:id="_16_5_4_5b501fb_1406633287322_222391_6886" annotatedElement="_16_5_4_5b501fb_1406633287172_637798_5863" body="Hier kann angegeben werden, welche Sprachen eine natürliche Person als Muttersprache beherrscht."/>
                  <ownedEnd xmi:id="_16_5_4_5b501fb_1406633287322_105833_6887" name="" visibility="private" type="_16_5_4_5b501fb_1406633287060_530611_5371" association="_16_5_4_5b501fb_1406633287172_637798_5863"/>
                </packagedElement>
