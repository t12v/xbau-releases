              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1696424191136_678854_24848" name="" visibility="public" value="1"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_19_0_4_b6602da_1696424827386_8062_24971" name="datumVorOrtBesichtigung" visibility="private" type="_14_0_1_6370212_1218191726109_379108_1042">
