            <ownedAttribute xmi:id="_19_0_4_b6602da_1714115823542_829325_25796" name="erneuerbareEnergieGasfoermigeBiomasse" visibility="private" type="_14_0_1_6370212_1218191716468_578747_1004">
              <ownedComment xmi:id="_19_0_4_b6602da_1714115823636_206652_26266" annotatedElement="_19_0_4_b6602da_1714115823542_829325_25796" body="&lt;para>Durch die Übermittlung dieses Elements/Attributs wird mitgeteilt, dass gasförmige Biomasse nach § 71ff GEG genutzt wird. In diesem Element/Attribut ist nur der Wert &quot;true&quot; zulässig (fixed-Wert).&lt;/para>"/>
              <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_19_0_4_b6602da_1714115823636_525190_26267" name="" visibility="public"/>
              <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_19_0_4_b6602da_1714115823635_623443_26265" name="" visibility="public" value="1"/>
