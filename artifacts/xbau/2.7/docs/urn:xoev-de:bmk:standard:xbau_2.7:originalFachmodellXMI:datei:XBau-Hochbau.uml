            </node>
            <node xmi:type="uml:CallBehaviorAction" xmi:id="_19_0_3_136d03d4_1611871270058_757805_27566" name="Schlussprüfbericht erstellen" visibility="public" incoming="_19_0_3_136d03d4_1611871270069_700484_27633" outgoing="_19_0_3_136d03d4_1611871270067_163259_27613" inPartition="_19_0_3_136d03d4_1611871270065_75840_27599">
