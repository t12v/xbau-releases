"2"/></slot><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_12_2" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_beschreibung"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_12_2_Value" value="bauliche Anlagen mit einer Höhe von mehr als 30 m "/></slot></packagedElement><packagedElement xmi:type="uml:InstanceSpecification" name="20" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_13"><classifier xmi:idref="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_Codelistenversion"/><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_13_1" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_code"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_13_1_Value" value="20"/></slot><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_13_2" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_beschreibung"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_13_2_Value" value="Fliegende Bauten, soweit sie einer Ausführungsgenehmigung bedürfen"/></slot></packagedElement><packagedElement xmi:type="uml:InstanceSpecification" name="21" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_14"><classifier xmi:idref="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_Codelistenversion"/><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_14_1" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_code"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_14_1_Value" value="21"/></slot><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_14_2" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_beschreibung"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_14_2_Value" value="Regallager mit einer Oberkante Lagerguthöhe von mehr als 7,50 m"/></slot></packagedElement><packagedElement xmi:type="uml:InstanceSpecification" name="22" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_15"><classifier xmi:idref="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_Codelistenversion"/><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_15_1" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_code"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_15_1_Value" value="22"/></slot><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_15_2" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_beschreibung"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_15_2_Value" value="bauliche Anlagen, deren Nutzung durch Umgang oder Lagerung von Stoffen mit Explosions- oder erhöhter Brandgefahr verbunden ist"/></slot></packagedElement><packagedElement xmi:type="uml:InstanceSpecification" name="23" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_16"><classifier xmi:idref="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_Codelistenversion"/><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_16_1" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_code"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_16_1_Value" value="23"/></slot><slot xmi:type="uml:Slot" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_16_2" definingFeature="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_beschreibung"><value xmi:type="uml:LiteralString" xmi:id="urn_xoev-de_xbau_codeliste_mbosonderbauten_1.0_16_2_Value" value="Sonstige Anlagen und Räume, deren Art oder Nutzung mit vergleichbaren Gefahren verbunden sind."/></slot></packagedElement><packagedElement xmi:type="uml:InstanceSpecification" name="3" xmi:id="urn_xoev-de_xbau_codeliste_mbosonde