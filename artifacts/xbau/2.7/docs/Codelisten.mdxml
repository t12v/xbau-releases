 19.0"><modelPart name="com.nomagic.magicdraw.uml_model.shared_model"/></xmi:Extension><XOEV_Profil:xoevCodelistenspalte xmi:id="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_ISO_2_xoevCodelistenspalte" base_Property="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_ISO_2" codeSpalte="false" datentyp="string" empfohleneCodeSpalte="false" spaltennameLang="ISO 2stellig" verwendung="optional"/><xmi:Extension extender="MagicDraw UML 19.0"><modelPart name="com.nomagic.magicdraw.uml_model.shared_model"/></xmi:Extension><XOEV_Profil:xoevCodelistenspalte xmi:id="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Kontinent_kurz_xoevCodelistenspalte" base_Property="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Kontinent_kurz" codeSpalte="false" datentyp="string" empfohleneCodeSpalte="false" spaltennameLang="Kontinent, Abkürzung" verwendung="optional"/><xmi:Extension extender="MagicDraw UML 19.0"><modelPart name="com.nomagic.magicdraw.uml_model.shared_model"/></xmi:Extension><XOEV_Profil:xoevCodelistenspalte xmi:id="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Hinweis_xoevCodelistenspalte" base_Property="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Hinweis" codeSpalte="false" datentyp="string" empfohleneCodeSpalte="false" spaltennameLang="Hinweis" verwendung="optional"/><xmi:Extension extender="MagicDraw UML 19.0"><modelPart name="com.nomagic.magicdraw.uml_model.shared_model"/></xmi:Extension><XOEV_Profil:xoevVersionCodeliste xmi:id="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_xoevVersionCodeliste" base_Class="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Codelistenversion" versionCodelistenHandbuch="1.0" aenderungZurVorversion="&#34;Nordmazedonien&#34; anstelle von &#34;Mazedonien&#34; &#xA;                (Suchbegriff), &#34;Nordmazedonien&#34; anstelle von &#34;ehem. jugoslawische Republik Mazedonien&#34; &#xA;                (Staatsname_kurz), &#34;die Republik Nordmazedonien&#34; anstelle von&#xA;                &#34;die ehemalige jugoslawische Republik Mazedonien&#34; (Staatsname_voll).&#xA;                Hinweise zum Umgang mit den Ausprägungen britischer Staatsangehörigkeit vor und nach einem BREXIT.&#xA;                Die Codeliste enthält keinen Halbgeviertstrich mehr." datumGueltigkeitAb="2019-04-01" version="2019-04-01"/><xmi:Extension extender="MagicDraw UML 19.0"><modelPart name="com.nomagic.magicdraw.uml_model.shared_model"/></xmi:Extension><XOEV_Profil:xoevCodeliste xmi:id="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_xoevCodeliste" base_Class="urn_de_bund_destatis_bevoelkerungsstatistik_schluessel_staatsgebiete_2019-04-01_Codeliste" beschreibung="Staatsgebiete. Tabelle von derzeitigen Staatsgebieten &#xA;                und deren unselbständiger Teile, d.h. von Staaten und deren Gebiete bzw. Gebietsteile &#xA;                sowie von exterritorialen Teilen von Staaten. Liste von Gebieten, die über einen eigenen &#xA;                ISO-3166-1 Code verfügen. Mehrere Einträge können den gleichen Destatis-Gebietscode besitzen. &#xA;                Bei Staaten ohne unselbständige Gebiete (mit eigenen ISO-Code) trägt das Staatsgebiet &#xA;                sowohl den gleichen Destatis-Code wie auch den gleichen ISO-Code wie der Staat. &#xA;                Bei Staaten mit unselbständigen Gebieten (mit eigenen ISO-Code) wird der Teil des &#xA;                Staatsgebietes mit den gleichen Destatis- und ISO-Codes wie der Staat als &#34;Mutterland&#34; &#xA;                bezeichnet, alle anderen Teile des Staatsgebietes als unselbständige(s) Gebiete(e). &#xA;                Enthält z.B. Einträge für: Frankreich (Mutterland, also das Hexagon), Französisch-Guayana &#xA;                (exterritoriales Gebiet, d.h. Übersee-Departement Frankreichs), Italien (Gebiet des Stiefels &#xA;                + Inseln im Mittelmeer), Vereinigtes Königreich (= Großbritannien - d.h. Gebiet von England, &#xA;                Schottland, Wales - plus Nordirland), britische Jungferninseln (exterritoriales Gebiet des &#xA;                Vereinigten Königreichs), Jersey (Krongebiet, rechtlich kein Teil des Vereinigten Königreichs). &#xA;                Neben der amtlichen Bezeichnung des Gebiets (Kurzform und Vollform) ist der Suchbegriff &#xA;                aus dem Länderverzeichnis des Auswärtigen Amtes aufgeführt (der Suchbegriff ist hier eine &#xA;                griffige Bezeichnung des Gebietes). Die Angaben umfassen zudem die amtlichen Bezeichnungen &#xA;                (Kurzform und Vollform) des Staates, zu dem das Gebiet gehört, die Staatsangehörigkeit, &#xA;                die in diesem Gebiet gilt, sowie die numerischen Destatis-Code für Gebiet, Staatsangehörigkeit &#xA;                und Staat, den 2- und 3-stelligen alphabetischen ISO 3166-1 Code sowie für den Staat, zu dem &#xA;                das Gebiet gehört, ggf. das Datum der Selbständigkeit bzw. Gründungsdatum nach den Angaben &#xA;                des Auswärtigen Amtes und das Auflösungs- bzw. Enddatum als berechnete Angabe aus dem &#xA;                Gründungsdatum des/der Nachfolgestaaten." herausgebernameKurz="DESTATIS F204" herausgebernameLang="Statistisches Bundesamt F 204, Wiesbaden" kennung="urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:staatsgebiete" nameKurz="DESTATIS Staatsgebiete" nameLang="Codeliste Staatsgebiete aus der Staats- und Gebietssystematik des Statistischen Bundesamtes" nameTechnisch="Staatsgebiete"/><xmi:Extension extender="MagicDraw UML 19.0"><filePart name="PROJECT-ec10d975-6d30-4dad-8386-6786ddda7808" type="BINARY">H4sIAAAAAAAAAAMAAAAAAAAAAAA=</filePart></xmi:Extension><xmi:Extension extender="MagicDraw UML 19.0"><filePart name="com.nomagic.ci.metamodel.project" type="XML" header="&lt;?xml version=&#34