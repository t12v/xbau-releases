<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xbauk="http://www.xleitstelle.de/xbau/kernmodul/1/4/0"
           xmlns:din91379="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           targetNamespace="http://www.xleitstelle.de/xbau/kernmodul/1/4/0"
           version="1.4.0"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">
   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XBau-Kernmodul</nameLang>
            <nameKurz>XBau-Kernmodul</nameKurz>
            <nameTechnisch>xbau-kernmodul</nameTechnisch>
            <kennung>urn:xoev-de:bmk:standard:xbau-kernmodul</kennung>
            <beschreibung>Das XBau-Kernmodul umfasst die von den XBau-Fachmodulen gemeinsam verwendeten Daten- und Nachrichtentypen.</beschreibung>
         </standard>
         <versionStandard>
            <version>1.4.0</version>
            <beschreibung>In den Bauantragsverfahren des XBau-Fachmoduls wird für das Ergebnis der formellen Prüfung nun die generische Kernmodul-Nachricht verwendet, welche zu diesem Zweck ergänzt und textlich angepasst wurde. Dienste mit dem Dienstanbietern "Bauaufsichtsbehörde" oder "Baubeteiligte Stelle" können nun auch von Bau- bzw. Beteiligungsportalen verwendet werden. Die Übermittlung mandatorischer Freitextelemente ohne Inhalt wird jetzt durch die Verwendung neuer eingeschränkter Datentypen unterbunden. Die Nutzungsszenarien der Prozessnachrichten wurden weiter ausgebaut, z.B. für die Unterbrechung der Antragsbearbeitung oder die Übermittlung bescheidähnlicher Dokumente. Die Verarbeitbarkeit von Anlagen wurde verbessert, indem IDs für verlinkte Anlagen und eine Prüfung auf doppelt vorhandene Anlagen eingeführt wurden. Es wurde ein generischer Prozess hinzugefügt, der es der Bauaufsicht ermöglicht, selbst ein digitales Verfahren zu eröffnen. Weitere Details zu Änderungen sind in der Versionshistorie des Spezifikationsdokuments enthalten.</beschreibung>
            <versionXOEVProfil>3.0.3</versionXOEVProfil>
            <versionXOEVHandbuch>3.0.1</versionXOEVHandbuch>
            <versionXGenerator>3.2.4</versionXGenerator>
            <versionModellierungswerkzeug>19.0</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:import schemaLocation="din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:simpleType name="Dateiname">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp definiert den in XBau zulässigen Aufbau von Dateinamen. Es wird empfohlen, die Länge von Dateinamen auf maximal 140 Zeichen zu beschränken.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:pattern value="[-a-zA-Z0-9ÄÖÜäöüß _!=+~,;.#°§$%()\[\]]+\.[a-zA-Z0-9]+"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Dezimal.XBau">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp stellt numerische Werte mit zwei Nachkommastellen dar. Er kann für Zahlen genutzt werden, die mit dieser Präzision sinnvoll sind. Darum erlaubt der Datentyp Dezimal.XBau zum Beispiel bei der Übertragung der Einheit Meter (m) eine Präzision von einem Zentimeter.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:decimal">
         <xs:fractionDigits value="2"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Jahr">
      <xs:annotation>
         <xs:documentation>Mit diesem Datentyp wird ein teilweise bekanntes Datum übermittelt. Vom Datum ist nur das Jahr bekannt.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:gYear">
         <xs:pattern value="[0-9]{4}"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="JahrMonat">
      <xs:annotation>
         <xs:documentation>Mit diesem Datentyp wird ein teilweise bekanntes Datum übermittelt. Vom Datum sind nur Jahr und Monat bekannt.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:gYearMonth">
         <xs:pattern value="[0-9]{4}-[0-9]{2}"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="datatypeCNotBlank">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp definiert einen Freitext mit dem Zeichenvorrat von DataTypeC, der jedoch weder leer sein, noch nur Whitespace-Zeichen enthalten darf.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="din91379:datatypeC">
         <xs:minLength value="1"/>
         <xs:whiteSpace value="collapse"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="datatypeDNotBlank">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp definiert einen Freitext mit dem Zeichenvorrat von DataTypeD, der jedoch weder leer sein, noch nur Whitespace-Zeichen enthalten darf.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="din91379:datatypeD">
         <xs:minLength value="1"/>
         <xs:whiteSpace value="collapse"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="stringNotBlank">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp definiert einen string (W3C-Datentyp), der jedoch weder leer sein, noch nur Whitespace-Zeichen enthalten darf.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:minLength value="1"/>
         <xs:whiteSpace value="collapse"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="tokenNotBlank">
      <xs:annotation>
         <xs:documentation>Dieser Datentyp definiert ein token (W3C-Datentyp), das jedoch weder leer sein, noch nur Whitespace-Zeichen enthalten darf.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:token">
         <xs:minLength value="1"/>
         <xs:whiteSpace value="collapse"/>
      </xs:restriction>
   </xs:simpleType>
</xs:schema>
