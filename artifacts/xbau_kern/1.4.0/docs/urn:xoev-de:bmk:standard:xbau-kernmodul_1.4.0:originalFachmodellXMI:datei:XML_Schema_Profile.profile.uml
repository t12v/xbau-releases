          <language>OCL2.0</language>
          <body>not specific.appliedStereotypeInstance.oclIsUndefined() and specific.appliedStereotypeInstance.classifier -> select (name='XSDsimpleType') ->size()=0</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163579507359_662856_1290" name="xsdattributegroup on Simpletype or Complextype" visibility="public" constrainedElement="magicdraw_1046684505444_590497_493">
