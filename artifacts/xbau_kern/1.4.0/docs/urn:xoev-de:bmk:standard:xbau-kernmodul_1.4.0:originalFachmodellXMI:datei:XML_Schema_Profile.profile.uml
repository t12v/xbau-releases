    <packagedElement xmi:type="uml:Package" xmi:id="_12_0_8f90291_1163703146375_8469_2064" name="XML Schema constraints" visibility="public" URI="">
      <ownedRule xmi:id="_12_0_8f90291_1163575123937_950942_1219" name="Not XML Schema Types for XSDattribute" visibility="public" constrainedElement="magicdraw_1046682040730_843189_181">
        <ownedComment xmi:id="_12_0_8f90291_1163575454812_25968_1228" annotatedElement="_12_0_8f90291_1163575123937_950942_1219" body="XML Schema – specific types, not simple UML types should be used."/>
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_12_0_8f90291_1163575353828_963914_1220" name="" visibility="public">
          <language>OCL2.0</language>
          <body>(not type.oclIsUndefined()) implies (type.oclIsKindOf(XSDsimpleType) or type.oclIsKindOf(XSDcomplexType) or (type.oclIsKindOf(XSDcomponent) and type.name='anyType'))</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163575564875_903163_1229" name="Not XML Schema Types for XSDelement" visibility="public" constrainedElement="magicdraw_1046682074970_241068_216">
        <ownedComment xmi:id="_12_0_8f90291_1163575564875_184456_1231" annotatedElement="_12_0_8f90291_1163575564875_903163_1229" body="XML Schema – specific types, not simple UML types should be used."/>
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_12_0_8f90291_1163575564875_842586_1230" name="" visibility="public">
          <language>OCL2.0</language>
          <body>(not type.oclIsUndefined()) implies type.oclIsKindOf(XSDsimpleType) or type.oclIsKindOf(XSDcomplexType) or (type.oclIsKindOf(XSDcomponent) and name='anyType')</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163578065437_960718_1249" name="No xsdattribute in xsdsimpletype" visibility="public" constrainedElement="magicdraw_1046682040730_843189_181">
        <ownedComment xmi:id="_12_0_8f90291_1163578065437_986038_1251" annotatedElement="_12_0_8f90291_1163578065437_960718_1249" body="No XSDAttributes in XSDSimpleTypes"/>
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_12_0_8f90291_1163578065437_66190_1250" name="" visibility="public">
          <language>OCL2.0</language>
          <body>not owner.appliedStereotypeInstance.oclIsUndefined() and
owner.appliedStereotypeInstance.classifier -> select (name='XSDsimpleType') ->size()=0</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163576703203_207632_1239" name="No xsdelement in xsdsimpletype" visibility="public" constrainedElement="magicdraw_1046682074970_241068_216">
        <ownedComment xmi:id="_12_0_8f90291_1163577439390_112336_1248" annotatedElement="_12_0_8f90291_1163576703203_207632_1239" body="No XSDElements in XSDSimpleTypes"/>
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_12_0_8f90291_1163576860328_549439_1240" name="" visibility="public">
          <language>OCL2.0</language>
          <body>not owner.appliedStereotypeInstance.oclIsUndefined() and
owner.appliedStereotypeInstance.classifier -> select (name='XSDsimpleType') -> size()=0</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163579728187_658670_1301" name="xsdattribute in xsdsimplecontent" visibility="public" constrainedElement="magicdraw_1046682040730_843189_181">
        <ownedComment xmi:id="_12_0_8f90291_1163579728187_686842_1303" annotatedElement="_12_0_8f90291_1163579728187_658670_1301" body="No XSDAttributes in XSDsimpleContent"/>
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_12_0_8f90291_1163579728187_69197_1302" name="" visibility="public">
          <language>OCL2.0</language>
          <body>not owner.appliedStereotypeInstance.oclIsUndefined() and owner.appliedStereotypeInstance.classifier -> select (name='XSDsimpleContent') ->asSet()->size()=0</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_12_0_8f90291_1163578227171_428030_1260" name="Simple Type Derived by Extension" visibility="public" constrainedElement="magicdraw_1046684263597_121702_458">
        <ownedComment xmi:id="_12_0_8f90291_1163578556218_779910_1269" annotatedElement="_12_0_8f90291_1163578227171_428030_1260" body="SimpleType can not be derived by extension"/>
